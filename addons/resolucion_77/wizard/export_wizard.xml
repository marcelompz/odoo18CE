<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista Form del Wizard de Exportación -->
        <record id="view_resolucion_77_export_wizard_form" model="ir.ui.view">
            <field name="name">resolucion.77.export.wizard.form</field>
            <field name="model">resolucion.77.export.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Exportar Cuadro de Depreciación">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del reporte..."/>
                            </h1>
                        </div>

                        <group>
                            <group name="filters" string="Filtros de Datos">
                                <field name="fecha_desde"/>
                                <field name="fecha_hasta"/>
                                <field name="incluir_activos"/>
                                <field name="incluir_dados_baja"/>
                                <field name="solo_incluir_en_reporte"/>
                            </group>
                            <group name="fiscal_config" string="Configuración Fiscal">
                                <field name="ejercicio_fiscal"/>
                                <field name="fecha_cierre_fiscal"/>
                                <field name="currency_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <group>
                            <group name="format_options" string="Opciones de Formato">
                                <field name="incluir_totales"/>
                                <field name="incluir_encabezado_empresa"/>
                                <field name="incluir_fecha_generacion"/>
                            </group>
                            <group name="categories" string="Filtrar por Categorías">
                                <field name="categoria_ids" widget="many2many_tags"/>
                            </group>
                        </group>

                        <div class="oe_clear">
                            <p class="text-muted">
                                <i class="fa fa-info-circle"/> 
                                Este asistente le permitirá exportar el Cuadro de Depreciación en formato Excel 
                                compatible con los requerimientos de la Resolución General N° 77/2020 de la SET.
                            </p>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_export_excel" type="object" 
                                string="Exportar a Excel" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción del Wizard de Exportación -->
        <record id="action_resolucion_77_export_wizard" model="ir.actions.act_window">
            <field name="name">Exportar Cuadro de Depreciación</field>
            <field name="res_model">resolucion.77.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_resolucion_77_export_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Vista Form del Wizard de Importación -->
        <record id="view_resolucion_77_import_wizard_form" model="ir.ui.view">
            <field name="name">resolucion.77.import.wizard.form</field>
            <field name="model">resolucion.77.import.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Importar Datos desde CSV">
                    <header>
                        <button name="action_validate_file" type="object" 
                                string="Validar Archivo" class="btn-secondary"
                                modifiers="{'invisible': [['estado', 'not in', ['draft']]]}"/>
                        <button name="action_import_data" type="object" 
                                string="Importar Datos" class="btn-primary"
                                modifiers="{'invisible': [['estado', '!=', 'ready']]}"/>
                        <button name="action_download_template" type="object" 
                                string="Descargar Plantilla" class="btn-info"/>
                        <field name="estado" widget="statusbar" statusbar_visible="draft,validating,ready,imported"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre de la importación..."/>
                            </h1>
                        </div>

                        <group>
                            <group name="file_config" string="Archivo CSV">
                                <field name="archivo_csv" filename="nombre_archivo"/>
                                <field name="nombre_archivo" invisible="1"/>
                                <field name="separador"/>
                                <field name="encoding"/>
                                <field name="tiene_encabezado"/>
                            </group>
                            <group name="default_config" string="Configuración por Defecto">
                                <field name="fecha_cierre_fiscal"/>
                                <field name="porcentaje_residual"/>
                                <field name="incluir_en_reporte"/>
                                <field name="activo"/>
                            </group>
                        </group>

                        <group>
                            <group name="import_options" string="Opciones de Importación">
                                <field name="actualizar_existentes"/>
                                <field name="crear_categorias"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group name="statistics" string="Estadísticas" 
                                   modifiers="{'invisible': [['estado', 'in', ['draft']]]}">
                                <field name="registros_procesados"/>
                                <field name="registros_creados"/>
                                <field name="registros_actualizados"/>
                                <field name="registros_error"/>
                            </group>
                        </group>

                        <group modifiers="{'invisible': [['log_errores', '=', False]]}">
                            <field name="log_errores" widget="text" readonly="1"/>
                        </group>

                        <div class="oe_clear">
                            <p class="text-muted">
                                <i class="fa fa-info-circle"/> 
                                <strong>Formato del archivo CSV:</strong><br/>
                                Columnas esperadas: codigo, descripcion, fecha_adquisicion (DD/MM/YYYY), valor_inicial, 
                                porcentaje_depreciacion, vida_util, categoria, numero_factura, proveedor<br/>
                                <strong>Nota:</strong> Use "Descargar Plantilla" para obtener un archivo de ejemplo.
                            </p>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción del Wizard de Importación -->
        <record id="action_resolucion_77_import_wizard" model="ir.actions.act_window">
            <field name="name">Importar Datos desde CSV</field>
            <field name="res_model">resolucion.77.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_resolucion_77_import_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Agregar a menús -->
        <menuitem id="menu_resolucion_77_export" name="Exportar a Excel" 
                  parent="resolucion_77.menu_resolucion_77_depreciacion" sequence="20"
                  action="action_resolucion_77_export_wizard"/>
        
        <menuitem id="menu_resolucion_77_import" name="Importar desde CSV" 
                  parent="resolucion_77.menu_resolucion_77_depreciacion" sequence="30"
                  action="action_resolucion_77_import_wizard"/>

    </data>
</odoo> 