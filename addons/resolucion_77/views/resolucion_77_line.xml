<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista Tree (Lista) -->
        <record id="view_resolucion_77_line_tree" model="ir.ui.view">
            <field name="name">resolucion.77.line.tree</field>
            <field name="model">resolucion.77.line</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Cuadro de Depreciación" create="true" edit="true" delete="true" export_xlsx="true" sample="1">
                    <field name="codigo"/>
                    <field name="name"/>
                    <field name="fecha_adquisicion"/>
                    <field name="categoria_activo"/>
                    <field name="valor_inicial" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="porcentaje_depreciacion" widget="percentage" options="{'precision': 2}"/>
                    <field name="vida_util" widget="integer"/>
                    <field name="depreciacion_acumulada" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="valor_fiscal_neto" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="valor_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="asset_created" widget="boolean_toggle"/>
                    <field name="move_count"/>
                    <field name="activo" widget="boolean_toggle"/>
                    <field name="incluir_en_reporte" widget="boolean_toggle"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="view_resolucion_77_line_form" model="ir.ui.view">
            <field name="name">resolucion.77.line.form</field>
            <field name="model">resolucion.77.line</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Bien del Activo Fijo">
                    <header>
                        <button name="export_cuadro_depreciacion" type="object" 
                                string="Exportar a Excel" class="btn-primary"
                                invisible="id == False"/>
                        <button name="action_create_asset" type="object" 
                                string="Crear Activo Fijo" class="btn-secondary"
                                invisible="asset_created == True"/>
                        <button name="action_generate_depreciation_move" type="object" 
                                string="Generar Asiento" class="btn-secondary"
                                invisible="asset_created == False"/>
                        <field name="activo" widget="boolean_button" 
                               options="{'terminology': {'string_true': 'Activo', 'string_false': 'Inactivo'}}" invisible="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_dar_de_baja" type="object" 
                                    class="oe_stat_button" icon="fa-trash"
                                    invisible="baja_definitiva == True">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Dar de Baja</span>
                                </div>
                            </button>
                            <button name="action_reactivar" type="object" 
                                    class="oe_stat_button" icon="fa-refresh"
                                    invisible="baja_definitiva == False">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Reactivar</span>
                                </div>
                            </button>
                            <button name="action_view_moves" type="object" 
                                    class="oe_stat_button" icon="fa-book"
                                    invisible="move_count == 0">
                                <div class="o_stat_info">
                                    <span class="o_stat_value"><field name="move_count"/></span>
                                    <span class="o_stat_text">Asientos</span>
                                </div>
                            </button>
                            <!--
                            <button name="action_view_asset" type="object" 
                                    class="oe_stat_button" icon="fa-building"
                                    modifiers="{'invisible': [['asset_created', '=', False]]}">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Ver Activo Fijo</span>
                                </div>
                            </button>
                            -->
                        </div>

                        <widget name="web_ribbon" title="Activo"
                                invisible="not activo"/>
                        <widget name="web_ribbon" title="Inactivo"
                            bg_color="text-bg-danger"
                            invisible="activo"/>

                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Descripción del bien..."/>
                            </h1>
                        </div>

                        <group>
                            <group name="basic_info" string="Información Básica">
                                <field name="codigo"/>
                                <field name="categoria_activo"/>
                                <field name="fecha_adquisicion"/>
                                <field name="valor_inicial"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </group>
                            <group name="depreciation_config" string="Configuración de Depreciación">
                                <field name="porcentaje_depreciacion"/>
                                <field name="vida_util"/>
                                <field name="metodo"/>
                                <field name="fecha_cierre_fiscal"/>
                                <field name="porcentaje_residual"/>
                            </group>
                        </group>

                        <group>
                            <group name="calculated_values" string="Valores Calculados">
                                <field name="depreciacion_anual"/>
                                <field name="depreciacion_mensual"/>
                                <field name="depreciacion_acumulada"/>
                                <field name="valor_fiscal_neto"/>
                                <field name="valor_residual"/>
                            </group>
                            <group name="status" string="Estado y Control">
                                <field name="incluir_en_reporte"/>
                                <field name="baja_definitiva"/>
                                <field name="fecha_baja" invisible="baja_definitiva == False"/>
                                <field name="asset_created" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="accounting_config" string="Configuración Contable">
                                <group>
                                    <group name="accounts" string="Cuentas Contables">
                                        <field name="account_asset_id"/>
                                        <field name="account_depreciation_id"/>
                                        <field name="account_depreciation_expense_id"/>
                                    </group>
                                    <group name="journal" string="Diario">
                                        <field name="journal_id"/>
                                        <field name="asset_id" readonly="1"/>
                                    </group>
                                </group>
                                <div class="oe_clear">
                                    <p class="text-muted">
                                        <i class="fa fa-info-circle"/> 
                                        Configure las cuentas contables y el diario para generar asientos automáticamente.
                                    </p>
                                </div>
                            </page>
                            <page name="purchase_info" string="Información de Compra">
                                <group>
                                    <group>
                                        <field name="proveedor_id"/>
                                        <field name="numero_factura"/>
                                    </group>
                                    <group>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                </group>
                            </page>
                            <page name="documents" string="Documentos">
                                <group>
                                    <field name="nombre_documento" invisible="1"/>
                                    <field name="documento_respaldo" filename="nombre_documento"/>
                                </group>
                                <div class="oe_clear">
                                    <p class="text-muted">
                                        <i class="fa fa-info-circle"/> 
                                        Adjunte aquí la factura de compra, contrato de adquisición u otro documento de respaldo.
                                    </p>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter para seguimiento de actividades -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Vista Search -->
        <record id="view_resolucion_77_line_search" model="ir.ui.view">
            <field name="name">resolucion.77.line.search</field>
            <field name="model">resolucion.77.line</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Buscar Bienes del Activo Fijo">
                    <field name="name" string="Descripción"/>
                    <field name="codigo" string="Código"/>
                    <field name="categoria_activo"/>
                    <field name="proveedor_id"/>
                    <field name="numero_factura"/>
                    
                    <filter name="activos" string="Activos" 
                            domain="[('activo', '=', True)]"/>
                    <filter name="dados_baja" string="Dados de Baja" 
                            domain="[('baja_definitiva', '=', True)]"/>
                    <filter name="incluir_reporte" string="Incluir en Reporte" 
                            domain="[('incluir_en_reporte', '=', True)]"/>
                    
                    <separator/>
                    
                    <filter name="asset_created" string="Con Activo Fijo Creado" 
                            domain="[('asset_created', '=', True)]"/>
                    <filter name="asset_not_created" string="Sin Activo Fijo" 
                            domain="[('asset_created', '=', False)]"/>
                    <!--
                    <filter name="with_moves" string="Con Asientos Contables" 
                            domain="[('move_count', '>', 0)]"/>
                    -->
                    
                    <separator/>
                    
                    <filter name="este_año" string="Adquiridos este año"
                            domain="[('fecha_adquisicion', '>=', datetime.datetime.now().strftime('%Y-01-01'))]"/>
                    <filter name="año_pasado" string="Adquiridos año pasado"
                            domain="[('fecha_adquisicion', '>=', (datetime.datetime.now() - datetime.timedelta(days=365)).strftime('%Y-01-01')),
                                     ('fecha_adquisicion', '&lt;', datetime.datetime.now().strftime('%Y-01-01'))]"/>
                    
                    <separator/>
                    
                    <group expand="0" string="Agrupar por...">
                        <filter name="group_categoria" string="Categoría" 
                                context="{'group_by': 'categoria_activo'}"/>
                        <filter name="group_año" string="Año de Adquisición" 
                                context="{'group_by': 'fecha_adquisicion:year'}"/>
                        <filter name="group_proveedor" string="Proveedor" 
                                context="{'group_by': 'proveedor_id'}"/>
                        <filter name="group_estado" string="Estado" 
                                context="{'group_by': 'activo'}"/>
                        <filter name="group_asset_created" string="Activo Fijo Creado" 
                                context="{'group_by': 'asset_created'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vista Kanban -->
        <record id="view_resolucion_77_line_kanban" model="ir.ui.view">
            <field name="name">resolucion.77.line.kanban</field>
            <field name="model">resolucion.77.line</field>
            <field name="type">kanban</field>
            <field name="arch" type="xml">
                <kanban default_group_by="categoria_activo" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="codigo"/>
                    <field name="valor_inicial"/>
                    <field name="valor_fiscal_neto"/>
                    <field name="activo"/>
                    <field name="categoria_activo"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div t-if="record.codigo.value">
                                            <i class="fa fa-barcode"/> <field name="codigo"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-money"/> 
                                            <field name="valor_inicial" widget="monetary"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-calculator"/> 
                                            <field name="valor_fiscal_neto" widget="monetary"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <div t-if="record.activo.raw_value" class="badge badge-success">Activo</div>
                                        <div t-else="" class="badge badge-secondary">Inactivo</div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Acción principal -->
        <record id="action_resolucion_77_line" model="ir.actions.act_window">
            <field name="name">Cuadro de Depreciación</field>
            <field name="res_model">resolucion.77.line</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="view_resolucion_77_line_tree"/>
            <field name="context">{
                'search_default_activos': 1,
                'search_default_incluir_reporte': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Cree su primer bien del activo fijo!
                </p>
                <p>
                    Registre aquí todos los bienes del activo fijo para generar 
                    el cuadro de depreciación según la Resolución 77 de la SET.
                </p>
            </field>
        </record>

        <!-- Acción para abrir activo fijo -->
        <record id="action_open_asset" model="ir.actions.act_window">
            <field name="name">Activo Fijo</field>
            <field name="res_model">account.asset</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'default_name': context.get('default_name', ''), 'default_original_value': context.get('default_original_value', 0)}</field>
        </record>

        <!-- Submenús -->
        <menuitem id="menu_resolucion_77_line" name="Cuadro de Depreciación" 
                  parent="resolucion_77.menu_resolucion_77_depreciacion" sequence="10"
                  action="action_resolucion_77_line"/>

    </data>
</odoo> 
