<odoo>

    <!-- list view  -->

    <record id="res_country_state_district_city_tree" model="ir.ui.view">
        <field name="name">res.country.state.district.city.tree</field>
        <field name="model">res.country.state.district.city</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="district_id"/>
            </list>
        </field>
    </record>

    <!-- form view  -->

    <record id="res_country_state_district_city_form" model="ir.ui.view">
        <field name="name">res.country.state.district.city.form</field>
        <field name="model">res.country.state.district.city</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="district_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search view  -->

    <record id="res_country_state_district_city_search" model="ir.ui.view">
        <field name="name">res.country.state.district.city.search</field>
        <field name="model">res.country.state.district.city</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="district_id"/>
                <filter 
                    name="group_district_id" 
                    string="Distritos" 
                    context="{'group_by': 'district_id'}" 
                />
            </search>
        </field>
    </record>

    <!-- window action  -->

    <record id="res_country_state_district_city_action" model="ir.actions.act_window">
        <field name="name">Ciudades</field>
        <field name="res_model">res.country.state.district.city</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu  -->

    <menuitem
        id="res_country_state_district_city_menu"
        name="Ciudades"
        action="res_country_state_district_city_action"
        parent="contacts.menu_localisation"
        sequence="3"
    />

</odoo>
