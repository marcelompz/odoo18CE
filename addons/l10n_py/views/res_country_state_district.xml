<odoo>

    <!-- tree view  -->

    <record id="res_country_state_district_tree" model="ir.ui.view">
        <field name="name">res.country.state.district.tree</field>
        <field name="model">res.country.state.district</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <!-- form view  -->

    <record id="res_country_state_district_form" model="ir.ui.view">
        <field name="name">res.country.state.district.form</field>
        <field name="model">res.country.state.district</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="state_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- search view  -->

    <record id="res_country_state_district_search" model="ir.ui.view">
        <field name="name">res.country.state.district.search</field>
        <field name="model">res.country.state.district</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state_id"/>
                <filter 
                    name="group_state_id" 
                    string="State" 
                    context="{'group_by': 'state_id'}" 
                />
            </search>
        </field>
    </record>

    <!-- window action  -->

    <record id="res_country_state_district_action" model="ir.actions.act_window">
        <field name="name">Distritos</field>
        <field name="res_model">res.country.state.district</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new record</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_country_state_district_menu"
        name="Distritos"
        action="res_country_state_district_action"
        parent="contacts.menu_localisation"
        sequence="2"
    />

</odoo>
