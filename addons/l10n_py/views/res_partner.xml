<odoo>

    <!-- form view -->

    <record id="res_partner_inherit_form" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//sheet/group[1]" position="before">
                <group>
                    <group>
                        <field name="partner_code" readonly="1"/>
                        <field name="partner_fantasy_name"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                <div class="o_address_format">
                    <field name="street" placeholder="Calle..." class="o_address_street"
                        readonly="type == 'contact' and parent_id"/>
                    <field name="street2" placeholder="Calle 2..." class="o_address_street"
                        readonly="type == 'contact' and parent_id"/>
                    <field name="city_id" placeholder="Ciudad" class="o_address_city" options="{'no_open': True, 'no_create': True}"
                        readonly="type == 'contact' and parent_id"/>
                    <field name="district_id" placeholder="Distrito" class="o_address_city" options='{"no_open": True, "no_create": True}'
                        readonly="type == 'contact' and parent_id"/>
                    <field name="state_id" class="o_address_state" placeholder="Departamento" options="{'no_open': True, 'no_quick_create': True}"
                        readonly="type == 'contact' and parent_id" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                    <field name="zip" placeholder="ZIP" class="o_address_zip"
                        readonly="type == 'contact' and parent_id"/>
                    <field name="city" invisible="1"/>
                    <div name="partner_address_country" class="d-flex justify-content-between">
                        <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'
                            readonly="type == 'contact' and parent_id"/>
                    </div>
                </div>
                <field name="house_number" widget="integer" readonly="type == 'contact' and parent_id"/>
            </xpath>
            
        </field>
    </record>

    <!-- tree view -->

    <record id="res_partner_inherit_tree" model="ir.ui.view">
        <field name="name">res.partner.inherit.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='complete_name']" position="before">
                <field name="partner_code"/>
            </xpath>
        
        </field>
    </record>

</odoo>
