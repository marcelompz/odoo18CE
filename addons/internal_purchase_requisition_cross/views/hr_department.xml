<odoo>

    <!-- product selection view -->
    <record id="view_product_selection_department_tree" model="ir.ui.view">
        <field name="name">product.product.department.selection.tree</field>
        <field name="model">product.product</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <list string="Seleccionar Productos para Departamento" create="false" edit="false">
                <field name="is_favorite" widget="boolean_favorite" nolabel="1" readonly="1"/>
                <field name="default_code" optional="show" readonly="1"/>
                <field name="barcode" optional="hide" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="product_template_variant_value_ids" widget="many2many_tags" groups="product.group_product_variant" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
                <field name="lst_price" optional="show" string="Precio de Venta"/>
                <field name="standard_price" optional="show"/>
                <field name="categ_id" optional="hide"/>
                <field name="product_tag_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                <field name="additional_product_tag_ids" widget="many2many_tags" optional="hide"/>
                <field name="type" optional="hide" readonly="1"/>
                <field name="uom_id" string="Unidad" groups="uom.group_uom" optional="show" readonly="1"/>
                <field name="product_tmpl_id" readonly="1" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
                <button name="action_open_product_form" 
                    type="object" 
                    string="Editar" 
                    icon="fa-external-link" 
                    class="oe_link"
                />
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="hr_department_inherit_form" model="ir.ui.view">
        <field name="name">hr.department.inherit.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Productos Asignados">
                        <field name="department_product_ids" context="{'list_view_ref': 'internal_purchase_requisition_cross.view_product_selection_department_tree',}">
                            <list string="Productos">
                                <field name="default_code"/>
                                <field name="name"/>
                                <field name="list_price"/>
                                <field name="qty_available"/>
                            </list>
                        </field>
                        <span>Productos: <field name="product_count"/></span>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>

</odoo>
