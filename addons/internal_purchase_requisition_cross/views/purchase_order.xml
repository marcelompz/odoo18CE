<odoo>

    <!-- form view -->
    <record id="purchase_order_inherit_form" model="ir.ui.view">
        <field name="name">purchase.order.inherit.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">

            <!-- se agrega campos en la linea de la orden -->
            <xpath expr="//notebook//page[@name='products']//field[@name='order_line']//field[@name='product_qty']" position="before">
                <field name="product_length" optional="show"/>
                <field name="product_width" optional="show"/>
                <field name="product_grammar" optional="show"/>
                <field name="price_meter" widget="monetary" optional="show"/>
            </xpath>

            <!-- quitamos el default_code de la descripcion del producto -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="context">{'display_default_code': False}</attribute>                
            </xpath>
        
        </field>
    </record>

</odoo>
