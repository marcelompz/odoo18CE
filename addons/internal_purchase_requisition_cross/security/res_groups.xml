<odoo>

    <data noupdate="1">
    
        <record id="group_authorizate_purchase_requisition" model="res.groups">
            <field name="name">Aprovador de requisición de compras</field>
        </record>

        <!-- 1. Categoría del Módulo (Para que aparezca en Ajustes/Usuarios) -->
        <record id="module_category_purchase_requisition" model="ir.module.category">
            <field name="name">Gestión de Requisición de compras</field>
            <field name="description">Niveles de acceso para el módulo de requisición de compras</field>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Grupo: Usuario (Ver solo propios) -->
        <record id="group_purchase_requisition_user" model="res.groups">
            <field name="name">Usuario (Solo sus documentos)</field>
            <field name="category_id" ref="module_category_purchase_requisition"/>
        </record>

        <!-- 3. Grupo: Responsable (Ver todo) -->
        <record id="group_purchase_requisition_manager" model="res.groups">
            <field name="name">Responsable (Ver Todos)</field>
            <field name="category_id" ref="module_category_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('group_purchase_requisition_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    
    </data>
    

</odoo>
