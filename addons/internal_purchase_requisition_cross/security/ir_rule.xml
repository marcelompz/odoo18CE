<odoo>

    <data noupdate="1">
    
        <!-- REGLA 1: Para el Usuario Básico -> Solo lo que él creó -->
        <record id="rule_purchase_requisition_user_own_docs" model="ir.rule">
            <field name="name">Requisición: Ver solo mis documentos</field>
            <field name="model_id" ref="internal_purchase_requisition.model_purchase_requisition"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('internal_purchase_requisition_cross.group_purchase_requisition_user'))]"/>
        </record>

        <!-- REGLA 2: Para el Responsable -> Ver Todo -->
        <record id="rule__manager_all_docs" model="ir.rule">
            <field name="name">Requisición: Ver todos los documentos</field>
            <field name="model_id" ref="internal_purchase_requisition.model_purchase_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('internal_purchase_requisition_cross.group_purchase_requisition_manager'))]"/>
        </record>
    
    </data>
    

</odoo>
