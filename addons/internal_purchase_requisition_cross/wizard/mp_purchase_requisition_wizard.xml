<odoo>

    <!-- list view -->
    <record id="view_product_product_wizard_selection_list" model="ir.ui.view">
        <field name="name">product.product.wizard.selection.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Productos" editable="bottom" create="0" delete="0">
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="qty_available" optional="show" string="A mano"/>
            </list>
        </field>
    </record>

    <!-- wizard view -->
    <record id="mp_purchase_requisition_wizard_form" model="ir.ui.view">
        <field name="name">mp.purchase.requisition.wizard.form</field>
        <field name="model">mp.purchase.requisition.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar productos">
                <field name="department_id" invisible="1"/>
                <field name="allowed_product_ids" invisible="1"/>
                <field name="product_ids" 
                       options="{'no_create': True}"
                       context="{'list_view_ref': 'internal_purchase_requisition_cross.view_product_product_wizard_selection_list'}"/>
                <footer>
                    <button string="Confirmar" name="confirm_requisition_product" type="object"  class="oe_highlight" />
                    <button string="Cancelar" class="oe_highlight" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- windows action -->
    <record id="mp_purchase_requisition_wizard_action" model="ir.actions.act_window">
        <field name="name">mp.purchase.requisition.wizard.action</field>
        <field name="res_model">mp.purchase.requisition.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
