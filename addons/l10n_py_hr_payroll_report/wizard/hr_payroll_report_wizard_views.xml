    <record id="action_hr_payroll_report_payroll_summary" model="ir.actions.act_window">
        <field name="name">Planilla de Salarios</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_payroll_report_wizard_form_payroll_summary"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'payroll_summary'}</field>
    </record>

    <menuitem id="menu_hr_payroll_report_wizard"
              name="Reportes Legales (MTESS/DNIT)"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              sequence="30"/>

    <menuitem id="menu_hr_payroll_report_mtess_monthly"
              name="MTESS - Planilla Laboral Mensual"
              action="action_hr_payroll_report_mtess_monthly"
              parent="menu_hr_payroll_report_wizard"
