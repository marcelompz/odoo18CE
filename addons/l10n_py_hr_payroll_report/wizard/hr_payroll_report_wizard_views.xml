              sequence="20"/>

    <menuitem id="menu_hr_payroll_report_mtess_vacations"
              name="MTESS - Libro Registro de Vacaciones"
              action="action_hr_payroll_report_mtess_vacations"
              parent="menu_hr_payroll_report_wizard"
              sequence="30"/>

    <menuitem id="menu_hr_payroll_report_dnit_salary"
              name="DNIT - Listado Nomina Salarial"
              action="action_hr_payroll_report_dnit_salary"
              parent="menu_hr_payroll_report_wizard"
