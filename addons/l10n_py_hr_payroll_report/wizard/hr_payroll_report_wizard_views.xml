        <field name="res_model">hr.payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_payroll_report_wizard_form_mtess_vacations"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'mtess_vacations'}</field>
    </record>

    <record id="action_hr_payroll_report_dnit_salary" model="ir.actions.act_window">
        <field name="name">DNIT - Listado Nomina Salarial</field>
