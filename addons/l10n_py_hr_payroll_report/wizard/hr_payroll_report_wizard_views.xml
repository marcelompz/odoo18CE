<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportes Legales de N?mina (MTESS/DNIT)">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="payslip_run_id" invisible="report_type != 'payroll_summary'"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_report_wizard_form_mtess_monthly" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form.mtess.monthly</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="MTESS - Planilla Laboral Mensual">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="payslip_run_id"/>
                    </group>
                    <group>
                        <field name="date_from" invisible="[(payslip_run_id, '!=', False)]"/>
                        <field name="date_to" invisible="[(payslip_run_id, '!=', False)]"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_report_wizard_form_mtess_employees" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form.mtess.employees</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="MTESS - Libro Registro de Empleados y Obreros">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_report_wizard_form_mtess_vacations" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form.mtess.vacations</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="MTESS - Libro Registro de Vacaciones">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_report_wizard_form_dnit_salary" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form.dnit.salary</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="DNIT - Listado N?mina Salarial">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_report_wizard_form_payroll_summary" model="ir.ui.view">
        <field name="name">hr.payroll.report.wizard.form.payroll.summary</field>
        <field name="model">hr.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Planilla de Salarios">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="payslip_run_id" required="1"/>
                    </group>
                    </group>
                <footer>
                    <button name="action_generate_xlsx" string="Generar Excel" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_report_mtess_monthly" model="ir.actions.act_window">
        <field name="name">MTESS - Planilla Laboral Mensual</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_payroll_report_wizard_form_mtess_monthly"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'mtess_monthly'}</field>
    </record>

    <record id="action_hr_payroll_report_mtess_employees" model="ir.actions.act_window">
