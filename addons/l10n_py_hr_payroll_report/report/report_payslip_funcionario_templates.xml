<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_payslip_funcionario">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
                <style>
                    @page {
                        margin: 0;
                    }
                    body, div, span, td, th {
                        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif !important;
                    }
                </style>
            </head>
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'DejaVu Sans', 'Liberation Sans', Arial, sans-serif; padding: 0; margin: 0;">
                    
                    <!-- Encabezado del Ministerio de Trabajo -->
                    <div style="margin-bottom: 20px; border-bottom: 2px solid #000; padding-bottom: 10px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 60%; vertical-align: top;">
                                    <div style="font-weight: bold; font-size: 12px; margin-bottom: 5px;">
                                        MINISTERIO DE TRABAJO, EMPLEO Y SEGURIDAD SOCIAL PARAGUAY
                                    </div>
                                    <div style="font-size: 10px; margin-bottom: 2px;">
                                        Direcci&#243;n: Luis A. de Herrera e/ Paraguari
                                    </div>
                                    <div style="font-size: 10px; margin-bottom: 2px;">
                                        Tel&#233;fono: (+595 21) 729-0100
                                    </div>
                                    <div style="font-size: 10px;">
                                        Horario de atenci&#243;n: de 07:00hs a 15:00hs
                                    </div>
                                </td>
                                <td style="width: 40%; vertical-align: top; text-align: right;">
                                    <div style="font-weight: bold; font-size: 18px; margin-bottom: 5px;">
                                        LIQUIDACI&#211;N DE SALARIO
                                    </div>
                                    <div style="font-size: 14px; margin-bottom: 3px;">
                                        N&#176;: <span t-esc="o.number or o.id"/>
                                    </div>
                                    <div style="font-size: 12px; font-weight: bold;">
                                        ORIGINAL
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Información del Empleador y Trabajador -->
                    <div style="margin-bottom: 20px;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                            <tr>
                                <td style="width: 50%; border: 1px solid #000; padding: 10px; vertical-align: top;">
                                    <div style="font-weight: bold; margin-bottom: 8px; font-size: 14px;">EMPLEADOR</div>
                                    <div style="font-size: 14px; margin-bottom: 10px;">
                                        <span t-field="o.company_id.name"/>
                                    </div>
                                    <div style="font-weight: bold; margin-top: 10px;">
                                        RUC N&#176;: <span t-field="o.company_id.vat"/>
                                    </div>
                                </td>
                                <td style="width: 50%; border: 1px solid #000; padding: 10px; vertical-align: top;">
                                    <div style="font-weight: bold; margin-bottom: 8px; font-size: 14px;">NOMBRE Y APELLIDO DEL TRABAJADOR</div>
                                    <div style="font-size: 14px; margin-bottom: 10px;">
                                        <span t-field="o.employee_id.name"/>
                                    </div>
                                    <div style="font-weight: bold; margin-top: 10px;">
                                        C.I. N&#176;: <span t-field="o.employee_id.identification_id"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Período de Pago y Detalles de Trabajo -->
                    <div style="margin-bottom: 20px;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 10px; vertical-align: top;">
                                    <div style="font-weight: bold; margin-bottom: 8px; font-size: 14px;">PER&#205;ODO DE PAGO</div>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="padding: 3px 0;">
                                                <strong>DESDE:</strong> 
                                                <span t-field="o.date_from" t-options="{'widget': 'date'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;">
                                                <strong>HASTA:</strong> 
                                                <span t-field="o.date_to" t-options="{'widget': 'date'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;">
                                                <strong>FECHA:</strong> 
                                                <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 3px 0;">
                                                <strong>FORMA DE PAGO:</strong> 
                                                <span t-out="o.get_payment_method()"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <td style="border: 1px solid #000; padding: 10px; vertical-align: top;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="padding: 5px 0;">
                                                <strong>HORAS TRABAJADAS:</strong> <span t-out="o.get_worked_hours()"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px 0;">
                                                <strong>CANTIDAD DE D&#205;AS TRABAJADOS:</strong> <span t-esc="o.get_worked_days()"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px 0;">
                                                <strong>CANTIDAD DE PIEZAS O TAREAS:</strong> 0
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Tabla de Egresos e Ingresos -->
                    <div style="margin-bottom: 20px;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th style="border: 1px solid #000; padding: 10px; text-align: left; width: 70%;">CONCEPTO</th>
                                    <th style="border: 1px solid #000; padding: 10px; text-align: right; width: 30%;">MONTO EN GS.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Mostrar todas las líneas del payslip que aparecen en el recibo (igual que el recibo nativo) -->
                                <t t-set="all_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip)"/>
                                <t t-set="ingresos_lines" t-value="all_lines.filtered(lambda l: l.total &gt; 0)"/>
                                <t t-set="egresos_lines" t-value="all_lines.filtered(lambda l: l.total &lt; 0)"/>
                                
                                <!-- INGRESOS -->
                                <t t-if="ingresos_lines">
                                    <tr>
                                        <td colspan="2" style="border: 1px solid #000; padding: 8px; font-weight: bold; background-color: #f0f0f0;">
                                            INGRESOS
                                        </td>
                                    </tr>
                                    <t t-foreach="ingresos_lines.sorted(lambda l: l.sequence)" t-as="line">
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 8px;">
                                                <span t-out="line.name"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                                <span t-out="line.total" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                
                                <!-- EGRESOS -->
                                <t t-if="egresos_lines">
                                    <tr>
                                        <td colspan="2" style="border: 1px solid #000; padding: 8px; font-weight: bold; background-color: #f0f0f0;">
                                            EGRESOS
                                        </td>
                                    </tr>
                                    <t t-foreach="egresos_lines.sorted(lambda l: l.sequence)" t-as="line">
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 8px;">
                                                <span t-out="line.name"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                                <span t-out="abs(line.total)" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                
                                <!-- Totales -->
                                <tr style="background-color: #f9f9f9;">
                                    <td style="border: 1px solid #000; padding: 10px; font-weight: bold; text-align: right;">
                                        MONTO TOTAL DE INGRESO:
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold;">
                                        <span t-out="o.get_total_ingresos()" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: #f9f9f9;">
                                    <td style="border: 1px solid #000; padding: 10px; font-weight: bold; text-align: right;">
                                        MONTO TOTAL DE EGRESO:
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold;">
                                        <span t-out="o.get_total_egresos()" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="background-color: #e0e0e0; border: 2px solid #000;">
                                    <td style="border: 1px solid #000; padding: 12px; font-weight: bold; text-align: right; font-size: 16px;">
                                        MONTO TOTAL A COBRAR:
                                    </td>
                                    <td style="border: 1px solid #000; padding: 12px; text-align: right; font-weight: bold; font-size: 16px;">
                                        <span t-out="o.get_total_cobrar()" t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Firmas y QR Code -->
                    <div style="margin-top: 30px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 40%; vertical-align: top;">
                                    <div style="border: 1px solid #000; padding: 15px; min-height: 120px;">
                                        <div style="font-weight: bold; margin-bottom: 5px;">
                                            <span t-field="o.company_id.name"/>
                                        </div>
                                        <div style="margin-bottom: 10px;">
                                            RUC: <span t-field="o.company_id.vat"/>
                                        </div>
                                        <t t-if="o.company_id.company_signature">
                                            <div style="margin: 10px 0; text-align: center;">
                                                <img t-att-src="image_data_uri(o.company_id.company_signature)"
                                                     style="max-height: 80px; max-width: 100%;"
                                                     alt="Firma de la empresa"/>
                                            </div>
                                        </t>
                                        <div style="margin-top: 40px; border-top: 1px solid #000; padding-top: 10px;">
                                            <strong>FIRMA DEL EMPLEADOR</strong>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 30%; vertical-align: top; text-align: center;">
                                    <div style="border: 1px solid #000; padding: 15px; min-height: 120px;">
                                        <div style="margin-bottom: 10px;">
                                            <strong>FIRMA DEL EMPLEADO</strong>
                                        </div>
                                        <div style="margin-top: 50px;">
                                            <span t-field="o.employee_id.name"/>
                                        </div>
                                        <div style="margin-top: 5px; font-size: 11px;">
                                            C.I. N°: <span t-field="o.employee_id.identification_id"/>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 30%; vertical-align: top; text-align: center;">
                                    <div style="padding: 10px;">
                                        <!-- Código QR que redirige al PDF generado -->
                                        <div class="text-center">
                                            <img t-att-src="'/report/barcode/QR/' + o.access_url" style="width:150px;height:150px" alt="QR lista"/>
                                        </div>
                                        <div style="margin-top: 5px; font-size: 10px; color: #666;">
                                            C&#243;digo QR para validaci&#243;n
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
