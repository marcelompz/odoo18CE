<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_payslip_ips">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
                <style>
                    @page {
                        margin: 0;
                    }
                    body, div, span, td, th {
                        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif !important;
                    }
                </style>
            </head>
            <!-- Agrupar por empresa y período -->
            <t t-set="companies" t-value="docs.mapped('company_id')"/>
            <t t-foreach="companies" t-as="company">
                <t t-set="company_payslips" t-value="docs.filtered(lambda p: p.company_id == company)"/>
                <t t-set="periods" t-value="company_payslips.mapped(lambda p: (p.date_from, p.date_to))"/>
                <t t-set="unique_periods" t-value="list(set(periods))"/>
                
                <t t-foreach="unique_periods" t-as="period_tuple">
                    <t t-set="period_from" t-value="period_tuple[0]"/>
                    <t t-set="period_to" t-value="period_tuple[1]"/>
                    <t t-set="period_payslips" t-value="company_payslips.filtered(lambda p: p.date_from == period_from and p.date_to == period_to)"/>
                    <t t-set="sorted_payslips" t-value="period_payslips.sorted(lambda p: p.employee_id.name)"/>
                    <t t-set="total_employees" t-value="len(sorted_payslips)"/>
                        
                        <div class="page" style="font-family: Arial, sans-serif; padding: 0; margin: 0;">
                            
                            <!-- Encabezado IPS -->
                            <div style="text-align: center; margin-bottom: 20px; border-bottom: 2px solid #000; padding-bottom: 10px;">
                                <div style="font-weight: bold; font-size: 18px; margin-bottom: 5px;">
                                    INSTITUTO DE PREVISI&#211;N SOCIAL
                                </div>
                                <div style="font-size: 14px; margin-bottom: 5px;">
                                    PLANILLA DE APORTES
                                </div>
                                <div style="font-size: 12px;">
                                PERÍODO: 
                                    <span t-out="period_from.strftime('%d/%m/%Y') if period_from else ''"/> 
                                    al 
                                    <span t-out="period_to.strftime('%d/%m/%Y') if period_to else ''"/>
                                </div>
                            </div>

                            <!-- Información de la Empresa -->
                            <div style="margin-bottom: 15px; border: 1px solid #000; padding: 10px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <div style="font-weight: bold; margin-bottom: 5px; font-size: 12px;">RAZ&#211;N SOCIAL:</div>
                                            <div style="font-size: 12px; margin-bottom: 10px;">
                                                <span t-field="company.name"/>
                                            </div>
                                            <div style="font-weight: bold; margin-bottom: 5px; font-size: 12px;">DIRECCI&#211;N:</div>
                                            <div style="font-size: 11px;">
                                                <span t-if="company.street" t-out="company.street"/>
                                                <span t-if="company.street2">, <span t-out="company.street2"/></span>
                                                <span t-if="company.city">, <span t-out="company.city"/></span>
                                            </div>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <div style="font-weight: bold; margin-bottom: 5px; font-size: 12px;">N&#218;MERO PATRONAL:</div>
                                            <div style="font-size: 12px; margin-bottom: 10px;">
                                                <span t-out="company.vat or 'N/A'"/>
                                            </div>
                                            <div style="font-weight: bold; margin-bottom: 5px; font-size: 12px;">RUC:</div>
                                            <div style="font-size: 12px;">
                                                <span t-field="company.vat"/>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Tabla de Trabajadores -->
                            <div style="margin-bottom: 15px;">
                                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 10px;">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 5%;">N&#176;</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 12%;">C.I. N&#176;</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 12%;">N&#176; ASEGURADO</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: left; width: 25%;">APELLIDOS Y NOMBRES</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 7%;">D&#205;AS TRAB.</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: right; width: 11%;">SALARIO IMPONIBLE</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: right; width: 11%;">DESCUENTO IPS</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 9%;">CATEGOR&#205;A</th>
                                            <th style="border: 1px solid #000; padding: 5px; text-align: center; width: 15%;">C&#211;DIGOS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="row_num" t-value="0"/>
                                        <t t-foreach="sorted_payslips" t-as="payslip">
                                            <t t-set="row_num" t-value="row_num + 1"/>
                                            <t t-set="salario_imponible" t-value="payslip.get_total_ingresos()"/>
                                            <t t-set="dias_trabajados" t-value="payslip.get_worked_days()"/>
                                            <t t-set="descuento_ips" t-value="payslip.get_ips_trabajador()"/>
                                            <t t-set="categoria" t-value="'Obrero'"/>
                                            <tr>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                    <span t-out="row_num"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                    <span t-out="payslip.employee_id.identification_id or ''"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                    <span t-out="payslip.employee_id.ips_number or ''"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px;">
                                                    <span t-field="payslip.employee_id.name"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                                    <span t-out="dias_trabajados"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                                    <span t-out="salario_imponible" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: right;">
                                                    <span t-out="descuento_ips" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center; font-size: 9px;">
                                                    <span t-out="categoria"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 4px; text-align: center; font-size: 9px;">
                                                    <!-- Códigos: 3_Vacaciones, 4_Reposo, 5_Indemnización, 6_Otras Causas -->
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Totales -->
                                <div style="margin-bottom: 20px; border: 1px solid #000; padding: 10px;">
                                    <t t-set="total_salarios" t-value="sum(period_payslips.mapped(lambda p: p.get_total_ingresos()))"/>
                                    <t t-set="total_descuento_ips" t-value="sum(period_payslips.mapped(lambda p: p.get_ips_trabajador()))"/>
                                    <t t-set="recargos" t-value="0"/>
                                    <t t-set="total_pagar" t-value="total_descuento_ips + recargos"/>
                                    
                                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                        <tr>
                                            <td style="width: 60%; padding: 5px; font-weight: bold;">
                                                TOTAL DE TRABAJADORES QUE HAN PRESTADO SERVICIOS DURANTE EL MES:
                                            </td>
                                            <td style="width: 40%; padding: 5px; text-align: right; font-weight: bold; border: 1px solid #000;">
                                                <span t-out="total_employees"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px; font-weight: bold;">
                                                TOTAL DE SALARIOS EN GUARAN&#205;ES:
                                            </td>
                                            <td style="padding: 5px; text-align: right; font-weight: bold; border: 1px solid #000;">
                                                <span t-out="total_salarios" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px; font-weight: bold;">
                                                TOTAL DE DESCUENTO IPS TRABAJADORES (9%):
                                            </td>
                                            <td style="padding: 5px; text-align: right; font-weight: bold; border: 1px solid #000;">
                                                <span t-out="total_descuento_ips" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 5px; font-weight: bold;">
                                                RECARGOS, SI CORRESPONDE:
                                            </td>
                                            <td style="padding: 5px; text-align: right; font-weight: bold; border: 1px solid #000;">
                                                <span t-out="recargos" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr style="background-color: #f0f0f0;">
                                            <td style="padding: 8px; font-weight: bold; font-size: 12px;">
                                                TOTAL A PAGAR:
                                            </td>
                                            <td style="padding: 8px; text-align: right; font-weight: bold; font-size: 12px; border: 2px solid #000;">
                                                <span t-out="total_pagar" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <!-- Firma y Sello -->
                                <div style="margin-top: 30px;">
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td style="width: 40%; vertical-align: top;">
                                                <div style="margin-bottom: 10px; font-weight: bold; font-size: 11px;">
                                                    LUGAR Y FECHA DE PAGO:
                                                </div>
                                                <div style="border: 1px solid #000; padding: 10px; min-height: 40px;">
                                                    <span t-out="company.city or 'Asunci&#243;n'"/>,
                                                    <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d de %B de %Y')"/>
                                                </div>
                                            </td>
                                            <td style="width: 60%; vertical-align: top; text-align: center;">
                                                <div style="border: 1px solid #000; padding: 15px; min-height: 80px;">
                                                    <div style="margin-bottom: 10px; font-weight: bold; font-size: 11px;">
                                                        FIRMA DEL RESPONSABLE POR LA EMPRESA
                                                    </div>
                                                    <div style="margin-top: 30px;">
                                                        <div style="font-weight: bold; margin-bottom: 5px;">
                                                            <span t-field="company.name"/>
                                                        </div>
                                                        <div style="font-size: 10px;">
                                                            RUC: <span t-field="company.vat"/>
                                                        </div>
                                                    </div>
                                                    <div style="margin-top: 10px; font-size: 9px; color: #666;">
                                                        SELLO DE LA EMPRESA
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <!-- Pie de página -->
                                <div style="margin-top: 20px; text-align: center; font-size: 9px; color: #666; border-top: 1px solid #ddd; padding-top: 5px;">
                                    <div>REGISTRO DE PAGO: <span t-out="'N/A'"/></div>
                                    <div style="margin-top: 5px;">Este documento fue generado el <span t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M:%S')"/></div>
                                </div>
                        </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
