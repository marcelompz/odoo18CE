<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_contract_py">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
                <style>
                    @page {
                        margin: 2cm;
                    }
                    body {
                        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
                        font-size: 11pt;
                        line-height: 1.6;
                        color: #000;
                    }
                    .contract-content {
                        padding: 20px;
                    }
                    .contract-content p {
                        margin: 8px 0;
                        text-align: justify;
                    }
                    .contract-content strong {
                        font-weight: bold;
                    }
                    .contract-content ol,
                    .contract-content ul {
                        margin: 10px 0;
                        padding-left: 30px;
                    }
                    .contract-content li {
                        margin: 5px 0;
                    }
                    .signature-section {
                        margin-top: 60px;
                        page-break-inside: avoid;
                    }
                    .signature-line {
                        margin-top: 50px;
                        border-top: 1px solid #000;
                        padding-top: 5px;
                        text-align: center;
                    }
                </style>
            </head>
            <t t-if="not contracts_with_html or len(contracts_with_html) == 0">
                <div class="page">
                    <div class="contract-content">
                        <p><strong>Error:</strong> No se encontraron contratos para imprimir.</p>
                    </div>
                </div>
            </t>
            <t t-foreach="contracts_with_html" t-as="contract_data">
                <div class="page">
                    <div class="contract-content">
                        <t t-if="contract_data.html_content">
                            <t t-raw="contract_data.html_content"/>
                        </t>
                        <t t-if="not contract_data.html_content">
                            <p><strong>Error:</strong> El contrato no tiene contenido para mostrar.</p>
                        </t>
                        
                        <div class="signature-section">
                            <div class="signature-line">
                                <strong>LA EMPRESA</strong>
                            </div>
                            <div style="margin-top: 60px;"></div>
                            <div class="signature-line">
                                <strong>EL TRABAJADOR</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

