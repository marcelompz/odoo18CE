<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_contract_template_tree" model="ir.ui.view">
        <field name="name">hr.contract.template.list</field>
        <field name="model">hr.contract.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Contrato">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_template_form" model="ir.ui.view">
        <field name="name">hr.contract.template.form</field>
        <field name="model">hr.contract.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Contrato (PY)">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="template_code"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Contenido HTML" name="description">
                            <field name="description" widget="html" nolabel="1" 
                                   placeholder="Escribe aquí el contenido HTML del contrato. Puedes usar variables como &lt;&lt;NOMBRE_EMPLEADO&gt;&gt; o {{ COMPANY_NAME }}"/>
                        </page>
                        <page string="Variables Disponibles" name="variables">
                            <field name="available_variables_info" widget="html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Markdown" name="markdown">
                            <field name="body_md" widget="text" nolabel="1" 
                                   placeholder="Contenido en formato Markdown (opcional)"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_contract_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Contrato PY</field>
        <field name="res_model">hr.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay plantillas configuradas.
            </p>
            <p>
                Crea plantillas de contratos laborales paraguayos para reutilizarlas en tus documentos.
            </p>
        </field>
    </record>

    <!-- Menú en el menú de Empleados -->
    <menuitem id="menu_hr_contract_template"
              name="Plantillas de Contrato PY"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_hr_contract_template"
              sequence="23"/>
</odoo>

