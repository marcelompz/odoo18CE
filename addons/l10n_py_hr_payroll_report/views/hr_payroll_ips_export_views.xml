<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_hr_payroll_ips_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar Planilla IPS</field>
        <field name="res_model">hr.payroll.ips.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Acción de servidor para el menú, sin dependencia de active_id -->
    <record id="action_server_hr_payroll_ips_export_wizard_menu" model="ir.actions.server">
        <field name="name">Exportar Planilla IPS</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('l10n_py_hr_payroll_report.action_hr_payroll_ips_export_wizard').read()[0]
        </field>
    </record>

    <record id="view_hr_payroll_ips_export_wizard" model="ir.ui.view">
        <field name="name">hr.payroll.ips.export.wizard.view</field>
        <field name="model">hr.payroll.ips.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Planilla IPS a Excel">
                <group>
                    <field name="payslip_run_id" required="1"/>
                </group>
                <group invisible="not file_data">
                    <field name="file_data" filename="filename" widget="binary" string="Descargar archivo Excel"/>
                </group>
                <footer>
                    <button string="Generar Excel" type="object" name="action_generate_file" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_ips_export"
              name="Exportar Planilla IPS"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_server_hr_payroll_ips_export_wizard_menu"
              sequence="32"/>

    <!-- Botón en la vista de Lotes de Nómina -->
    <record id="hr_payslip_run_form_inherit_ips_export" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.ips.export</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_hr_payroll_ips_export_wizard)d" 
                        string="Exportar Planilla IPS" 
                        type="action" 
                        class="btn-primary"
                        context="{'default_payslip_run_id': id}"
                        invisible="state not in ('done', 'paid')"/>
            </xpath>
        </field>
    </record>
</odoo>

