<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_create_demo_payslips_wizard" model="ir.actions.act_window">
        <field name="name">Crear Payslips Demo</field>
        <field name="res_model">create.demo.payslips.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_create_demo_payslips_wizard" model="ir.ui.view">
        <field name="name">create.demo.payslips.wizard.view</field>
        <field name="model">create.demo.payslips.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Payslips de Demostración">
                <div class="alert alert-info" role="alert">
                    <p><strong>Este wizard creará un lote completo de nómina con:</strong></p>
                    <ul>
                        <li><strong>Lote de nómina</strong> con 2 empleados demo</li>
                        <li><strong>Empleado 1:</strong> 30 días trabajados (IPS normal)</li>
                        <li><strong>Empleado 2:</strong> 24 días trabajados (VARIAS CAUSAS)</li>
                        <li><strong>Conceptos calculados:</strong>
                            <ul>
                                <li>Salario básico</li>
                                <li>IPS trabajador (9%)</li>
                                <li>IPS patronal (16.5%)</li>
                                <li>Total bruto y neto</li>
                                <li>Demás reglas salariales configuradas</li>
                            </ul>
                        </li>
                        <li>Payslips <strong>calculados y confirmados</strong> listos para usar</li>
                    </ul>
                    <p><strong>Nota:</strong> Asegúrate de tener los datos demo cargados.</p>
                </div>
                <footer>
                    <button string="Crear Payslips Demo" type="object" name="action_create_demo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_create_demo_payslips"
              name="Crear Payslips Demo"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_create_demo_payslips_wizard"
              sequence="40"/>
</odoo>

