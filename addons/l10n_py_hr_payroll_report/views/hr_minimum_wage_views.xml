<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para salario mínimo -->
    <record id="view_hr_minimum_wage_tree" model="ir.ui.view">
        <field name="name">hr.minimum.wage.tree</field>
        <field name="model">hr.minimum.wage</field>
        <field name="arch" type="xml">
            <list string="Salarios Mínimos">
                <field name="name"/>
                <field name="amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para salario mínimo -->
    <record id="view_hr_minimum_wage_form" model="ir.ui.view">
        <field name="name">hr.minimum.wage.form</field>
        <field name="model">hr.minimum.wage</field>
        <field name="arch" type="xml">
            <form string="Salario Mínimo">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej: Salario Mínimo 2025"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to" placeholder="Dejar vacío si está vigente"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para salario mínimo -->
    <record id="view_hr_minimum_wage_search" model="ir.ui.view">
        <field name="name">hr.minimum.wage.search</field>
        <field name="model">hr.minimum.wage</field>
        <field name="arch" type="xml">
            <search string="Salarios Mínimos">
                <field name="name"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Vigentes" name="current" 
                        domain="[('date_from', '&lt;=', context_today()), '|', ('date_to', '=', False), ('date_to', '&gt;=', context_today())]"/>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para salario mínimo -->
    <record id="action_hr_minimum_wage" model="ir.actions.act_window">
        <field name="name">Salarios Mínimos</field>
        <field name="res_model">hr.minimum.wage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_minimum_wage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer salario mínimo
            </p>
            <p>
                Los salarios mínimos se usan para calcular bonificaciones familiares legales
                y para validar que los contratos cumplan con el mínimo legal vigente.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_hr_minimum_wage"
              name="Salarios Mínimos"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_hr_minimum_wage"
              sequence="22"/>
</odoo>

