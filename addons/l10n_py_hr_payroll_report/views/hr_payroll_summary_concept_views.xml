<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_summary_concept_list" model="ir.ui.view">
        <field name="name">hr.payroll.summary.concept.list</field>
        <field name="model">hr.payroll.summary.concept</field>
        <field name="arch" type="xml">
            <list string="Conceptos de Planilla de Salarios">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code_list"/>
                <field name="compute_mode"/>
                <field name="use_abs"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_summary_concept_form" model="ir.ui.view">
        <field name="name">hr.payroll.summary.concept.form</field>
        <field name="model">hr.payroll.summary.concept</field>
        <field name="arch" type="xml">
            <form string="Concepto de Planilla de Salarios">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="code_list" placeholder="BASIC, PY_TOTAL_BRUTO"/>
                            <field name="compute_mode"/>
                            <field name="use_abs"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_summary_concept" model="ir.actions.act_window">
        <field name="name">Conceptos Planilla de Salarios</field>
        <field name="res_model">hr.payroll.summary.concept</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer concepto para la planilla de salarios
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_summary_concept"
              name="Conceptos Planilla de Salarios"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_hr_payroll_summary_concept"
              sequence="80"/>
</odoo>
