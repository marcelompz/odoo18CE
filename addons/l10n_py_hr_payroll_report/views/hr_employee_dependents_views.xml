<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_dependents" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.dependents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Dependientes" name="dependents">
                    <field name="dependent_ids" nolabel="1" context="{'default_employee_id': id}" 
                           options="{'no_create': False, 'no_create_edit': False}">
                        <list string="Dependientes" editable="bottom">
                            <field name="name" required="1"/>
                            <field name="identification_id"/>
                            <field name="birth_date" required="1"/>
                            <field name="age" readonly="1"/>
                            <field name="relationship"/>
                            <field name="is_student"/>
                            <field name="is_dependent" readonly="1"/>
                            <field name="is_active"/>
                        </list>
                        <form string="Dependiente">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="employee_id" invisible="1"/>
                                        <field name="name"/>
                                        <field name="identification_id"/>
                                        <field name="birth_date"/>
                                        <field name="age" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="relationship"/>
                                        <field name="is_student"/>
                                        <field name="is_dependent" readonly="1"/>
                                        <field name="is_active"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
