<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_mtess_concept_list" model="ir.ui.view">
        <field name="name">hr.payroll.mtess.concept.list</field>
        <field name="model">hr.payroll.mtess.concept</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="grupo" string="Grupo"/>
                <field name="name" string="Concepto"/>
                <field name="display_code" string="Codigo"/>
                <field name="display_calc_type" string="Tipo de calculo"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_mtess_concept_form" model="ir.ui.view">
        <field name="name">hr.payroll.mtess.concept.form</field>
        <field name="model">hr.payroll.mtess.concept</field>
        <field name="arch" type="xml">
            <form string="Concepto MTESS">
                <sheet>
                    <group>
                        <field name="grupo" string="Grupo"/>
                        <field name="name" string="Concepto"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="value_type" string="Tipo"/>
                        <field name="fixed_code" string="Codigo" invisible="[(value_type, '!=', 'fixed')]" />
                        <field name="code_list" string="Codigo" invisible="[(value_type, '!=', 'salary_rule')]" />
                        <field name="exclude_code_list" invisible="[(value_type, '!=', 'salary_rule')]" />
                        <field name="compute_mode" string="Modo de calculo" invisible="[(value_type, '!=', 'salary_rule')]" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_mtess_concept" model="ir.actions.act_window">
        <field name="name">Conceptos MTESS</field>
        <field name="res_model">hr.payroll.mtess.concept</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer concepto para MTESS
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_mtess_concept"
              name="Conceptos MTESS"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_hr_payroll_mtess_concept"
              sequence="60"/>
</odoo>
