<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para categorías de bonificaciones -->
    <record id="view_hr_bonification_category_tree" model="ir.ui.view">
        <field name="name">hr.bonification.category.tree</field>
        <field name="model">hr.bonification.category</field>
        <field name="arch" type="xml">
            <list string="Categorías de Bonificaciones">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="bonification_ids" widget="many2many_tags" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para categorías de bonificaciones -->
    <record id="view_hr_bonification_category_form" model="ir.ui.view">
        <field name="name">hr.bonification.category.form</field>
        <field name="model">hr.bonification.category</field>
        <field name="arch" type="xml">
            <form string="Categoría de Bonificación">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Descripción de la categoría..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bonificaciones" name="bonifications">
                            <field name="bonification_ids" nolabel="1">
                                <list string="Bonificaciones">
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="amount_type"/>
                                    <field name="amount"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana para categorías de bonificaciones -->
    <record id="action_hr_bonification_category" model="ir.actions.act_window">
        <field name="name">Categorías de Bonificaciones</field>
        <field name="res_model">hr.bonification.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera categoría de bonificación
            </p>
            <p>
                Las categorías de bonificaciones permiten agrupar diferentes tipos de bonificaciones
                y asignarlas a empleados mediante checkboxes.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_hr_bonification_category"
              name="Categorías de Bonificaciones"
              parent="l10n_py_hr_payroll_report.menu_rrhh_paraguay_root"
              action="action_hr_bonification_category"
              sequence="20"/>
</odoo>

