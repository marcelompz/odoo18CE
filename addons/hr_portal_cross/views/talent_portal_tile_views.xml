<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===== CATEGORIA ===== -->
    <record id="view_talent_portal_category_form" model="ir.ui.view">
        <field name="name">talent.portal.category.form</field>
        <field name="model">talent.portal.category</field>
        <field name="arch" type="xml">
            <form string="Categoria">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Beneficios"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="icon_class" placeholder="fa-folder"/>
                            <field name="color" widget="char" placeholder="#667eea"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="active"/>
                            <field name="tile_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_talent_portal_category_list" model="ir.ui.view">
        <field name="name">talent.portal.category.list</field>
        <field name="model">talent.portal.category</field>
        <field name="arch" type="xml">
            <list string="Categorias" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon_class"/>
                <field name="color"/>
                <field name="tile_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_talent_portal_category" model="ir.actions.act_window">
        <field name="name">Categorias del Portal</field>
        <field name="res_model">talent.portal.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== TILE ===== -->
    <record id="view_talent_portal_tile_form" model="ir.ui.view">
        <field name="name">talent.portal.tile.form</field>
        <field name="model">talent.portal.tile</field>
        <field name="arch" type="xml">
            <form string="Tile">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Asistencias"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="description"/>
                            <field name="icon_class" placeholder="fa-clock-o"/>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Destino (uno de los tres)">
                            <field name="action_id" options="{'no_create': True}"/>
                            <field name="action_xml_id"/>
                            <field name="method_call"/>
                        </group>
                    </group>
                    <group string="Badge de Cantidad (KPI)">
                        <group>
                            <field name="show_count"/>
                            <field name="count_model" invisible="not show_count"/>
                        </group>
                        <group>
                            <field name="count_domain" invisible="not show_count"/>
                        </group>
                    </group>
                    <group string="Seguridad">
                        <field name="groups_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_talent_portal_tile_list" model="ir.ui.view">
        <field name="name">talent.portal.tile.list</field>
        <field name="model">talent.portal.tile</field>
        <field name="arch" type="xml">
            <list string="Tiles del Portal" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="icon_class" optional="hide"/>
                <field name="color" widget="color_picker"/>
                <field name="action_xml_id" optional="show"/>
                <field name="method_call" optional="hide"/>
                <field name="show_count" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban PLANO (sin agrupar) -->
    <record id="view_talent_portal_tile_kanban" model="ir.ui.view">
        <field name="name">talent.portal.tile.kanban</field>
        <field name="model">talent.portal.tile</field>
        <field name="arch" type="xml">
            <kanban string="Talento Humano" default_order="category_id, sequence, id"
                    create="0" delete="0" edit="0" group_create="0"
                    class="o_hr_portal_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="icon_class"/>
                <field name="color"/>
                <field name="show_count"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <button name="action_open_target" type="object"
                                t-attf-class="o_hr_portal_tile_btn o_hr_portal_tile tile-color-#{record.color.raw_value or 8}">
                            <t t-if="record.show_count.raw_value">
                                <div class="o_hr_portal_tile_badge"><i class="fa fa-bell-o"/></div>
                            </t>
                            <div class="o_hr_portal_tile_icon">
                                <i t-attf-class="fa #{record.icon_class.raw_value or 'fa-cubes'}"/>
                            </div>
                            <h3 class="o_hr_portal_tile_title"><field name="name"/></h3>
                            <p class="o_hr_portal_tile_desc"><field name="description"/></p>
                        </button>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban AGRUPADO por categoria (columnas) -->
    <record id="view_talent_portal_tile_kanban_grouped" model="ir.ui.view">
        <field name="name">talent.portal.tile.kanban.grouped</field>
        <field name="model">talent.portal.tile</field>
        <field name="arch" type="xml">
            <kanban string="Talento Humano por Categoria"
                    default_group_by="category_id"
                    default_order="sequence, id"
                    create="0" delete="0" edit="0" group_create="0"
                    class="o_hr_portal_kanban o_hr_portal_kanban_grouped">
                <field name="id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="icon_class"/>
                <field name="color"/>
                <field name="show_count"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <button name="action_open_target" type="object"
                                t-attf-class="o_hr_portal_tile_btn o_hr_portal_tile tile-color-#{record.color.raw_value or 8}">
                            <t t-if="record.show_count.raw_value">
                                <div class="o_hr_portal_tile_badge"><i class="fa fa-bell-o"/></div>
                            </t>
                            <div class="o_hr_portal_tile_icon">
                                <i t-attf-class="fa #{record.icon_class.raw_value or 'fa-cubes'}"/>
                            </div>
                            <h3 class="o_hr_portal_tile_title"><field name="name"/></h3>
                            <p class="o_hr_portal_tile_desc"><field name="description"/></p>
                        </button>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Accion principal: muestra plano por defecto, con boton para agrupar -->
    <record id="action_talent_portal" model="ir.actions.act_window">
        <field name="name">Talento Humano</field>
        <field name="res_model">talent.portal.tile</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_talent_portal_tile_kanban"/>
        <field name="domain">[('active', '=', True)]</field>
    </record>

    <!-- Accion: vista agrupada por columnas -->
    <record id="action_talent_portal_grouped" model="ir.actions.act_window">
        <field name="name">Talento Humano (por Categoria)</field>
        <field name="res_model">talent.portal.tile</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_talent_portal_tile_kanban_grouped"/>
        <field name="domain">[('active', '=', True)]</field>
    </record>

    <record id="action_talent_portal_tile_config" model="ir.actions.act_window">
        <field name="name">Configuracion de Tiles</field>
        <field name="res_model">talent.portal.tile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
