<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_employee_birthday_kanban" model="ir.ui.view">
        <field name="name">hr.employee.kanban.birthday</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <kanban string="Cumpleanos del Mes" 
                    create="0" delete="0" edit="0"
                    class="o_hr_birthday_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="birthday"/>
                <field name="birthday_day_label"/>
                <field name="birthday_days_until"/>
                <field name="birthday_is_today"/>
                <field name="birthday_age"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <field name="image_128"/>
                <field name="work_email"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_hr_birthday_card #{record.birthday_is_today.raw_value ? 'is_today' : ''}"
                            >
                            <div class="o_hr_birthday_top">
                                <img t-att-src="kanban_image('hr.employee', 'image_256', record.id.raw_value)"
                                     class="o_hr_birthday_photo"
                                     t-att-alt="record.name.value"/>
                                <t t-if="record.birthday_is_today.raw_value">
                                    <div class="o_hr_birthday_party">
                                        <i class="fa fa-birthday-cake"/>
                                    </div>
                                </t>
                            </div>
                            <div class="o_hr_birthday_body">
                                <h3 class="o_hr_birthday_name">
                                    <field name="name"/>
                                </h3>
                                <p class="o_hr_birthday_job text-muted">
                                    <field name="job_title"/>
                                </p>
                                <div class="o_hr_birthday_date_box">
                                    <div class="o_hr_birthday_date_label">
                                        <field name="birthday_day_label"/>
                                    </div>
                                    <t t-if="!record.birthday_is_today.raw_value">
                                        <div class="o_hr_birthday_countdown">
                                            <span t-if="record.birthday_days_until.raw_value == 1">en 1 dia</span>
                                            <span t-if="record.birthday_days_until.raw_value > 1">
                                                en <t t-esc="record.birthday_days_until.raw_value"/> dias
                                            </span>
                                        </div>
                                    </t>
                                    <t t-if="record.birthday_is_today.raw_value">
                                        <div class="o_hr_birthday_age_today">
                                            Cumple <t t-esc="record.birthday_age.raw_value"/> anos hoy!
                                        </div>
                                    </t>
                                </div>
                                <t t-if="record.department_id.raw_value">
                                    <div class="o_hr_birthday_dept">
                                        <i class="fa fa-building-o"/>
                                        <field name="department_id"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
