<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Form -->
    <record id="view_talent_holiday_form" model="ir.ui.view">
        <field name="name">talent.holiday.form</field>
        <field name="model">talent.holiday</field>
        <field name="arch" type="xml">
            <form string="Feriado">
                <header>
                    <button name="action_send_notification" string="Enviar Aviso a Empleados"
                            type="object" class="oe_highlight" icon="fa-bullhorn"
                            confirm="Esto enviara una notificacion interna a todos los empleados activos. Continuar?"/>
                    <field name="notification_sent" invisible="1"/>
                    <field name="notification_date" widget="statinfo" invisible="not notification_sent"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_small'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del feriado"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="country_id"/>
                            <field name="is_national"/>
                            <field name="is_movable"/>
                            <field name="color" widget="selection"/>
                        </group>
                        <group>
                            <field name="days_until" invisible="is_past"/>
                            <field name="is_today" invisible="not is_today"/>
                            <field name="is_past" invisible="not is_past"/>
                            <field name="notification_sent" readonly="1"/>
                            <field name="notification_date" readonly="1" invisible="not notification_sent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripcion / Origen">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Mensaje Reflexivo">
                            <field name="reflective_message" nolabel="1"
                                placeholder="Escriba el mensaje que se enviara a todos los empleados sobre este feriado..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_talent_holiday_kanban" model="ir.ui.view">
        <field name="name">talent.holiday.kanban</field>
        <field name="model">talent.holiday</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard talent_holiday_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="image"/>
                <field name="image_small"/>
                <field name="description"/>
                <field name="color"/>
                <field name="is_past"/>
                <field name="is_today"/>
                <field name="days_until"/>
                <field name="notification_sent"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click talent_holiday_card"
                             t-attf-style="position:relative; min-height:240px; border-radius:14px; overflow:hidden; box-shadow:0 4px 18px rgba(0,0,0,0.12); background:#fff;">

                            <!-- IMAGEN HERO -->
                            <div t-if="record.image.raw_value" style="height:140px; overflow:hidden; background:#222;">
                                <img t-attf-src="/web/image/talent.holiday/{{record.id.raw_value}}/image"
                                     style="width:100%; height:100%; object-fit:cover;"/>
                            </div>
                            <div t-if="!record.image.raw_value" style="height:120px; background:linear-gradient(135deg,#c2255c,#e8590c); display:flex; align-items:center; justify-content:center;">
                                <i class="fa fa-flag" style="font-size:48px; color:#fff;"/>
                            </div>

                            <!-- BADGE FECHA -->
                            <div t-attf-style="position:absolute; top:10px; right:10px; background:#fff; color:#333; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:bold; box-shadow:0 2px 6px rgba(0,0,0,0.2);">
                                <i class="fa fa-calendar"/> <field name="date"/>
                            </div>

                            <!-- BADGE HOY / DIAS RESTANTES -->
                            <div t-if="record.is_today.raw_value"
                                 style="position:absolute; top:10px; left:10px; background:#e03131; color:#fff; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:bold;">
                                HOY
                            </div>
                            <div t-if="!record.is_today.raw_value &amp;&amp; !record.is_past.raw_value &amp;&amp; record.days_until.raw_value &gt; 0 &amp;&amp; record.days_until.raw_value &lt;= 30"
                                 style="position:absolute; top:10px; left:10px; background:#1864ab; color:#fff; padding:4px 10px; border-radius:20px; font-size:10px; font-weight:bold;">
                                En <field name="days_until"/> dias
                            </div>
                            <div t-if="record.is_past.raw_value"
                                 style="position:absolute; top:10px; left:10px; background:#868e96; color:#fff; padding:4px 10px; border-radius:20px; font-size:10px;">
                                Pasado
                            </div>

                            <!-- CONTENIDO -->
                            <div style="padding:14px;">
                                <div style="font-weight:bold; font-size:15px; color:#222; margin-bottom:4px;">
                                    <field name="name"/>
                                </div>
                                <div style="font-size:11px; color:#666; line-height:1.4; max-height:38px; overflow:hidden;">
                                    <field name="description"/>
                                </div>
                                <div style="margin-top:10px;">
                                    <span t-if="record.notification_sent.raw_value"
                                          style="font-size:10px; color:#2b8a3e;">
                                        <i class="fa fa-check-circle"/> Aviso enviado
                                    </span>
                                    <button name="action_send_notification" type="object"
                                            t-if="!record.notification_sent.raw_value"
                                            class="btn btn-sm btn-primary"
                                            style="font-size:11px; padding:4px 10px;">
                                        <i class="fa fa-bullhorn"/> Enviar Aviso
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista List -->
    <record id="view_talent_holiday_list" model="ir.ui.view">
        <field name="name">talent.holiday.list</field>
        <field name="model">talent.holiday</field>
        <field name="arch" type="xml">
            <list string="Feriados" decoration-success="is_today" decoration-muted="is_past" decoration-info="not is_past and not is_today">
                <field name="date"/>
                <field name="name"/>
                <field name="country_id" optional="hide"/>
                <field name="is_national" optional="show"/>
                <field name="is_movable" optional="hide"/>
                <field name="days_until" string="Dias restantes" optional="show"/>
                <field name="notification_sent" optional="show"/>
                <field name="notification_date" optional="hide"/>
                <button name="action_send_notification" type="object" string="Enviar Aviso" icon="fa-bullhorn" invisible="notification_sent"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_talent_holiday_search" model="ir.ui.view">
        <field name="name">talent.holiday.search</field>
        <field name="model">talent.holiday</field>
        <field name="arch" type="xml">
            <search string="Buscar Feriados">
                <field name="name"/>
                <field name="date"/>
                <filter string="Proximos" name="upcoming" domain="[('is_past','=',False)]"/>
                <filter string="Pasados" name="past" domain="[('is_past','=',True)]"/>
                <filter string="Hoy" name="today" domain="[('is_today','=',True)]"/>
                <filter string="Avisados" name="notified" domain="[('notification_sent','=',True)]"/>
                <filter string="Sin Avisar" name="not_notified" domain="[('notification_sent','=',False)]"/>
                <group string="Agrupar por">
                    <filter string="Mes" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Pais" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_talent_holiday" model="ir.actions.act_window">
        <field name="name">Feriados</field>
        <field name="res_model">talent.holiday</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_talent_holiday_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer feriado</p>
            <p>Define cada feriado con su fecha, imagen y mensaje reflexivo, y envia avisos a todos los empleados.</p>
        </field>
    </record>

</odoo>
