<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="current_stock_general">
            <div class="page">
                <div align="center">
                    <h2>
                        <span>Stock Actual y Margen Bruto</span>
                    </h2>
                </div>
                <t t-if="not wizard_id">
                    <t t-set="wizard_id" t-value="docs"/>
                </t>
                <table class="table table-sm o_main_table table-bordered mt-4" style="font-size: 10px;">
                    <thead style="display: table-row-group">
                        <tr style="background-color: #f2f2f2;">
                            <th width="2%" class="text-center">No</th>
                            <th width="18%" class="text-center">Producto</th>
                            <th width="8%" class="text-center">Categoría</th>
                            <th width="8%" class="text-center">Lote / SN</th>
                            <th width="8%" class="text-center">Ubicación</th>
                            <th width="10%" class="text-center">Entrada</th>
                            <th width="3%" class="text-center">Días</th>
                            <th width="5%" class="text-center">Stock</th>
                            <th width="5%" class="text-center">Reserv.</th>
                            <th width="5%" class="text-center">Disp.</th>
                            <th width="6%" class="text-center">Costo U.</th>
                            <th width="6%" class="text-center">Costo T.</th>
                            <th width="6%" class="text-center">PVP U.</th>
                            <th width="6%" class="text-center">PVP T.</th>
                            <th width="6%" class="text-center">Margen</th>
                            <th width="3%" class="text-center">%</th>
                        </tr>
                    </thead>
                    <t t-set="datas" t-value="wizard_id.get_current_stock_data()"/>
                    <tbody>
                        <t t-set="total_qty" t-value="0"/>
                        <t t-set="total_reserved_qty" t-value="0"/>
                        <t t-set="total_available_qty" t-value="0"/>
                        <t t-set="total_cost_sum" t-value="0"/>
                        <t t-set="total_sale_sum" t-value="0"/>
                        <t t-set="total_margin_sum" t-value="0"/>

                        <t t-foreach="datas" t-as="data">
                            <t t-set="total_qty" t-value="total_qty + data['quantity']"/>
                            <t t-set="total_reserved_qty" t-value="total_reserved_qty + data['reserved_quantity']"/>
                            <t t-set="total_available_qty" t-value="total_available_qty + data['available_quantity']"/>
                            <t t-set="total_cost_sum" t-value="total_cost_sum + data['total_cost']"/>
                            <t t-set="total_sale_sum" t-value="total_sale_sum + data['total_sale_value']"/>
                            <t t-set="total_margin_sum" t-value="total_margin_sum + data['gross_margin']"/>

                            <tr>
                                <td class="text-center"><span t-esc="data['no']"/></td>
                                <td><span t-esc="data['product_name']"/></td>
                                <td><span t-esc="data['categ_name']"/></td>
                                <td><span t-esc="data['lot_name']"/></td>
                                <td><span t-esc="data['location_name']"/></td>
                                <td class="text-center"><span t-esc="data['incoming_date']"/></td>
                                <td class="text-center"><span t-esc="'{:,.0f}'.format(data['stock_age'])"/></td>
                                <td class="text-end"><span t-esc="'{:,.2f}'.format(data['quantity'])"/></td>
                                <td class="text-end"><span t-esc="'{:,.2f}'.format(data['reserved_quantity'])"/></td>
                                <td class="text-end"><span t-esc="'{:,.2f}'.format(data['available_quantity'])"/></td>
                                <td class="text-end"><span t-esc="'{:,.0f}'.format(data['unit_cost'])"/></td>
                                <td class="text-end fw-bold"><span t-esc="'{:,.0f}'.format(data['total_cost'])"/></td>
                                
                                <!-- NUEVAS COLUMNAS DE VENTA -->
                                <td class="text-end"><span t-esc="'{:,.0f}'.format(data['sale_price'])"/></td>
                                <td class="text-end fw-bold"><span t-esc="'{:,.0f}'.format(data['total_sale_value'])"/></td>
                                <td class="text-end text-primary"><span t-esc="'{:,.0f}'.format(data['gross_margin'])"/></td>
                                <td class="text-end"><span t-esc="'{:,.1f}'.format(data['margin_percent'] * 100)"/>%</td>
                            </tr>
                        </t>
                    </tbody>
                    <tr style="background-color: #eee; font-weight: bold;">
                        <td colspan="7" class="text-center">GRAND TOTAL</td>
                        <td class="text-end"><span t-esc="'{:,.2f}'.format(total_qty)"/></td>
                        <td class="text-end"><span t-esc="'{:,.2f}'.format(total_reserved_qty)"/></td>
                        <td class="text-end"><span t-esc="'{:,.2f}'.format(total_available_qty)"/></td>
                        <td class="text-end"> - </td>
                        <td class="text-end"><span t-esc="'{:,.0f}'.format(total_cost_sum)"/></td>
                        <td class="text-end"> - </td>
                        <td class="text-end"><span t-esc="'{:,.0f}'.format(total_sale_sum)"/></td>
                        <td class="text-end text-primary"><span t-esc="'{:,.0f}'.format(total_margin_sum)"/></td>
                        <td class="text-end">
                            <t t-if="total_sale_sum > 0">
                                <span t-esc="'{:,.1f}'.format((total_margin_sum / total_sale_sum) * 100)"/>%
                            </t>
                        </td>
                    </tr>
                </table>
            </div>
        </template>

        <template id="current_stock_document">
            <t t-call="web.external_layout">
                <t t-call="ms_stock_report.current_stock_general"/>
            </t>
        </template>

        <template id="current_stock">
		    <t t-call="web.html_container">
		        <t t-call="ms_stock_report.current_stock_document" />
		    </t>
		</template>
		
		<record id="report_current_stock" model="ir.actions.report">
            <field name="name">Current Stock</field>
            <field name="model">ms.stock.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ms_stock_report.current_stock</field>
            <field name="report_file">ms_stock_report.current_stock</field>
            <field name="print_report_name">'Current Stock'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_euro_landscape"/>
        </record>

        <template id="current_stock_template">
            <t t-call="portal.portal_layout">
                <t t-set="additional_title">Current Stock</t>
                <t t-call="ms_stock_report.current_stock_general"/>
            </t>
        </template>

    </data>
</odoo>
