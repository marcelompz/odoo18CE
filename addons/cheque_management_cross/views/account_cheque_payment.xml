<odoo>

    <!-- wizard view -->

    <record id="account_cheque_payment_wizard" model="ir.ui.view">
        <field name="name">account.cheque.payment.wizard</field>
        <field name="model">account.cheque.payment</field>
        <field name="arch" type="xml">
            <form string="Pago con cheque">
                <sheet>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="partner_id" readonly="1" />
                            <field name="payment_amount" widget="monetary" />
                            <field name="currency_cheque_id" required="1"/>
                            <field name="payment_cheque_amount" required="1"/>
                            <field name="reference" />
                            <field name="journal_id" options="{'no_create':1,'no_create_edit':1}" />
                            <field name='cheque_status' widget="radio"/>
                            <field name="name" invisible="1" />
                            <field name="payment_type" invisible="1" />
                        </group>
                        <group>
                            <field name="payment_date" />
                            <field name="due_date" />
                            <field name="memo" />
                            <field name="agent" />
                            <field name="bank_id" />
                            <field name="cheque_nro"/>
                            <field name="invoice_ids" readonly="1" widget="many2many_tags"/>
                            <field name="attachment_ids" widget="many2many_binary" string="Adjuntar imagen de cheque" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="button_register" string="Registrar cheque" type="object" class="btn-primary" />
                    <button string="Cancelar" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- tree view invoices selections -->
    <record id="account_move_selections_tree" model="ir.ui.view">
        <field name="name">account.move.selections.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Seleccionar facturas">
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="name" string="Nro. Interno"/>
                <field name="invoice_number" decoration-bf="1" decoration-success="1" string="Nro. Factura"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due" decoration-bf="1" widget="remaining_days"/>
                <field name="amount_total_in_currency_signed" string="Total Factura" sum="amount_total_in_currency"/>
                <field name="amount_residual_signed" string="Pendiente" sum="amount_residual"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="hide"/>
                <field name="payment_state"
                    widget="badge"
                    decoration-danger="payment_state == 'not_paid'"
                    decoration-warning="payment_state in ('partial', 'in_payment')"
                    decoration-success="payment_state in ('paid', 'reversed')"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <!-- form view -->

    <record id="account_cheque_payment_form" model="ir.ui.view">
        <field name="name">account.cheque.payment.form</field>
        <field name="model">account.cheque.payment</field>
        <field name="arch" type="xml">
            <form string="Pago con cheque">
                <header>
                    <button name="action_register" class="oe_highlight" invisible="state != 'draft'" string="Registrar" type="object" />
                    <button name="action_returned" class="oe_highlight" invisible="state not in ['registered','paid']" string="Devolver" type="object" />
                    <button name="action_deposited" class="oe_highlight" invisible="state not in ['registered','returned','bounced','paid','done']" string="Depositar" type="object" />
                    <button name="action_bounced" class="oe_highlight" invisible="state not in ['deposited']" string="Rebotar" type="object" />
                    <button name="action_done" class="oe_highlight" invisible="state not in ['deposited']" string="Hecho" type="object" />
                    <button name="action_set_draft" class="oe_highlight" invisible="state not in ['registered','cancel','paid']" string="Restablecer al borrador" type="object" />
                    <button name="action_cancel" class="oe_highlight" invisible="state == 'cancel'" string="Cancelar" type="object" />
                    <!-- <button name="action_skip_steps" class="oe_highlight" invisible="state != 'registered'" string="Pagar" type="object" /> -->
                    <button name="action_finish" class="oe_highlight" invisible="state != 'paid'" string="Finalizar" type="object" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="open_attachments" class="oe_stat_button" icon="fa-cloud-upload" type="object" string="Adjuntos"></button>
                        <button name="open_journal_items" class="oe_stat_button" icon="fa-list" type="object" string="Apuntes contables"></button>
                        <button name="open_journal_entry" class="oe_stat_button" icon="fa-list" type="object" string="Asientos contables"></button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" />
                            <field name="payment_type" readonly="state not in ['draft','bounced','returned']" widget="radio" />
                            <field name="currency_id" invisible="1" />
                            <field name="partner_id" readonly="state not in ['draft','bounced','returned']" />
                            <field name='company_id' invisible="1"/>
                            <field name="payment_amount" widget="monetary" readonly="state not in ['draft','bounced','returned']" />
                            <field name="currency_cheque_id" required="1" readonly="state not in ['draft','bounced']" options="{'no_create': 1, 'no_open': 1}"/>
                            <field name="payment_cheque_amount" required="1" readonly="state not in ['draft','bounced']"/>
                            <field name="reference" readonly="state not in ['draft','bounced','returned']" />
                            <field name="journal_id" options="{'no_create':1,'no_create_edit':1}" readonly="state not in ['draft','bounced','returned']" />
                        </group>
                        <group>
                            <field name="payment_date" readonly="state not in ['draft','bounced','returned']" />
                            <field name="due_date" readonly="state not in ['draft','bounced','returned']" />
                            <field name="memo" readonly="state not in ['draft','bounced','returned']" />
                            <field name="agent" readonly="state not in ['draft','bounced','returned']" />
                            <field name="bank_id" readonly="state not in ['draft','bounced','returned']" />
                            <field name="cheque_nro"/>
                            <field name="done_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Facturas">
                            <field name="account_move_ids" invisible="1"/>
                            <field 
                                name="invoice_ids" 
                                domain="[('id','in',account_move_ids)]" 
                                readonly="state not in ['draft','bounced','returned']"
                                context="{
                                    'list_view_ref': 'cheque_management_cross.account_move_selections_tree'
                                }"
                            >
                                <list default_order="sequence">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="invoice_number" decoration-bf="1" decoration-success="1" string="Factura"/>
                                    <field name="invoice_date_due" widget="remaining_days"/>
                                    <field name="amount_total_signed" widget="monetary" sum="total_amount_total_signed"/>
                                    <field name="amount_total_in_currency_signed" widget="monetary" sum="total_amount_total_in_currency_signed"/>
                                    <field name="amount_residual_signed" widget="monetary" optional="show" sum="total_amount_residual_signed"/>
                                    <field name="payment_state"
                                        widget="badge"
                                        decoration-danger="payment_state == 'not_paid'"
                                        decoration-warning="payment_state in ('partial', 'in_payment')"
                                        decoration-success="payment_state in ('paid', 'reversed')"
                                        optional="show"
                                    />
                                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Adjuntos">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- tree view -->

    <record id="account_cheque_payment_tree" model="ir.ui.view">
        <field name="name">account.cheque.payment.tree</field>
        <field name="model">account.cheque.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_date"/>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="cheque_nro" optional="hide"/>
                <field name="currency_cheque_id" column_invisible="1"/>
                <field name="payment_cheque_amount" widget="monetary"/>
                <field name="payment_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-it="state == 'draft'" decoration-info="state == 'registered'" decoration-warning="state == 'deposited'" decoration-danger="state in ['returned', 'bounced']" decoration-success="state in ['done', 'paid']"/>
            </list>
        </field>
    </record>

    <!-- search view -->

    <record id="account_cheque_payment_search" model="ir.ui.view">
        <field name="name">account.cheque.payment.search</field>
        <field name="model">account.cheque.payment</field>
        <field name="arch" type="xml">
            <search string="Search cheque payment">
                <filter name="draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="registered" string="Registrados" domain="[('state','=','registered')]"/>
                <filter name="returned" string="Devueltos" domain="[('state','=','returned')]"/>
                <filter name="deposited" string="Depositados" domain="[('state','=','deposited')]"/>
                <filter name="bounced" string="Rebotados" domain="[('state','=','bounced')]"/>
                <filter name="cancel" string="Cancelados" domain="[('state','=','cancel')]"/>
                <filter name="customer" string="Clientes" domain="[('partner_id.customer_rank','&gt;', 0)]"/>
               	<filter name="partner" string="Proveedores" domain="[('partner_id.supplier_rank','&gt;', 0)]"/>
                <separator/>
                <field name="partner_id" operator="child_of"/>
                <field name="name" string="Nombre"/>
                <field name="payment_date" string="Fecha de pago"/>
                <field name='reference'/>
                <field name='agent'/>
                <field name='bank_id'/>
                <field name="cheque_nro"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_partner_id" string="Cliente/Proveedor" context="{'group_by':'partner_id'}"/>
                    <filter name="status" string="Estado" context="{'group_by':'state'}"/>
                    <separator/>
                    <filter string="Fecha de pago" name="invoicedate" context="{'group_by':'payment_date'}"/>
                    <filter string="Fecha vencimiento" name="duedate" context="{'group_by':'due_date'}"/>
                    <separator/>
                    <filter string="Diario" name="journal_id" context="{'group_by':'journal_id'}"/>
                    <filter string="Banco" name="bank_id" context="{'group_by':'bank_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- window action -->

    <record id="account_cheque_payment_wizard_action" model="ir.actions.act_window">
        <field name="name">Pago con cheque</field>
        <field name="res_model">account.cheque.payment</field>
        <field name="view_id" ref="cheque_management_cross.account_cheque_payment_wizard" />
        <field name="target">new</field>
    </record>

    <record id="account_cheque_payment_action" model="ir.actions.act_window">
        <field name="name">Pago con cheque</field>
        <field name="res_model">account.cheque.payment</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('cheque_management_cross.account_cheque_payment_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('cheque_management_cross.account_cheque_payment_form')})]"
        />
    </record>

    <!-- menu -->

    <menuitem 
        id="account_cheque_payment_menu" 
        name="Pago con cheque" 
        groups="account.group_account_invoice" 
        parent="account.menu_finance" 
        sequence="25" 
        action="cheque_management_cross.account_cheque_payment_action"
    />

</odoo>
