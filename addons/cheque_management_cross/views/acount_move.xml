<odoo>

    <!-- form view -->

    <record id="account_move_inherit" model="ir.ui.view">
        <field name="name">account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_register_payment']" position="after">                
                <button
                    name="%(account_cheque_payment_wizard_action)d"
                    type="action"
                    string="Registrar cheque"
                    invisible="state != 'posted' or payment_state == 'paid' or move_type not in ['out_invoice','in_invoice']"
                    groups="account.group_account_invoice"
                    class="oe_highlight"
                />
            </xpath>
                
            <xpath expr="//div[@name='button_box']" position="inside">
                <button 
                    name="open_cheque_payment"
                    class="oe_stat_button"
                    type="object"
                    icon="fa-credit-card"
                    invisible="cheque_payment_count == 0">
                    <field name="cheque_payment_count" widget="statinfo"  string="Pago con cheques"/>
                </button>
            </xpath>

            <xpath expr='//page[@name="other_info"]' position='after'>
                <page name='cheque_payment' string='Pago con cheque'>
                    <field name='cheque_payment_ids'>
                        <list decoration-success="state =='done'" decoration-info="state == 'draft'"  decoration-danger="state == 'bounced'" decoration-muted="state == 'cancel'">
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_date"/>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="partner_id"/>
                            <field name="payment_amount"/>
                            <field name="state"/>
                        </list>
                        <form>
                            <header>
                                <button name="action_register" class="oe_highlight" invisible="state != 'draft'" string="Registrar" type="object"/>
                                <button name="action_returned" class="oe_highlight" invisible="state != 'registered'" string="Devolver" type="object"/>
                                <button name="action_deposited" class="oe_highlight" invisible="state not in ['registered','returned','bounced']" string="Depositar" type="object"/>
                                <button name="action_bounced" class="oe_highlight" invisible="state != 'deposited'" string="Rebotar" type="object"/>
                                <button name="action_done" class="oe_highlight" invisible="state != 'deposited'" string="Hecho" type="object"/>
                                <button name="action_cancel" class="oe_highlight" invisible="state not in ['registered','returned','bounced']" string="Cancelar" type="object"/>
                                <field name="state" widget="statusbar"/>
                            </header>
                            <sheet>
                                <div name="button_box" class="oe_button_box">
                                    <button name="open_attachments"
                                        class="oe_stat_button"
                                        icon="fa-cloud-upload"
                                        type="object"
                                        string="Adjuntos">
                                    </button>
                                    <button name="open_journal_items"
                                        class="oe_stat_button"
                                        icon="fa-list"
                                        type="object"
                                        string="Apuntes contables">
                                    </button>
                                    <button name="open_journal_entry"
                                        class="oe_stat_button"
                                        icon="fa-list"
                                        type="object"
                                        string="Asientos contables">
                                    </button>
                                </div>
                                <group>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="payment_type" readonly="state not in ['draft','bounced']" widget="radio"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="partner_id" readonly="state not in ['draft','bounced']"/>
                                        <field name="payment_amount" widget="monetary" readonly="state not in ['draft','bounced']"/>
                                        <field name="reference" readonly="state not in ['draft','bounced']"/>
                                        <field name="journal_id" options="{'no_create':1,'no_create_edit':1}" readonly="state not in ['draft','bounced']"/>
                                    </group>
                                    <group>
                                        <field name="payment_date" readonly="state not in ['draft','bounced']"/>
                                        <field name="due_date" readonly="state not in ['draft','bounced']"/>
                                        <field name="memo" readonly="state not in ['draft','bounced']"/>
                                        <field name="agent" readonly="state not in ['draft','bounced']"/>
                                        <field name="bank_id" readonly="state not in ['draft','bounced']"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Adjuntos">
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_cheque_received"/>
                        <field name="total_cheque_pending" />
                        <field name="total_cheque_cancel" invisible="total_cheque_cancel == 0.0"/>
                        <field name="total_cheque_payment" class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='payment_reference']" position="after">
				<field name="is_boolean" invisible="1"/>
            </xpath>
            
			<xpath expr="//sheet//widget[2]" position="attributes">
				<attribute name="invisible">not is_boolean or (payment_state != 'in_payment' and move_type not in ['out_invoice','out_refund','in_invoice','in_refund','out_receipt','in_receipt'])</attribute>
			</xpath>

        </field>
    </record>

    <!-- action window -->

    <record id="account_cheque_payment_move_journal_line_action" model="ir.actions.act_window">
        <field name="name">Entradas de diario</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_move_tree" />
        <field name="search_view_id" ref="account.view_account_move_filter" />
        <field name="context">{'default_type': 'entry','view_no_maturity': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una entrada de diario
            </p>
            <p>
                Una entrada de diario consta de varios elementos de diario, cada uno de los cuales es una transacción de débito o de crédito.
            </p>
        </field>
    </record>

</odoo>
