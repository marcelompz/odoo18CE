<odoo>

    <record id="account_cheque_payment_action_state_register" model="ir.actions.server">
        <field name="name">Registrar los cheques</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_state_register() </field>
    </record>

    <record id="account_cheque_payment_action_state_return" model="ir.actions.server">
        <field name="name">Devolver los cheques</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_state_return() </field>
    </record>

    <record id="account_cheque_payment_action_state_deposit" model="ir.actions.server">
        <field name="name">Depositar los cheques</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_state_deposit() </field>
    </record>

    <record id="account_cheque_payment_action_state_bounce" model="ir.actions.server">
        <field name="name">Rebotar los cheques</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_state_bounce() </field>
    </record>
     
    <record id="account_cheque_payment_action_state_done" model="ir.actions.server">
        <field name="name">Cheques a Hecho</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_state_done() </field>
    </record>

    <record id="account_cheque_payment_action_register_check" model="ir.actions.server">
        <field name="name">Registrar pago con cheque</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code"> action = model.action_register_check() </field>
    </record>

    <record id="cmc_cancel_multi_action" model="ir.actions.server">
        <field name="name">Cancelar</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="groups_id" eval="[(4, ref('cheque_management_cross.group_account_cheque_payment_cancel'))]" />
        <field name="state">code</field>
        <field name="code">
            records.action_cheque_cancel()
        </field>
    </record>

    <record id="cmc_cancel_draft_multi_action" model="ir.actions.server">
        <field name="name">Cancelar y restablecer borrador</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="groups_id" eval="[(4, ref('cheque_management_cross.group_account_cheque_payment_cancel'))]" />
        <field name="state">code</field>
        <field name="code">
            records.action_cheque_cancel_draft()
        </field>
    </record>

    <record id="cmc_cancel_delete_multi_action" model="ir.actions.server">
        <field name="name">Cancelar y eliminar</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="groups_id" eval="[(4, ref('cheque_management_cross.group_account_cheque_payment_cancel'))]" />
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
            records.action_cheque_cancel_delete()
        </field>
    </record>

</odoo>
