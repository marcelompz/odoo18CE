<odoo>

    <!-- report document -->

    <template id="report_account_cheque_payment_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <center><h2>Informe de pago de cheques</h2></center>
                    <br />
                    <table class="table table-condensed" name="cheque_table" width="100%">
                        <tr>
                            <th width="15%">Nombre</th>
                            <th width="15%">Cliente</th>
                            <th width="15%">Banco</th>
                            <th width="10%">Fecha pago</th>
                            <th width="15%">Monto pagado</th>
                            <th width="20%">Referencia</th>
                            <th width="10%">Estado</th>
                        </tr>
                        <tr t-foreach="docs" t-as="doc">
                            <td width="15%">
                                <span t-field="doc.name" />
                            </td>
                            <td width="15%"><span t-field="doc.partner_id.name" /></td>
                            <td width="15%"><span t-field="doc.bank_id.display_name" /></td>
                            <td width="10%"><span t-field="doc.payment_date" /></td>
                            <td width="15%"><span t-field="doc.payment_amount" /></td>
                            <td width="20%"><span t-field="doc.reference" /></td>
                            <td width="10%"><span t-field="doc.state" /></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- report action -->

    <record id="action_report_account_cheque_payment" model="ir.actions.report">
        <field name="name">Reporte de cheques</field>
        <field name="model">account.cheque.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cheque_management_cross.report_account_cheque_payment_document</field>
        <field name="report_file">cheque_management_cross.report_account_cheque_payment_document</field>
        <field name="binding_model_id" ref="cheque_management_cross.model_account_cheque_payment" />
        <field name="paperformat_id" ref="cheque_management_cross.cheque_report_paperformat" />
        <field name="binding_type">report</field>
    </record>

</odoo>
