<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template para mostrar las imágenes de variantes en la página del producto -->
        <template id="product_variant_images_frontend" inherit_id="website_sale.product" name="Product Variant Images">
            <!-- Agregar contenedor para imágenes de variantes después de la imagen principal -->
            <xpath expr="//div[hasclass('product_detail_img')]" position="after">
                <div class="product_variant_images_container mt-3" t-if="product.variant_image_ids">
                    <h6 class="mb-2">Variantes disponibles:</h6>
                    <div class="row">
                        <t t-foreach="product.variant_image_ids" t-as="variant_image">
                            <div class="col-3 col-md-2 mb-2">
                                <div class="variant_image_thumbnail" 
                                     t-att-data-variant-id="variant_image.product_variant_id.id"
                                     t-att-data-image-url="variant_image.image_url"
                                     t-att-title="variant_image.name">
                                    <img t-attf-src="#{variant_image.image_url}" 
                                         class="img-fluid rounded border variant_thumbnail_img"
                                         t-att-alt="variant_image.name"/>
                                    <div class="variant_price_overlay">
                                        <small t-field="variant_image.product_variant_id.list_price" 
                                               t-options='{"widget": "monetary", "display_currency": variant_image.product_variant_id.currency_id}'/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </xpath>

            <!-- Modificar el contenedor de precio para que sea actualizable -->
            <xpath expr="//div[@id='product_price']" position="attributes">
                <attribute name="id">product_price_container</attribute>
            </xpath>

            <!-- Agregar información de la variante seleccionada -->
            <xpath expr="//div[@id='product_price_container']" position="after">
                <div id="selected_variant_info" class="mt-2" style="display: none;">
                    <small class="text-muted">
                        Variante seleccionada: <span id="selected_variant_name"></span>
                    </small>
                </div>
            </xpath>
        </template>

        <!-- Template para agregar datos de producto necesarios para JavaScript -->
        <template id="product_variant_data" inherit_id="website_sale.product" name="Product Variant Data">
            <xpath expr="//div[@id='product_details']" position="attributes">
                <attribute name="t-att-data-product-id">product.id</attribute>
                <attribute name="t-att-data-current-variant-id">product.product_variant_id.id if product.product_variant_id else ''</attribute>
            </xpath>
        </template>

        <!-- Template para mostrar información adicional de variantes -->
        <template id="product_variant_selector_enhanced" inherit_id="website_sale.product" name="Enhanced Variant Selector">
            <!-- Mejorar el selector de variantes existente si existe -->
            <xpath expr="//div[hasclass('js_product')]" position="attributes">
                <attribute name="class" add="product_variant_enhanced" separator=" "/>
            </xpath>
        </template>

        <!-- Template para agregar estilos y scripts específicos -->
        <template id="product_variant_assets" inherit_id="website.layout" name="Product Variant Assets">
            <xpath expr="//head" position="inside">
                <t t-if="request.httprequest.path.startswith('/shop/product/')">
                    <!-- Los assets CSS y JS se cargan automáticamente desde __manifest__.py -->
                </t>
            </xpath>
        </template>

        <!-- Template alternativo para productos sin variantes configuradas -->
        <template id="product_no_variants_message" inherit_id="website_sale.product" name="No Variants Message">
            <xpath expr="//div[hasclass('product_detail_img')]" position="after">
                <div class="alert alert-info mt-3" t-if="not product.variant_image_ids and product.product_variant_ids and len(product.product_variant_ids) > 1">
                    <i class="fa fa-info-circle"/> 
                    <strong>Información:</strong> Este producto tiene múltiples variantes disponibles. 
                    Para una mejor experiencia, el administrador puede configurar imágenes específicas para cada variante.
                </div>
            </xpath>
        </template>

    </data>
</odoo>

