<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_task_generator" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.task.generator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_task_generator"
                        string="Generar Tareas en Proyecto"
                        type="object"
                        class="oe_highlight"
                        invisible="has_generated_tasks"/>
                <button name="action_open_tasks"
                        type="object"
                        icon="fa-tasks"
                        string="Tareas"
                        class="oe_stat_button">
                    <field name="task_count" widget="statinfo" string="Tareas"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Tareas Generadas" invisible="not task_ids">
                    <field name="task_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="date_deadline"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="project_id"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="date_deadline"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo> 