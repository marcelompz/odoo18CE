<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para plantillas -->
    <record id="view_task_template_form" model="ir.ui.view">
        <field name="name">project.task.template.form</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Tareas">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Tareas Simples" name="simple_tasks">
                            <field name="simple_task_ids" context="{'default_is_complex': False}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="days_to_deadline"/>
                                    <field name="is_complex" invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="days_to_deadline"/>
                                        <field name="is_complex" invisible="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Tareas Complejas" name="complex_tasks">
                            <field name="complex_task_ids" context="{'default_is_complex': True}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="days_to_deadline"/>
                                    <field name="is_complex" invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="days_to_deadline"/>
                                        <field name="is_complex" invisible="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para plantillas -->
    <record id="view_task_template_tree" model="ir.ui.view">
        <field name="name">project.task.template.list</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Tareas">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda para plantillas -->
    <record id="view_task_template_search" model="ir.ui.view">
        <field name="name">project.task.template.search</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <search string="Plantillas de Tareas">
                <field name="name"/>
                <field name="description"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para plantillas -->
    <record id="action_task_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Tareas</field>
        <field name="res_model">project.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_task_template_tree'), 'list'), (ref('view_task_template_form'), 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva plantilla de tareas
            </p>
        </field>
    </record>

    <!-- Elemento de menú para plantillas -->
    <menuitem id="menu_task_template"
              name="Plantillas de Tareas"
              action="action_task_template"
              parent="project.menu_main_pm"
              sequence="100"/>
</odoo> 