<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para tareas -->
    <record id="view_task_form_inherit_sale_order" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sale.order</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="sale_order_id" readonly="1"/>
                <field name="sale_order_task_count" readonly="1" widget="statinfo"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de lista para tareas -->
    <record id="view_task_list_inherit_sale_order" model="ir.ui.view">
        <field name="name">project.task.list.inherit.sale.order</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sale_order_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="user_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vista de búsqueda para tareas -->
    <record id="view_task_search_form_inherit_sale_order" model="ir.ui.view">
        <field name="name">project.task.search.inherit.sale.order</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sale_order_id"/>
            </field>
            <filter name="my_tasks" position="after">
                <separator/>
                <filter string="Tareas de Orden de Venta" name="sale_order_tasks" domain="[('sale_order_id', '!=', False)]"/>
            </filter>
            <group position="inside">
                <filter string="Orden de Venta" name="sale_order" context="{'group_by': 'sale_order_id'}"/>
            </group>
        </field>
    </record>

    <!-- Acción de ventana para tareas -->
    <record id="action_sale_order_tasks" model="ir.actions.act_window">
        <field name="name">Tareas de Orden de Venta</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_task_list_inherit_sale_order'), 'list'), (ref('view_task_form_inherit_sale_order'), 'form')]"/>
        <field name="search_view_id" ref="view_task_search_form_inherit_sale_order"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva tarea
            </p>
        </field>
    </record>
</odoo> 