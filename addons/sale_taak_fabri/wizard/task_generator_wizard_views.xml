<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista para tareas simples -->
    <record id="view_simple_task_tree" model="ir.ui.view">
        <field name="name">sale.task.generator.simple.task.tree</field>
        <field name="model">sale.task.generator.simple.task</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <!-- Vista para tareas complejas -->
    <record id="view_complex_task_tree" model="ir.ui.view">
        <field name="name">sale.task.generator.complex.task.tree</field>
        <field name="model">sale.task.generator.complex.task</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <!-- Vista principal del wizard -->
    <record id="view_task_generator_wizard_form" model="ir.ui.view">
        <field name="name">sale.task.generator.wizard.form</field>
        <field name="model">sale.task.generator.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Tareas">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="project_id" required="1"/>
                    <field name="template_id"/>
                    <field name="validity_date"/>
                </group>
                <notebook>
                    <page string="Tareas Simples">
                        <field name="simple_task_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="date_deadline"/>
                            </list>
                        </field>
                    </page>
                    <page string="Tareas Complejas">
                        <field name="complex_task_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="date_deadline"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_generate_tasks" 
                            string="Generar Tareas" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_task_generator_wizard" model="ir.actions.act_window">
        <field name="name">Generador de Tareas</field>
        <field name="res_model">sale.task.generator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo> 