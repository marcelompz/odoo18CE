<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Configuración de categoría propia -->
    <record id="module_category_pagopar" model="ir.module.category">
        <field name="name">Pagopar</field>
        <field name="description">Categoría para configuración Pagopar</field>
        <field name="sequence">100</field>
    </record>
    
    <!-- Grupos de seguridad -->
    <record id="group_pagopar_user" model="res.groups">
        <field name="name">Pagopar User</field>
        <field name="category_id" ref="module_category_pagopar"/>
        <field name="comment">Usuarios que pueden ver configuraciones básicas de Pagopar</field>
    </record>
    
    <record id="group_pagopar_manager" model="res.groups">
        <field name="name">Pagopar Manager</field>
        <field name="category_id" ref="module_category_pagopar"/>
        <field name="comment">Usuarios que pueden gestionar la configuración completa de Pagopar</field>
        <!-- Pagopar Manager inherits all Pagopar User rights -->
        <field name="implied_ids" eval="[(4, ref('pagopar_integration.group_pagopar_user'))]"/>
    </record>
    
    <!-- Regla para acceso a configuración API solo por administradores del sistema -->
    <record id="pagopar_api_admin_rule" model="ir.rule">
        <field name="name">Pagopar API: Solo Administradores</field>
        <field name="model_id" ref="model_pagopar_api"/>
        <field name="domain_force">[('id', '>=', 0)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Regla para lectura básica por usuarios Pagopar -->
    <record id="pagopar_api_user_rule" model="ir.rule">
        <field name="name">Pagopar API: Lectura Usuarios</field>
        <field name="model_id" ref="model_pagopar_api"/>
        <field name="domain_force">[('id', '>=', 0)]</field>
        <field name="groups" eval="[(4, ref('pagopar_integration.group_pagopar_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
</odoo> 