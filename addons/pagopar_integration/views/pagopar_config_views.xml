<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Menú principal de Pagopar -->
    <menuitem id="menu_pagopar_main"
              name="Pagopar"
              sequence="60"
              groups="pagopar_integration.group_pagopar_user,pagopar_integration.group_pagopar_manager"
              web_icon="pagopar_integration,static/description/icon.png"/>
    
    <!-- Vista formulario para configuración Pagopar -->
    <record id="pagopar_config_form_view" model="ir.ui.view">
        <field name="name">pagopar.config.form</field>
        <field name="model">pagopar.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Pagopar">
                <header>
                    <button name="action_test_configuration" 
                            string="Probar Configuración" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_view_payment_stats" 
                            string="Ver Estadísticas" 
                            type="object" 
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de configuración"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Configuración API" name="api_config">
                            <group>
                                <group string="Timeouts y Reintentos">
                                    <field name="api_timeout"/>
                                    <field name="max_retries"/>
                                    <field name="retry_delay"/>
                                </group>
                                <group string="Configuración de Orden">
                                    <field name="order_expiration_hours"/>
                                    <field name="auto_confirm_payments"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Logging y Monitoreo" name="logging">
                            <group>
                                <group string="Configuración de Logs">
                                    <field name="enable_detailed_logging"/>
                                    <field name="log_api_requests"/>
                                    <field name="log_webhook_notifications"/>
                                </group>
                                <group string="Estadísticas">
                                                            <field name="last_webhook_received" readonly="True"/>
                        <field name="webhook_count_today" readonly="True"/>
                        <field name="successful_payments_today" readonly="True"/>
                        <field name="failed_payments_today" readonly="True"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Seguridad" name="security">
                            <group>
                                <group string="Validación de Webhooks">
                                    <field name="webhook_signature_validation"/>
                                    <field name="validate_webhook_ip"/>
                                </group>
                                <group string="IPs Permitidas" 
                                       invisible="not validate_webhook_ip">
                                    <field name="allowed_webhook_ips" 
                                           nolabel="1" 
                                           placeholder="192.168.1.1&#10;10.0.0.1&#10;..."
                                           widget="text"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Notificaciones" name="notifications">
                            <group>
                                <group string="Email">
                                    <field name="send_email_notifications"/>
                                    <field name="notification_email_template_id" 
                                           invisible="not send_email_notifications"/>
                                </group>
                                <group string="Moneda">
                                    <field name="default_currency_id"/>
                                    <field name="amount_precision"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vista lista para configuración Pagopar -->
    <record id="pagopar_config_list_view" model="ir.ui.view">
        <field name="name">pagopar.config.list</field>
        <field name="model">pagopar.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones Pagopar">
                <field name="name"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="api_timeout"/>
                <field name="webhook_signature_validation"/>
                <field name="successful_payments_today"/>
                <field name="failed_payments_today"/>
                <field name="last_webhook_received"/>
            </list>
        </field>
    </record>
    
    <!-- Vista de búsqueda para configuración Pagopar -->
    <record id="pagopar_config_search_view" model="ir.ui.view">
        <field name="name">pagopar.config.search</field>
        <field name="model">pagopar.config</field>
        <field name="arch" type="xml">
            <search string="Buscar Configuraciones Pagopar">
                <field name="name"/>
                <field name="company_id"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empresa" name="group_company" domain="[]" 
                            context="{'group_by': 'company_id'}" 
                            groups="base.group_multi_company"/>
                    <filter string="Estado" name="group_active" domain="[]" 
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Acción para configuración Pagopar -->
    <record id="action_pagopar_config" model="ir.actions.act_window">
        <field name="name">Configuración Avanzada Pagopar</field>
        <field name="res_model">pagopar.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva configuración de Pagopar
            </p>
            <p>
                Configure parámetros avanzados como timeouts, logging, 
                seguridad y notificaciones para la integración con Pagopar.
            </p>
        </field>
    </record>
    
    <!-- Menú para configuración avanzada -->
    <menuitem id="menu_pagopar_config"
              name="Configuración Avanzada"
              parent="menu_pagopar_main"
              action="action_pagopar_config"
              sequence="30"/>
    
</odoo> 