<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template para formulario de redirección de Pagopar -->
    <template id="redirect_form_pagopar" name="Pagopar: Redirect Form">
        <div class="text-center">
            <h4><i class="fa fa-spinner fa-spin text-primary"/> Conectando con Pagopar...</h4>
            <p class="text-muted">Será redirigido automáticamente al portal de pagos seguro de Pagopar.</p>
        </div>

        <form name="pagopar_redirect_form" id="pagopar_redirect_form" t-att-action="pagopar_payment_url" method="GET" target="_self">
            <!-- This form will be automatically submitted -->
        </form>

        <script type="text/javascript">
            (function() {
                var paymentUrl = '<t t-esc="pagopar_payment_url"/>';
                if (paymentUrl &amp;&amp; paymentUrl !== 'False' &amp;&amp; paymentUrl !== '') {
                    // Set a small delay to let the page render the loading message
                    setTimeout(function() {
                        window.location.href = paymentUrl;
                    }, 1000);
                } else {
                    // If no URL, show error
                    setTimeout(function() {
                        document.querySelector('.text-center').innerHTML = '<div class="alert alert-danger"><h4>Error</h4><p>No se pudo generar la URL de pago. Por favor, intente nuevamente.</p></div>';
                    }, 2000);
                }
            })();
        </script>
    </template>

    <!-- Template para pago exitoso -->
    <template id="payment_success" name="Pago Exitoso - Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card border-success mt-5">
                                <div class="card-header bg-success text-white text-center">
                                    <h3><i class="fa fa-check-circle"/> Pago Exitoso</h3>
                                </div>
                                <div class="card-body text-center">
                                    <div class="alert alert-success" role="alert">
                                        <h4>¡Su pago ha sido procesado correctamente!</h4>
                                        <p>Gracias por utilizar Pagopar para procesar su pago.</p>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-md-6">
                                            <strong>Referencia:</strong>
                                            <p t-esc="transaction.reference"/>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Monto:</strong>
                                            <p><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></p>
                                        </div>
                                    </div>

                                    <div class="row" t-if="transaction.pagopar_payment_method">
                                        <div class="col-md-6">
                                            <strong>Método de Pago:</strong>
                                            <p t-esc="transaction.pagopar_payment_method"/>
                                        </div>
                                        <div class="col-md-6" t-if="transaction.pagopar_paid_at">
                                            <strong>Fecha de Pago:</strong>
                                            <p t-esc="transaction.pagopar_paid_at"/>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <a href="/" class="btn btn-primary">Volver al Inicio</a>
                                        <a href="/my/orders" class="btn btn-secondary" t-if="request.env.user != request.env.ref('base.public_user')">Ver Mis Pedidos</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template para pago pendiente -->
    <template id="payment_pending" name="Pago Pendiente - Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card border-warning mt-5">
                                <div class="card-header bg-warning text-white text-center">
                                    <h3><i class="fa fa-clock-o"/> Pago Pendiente</h3>
                                </div>
                                <div class="card-body text-center">
                                    <div class="alert alert-warning" role="alert">
                                        <h4>Su pago está siendo procesado</h4>
                                        <p>Pagopar está verificando su pago. Le notificaremos por email una vez confirmado.</p>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-md-6">
                                            <strong>Referencia:</strong>
                                            <p t-esc="transaction.reference"/>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Monto:</strong>
                                            <p><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></p>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button class="btn btn-info" onclick="checkPaymentStatus()">
                                            <i class="fa fa-refresh"/> Verificar Estado
                                        </button>
                                        <a href="/" class="btn btn-secondary">Volver al Inicio</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function checkPaymentStatus() {
                    var orderId = '<t t-esc="transaction.pagopar_order_id"/>';
                    if (orderId) {
                        $.ajax({
                            url: '/payment/pagopar/validate',
                            type: 'POST',
                            dataType: 'json',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                jsonrpc: '2.0',
                                method: 'call',
                                params: {order_id: orderId}
                            }),
                            success: function(result) {
                                if (result.result.success) {
                                    if (result.result.status === 'done') {
                                        location.reload();
                                    } else {
                                        alert('El pago aún está pendiente. Intente nuevamente en unos minutos.');
                                    }
                                } else {
                                    alert('Error al verificar el estado: ' + result.result.error);
                                }
                            },
                            error: function() {
                                alert('Error de conexión al verificar el estado del pago.');
                            }
                        });
                    }
                }
            </script>
        </t>
    </template>

    <!-- Template para error de pago -->
    <template id="payment_error" name="Error de Pago - Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card border-danger mt-5">
                                <div class="card-header bg-danger text-white text-center">
                                    <h3><i class="fa fa-times-circle"/> Error de Pago</h3>
                                </div>
                                <div class="card-body text-center">
                                    <div class="alert alert-danger" role="alert">
                                        <h4>Hubo un problema con su pago</h4>
                                        <p t-if="error_message" t-esc="error_message"/>
                                        <p t-else="">Su pago no pudo ser procesado. Por favor, intente nuevamente.</p>
                                    </div>

                                    <div class="row mt-4" t-if="transaction">
                                        <div class="col-md-6">
                                            <strong>Referencia:</strong>
                                            <p t-esc="transaction.reference"/>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Monto:</strong>
                                            <p><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></p>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <a href="/shop/cart" class="btn btn-primary" t-if="request.env.user != request.env.ref('base.public_user')">
                                            <i class="fa fa-shopping-cart"/> Intentar Nuevamente
                                        </a>
                                        <a href="/" class="btn btn-secondary">Volver al Inicio</a>
                                        <a href="/contactus" class="btn btn-info">Contactar Soporte</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template para pago cancelado -->
    <template id="payment_cancelled" name="Pago Cancelado - Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="card border-secondary mt-5">
                                <div class="card-header bg-secondary text-white text-center">
                                    <h3><i class="fa fa-times"/> Pago Cancelado</h3>
                                </div>
                                <div class="card-body text-center">
                                    <div class="alert alert-secondary" role="alert">
                                        <h4>Su pago ha sido cancelado</h4>
                                        <p>El proceso de pago fue cancelado. Puede intentar nuevamente cuando guste.</p>
                                    </div>

                                    <div class="row mt-4" t-if="transaction">
                                        <div class="col-md-6">
                                            <strong>Referencia:</strong>
                                            <p t-esc="transaction.reference"/>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Monto:</strong>
                                            <p><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></p>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <a href="/shop/cart" class="btn btn-primary" t-if="request.env.user != request.env.ref('base.public_user')">
                                            <i class="fa fa-shopping-cart"/> Intentar Nuevamente
                                        </a>
                                        <a href="/" class="btn btn-secondary">Volver al Inicio</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Template para formulario de pago de transacción -->
    <template id="transaction_payment_form" name="Formulario de Pago - Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card mt-5">
                                <div class="card-header bg-primary text-white text-center">
                                    <h3><i class="fa fa-credit-card"/> Pagar con Pagopar</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h5>Resumen del Pago</h5>
                                            <table class="table table-sm">
                                                <tr>
                                                    <th>Referencia:</th>
                                                    <td t-esc="transaction.reference"/>
                                                </tr>
                                                <tr>
                                                    <th>Monto:</th>
                                                    <td><strong><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></strong></td>
                                                </tr>
                                                <tr t-if="transaction.partner_id">
                                                    <th>Cliente:</th>
                                                    <td t-esc="transaction.partner_id.name"/>
                                                </tr>
                                                <tr>
                                                    <th>Estado:</th>
                                                    <td>
                                                        <span t-if="transaction.state == 'pending'" class="badge badge-warning">Pendiente</span>
                                                        <span t-elif="transaction.state == 'done'" class="badge badge-success">Completado</span>
                                                        <span t-elif="transaction.state == 'cancel'" class="badge badge-secondary">Cancelado</span>
                                                        <span t-else="" class="badge badge-info" t-esc="transaction.state"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>

                                        <div class="col-md-6">
                                            <h5>Métodos de Pago Disponibles</h5>
                                            <div class="payment-methods">
                                                <div class="payment-method mb-3" t-if="provider.pagopar_allow_credit_cards">
                                                    <i class="fa fa-credit-card text-primary"/> Tarjetas de Crédito
                                                </div>
                                                <div class="payment-method mb-3" t-if="provider.pagopar_allow_debit_cards">
                                                    <i class="fa fa-credit-card-alt text-success"/> Tarjetas de Débito
                                                </div>
                                                <div class="payment-method mb-3" t-if="provider.pagopar_allow_bank_transfer">
                                                    <i class="fa fa-bank text-info"/> Transferencia Bancaria
                                                </div>
                                                <div class="payment-method mb-3" t-if="provider.pagopar_allow_cash_payment">
                                                    <i class="fa fa-money text-warning"/> Pago en Efectivo
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-12 text-center">
                                            <button class="btn btn-primary btn-lg" onclick="processPaygoparPayment()">
                                                <i class="fa fa-lock"/> Proceder al Pago Seguro
                                            </button>
                                            <div class="mt-2">
                                                <small class="text-muted">
                                                    <i class="fa fa-shield"/> Procesado de forma segura por Pagopar
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function processPaygoparPayment() {
                    // Redirigir al formulario de pago de Pagopar
                    window.location.href = '/payment/pagopar/payment_form?tx_id=<t t-esc="transaction.id"/>';
                }
            </script>
        </t>
    </template>

    <!-- Template para lista de pagos en portal del cliente -->
    <template id="portal_my_payments" name="Mis Pagos - Portal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mis Pagos</t>
            </t>

            <div class="o_portal_docs">
                <!-- Filtros -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="btn-group" role="group">
                            <t t-foreach="filter_options.items()" t-as="filter_item">
                                <a t-att-href="default_url + '?filterby=' + filter_item[0]"
                                   t-att-class="'btn btn-outline-secondary' + (' active' if filterby == filter_item[0] else '')"
                                   t-esc="filter_item[1]['label']"/>
                            </t>
                        </div>
                    </div>
                    <div class="col-md-6 text-right">
                        <div class="btn-group" role="group">
                            <t t-foreach="sort_options.items()" t-as="sort_item">
                                <a t-att-href="default_url + '?sortby=' + sort_item[0]"
                                   t-att-class="'btn btn-outline-secondary btn-sm' + (' active' if sortby == sort_item[0] else '')"
                                   t-esc="sort_item[0].title()"/>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Lista de transacciones -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Referencia</th>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not transactions">
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        <i class="fa fa-credit-card fa-3x mb-3"/>
                                        <br/>No hay pagos registrados
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="transactions" t-as="transaction">
                                <tr>
                                    <td>
                                        <a t-att-href="'/my/payment/' + str(transaction.id)"
                                           class="text-decoration-none">
                                            <strong t-esc="transaction.reference"/>
                                        </a>
                                    </td>
                                    <td t-esc="transaction.create_date.strftime('%d/%m/%Y')"/>
                                    <td>
                                        <strong><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></strong>
                                    </td>
                                    <td t-esc="transaction.pagopar_payment_method or '-'"/>
                                    <td>
                                        <span t-if="transaction.state == 'pending'" class="badge badge-warning">Pendiente</span>
                                        <span t-elif="transaction.state == 'done'" class="badge badge-success">Completado</span>
                                        <span t-elif="transaction.state == 'cancel'" class="badge badge-secondary">Cancelado</span>
                                        <span t-else="" class="badge badge-info" t-esc="transaction.state"/>
                                    </td>
                                    <td>
                                        <a t-att-href="'/my/payment/' + str(transaction.id)"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-eye"/> Ver
                                        </a>
                                        <a t-if="transaction.state == 'pending'"
                                           t-att-href="'/payment/pagopar/pay/' + str(transaction.id)"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-credit-card"/> Pagar
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!-- Template para detalle de pago en portal del cliente -->
    <template id="portal_payment_detail" name="Detalle de Pago - Portal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="container">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="card">
                            <div class="card-header">
                                <h4><i class="fa fa-credit-card"/> Detalle del Pago</h4>
                                <div class="float-right">
                                    <span t-if="transaction.state == 'pending'" class="badge badge-warning badge-lg">Pendiente</span>
                                    <span t-elif="transaction.state == 'done'" class="badge badge-success badge-lg">Completado</span>
                                    <span t-elif="transaction.state == 'cancel'" class="badge badge-secondary badge-lg">Cancelado</span>
                                    <span t-else="" class="badge badge-info badge-lg" t-esc="transaction.state"/>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6>Información del Pago</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Referencia:</th>
                                                <td t-esc="transaction.reference"/>
                                            </tr>
                                            <tr>
                                                <th>Monto:</th>
                                                <td><strong><span t-esc="transaction.amount"/> <span t-esc="transaction.currency_id.name"/></strong></td>
                                            </tr>
                                            <tr>
                                                <th>Fecha de Creación:</th>
                                                <td t-esc="transaction.create_date.strftime('%d/%m/%Y %H:%M')"/>
                                            </tr>
                                            <tr t-if="transaction.pagopar_paid_at">
                                                <th>Fecha de Pago:</th>
                                                <td t-esc="transaction.pagopar_paid_at"/>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h6>Detalles de Pagopar</h6>
                                        <table class="table table-sm">
                                            <tr t-if="transaction.pagopar_order_id">
                                                <th>ID de Orden Pagopar:</th>
                                                <td t-esc="transaction.pagopar_order_id"/>
                                            </tr>
                                            <tr t-if="transaction.pagopar_payment_method">
                                                <th>Método de Pago:</th>
                                                <td t-esc="transaction.pagopar_payment_method"/>
                                            </tr>
                                            <tr>
                                                <th>Proveedor:</th>
                                                <td>Pagopar</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-12">
                                        <div class="btn-group">
                                            <a href="/my/payments" class="btn btn-secondary">
                                                <i class="fa fa-arrow-left"/> Volver a Mis Pagos
                                            </a>
                                            <a t-if="transaction.state == 'pending'"
                                               t-att-href="'/payment/pagopar/pay/' + str(transaction.id)"
                                               class="btn btn-primary">
                                                <i class="fa fa-credit-card"/> Completar Pago
                                            </a>
                                            <button t-if="transaction.pagopar_order_id and transaction.state == 'pending'"
                                                    class="btn btn-info"
                                                    onclick="checkPaymentStatus()">
                                                <i class="fa fa-refresh"/> Verificar Estado
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script t-if="transaction.pagopar_order_id and transaction.state == 'pending'">
                function checkPaymentStatus() {
                    var orderId = '<t t-esc="transaction.pagopar_order_id"/>';
                    if (orderId) {
                        $.ajax({
                            url: '/payment/pagopar/validate',
                            type: 'POST',
                            dataType: 'json',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                jsonrpc: '2.0',
                                method: 'call',
                                params: {order_id: orderId}
                            }),
                            success: function(result) {
                                if (result.result.success) {
                                    if (result.result.status === 'done') {
                                        location.reload();
                                    } else {
                                        alert('El pago aún está pendiente. Intente nuevamente en unos minutos.');
                                    }
                                } else {
                                    alert('Error al verificar el estado: ' + result.result.error);
                                }
                            },
                            error: function() {
                                alert('Error de conexión al verificar el estado del pago.');
                            }
                        });
                    }
                }
            </script>
        </t>
    </template>

    <!-- Extensión del menú del portal para agregar enlace a pagos -->
    <template id="portal_my_account_menu_pagopar" name="Portal layout : Pagopar menu entry" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'payments'" class="breadcrumb-item active">
                <span>Mis Pagos</span>
            </li>
            <li t-elif="page_name == 'payment_detail'" class="breadcrumb-item active">
                <span>Detalle de Pago</span>
            </li>
        </xpath>
    </template>

    <!-- Agregar enlace a pagos en el portal principal -->
    <template id="portal_my_home_menu_pagopar" name="Portal my home : Pagopar entry" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa-credit-card'"/>
                <t t-set="title">Mis Pagos</t>
                <t t-set="url" t-value="'/my/payments'"/>
                <t t-set="text">Ver el historial de pagos realizados con Pagopar</t>
                <t t-set="count" t-value="pagopar_payment_count"/>
            </t>
        </xpath>
    </template>

    <!-- Widget de pago rápido para ecommerce -->
    <template id="pagopar_payment_widget" name="Widget de Pago Pagopar">
        <div class="pagopar-payment-widget">
            <div class="payment-option" data-provider="pagopar">
                <div class="payment-provider-header">
                    <img src="/pagopar_integration/static/src/img/pagopar-logo.png" alt="Pagopar" class="payment-logo"/>
                    <span class="payment-name">Pagopar</span>
                </div>
                <div class="payment-description">
                    <p>Paga de forma segura con tarjetas, transferencias bancarias o efectivo.</p>
                    <div class="payment-methods-icons">
                        <i class="fa fa-credit-card" title="Tarjetas de Crédito"/>
                        <i class="fa fa-credit-card-alt" title="Tarjetas de Débito"/>
                        <i class="fa fa-bank" title="Transferencias"/>
                        <i class="fa fa-money" title="Efectivo"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Template para página de checkout personalizada -->
    <template id="pagopar_checkout_page" name="Checkout con Pagopar">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-header">
                                    <h4><i class="fa fa-shopping-cart"/> Finalizar Compra</h4>
                                </div>
                                <div class="card-body">
                                    <!-- Resumen del pedido -->
                                    <div class="order-summary mb-4">
                                        <h5>Resumen del Pedido</h5>
                                        <div class="table-responsive">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th>Cantidad</th>
                                                        <th>Precio</th>
                                                        <th>Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="order.order_line" t-as="line">
                                                        <tr>
                                                            <td t-esc="line.product_id.name"/>
                                                            <td t-esc="line.product_uom_qty"/>
                                                            <td t-esc="line.price_unit"/>
                                                            <td t-esc="line.price_subtotal"/>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                                <tfoot>
                                                    <tr class="font-weight-bold">
                                                        <td colspan="3">Total:</td>
                                                        <td t-esc="order.amount_total"/>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Selección de método de pago -->
                                    <div class="payment-selection">
                                        <h5>Método de Pago</h5>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="payment_method" id="pagopar_payment" value="pagopar" checked="checked"/>
                                            <label class="form-check-label" for="pagopar_payment">
                                                <img src="/pagopar_integration/static/src/img/pagopar-logo.png" alt="Pagopar" style="height: 30px; margin-right: 10px;"/>
                                                Pagar con Pagopar
                                            </label>
                                        </div>
                                        <div class="payment-info mt-2 ml-4">
                                            <small class="text-muted">
                                                <i class="fa fa-shield"/> Pago seguro procesado por Pagopar<br/>
                                                <i class="fa fa-credit-card"/> Acepta tarjetas, transferencias y efectivo
                                            </small>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button class="btn btn-primary btn-lg btn-block" onclick="processPagoparOrder()">
                                            <i class="fa fa-lock"/> Proceder al Pago Seguro
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Información de Entrega</h5>
                                </div>
                                <div class="card-body">
                                    <address t-if="order.partner_shipping_id">
                                        <strong t-esc="order.partner_shipping_id.name"/><br/>
                                        <span t-esc="order.partner_shipping_id.street"/><br/>
                                        <span t-if="order.partner_shipping_id.street2" t-esc="order.partner_shipping_id.street2"/><br/>
                                        <span t-esc="order.partner_shipping_id.city"/>, <span t-esc="order.partner_shipping_id.state_id.name"/><br/>
                                        <span t-esc="order.partner_shipping_id.country_id.name"/>
                                    </address>
                                </div>
                            </div>

                            <div class="card mt-3">
                                <div class="card-header">
                                    <h5>Seguridad del Pago</h5>
                                </div>
                                <div class="card-body">
                                    <div class="security-features">
                                        <div class="feature mb-2">
                                            <i class="fa fa-shield text-success"/> Encriptación SSL
                                        </div>
                                        <div class="feature mb-2">
                                            <i class="fa fa-lock text-success"/> Datos protegidos
                                        </div>
                                        <div class="feature mb-2">
                                            <i class="fa fa-check text-success"/> Certificado PCI DSS
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function processPagoparOrder() {
                    // Crear transacción de pago
                    $.ajax({
                        url: '/shop/payment/transaction',
                        type: 'POST',
                        data: {
                            'provider_id': '<t t-esc="pagopar_provider.id"/>',
                            'payment_method': 'pagopar',
                            'csrf_token': $('input[name="csrf_token"]').val()
                        },
                        success: function(result) {
                            if (result.success &amp;&amp; result.transaction_id) {
                                window.location.href = '/payment/pagopar/payment_form?tx_id=' + result.transaction_id;
                            } else {
                                alert('Error al crear la transacción de pago');
                            }
                        },
                        error: function() {
                            alert('Error de conexión al procesar el pago');
                        }
                    });
                }
            </script>
        </t>
    </template>

</odoo>
