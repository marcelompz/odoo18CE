<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para el proveedor de pagos Pagopar -->
    <record id="payment_provider_form_pagopar" model="ir.ui.view">
        <field name="name">payment.provider form (pagopar)</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_published"
                       widget="boolean_toggle"
                       string="Published on Website"
                       invisible="code != 'pagopar'"
                       help="Publicar en sitio web"/>
            </xpath>

            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group name="pagopar_api_credentials" string="Credenciales de API Pagopar" invisible="code != 'pagopar'">
                    <field name="pagopar_environment" widget="radio" options="{'horizontal': true}"/>
                    <field name="pagopar_token_privado" password="True" placeholder="ej: tu_token_privado"/>
                    <field name="pagopar_token_publico" placeholder="ej: tu_token_publico"/>
                    <field name="pagopar_comercio_id" placeholder="ID de comercio (opcional)"/>
                </group>

                <group name="pagopar_integration_urls" string="URLs de Integración" invisible="code != 'pagopar'">
                    <field name="pagopar_webhook_url"
                           string="URL de Webhook"
                           readonly="True"
                           widget="url"
                           help="Configure esta URL en su panel de Pagopar para recibir notificaciones"/>
                    <field name="pagopar_return_url"
                           string="URL de Retorno"
                           readonly="True"
                           widget="url"
                           help="URL donde Pagopar redirigirá al usuario después del pago"/>
                </group>

                <group name="pagopar_credential_actions" invisible="code != 'pagopar'" col="1">
                    <div class="row">
                        <div class="col-12">
                            <button name="action_test_pagopar_connection"
                                    type="object"
                                    class="btn btn-primary"
                                    invisible="not pagopar_token_privado">
                                <i class="fa fa-plug"/> Probar Conexión
                            </button>
                        </div>
                    </div>
                </group>
            </xpath>

            <xpath expr="//group[@name='provider_config']" position="inside">
                <group string="Opciones de Pago Pagopar" invisible="code != 'pagopar'">
                    <field name="pagopar_allow_cash_payment"
                           string="Permitir Pagos en Efectivo"
                           help="Habilita opciones de pago en efectivo a través de Pagopar"/>
                </group>

                <group string="Métodos de Pago Disponibles" invisible="code != 'pagopar'">
                    <field name="available_payment_method_ids"
                           widget="many2many_tags"
                           readonly="1"
                           string="Métodos Configurados"
                           help="Métodos de pago configurados para este proveedor"/>
                </group>

                <group name="pagopar_config_actions" invisible="code != 'pagopar'" col="1">
                    <div class="row">
                        <div class="col-md-4">
                            <button name="obtener_formas_pago"
                                    type="object"
                                    class="btn btn-info"
                                    invisible="not pagopar_token_privado">
                                <i class="fa fa-list"/> Obtener Formas de Pago
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button name="action_fix_pagopar_payment_method"
                                    type="object"
                                    class="btn btn-warning">
                                <i class="fa fa-wrench"/> Reparar Método de Pago
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button name="action_debug_payment_methods"
                                    type="object"
                                    class="btn btn-secondary">
                                <i class="fa fa-bug"/> Debug Métodos
                            </button>
                        </div>
                    </div>
                </group>
            </xpath>

            <xpath expr="//notebook" position="after">
                <div invisible="code != 'pagopar'">

                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-info" role="alert">
                                <h5><i class="fa fa-info-circle"/> Configuración de Pagopar</h5>
                                <p>Configure sus credenciales de Pagopar para procesar pagos en Paraguay.</p>
                                <p><strong>Requerido:</strong> Token Privado y Token Público obtenidos desde su panel de Pagopar.</p>
                                <p><strong>Documentación:</strong> Consulte la documentación oficial de Pagopar para obtener sus credenciales.</p>
                            </div>
                        </div>
                    </div>

                    <div class="row" invisible="state == 'disabled'">
                        <div class="col-12">
                            <div class="alert alert-warning" role="alert" invisible="state != 'test'">
                                <i class="fa fa-exclamation-triangle" title="Advertencia"/> <strong>Modo de Prueba:</strong>
                                Las transacciones se procesarán en el entorno sandbox de Pagopar.
                            </div>
                            <div class="alert alert-success" role="alert" invisible="state != 'enabled'">
                                <i class="fa fa-check-circle" title="Éxito"/> <strong>Modo Producción:</strong>
                                Las transacciones se procesarán en el entorno real de Pagopar.
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="alert alert-light" role="alert">
                                <h6><i class="fa fa-cog" title="Configuración"/> Pasos de Configuración:</h6>
                                <ol>
                                    <li>Vaya a la pestaña <strong>"Credentials"</strong> y configure:</li>
                                    <ul>
                                        <li>Seleccione el entorno (Sandbox para pruebas, Producción para uso real)</li>
                                        <li>Ingrese el <strong>Token Privado</strong> y <strong>Token Público</strong> (requeridos)</li>
                                        <li>Opcionalmente, añada el <strong>ID de Comercio</strong> para referencia interna</li>
                                        <li>Use <strong>Probar Conexión</strong> para verificar la configuración</li>
                                    </ul>
                                    <li>En la pestaña <strong>"Configuration"</strong> configure las opciones de pago</li>
                                    <li>Configure las URLs mostradas en su panel de Pagopar</li>
                                    <li>Active el proveedor cuando esté listo</li>
                                </ol>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>

</odoo>
