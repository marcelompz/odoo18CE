<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Configuración de demostración -->
        <record id="pagopar_config_demo" model="pagopar.config">
            <field name="name">Demo - Pagopar Paraguay</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">False</field>
            <field name="api_timeout">30</field>
            <field name="max_retries">2</field>
            <field name="retry_delay">3</field>
            <field name="enable_detailed_logging">True</field>
            <field name="log_api_requests">True</field>
            <field name="log_webhook_notifications">True</field>
            <field name="send_email_notifications">True</field>
            <field name="validate_webhook_ip">False</field>
            <field name="webhook_signature_validation">True</field>
            <field name="amount_precision">2</field>
            <field name="order_expiration_hours">12</field>
            <field name="auto_confirm_payments">True</field>
        </record>
        
        <!-- Proveedor de Pagopar en modo demo -->
        <record id="payment_provider_pagopar_demo" model="payment.provider">
            <field name="name">Pagopar Demo</field>
            <field name="code">pagopar</field>
            <field name="state">test</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">5</field>
            <field name="pagopar_environment">sandbox</field>
            <field name="pagopar_base_url">https://sandbox-api.pagopar.com</field>
            <field name="pagopar_api_key">pk_test_1234567890abcdef</field>
            <field name="pagopar_secret_key">sk_test_abcdef1234567890</field>
            <field name="pagopar_allow_credit_cards">True</field>
            <field name="pagopar_allow_debit_cards">True</field>
            <field name="pagopar_allow_bank_transfer">True</field>
            <field name="pagopar_allow_cash_payment">True</field>
        </record>
        
        <!-- Configuración de API Demo -->
        <record id="pagopar_api_demo" model="pagopar.api">
            <field name="name">API Demo - Pagopar</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">False</field>
            <field name="api_key">pk_test_demo_1234567890abcdef</field>
            <field name="secret_key">sk_test_demo_abcdef1234567890</field>
            <field name="base_url">https://sandbox-api.pagopar.com</field>
            <field name="environment">sandbox</field>
        </record>
        
        <!-- Transacciones de demostración -->
        <record id="payment_transaction_pagopar_demo_1" model="payment.transaction">
            <field name="reference">DEMO-PAY-001</field>
            <field name="provider_id" ref="payment_provider_pagopar_demo"/>
            <field name="provider_code">pagopar</field>
            <field name="amount">150000</field>
            <field name="currency_id" eval="ref('base.main_company').currency_id.id"/>
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="state">done</field>
            <field name="pagopar_order_id">demo_order_001</field>
            <field name="pagopar_payment_method">credit_card</field>
            <field name="pagopar_paid_at" eval="(datetime.datetime.now() - datetime.timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        
        <record id="payment_transaction_pagopar_demo_2" model="payment.transaction">
            <field name="reference">DEMO-PAY-002</field>
            <field name="provider_id" ref="payment_provider_pagopar_demo"/>
            <field name="provider_code">pagopar</field>
            <field name="amount">75000</field>
            <field name="currency_id" eval="ref('base.main_company').currency_id.id"/>
            <field name="partner_id" ref="base.res_partner_3"/>
            <field name="state">pending</field>
            <field name="pagopar_order_id">demo_order_002</field>
            <field name="pagopar_payment_method">bank_transfer</field>
        </record>
        
        <record id="payment_transaction_pagopar_demo_3" model="payment.transaction">
            <field name="reference">DEMO-PAY-003</field>
            <field name="provider_id" ref="payment_provider_pagopar_demo"/>
            <field name="provider_code">pagopar</field>
            <field name="amount">250000</field>
            <field name="currency_id" eval="ref('base.main_company').currency_id.id"/>
            <field name="partner_id" ref="base.res_partner_4"/>
            <field name="state">error</field>
            <field name="pagopar_order_id">demo_order_003</field>
            <field name="pagopar_payment_method">debit_card</field>
        </record>
        
    </data>
</odoo> 