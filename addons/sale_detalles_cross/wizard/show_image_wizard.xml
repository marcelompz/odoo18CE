<odoo>

    <!-- form view -->

    <record id="show_image_wizard_form" model="ir.ui.view">
        <field name="name">show.image.wizard.form</field>
        <field name="model">show.image.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="text-center" options="{'size': [800, 800]}" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
