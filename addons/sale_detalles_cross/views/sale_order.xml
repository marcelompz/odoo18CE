<odoo>

    <!-- form view -->

    <record id="sale_order_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_detalles.view_order_form_inherit" />
        <field name="arch" type="xml">

            <xpath expr="//notebook//page[@name='model_lines']//field[@name='model_line_ids']//list//field[@name='image']" position="after">
                <button name="open_image_view" type="object" string="Maximizar imagen" icon="fa-window-restore" class="oe_link"/>
            </xpath>

            <xpath expr="//notebook//page[@name='technical_info']//field[@name='technical_info_ids']//list//field[@name='answer']" position="after">
                <field name="primary_color"/>
                <field name="secundary_color"/>
                <field name="note"/>
            </xpath>
        
        </field>
    </record>

</odoo>
