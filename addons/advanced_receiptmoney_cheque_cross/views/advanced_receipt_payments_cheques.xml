<odoo>

    <!-- form view -->

    <record id="advanced_receipt_payments_cheques_form" model="ir.ui.view">
        <field name="name">advanced.receipt.payments.cheque.form</field>
        <field name="model">advanced.receipt.payments</field>
        <field name="inherit_id" ref="advanced_receiptmoney_cross.advanced_receipt_payments_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_ids']" position="after">
                <h2 class="text-center">Detalles de cheques</h2>
                <field name="customer_cheques_domain" invisible="1"/>
                <field name="cheque_ids" domain="customer_cheques_domain" readonly="state in ['done','canceled']">
                    <list>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="payment_date"/>
                        <field name="name"/>
                        <field name="reference"/>
                        <field name="journal_id"/>
                        <field name="partner_id"/>
                        <field name="cheque_nro" optional="hide"/>
                        <field name="currency_cheque_id" column_invisible="1"/>
                        <field name="payment_cheque_amount" widget="monetary"/>
                        <field name="payment_amount" sum="Total"/>
                        <field name="state" widget="badge" decoration-it="state == 'draft'" decoration-info="state == 'registered'" decoration-warning="state == 'deposited'" decoration-danger="state in ['returned', 'bounced']" decoration-success="state in ['done', 'paid']"/>
                    </list>
                </field>
            </xpath>
  
        </field>
    </record>

</odoo>
