<odoo>

    <template id="report_advanced_receipt_payments_document_inherit" inherit_id="advanced_receiptmoney_cross.report_advanced_receipt_payments_document">
        <xpath expr="//t[@id='payment_details']" position="after">
            <t t-if="len(doc.cheque_ids) > 0">
                <strong>DETALLES DE CHEQUES</strong>
                <table class="table table-sm" style="font-size:10px">
                    <thead>
                        <tr>
                            <th class="text-start">FECHA</th>
                            <th>NUMERO</th>
                            <th>LIBRADOR</th>
                            <th>DIARIO</th>
                            <th>BANCO</th>
                            <th>VENCIMIENTO</th>
                            <th class="text-end">MONTO</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.cheque_ids" t-as="line">
                            <td class="text-start">
                                <span t-field="line.payment_date"></span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.cheque_nro"></span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.reference"></span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.journal_id.name"></span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.bank_id.name"></span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.due_date"></span>
                            </td>
                            <td class="text-end">
                                <span t-field="line.payment_amount" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    
    </template>

</odoo>
