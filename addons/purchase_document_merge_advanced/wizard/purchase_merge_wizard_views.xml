<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_merge_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.merge.wizard.view.form</field>
        <field name="model">purchase.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Fusionar Documentos">
                <sheet>
                    <group>
                        <field name="document_type" invisible="1"/>
                        <field name="partner_id"/>
                    </group>
                    <group string="Selección de Documentos">
                        <field name="purchase_ids" widget="many2many_tags" invisible="document_type != 'purchase'"/>
                        <field name="invoice_ids" widget="many2many_tags" invisible="document_type != 'invoice'"/>
                        <field name="picking_ids" widget="many2many_tags" invisible="document_type != 'picking'"/>
                    </group>
                    <group string="Resultado de la Fusión">
                        <field name="target_purchase_id" invisible="document_type != 'purchase'" placeholder="Nuevo documento (opcional)"/>
                        <field name="target_invoice_id" invisible="document_type != 'invoice'" placeholder="Nuevo documento (opcional)"/>
                        <field name="target_picking_id" invisible="document_type != 'picking'" placeholder="Nuevo documento (opcional)"/>
                    </group>
                    <footer>
                        <button name="action_merge" string="Fusionar" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions for context menus -->
    <record id="action_purchase_order_merge" model="ir.actions.act_window">
        <field name="name">Fusionar Órdenes</field>
        <field name="res_model">purchase.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_account_move_merge" model="ir.actions.act_window">
        <field name="name">Fusionar Facturas</field>
        <field name="res_model">purchase.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_stock_picking_merge" model="ir.actions.act_window">
        <field name="name">Fusionar Recepciones</field>
        <field name="res_model">purchase.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
