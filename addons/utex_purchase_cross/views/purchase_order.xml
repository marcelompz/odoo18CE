<odoo>

    <!-- form view -->
    <record id="purchase_order_inherit_form" model="ir.ui.view">
        <field name="name">purchase.order.inherit.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']/list/field[@name='price_subtotal']" position="replace">
                <field name="price_subtotal" string="Importe S/Imp." optional="hide"/>
                <field name="price_total" string="Importe C/Imp." optional="show"/>
            </xpath>
        
        </field>
    </record>

    <!-- tree view -->
    <record id="purchase_order_inherit_tree" model="ir.ui.view">
        <field name="name">purchase.order.inherit.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="invoice_numbers_display" optional="show"/>
            </xpath>
        
        </field>
    </record>

</odoo>
