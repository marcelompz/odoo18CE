<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="address_column" name="Address Column">
        <script>
            window.isPublicUser = <t t-esc="1 if request.website.is_public_user() else 0"/>;
        </script>
        <div class="col-12 col-xl order-xl-1 oe_cart">
            <div class="row">
                <div class="col-lg-12">
                    <h3 class="o_page_header mt8">
                        Dirección de Facturación
                    </h3>
                </div>
                <div class="col-lg-12 one_kanban">
                    <t t-call="website_sale.address_kanban">
                        <t t-set='contact' t-value="website_sale_order.partner_id"/>
                        <t t-set='selected' t-value="1"/>
                        <t t-set='readonly' t-value="1"/>
                        <t t-set='allow_edit' t-value="1"/>
                    </t>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <h3 class="o_page_header mt16 mb4">
                        Dirección de Envío
                    </h3>
                </div>
                <div class="col-lg-12 one_kanban">
                    <t t-call="website_sale.address_kanban">
                        <t t-set='contact' t-value="website_sale_order.partner_shipping_id"/>
                        <t t-set='selected' t-value="1"/>
                        <t t-set='readonly' t-value="1"/>
                        <t t-set='allow_edit' t-value="1"/>
                    </t>
                </div>
            </div>
            <!-- Si necesitas un formulario de dirección personalizado, llama aquí a tu plantilla adaptada -->
            <t t-call="one_page_checkout.address_form"/>
            <t t-call="one_page_checkout.address_modal_wizard"/>
        </div>
    </template>
<!-- Herencia para modificar el botón de editar dirección y abrir un modal -->
<template id="address_kanban_inherit_modal" inherit_id="website_sale.address_kanban">
    <xpath expr="//a[contains(@class, 'js_edit_address') or contains(@data-action, 'edit')]" position="replace">
        <a href="#" class="btn btn-link js_open_address_modal"
           t-att-data-address-id="contact.id"
           t-att-data-address-type="'billing'"
           role="button">
           <i class="fa fa-pencil"/> Editar
        </a>
    </xpath>
    <!-- Puedes hacer lo mismo para el botón de agregar dirección si existe -->
    </template>
</odoo>
