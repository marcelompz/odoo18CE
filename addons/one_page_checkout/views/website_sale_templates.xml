<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Esta plantilla hereda de website_sale.payment y se usa para el paso de pago en el checkout de una sola página. -->
        <template id="one_page_checkout_payment" inherit_id="website_sale.payment">
            <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="replace">
                <t t-call="website_sale.checkout_layout">
                    <div class="single_pg_checkout_layout">
                        <div class='col-auto'>
                            <!-- Establece el paso a 20 si el partner está inactivo, o 40 si está activo. -->
                            <t t-if="website_sale_order.partner_id.active == False">
                                <t t-set="step" t-value="20"/>
                            </t>
                            <t t-else="">
                                <t t-set="step" t-value="40"/>
                            </t>
                        </div>
                        <div class='col-12'>
                            <div class="col-12">
                                <!-- Llama a la plantilla de pago para la columna derecha. Si el partner está inactivo, añade la clase 'block-ui'. -->
                                <div t-attf-class="column #{'block-ui' if website_sale_order.partner_id.active == False else ''}">
                                    <!--t t-call="one_page_checkout.payment"/-->
                                    <!-- Llama a las plantillas de resumen del carrito e información extra para la columna izquierda. -->
                                    
                                    
                                    <div class="row">
                                        <!-- Aquí tu formulario de pago personalizado o el estándar -->
                                        <t t-component="one_page_checkout.OnePagePaymentForm"/>
                                        <!-- o -->
                                        <t t-call="payment.form"/>
                                    </div>
                                    <div class="row">
                                        <t t-call="one_page_checkout.extra_info"/>
                                    </div>
                                    
                                </div>
                                <div class="row">
                                    <!-- Llama a la plantilla de columna de dirección para la columna central. -->
                                    <div class="col-12">
                                        <t t-call="one_page_checkout.address_column"/>
                                    </div>
                                    <div class="col-12">
                                        <t t-call="website_sale.delivery_form"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <!-- Muestra cualquier error que ocurra durante el checkout. -->
                                    <div class="col-12" t-if="errors">
                                        <t t-foreach="errors" t-as="error">
                                            <div class="alert alert-danger" t-if="error" role="alert">
                                                <h4>
                                                    <t t-esc="error[0]"/>
                                                </h4>
                                                <t t-esc="error[1]"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
