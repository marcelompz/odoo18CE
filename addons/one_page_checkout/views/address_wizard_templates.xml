<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modal para editar o crear dirección en el checkout -->
    <template id="address_modal_wizard">
        <div id="addressModal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form id="address_modal_form">
                        <div class="modal-header">
                            <h5 class="modal-title">Editar / Crear Dirección</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <t t-if="request and request.website and request.website.is_public_user()">
                                <form action="/web/signup" method="post" class="mb-3">
                                    <div class="mb-2">
                                        <label for="register_email">Correo electrónico</label>
                                        <input type="email" class="form-control" id="register_email" name="login" required="required"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="register_name">Nombre</label>
                                        <input type="text" class="form-control" id="register_name" name="name" required="required"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="register_password">Contraseña</label>
                                        <input type="password" class="form-control" id="register_password" name="password" required="required"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="register_password_confirm">Confirmar contraseña</label>
                                        <input type="password" class="form-control" id="register_password_confirm" name="password_confirm" required="required"/>
                                    </div>
                                    <button type="submit" class="btn btn-success">Crear cuenta</button>
                                </form>
                            </t>
                            <t t-if="not (request and request.website and request.website.is_public_user())">
                                <div class="row">
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_vat">RUC</label>
                                        <input type="text" class="form-control" id="modal_vat" name="vat"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_name">Nombre</label>
                                        <input type="text" class="form-control" id="modal_name" name="name" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_email">Correo electrónico</label>
                                        <input type="email" class="form-control" id="modal_email" name="email" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_phone">Teléfono</label>
                                        <input type="text" class="form-control" id="modal_phone" name="phone"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_street">Dirección</label>
                                        <input type="text" class="form-control" id="modal_street" name="street" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_city">Ciudad</label>
                                        <input type="text" class="form-control" id="modal_city" name="city" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_zip">Código Postal</label>
                                        <input type="text" class="form-control" id="modal_zip" name="zip" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_country_id">País</label>
                                        <input type="text" class="form-control" id="modal_country_id" name="country_name" required="required"/>
                                    </div>
                                    <div class="mb-3 col-lg-4">
                                        <label for="modal_state_id">Departamento</label>
                                        <input type="text" class="form-control" id="modal_state_id" name="state_name"/>
                                    </div>
                                </div>
                                <input type="hidden" id="modal_address_id" name="address_id"/>
                            </t>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>
</odoo> 