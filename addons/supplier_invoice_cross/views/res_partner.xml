<odoo>

    <!-- form view -->
    <record id="res_partner_inherit" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">

            <!-- campo de lista de timbrados -->
            <xpath expr="//page[@name='accounting']//group" position="after">
                <separator string="Timbrados de Proveedor"/>
                <group>
                    <field name="is_electronic_invoicing"/>
                </group>
                <field name="supplier_stamping_ids">
                    <list editable="bottom">
                        <field name="name"/>
                        <field name="is_electronic_invoice_stamp"/>
                        <field name="date_end" required="not is_electronic_invoice_stamp"/>
                    </list>
                </field>
            </xpath>
        
        </field>
    </record>

</odoo>
