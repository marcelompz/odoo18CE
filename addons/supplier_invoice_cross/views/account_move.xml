<odoo>

    <!-- form view -->

    <record id="account_move_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="electronic_invoice_cross.view_move_form_inherit" />
        <field name="arch" type="xml">

            <!-- numero de factura -->
            <xpath expr="//field[@name='invoice_number']" position="replace"/>
            <!-- <xpath expr="//field[@name='invoice_number']" position="replace"/> -->

            <!-- timbrado compra -->
            <xpath expr="//field[@name='fiscal_document']" position="after">
                <field name="expired_stamped" invisible="1"/>
                <label for="stamped_id" invisible="move_type != 'in_invoice'"/>
                <div class="o_row" invisible="move_type != 'in_invoice'">
                    <field name="stamped_id" 
                        readonly="not partner_id"
                        required="move_type == 'in_invoice' and fiscal_document"
                        context="{'default_partner_id': partner_id}"
                        options="{'no_open': True, 'no_create_edit': False, 'no_quick_create':True}"
                        placeholder="Seleccione o cree..."
                    />
                    <span class="text-muted" invisible="not stamped_date_end"> Vence: </span>
                    <field name="stamped_date_end" nolabel="1" decoration-danger="expired_stamped"/>
                </div>
                <field name="invoice_number" invisible="move_type != 'out_invoice'" readonly="not l10n_py_enabled_invoice_number or state != 'draft'"/>
                <field name="invoice_number" invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
            </xpath>

            <!-- referencia de factura -->
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- mensaje en la cabecera -->
            <xpath expr="//sheet" position="before">
                <div role="alert" class="alert alert-danger text-center" 
                    invisible="not expired_stamped or state != 'draft' or move_type != 'in_invoice'">
                    <i class="fa fa-exclamation-triangle mr-2"/>
                    <strong>Atención: </strong> El timbrado seleccionado ya venció.
                </div>
            </xpath>
        
        </field>
    </record>

    <!-- menu root -->

    <menuitem
        id="open_account_action_move_in_invoice_type"
        name="Factura Proveedor"
        action="account.action_move_in_invoice_type"
        sequence="50"
        web_icon="supplier_invoice_cross,static/description/supplier-purchase.png"
    />

</odoo>
