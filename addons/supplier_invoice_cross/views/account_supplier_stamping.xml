<odoo>

    <!-- form view -->
    <record id="account_supplier_stamping_form" model="ir.ui.view">
        <field name="name">account.supplier.stamping.form</field>
        <field name="model">account.supplier.stamping</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="partner_id" invisible="1"/> <!-- Se llena auto por contexto -->
                    <field name="is_electronic_invoice_stamp"/>
                    <field name="date_end" required="not is_electronic_invoice_stamp"/>
                </group>
            </form>
        </field>
    </record>

</odoo>
