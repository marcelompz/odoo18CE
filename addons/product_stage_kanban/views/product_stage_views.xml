<odoo>
    <data>
        <record id="product_stage_view_form" model="ir.ui.view">
            <field name="name">product.stage.view.form</field>
            <field name="model">product.stage</field>
            <field name="arch" type="xml">
                <form string="Etapa de Producto">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_stage_view_list" model="ir.ui.view">
            <field name="name">product.stage.view.list</field>
            <field name="model">product.stage</field>
            <field name="arch" type="xml">
                <list string="Etapas de Producto" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="fold"/>
                </list>
            </field>
        </record>

        <record id="product_stage_action" model="ir.actions.act_window">
            <field name="name">Etapas de Producto</field>
            <field name="res_model">product.stage</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva etapa de producto
                </p>
            </field>
        </record>

        <!-- Menú para Etapas de Producto en el menú principal de Inventario -->
        <menuitem
            id="product_stage_menu"
            name="Etapas de Producto"
            parent="stock.menu_stock_root"
            action="product_stage_action"
            sequence="20"/>

    </data>
</odoo>

