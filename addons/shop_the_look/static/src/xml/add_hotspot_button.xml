<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <div t-name="shop_the_look.hotspotmodal">
        <div class="modal add_hotspot_modal" id="shopModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog" style="max-width: 90%;max-height:100%">
                <div class="modal-content">
                    
                    <div class="modal-header-bar" ></div>
                    <div class="modal-header">
                        <h3 class="modal-title">Add Hotspot</h3>
                    </div>
                    <div class="picky-close-x-button" data-bs-dismiss="modal"></div>
                    <div class="modal-body">
                        <div class="row p-1 modal-row">
                            <div class="col-12 col-sm-12 col-md-6 modal_look_img">
                                <div class="imagemaps-wrapper">
                                    <t t-if="res.image">
                                        <img class="card-img-primary mt-1 mb-2" t-attf-src="data:image/*;base64,{{res.image}}" draggable="false" usemap="#workmap"/>
                                    </t>
                                    <t t-else="">
                                        <img class="card-img mt-1 mb-2" src="/shop_the_look/static/img/placeholder.png"/>
                                    </t>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 col-sm-12">
                                <div class="imagemaps-control">
                                    <fieldset>
                                        <legend>Select Product</legend>
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th scope="col">#</th>
                                                    <th scope="col">Products</th>
                                                    <th scope="col">Target</th>
                                                    <th scope="col">Delete</th>
                                                </tr>
                                            </thead>
                                            <tbody class="imagemaps-output">
                                                <tr class="item-###">
                                                    <th scope="row">### </th>
                                                    <td>
                                                        <select name="hotspot_product" class="form-control area-href" t-on-change="productSelectHotspot" >
                                                            <t t-foreach="res.looks_ids" t-as="looks_data" t-key="looks_data">
                                                                <option t-att-value="looks_data[1]" t-att-line="looks_data[2]">
                                                                    <t t-esc="looks_data[0]" />
                                                                </option>
                                                            </t>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-control area-target">
                                                            <option value="_self">Self</option>
                                                            <option value="_blank">Blank</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-danger btn-delete">Delete</button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </fieldset>
                                    <div>
                                      <button type="button" class="btn btn-info btn-add-map">Add New</button>
                                      <!-- <button type="button" class="btn btn-info btn-add-map" t-on-click="addProductHotspot">Add New</button> -->

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                        <div id="duplicate_error">

                        </div>
                        
                        <button type="button" class="btn btn-primary save_hotspot" data-bs-dismiss="modal" >
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <t t-name="shop_the_look.HotspotButton" t-inherit="web.FormView" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='control-panel-status-indicator']" position="after">
            <button t-if="model.config.resModel == 'shop.the.look'" type="button" class="btn btn-outline-primary ms-3" data-hotkey="h"  t-on-click="addHotspotButtonClicked">
                Add Hotspot
            </button>
            <!-- <div class="hotspot_data d-none"></div> -->
        </xpath>

    </t>
</templates>
