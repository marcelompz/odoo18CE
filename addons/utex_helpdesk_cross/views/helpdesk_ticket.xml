<odoo>

    <!-- list view -->
    <record id="helpdesk_ticket_inherit_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.inherit.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree" />
        <field name="arch" type="xml">

            <!-- campo priority -->
            <xpath expr="//field[@name='priority']" position="replace">
                <field 
                    name="priority" 
                    widget="badge" 
                    decoration-muted="priority == '0'" 
                    decoration-success="priority == '1'" 
                    decoration-warning="priority == '2'" 
                    decoration-danger="priority == '3'"
                    optional="show"
                />
            </xpath>

            <!-- campo create_uid -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="create_uid" string='Cargado por' optional="hide" widget="many2one_avatar_user"/>
            </xpath>
        
        </field>
    </record>

    <!-- form view -->
    <record id="helpdesk_ticket_inherit_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.inherit.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">

            <!-- campo priority -->
            <xpath expr="//group[hasclass('mb-0','mt-4')]//group[1]//field[@name='priority']" position="replace">
                <field name="priority" 
                    widget="statusbar" 
                    options="{'clickable': '1'}" 
                    class="my_priority_colors"
                />
            </xpath>

            <!-- campo maintenance_equipment_id y is_draft_state -->
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="maintenance_type_problem_ids" widget="many2many_checkboxes" options="{'no_create': 1}"/>
                <field name="team_equipment_ids" invisible="1"/>
                <field name="maintenance_equipment_id" domain="[('id', 'in', team_equipment_ids)]" options="{'no_create': 1}"/>
                <field name="is_draft_state" invisible="1"/>
            </xpath>

            <!-- boton de guardar y volver -->
            <xpath expr="//header" position="inside">
                <button string="Guardar y Volver" 
                    name="action_save_and_return" 
                    type="object" 
                    class="oe_highlight"/>
            </xpath>
                    <!-- invisible="id" -->

            <!-- campo team_id -->
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="widget">radio</attribute>
                <attribute name="options">{'horizontal': true}</attribute>
            </xpath>

            <!-- campo partner_id -->
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="current_user_allowed_partners" invisible="1"/>
                <field 
                    name="partner_id" 
                    class="field_partner_id" 
                    domain="[('id', '=', current_user_allowed_partners), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" 
                    widget="radio"
                    context="{'default_phone': partner_phone}"
                />
            </xpath>

            <!-- campo user_id -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">user_id</attribute>
            </xpath>

        </field>
    </record>

    <!-- form view helpdesk crm -->
    <record id="helpdesk_ticket_crm_inherit_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.crm.inherit.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="crm_helpdesk.helpdesk_ticket_view_form_inherited" />
        <field name="arch" type="xml">

            <xpath expr="//button[1]" position="attributes">
                <attribute name="invisible">not active or is_draft_state</attribute>
            </xpath>

            <xpath expr="//button[2]" position="attributes">
                <attribute name="invisible">not active or is_draft_state</attribute>
            </xpath>
        
        </field>
    </record>

    <!-- search view -->
    <record id="helpdesk_ticket_inherit_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.inherit.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search" />
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='my_ticket']" position="replace">
                <filter string="My Tickets" domain="[('create_uid','=',uid)]" name="my_ticket"/>
            </xpath>
        
        </field>
    </record>

    <!-- windows action new record -->
    <record id="action_create_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Nuevo ticket</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- menu root -->
    <menuitem
        id="create_helpdesk_ticket_menu_root" 
        name="Nuevo ticket"
        sequence="20"
        action="utex_helpdesk_cross.action_create_helpdesk_ticket" 
        web_icon="utex_helpdesk_cross,static/description/helpdesk-icon.png"
    />

    <menuitem
        id="my_helpdesk_ticket_menu_root" 
        name="Mis tickets"
        sequence="2"
        action="helpdesk.helpdesk_ticket_action_main_my" 
        web_icon="utex_helpdesk_cross,static/description/helpdesk-icon.png"
    />

</odoo>
