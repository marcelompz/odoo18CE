<odoo>

    <!-- form view -->
    <record id="helpdesk_team_inherit_form" model="ir.ui.view">
        <field name="name">helpdesk.team.inherit.form</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form" />
        <field name="arch" type="xml">

            <!-- campo property_res_users_id -->
            <xpath expr="//h2" position="before">
                <h2>Valores por defecto</h2>
                <div class="row mt16 o_settings_container" id="website_form_channel">
                    <setting help="Usuario por defecto a quien se le va asignar el ticket.">
                        <field name="property_res_users_id"/>
                    </setting>
                </div>
            </xpath>

            <!-- campo de maquinarias -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Maquinarias" name="equipments_tab">
                        <field name="equipment_ids">
                            <list string="Máquinas">
                                <field name="name"/>
                                <field name="label_number"/>
                                <field name="model"/>
                                <field name="serial_no"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        
        </field>
    </record>

</odoo>
