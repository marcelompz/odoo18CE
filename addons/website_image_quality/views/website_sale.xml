    <template id="dynamic_filter_template_product_product_view_detail_image_quality" inherit_id="website_sale.dynamic_filter_template_product_product_view_detail" customize_show="True" name="View Detail Image Quality">
        <xpath expr="//img[contains(@class, 'card-img-top')]" position="attributes">
            <attribute name="t-att-src">
                "/web/image/product.product/%s/image_1920/%s" % (
                    (record.id if hasattr(record, 'id') and record.id else record.id),
                    (record.display_name if hasattr(record, 'display_name') and record.display_name else record.display_name or 'producto')
                )
            </attribute>
        </xpath>
    </template>

