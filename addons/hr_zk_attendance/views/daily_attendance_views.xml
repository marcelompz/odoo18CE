<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Daily attendance list view-->
    <record id="daily_attendance_view_list" model="ir.ui.view">
        <field name="name">daily.attendance.view.list</field>
        <field name="model">daily.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" delete="false">
                <field name="punching_day"/>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="attendance_type"/>
                <field name="punching_time"/>
                <field name="address_id"/>
            </list>
        </field>
    </record>
    <!--    Attendance analysis action-->
    <record id="daily_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">daily.attendance</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>

    <!--
        Crossnexion: Server action visible en el menu Acciones de
        "Attendance Analysis" (modelo daily.attendance, vista SQL).
        Internamente borra zk_machine_attendance (la tabla real).
        Solo administradores.
    -->
    <record id="server_action_clear_daily_attendance" model="ir.actions.server">
        <field name="name">Borrar TODAS las marcaciones capturadas (Admin)</field>
        <field name="model_id" ref="hr_zk_attendance.model_daily_attendance"/>
        <field name="binding_model_id" ref="hr_zk_attendance.model_daily_attendance"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
action = env['zk.machine.attendance'].action_clear_all_captured()
        </field>
    </record>
</odoo>
