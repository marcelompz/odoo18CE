<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Biometric device configuration list view-->
    <record id="biometric_device_details_view_list" model="ir.ui.view">
        <field name="name">biometric.device.details.view.list</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port_number"/>
            </list>
        </field>
    </record>

    <!--Biometric device configuration form view-->
    <record id="biometric_device_details_view_form" model="ir.ui.view">
        <field name="name">biometric.device.details.view.form</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_timezone" string=" Set Time"
                            type="object" class="oe_highlight"/>
                    <button name="action_open_download_wizard"
                            string="Download Data"
                            type="object" class="oe_highlight"/>
                    <!-- Clear Data: solo administradores -->
                    <button name="action_clear_attendance" string="Clear Data"
                            type="object" class="btn btn-danger"
                            groups="base.group_system"
                            confirm="ATENCION: Esta operacion borrara TODAS las marcaciones del reloj biometrico Y de la base de datos de Odoo. Es una accion IRREVERSIBLE. Asegurese de haber descargado y procesado las marcaciones antes de continuar. Realmente desea continuar?"/>
                    <!-- Restart: solo administradores -->
                    <button name="action_restart_device" string="Restart"
                            type="object" class="btn btn-warning"
                            groups="base.group_system"
                            confirm="El reloj se reiniciara fisicamente. Las marcaciones almacenadas dentro del reloj NO se pierden. Continuar?"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_ip"/>
                        <field name="port_number"/>
                        <field name="address_id"/>
                    </group>
                    <button name="action_test_connection"
                            type="object" class="btn btn-secondary">
                        <i class="fa fa-fw o_button_icon fa-television"/>
                        Test Connection
                    </button>

                    <!-- Banner de advertencia visible solo para admins -->
                    <div class="alert alert-warning" groups="base.group_system" style="margin-top: 16px;">
                        <h4 style="margin-top: 0;">
                            <i class="fa fa-exclamation-triangle"/> Advertencia para administradores
                        </h4>
                        <p>
                            <b>Clear Data</b>: borra TODAS las marcaciones del reloj fisico
                            Y de la base de datos de Odoo. <b>Operacion irreversible.</b>
                            Antes de usarlo, asegurate de haber descargado y procesado
                            todas las marcaciones (boton "Download Data").
                        </p>
                        <p>
                            <b>Restart</b>: solo reinicia el hardware. No borra datos.
                        </p>
                        <p>
                            <b>Recomendacion</b>: si quiere volver a descargar marcaciones
                            desde cero pero <b>conservar las del reloj</b>, vaya a
                            <i>Asistencias > Gestion > Attendance Analysis</i> y use
                            la accion <b>Borrar TODAS las marcaciones capturadas (Admin)</b>;
                            eso solo limpia la base de datos, sin tocar el reloj.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!--Action for the biometric device-->
    <record id="biometric_device_details_action" model="ir.actions.act_window">
        <field name="name">Biometric Device</field>
        <field name="res_model">biometric.device.details</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--
        Server action: borrar TODAS las marcaciones capturadas en la BD,
        sin tocar el reloj. Solo administradores.
        Visible en el menu Acciones de zk.machine.attendance (Attendance Analysis).
    -->
    <record id="server_action_clear_zk_attendance_safe" model="ir.actions.server">
        <field name="name">Borrar TODAS las marcaciones capturadas (Admin)</field>
        <field name="model_id" ref="hr_zk_attendance.model_zk_machine_attendance"/>
        <field name="binding_model_id" ref="hr_zk_attendance.model_zk_machine_attendance"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_clear_all_captured()
        </field>
    </record>
</odoo>
