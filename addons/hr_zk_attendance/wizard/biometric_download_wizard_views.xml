<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="biometric_download_wizard_view_form" model="ir.ui.view">
        <field name="name">biometric.download.wizard.view.form</field>
        <field name="model">biometric.download.wizard</field>
        <field name="arch" type="xml">
            <form string="Download Attendance">
                <group>
                    <field name="device_id" readonly="1"/>
                </group>
                <group string="Date Range (optional)">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <p class="text-muted">
                    Leave both dates empty to download every event stored in
                    the device. Events outside the range will be ignored.
                </p>
                <footer>
                    <button name="action_confirm" string="Download"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_biometric_download_wizard" model="ir.actions.act_window">
        <field name="name">Download Attendance</field>
        <field name="res_model">biometric.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
