<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_surcharge" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.surcharge</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="surcharge" string="Payment Pricelist Configuration">
                    <field name="pricelist_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_inherit_surcharge" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.inherit.surcharge</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pricelist_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
