<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_group_by_category_list" model="ir.ui.view">
        <field name="name">mrp.group.by.category.list</field>
        <field name="model">mrp.group.by.category</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Producción por Categoría">
                <field name="name"/>
                <field name="category_id"/>
                <field name="product_qty"/>
                <field name="sale_order_id"/>
                <field name="state"/>
                <field name="production_id"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_group_by_category_form" model="ir.ui.view">
        <field name="name">mrp.group.by.category.form</field>
        <field name="model">mrp.group.by.category</field>
        <field name="arch" type="xml">
            <form string="Órdenes de Producción por Categoría">
                <header>
                    <button name="action_generate_grouped_production" 
                            type="object" 
                            string="Generar Orden de Producción Agrupada" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="product_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Componentes Agrupados">
                            <field name="bom_lines">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="product_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tareas Agrupadas">
                            <field name="workorder_lines">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="workcenter_id"/>
                                    <field name="time_cycle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_group_by_category" model="ir.actions.act_window">
        <field name="name">Órdenes de Producción por Categoría</field>
        <field name="res_model">mrp.group.by.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva orden de producción agrupada por categoría
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_group_by_category_root" name="Producción por Categoría" parent="mrp.menu_mrp_root" sequence="100"/>
    <menuitem id="menu_mrp_group_by_category" name="Órdenes por Categoría" parent="menu_mrp_group_by_category_root" action="action_mrp_group_by_category"/>
</odoo> 