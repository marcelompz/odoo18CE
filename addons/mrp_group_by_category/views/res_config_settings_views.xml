<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mrp_group" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.group</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='group_mrp_routings']" position="after">
                 <div class="col-12 col-lg-6 o_setting_box" id="default_product_for_wizard">
                    <div class="o_setting_right_pane">
                        <label for="wizard_default_product_id" string="Producto por defecto del Asistente"/>
                        <div class="text-muted">
                            Este producto se cargará por defecto en el asistente de fabricación.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="wizard_default_product_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo> 