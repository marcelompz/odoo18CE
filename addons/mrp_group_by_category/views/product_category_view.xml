<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_category_form_inherit" model="ir.ui.view">
            <field name="name">product.category.form.inherit</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="default_product_id" string="Producto Principal de Fabricación" options="{'no_create': True}"/>
                    <field name="production_product_id" string="Producto General de Producción" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Vista de lista completa -->
        <record id="view_product_category_list" model="ir.ui.view">
            <field name="name">product.category.list</field>
            <field name="model">product.category</field>
            <field name="arch" type="xml">
                <list string="Categorías de Producto">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="complete_name"/>
                </list>
            </field>
        </record>

        <!-- Acción de ventana -->
        <record id="action_product_category" model="ir.actions.act_window">
            <field name="name">Categorías de Producto</field>
            <field name="res_model">product.category</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_product_category_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera categoría de producto
                </p>
            </field>
        </record>

      
    </data>
</odoo> 