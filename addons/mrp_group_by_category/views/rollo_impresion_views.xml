<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista de rollos de impresión -->
        <record id="view_rollo_impresion_list" model="ir.ui.view">
            <field name="name">rollo.impresion.list</field>
            <field name="model">rollo.impresion</field>
            <field name="arch" type="xml">
                <list string="Rollos de Impresión">
                    <field name="name"/>
                    <field name="cantidad_total"/>
                </list>
            </field>
        </record>
        <!-- Vista de formulario de rollos de impresión -->
        <record id="view_rollo_impresion_form" model="ir.ui.view">
            <field name="name">rollo.impresion.form</field>
            <field name="model">rollo.impresion</field>
            <field name="arch" type="xml">
                <form string="Rollo de Impresión">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="cantidad_total" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Líneas">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="production_id" options="{'no_create': True}"/>
                                        <field name="descripcion"/>
                                        <field name="cantidad"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Vista de lista de líneas de rollo de impresión -->
        <record id="view_rollo_impresion_line_list" model="ir.ui.view">
            <field name="name">rollo.impresion.line.list</field>
            <field name="model">rollo.impresion.line</field>
            <field name="arch" type="xml">
                <list string="Líneas de Rollo de Impresión">
                    <field name="rollo_id"/>
                    <field name="production_id" options="{'no_create': True}"/>
                    <field name="descripcion"/>
                    <field name="cantidad"/>
                </list>
            </field>
        </record>
        <!-- Vista de formulario de línea de rollo de impresión -->
        <record id="view_rollo_impresion_line_form" model="ir.ui.view">
            <field name="name">rollo.impresion.line.form</field>
            <field name="model">rollo.impresion.line</field>
            <field name="arch" type="xml">
                <form string="Línea de Rollo de Impresión">
                    <sheet>
                        <group>
                            <field name="rollo_id"/>
                            <field name="production_id" options="{'no_create': True}"/>
                            <field name="descripcion"/>
                            <field name="cantidad"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Acción de ventana para rollos de impresión -->
        <record id="action_rollo_impresion" model="ir.actions.act_window">
            <field name="name">Rollos de Impresión</field>
            <field name="res_model">rollo.impresion</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_rollo_impresion_list"/>
        </record>
        <!-- Menú principal bajo Fabricación -->
        <menuitem id="menu_rollo_impresion_root" name="Rollos de Impresión" parent="mrp.menu_mrp_root" sequence="300" action="action_rollo_impresion"/>
        <!-- Vista de búsqueda para mrp.production -->
        <record id="view_mrp_production_search_by_origin" model="ir.ui.view">
            <field name="name">mrp.production.search.by.origin</field>
            <field name="model">mrp.production</field>
            <field name="arch" type="xml">
                <search>
                    <field name="origin"/>
                    <field name="name"/>
                    <!-- otros campos si quieres -->
                </search>
            </field>
        </record>
    </data>
</odoo> 