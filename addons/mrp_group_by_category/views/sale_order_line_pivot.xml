<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_pivot_by_category" model="ir.ui.view">
        <field name="name">sale.order.line.pivot.by.category</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Líneas de Venta por Categoría" display_quantity="true">
                <field name="validity_date" type="row" interval="month"/>
                <field name="validity_date" type="row" interval="day"/>
                <field name="order_display_name" type="row"/>
                <field name="product_categ_id" type="col"/>
                <field name="product_id" type="col"/>
                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sale_order_line_list_by_category" model="ir.ui.view">
        <field name="name">sale.order.line.list.by.category</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Análisis de Líneas de Venta" decoration-danger="has_pending_tasks == True" decoration-success="has_pending_tasks == False and production_id != False">
                <field name="order_display_name" string="Pedido"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="product_categ_id"/>
                <field name="validity_date"/>
                <field name="task_status"/>
                <field name="production_id"/>
                <field name="has_pending_tasks" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_search" model="ir.ui.view">
        <field name="name">sale.order.line.search.by.category</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search>
                <filter string="En Producción" name="in_production" domain="[('order_id.stage_id.name', '=', 'En producción')]"/>
                <filter string="Fuera de Producción" name="not_in_production" domain="[('order_id.stage_id.name', '!=', 'En producción')]"/>
            </search>
        </field>
    </record>

    <record id="action_sale_order_line_pivot_by_category" model="ir.actions.act_window">
        <field name="name">Análisis de Ventas por Categoría</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_sale_order_line_search"/>
        <field name="context">{'search_default_in_production': 1}</field>
    </record>

    <menuitem id="menu_sale_order_line_pivot_by_category"
              name="Ventas por Categoría"
              parent="mrp.menu_mrp_root"
              action="action_sale_order_line_pivot_by_category"
              sequence="100"/>
</odoo> 
