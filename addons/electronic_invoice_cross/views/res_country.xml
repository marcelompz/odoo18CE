<odoo>

    <!-- list view  -->

    <record id="res_country_inherit_list" model="ir.ui.view">
        <field name="name">res.country.inherit.list</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="code_alfa_3"/>
                <field name="code_numeric"/>
            </xpath>
        </field>
    </record>

    <!-- form view  -->

    <record id="res_country_inherit_form" model="ir.ui.view">
        <field name="name">res.country.inherit.form</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="base.view_country_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="code_alfa_3"/>
                <field name="code_numeric"/>
            </xpath>
        </field>
    </record>

    <!-- window action -->

    <record id="base.action_country_state" model="ir.actions.act_window">
        <field name="name">Departamentos</field>
    </record>

    <!-- menu  -->

    <record id="contacts.menu_country_state_partner" model="ir.ui.menu">
        <field name="name">Departamentos</field>
    </record>

</odoo>
