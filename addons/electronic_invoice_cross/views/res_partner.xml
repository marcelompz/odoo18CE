<odoo>

    <!-- form view  -->
    <record id="res_partner_inherit_form" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_a_state_provider"/>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="client_eligible_de" invisible="1"/>
                <field name="partner_code" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div 
                    role="alert" 
                    class="alert alert-warning text-center" 
                    invisible="client_eligible_de or partner_code == '/'">
                    Cliente no apto para facturación electrónica, son obligatorios los campos Nombre, Número de identificación, Dirección de contacto incluyendo Ciudad Distrito Departamento, Móvil y Correo electrónico.
                </div>
                <div 
                    role="alert" 
                    class="alert alert-success text-center" 
                    invisible="not client_eligible_de">
                    Cliente apto para facturación electrónica.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
