<odoo>

    <!-- TAX TYPE -->

    <!-- list view -->

    <record id="res_company_taxtype_list" model="ir.ui.view">
        <field name="name">res.company.taxtype.list</field>
        <field name="model">res.company.taxtype</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" required="1"/>
                <field name="taxtype_id" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="res_company_taxtype_action" model="ir.actions.act_window">
        <field name="name">Tipo de impuesto de empresa</field>
        <field name="res_model">res.company.taxtype</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- main menu -->

    <menuitem
        id="electronic_bill_menu"
        name="Factura electrónica"
        parent="base.menu_custom"
        sequence="2"
    />

    <!-- menu -->

    <menuitem
        id="res_company_taxtype_menu"
        name="Tipo de impuesto de empresa"
        action="res_company_taxtype_action"
        parent="electronic_invoice_cross.electronic_bill_menu"
        sequence="1"
    />

    <!-- TRANSACTION TYPE -->

    <!-- list view -->

    <record id="res_company_transactiontype_list" model="ir.ui.view">
        <field name="name">res.company.transactiontype.list</field>
        <field name="model">res.company.transactiontype</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" required="1"/>
                <field name="transaction_id" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="res_company_transactiontype_action" model="ir.actions.act_window">
        <field name="name">Tipo de transacción de la empresa</field>
        <field name="res_model">res.company.transactiontype</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_company_transactiontype_menu"
        name="Tipo de transacción de la empresa"
        action="res_company_transactiontype_action"
        parent="electronic_invoice_cross.electronic_bill_menu"
        sequence="2"
    />

</odoo>
