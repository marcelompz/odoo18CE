<odoo>

    <!-- list view -->

    <record id="res_presence_list" model="ir.ui.view">
        <field name="name">res.presence.list</field>
        <field name="model">res.presence</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="presence_id" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="res_presence_action" model="ir.actions.act_window">
        <field name="name">Indicador de presencia</field>
        <field name="res_model">res.presence</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_presence_menu"
        name="Indicador de presencia"
        action="res_presence_action"
        parent="electronic_invoice_cross.electronic_bill_menu"
        sequence="4"
    />

</odoo>
