<odoo>

    <!-- res.document.format -->

    <!-- list view -->

    <record id="res_document_format_list" model="ir.ui.view">
        <field name="name">res.document.format.list</field>
        <field name="model">res.document.format</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code" required="1"/>
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="res_document_format_action" model="ir.actions.act_window">
        <field name="name">Formato del documento</field>
        <field name="res_model">res.document.format</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_document_format_menu"
        name="Formato del documento"
        action="electronic_invoice_cross.res_document_format_action"
        parent="electronic_invoice_cross.electronic_bill_menu"
        sequence="5"
    />

    <!-- res.document.format.type -->

    <!-- list view -->

    <record id="res_document_format_type_list" model="ir.ui.view">
        <field name="name">res.document.format.type.list</field>
        <field name="model">res.document.format.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code" required="1"/>
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="res_document_format_type_action" model="ir.actions.act_window">
        <field name="name">Tipo de documento impreso</field>
        <field name="res_model">res.document.format.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_document_format_type_menu"
        name="Tipo de documento impreso"
        action="electronic_invoice_cross.res_document_format_type_action"
        parent="electronic_invoice_cross.electronic_bill_menu"
        sequence="6"
    />

</odoo>
