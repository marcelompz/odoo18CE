<odoo>

    <!-- form view -->

    <record id="res_partner_search_config_form" model="ir.ui.view">
        <field name="name">res.partner.search.config.form</field>
        <field name="model">res.partner.search.config</field>
        <field name="arch" type="xml">
            <form string="Ajustes de conexión">
                <group>
                    <group>
                        <field name="db_name" force_save="1"/>
                        <field name="db_user" force_save="1"/>
                        <field name="db_pwd" password="1" force_save="1"/>
                    </group>
                    <group>
                        <field name="db_host" force_save="1"/>
                        <field name="db_port" force_save="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Guardar" name="action_save" type="object" class="oe_highlight" />
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
