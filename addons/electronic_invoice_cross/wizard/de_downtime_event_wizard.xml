<odoo>

    <!-- form view -->

    <record id="de_downtime_event_wizard_form" model="ir.ui.view">
        <field name="name">de.downtime.event.wizard.form</field>
        <field name="model">de.downtime.event.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="authorization_id" invisible="1"/>
                            <field name="latam_doc_type_id" readonly="1"/>
                            <field name="establishment_code" readonly="1"/>
                            <field name="generation_point" readonly="1"/>
                            <field name="number_from"/>
                            <field name="number_to"/>
                            <field name="reason" colspan="3" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Aceptar" name="action_acept" type="object" class="oe_highlight" />
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
