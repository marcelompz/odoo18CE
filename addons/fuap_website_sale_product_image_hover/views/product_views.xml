<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_image_hover_form" model="ir.ui.view">
        <field name="name">product.image.hover.view.form</field>
        <field name="model">product.image</field>
        <field name="inherit_id" ref="website_sale.view_product_image_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_website_sale_image_modal')]/div" position="inside">
                <field name="product_tmpl_id" invisible="1"/>
                <div invisible="not product_tmpl_id">
                    <field name="hover" class="oe_edit_only"/>
                    <label for="hover"/><br/>
                </div>
            </xpath>
        </field>
    </record>
    
    <record id="view_product_image_hover_kanban" model="ir.ui.view">
        <field name="name">product.image.hover.view.kanban</field>
        <field name="model">product.image</field>
        <field name="inherit_id" ref="website_sale.product_image_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="hover"/>
            </xpath>
            <xpath expr="//div[hasclass('card')]" position="inside">
                <t t-if="record.hover.raw_value">
                    <span class="o_product_image_hover_icon" title="Image hover">
                        <i class="fa fa-image" aria-hidden="true"></i>
                    </span>
                </t>
            </xpath>
        </field>
    </record>
</odoo>