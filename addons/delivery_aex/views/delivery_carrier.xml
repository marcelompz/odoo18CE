<odoo>
    <data>
        <record id="view_delivery_carrier_form_with_aex" model="ir.ui.view">
            <field name="name">delivery.carrier.form.aex</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='delivery_type']" position="after">
                    <group string="AEX Configuration" invisible="delivery_type != 'aex'">
                        <field name="aex_clave_publica"/>
                        <field name="aex_clave_privada" password="True"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
