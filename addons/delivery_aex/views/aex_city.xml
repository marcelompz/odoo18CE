<odoo>

    <!-- tree view -->

    <record id="aex_city_tree" model="ir.ui.view">
        <field name="name">aex.city.tree</field>
        <field name="model">aex.city</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <header>
                    <button name="%(delivery_aex.action_aex_city_import_wizard)d" type="action" string="Import AEX Cities" class="oe_highlight"/>
                </header>
                <field name="name"/>
                <field name="code"/>
                <field name="department_name"/>
                <field name="department_code"/>
                <field name="country_name"/>
                <field name="country_code"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="aex_city_action" model="ir.actions.act_window">
        <field name="name">AEX Cities</field>
        <field name="res_model">aex.city</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Click en nuevo para agregar nuevos registros</p>
        </field>
    </record>

</odoo>
