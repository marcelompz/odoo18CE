<odoo>

    <!-- form view -->

    <record id="view_picking_form_aex" model="ir.ui.view">
        <field name="name">stock.picking.form.aex</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Añadimos el botón en la cabecera del formulario -->
            <xpath expr="//header" position="inside">
                <button name="action_print_aex_label"
                        string="Obtener Etiqueta AEX"
                        type="object"
                        class="oe_highlight"
                        invisible="delivery_type != 'aex' or carrier_tracking_ref == False"
                        help="Vuelve a obtener e imprimir la etiqueta de envío de AEX."/>
            </xpath>
        </field>
    </record>

</odoo>
