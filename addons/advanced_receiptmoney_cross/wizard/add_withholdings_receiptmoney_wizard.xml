<odoo>

    <!-- form view -->

    <record id="add_withholdings_receiptmoney_wizard_form" model="ir.ui.view">
        <field name="name">add.withholdings.receiptmoney.wizard.form</field>
        <field name="model">add.withholdings.receiptmoney.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="withholdings">
                    <group>
                        <field name="receiptmoney_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="name" required="1" default_focus="1"/>
                        <field name="amount" required="1"/>
                        <field name="journal_id" required="1" options="{'no_create': 1}"/>
                    </group>
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="date"/>
                        <field name="payment_type" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Agregar" name="action_done" type="object" class="oe_highlight" />
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
