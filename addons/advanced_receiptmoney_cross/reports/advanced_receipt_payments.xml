<odoo>

    <!-- report template -->

    <template id="report_advanced_receipt_payments_document">
        <t t-call="web.basic_layout">
            <div class="page border">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                <t t-set="company" t-value="doc.company_id"/>
                <div class="watermark" t-if="report_type == 'pdf' and doc.state == 'canceled'" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; text-align: center; opacity: 0.2;">
                    <span style="font-size: 6em; color: coral; -webkit-transform: rotate(-35deg); display: inline-block; margin-top: 20%;">RECIBO CANCELADO</span>
                </div>
                <div class="row border-bottom">
                    <div id="company_logo" class="col-3 mb4 text-center">
                        <img t-if="company.logo" style="max-height: 120px; max-width: 200px; display: block; margin: auto;" t-att-src="image_data_uri(company.logo)"/>
                        <h1 t-if="not company.logo"><t t-esc="company.name"/></h1>
                    </div>
                    <div class="col-5" id="company_address" style="font-size: 12px;">
                        <br/>
                        <strong t-field="company.name"/><br/>
                        <span t-if="company.vat">R.U.C.: <span t-field="company.vat"/></span><br/>
                        <span t-if="company.street"><t t-esc="company.street"/></span>
                        <span t-if="company.street2"><t t-esc="company.street2"/></span><br/>
                        <span t-if="company.city" t-esc="company.city"/>
                        <span t-if="company.country_id"> - <t t-esc="company.country_id.name"/></span><br/>
                        <!-- <span t-if="company.phone">Phone: <t t-esc="company.phone"/></span><br/> -->
                        <span t-if="company.mobile">Celular: <t t-esc="company.mobile"/></span><br/>
                        <span t-if="company.email">Email: <t t-esc="company.email"/></span><br/>
                    </div>
                    <div class="col-4 text-center">
                        <br/>
                        <h4>RECIBO DE DINERO</h4>
                        <p>Nº <span t-esc="doc.name"></span></p>
                        <h5><span t-field="doc.total_amount"/></h5>
                    </div>
                </div>
                
                <br/>
                
                <div style="padding-left:10px;">
                    <div class="text-end" style="padding-right:10px;">
                        <span><span t-esc="company.city"/>, <t t-esc="doc.date_to_text(doc.payment_date, doc.partner_id.lang)"/></span>
                    </div>
                    <br/>
                    <div>
                        <span class="pl-5">Recibimos de <span t-field="doc.partner_id.name"/></span>
                    </div>
                    <div>
                        <span class="pl-5">con R.U.C./C.I. <span t-field="doc.partner_id.vat"/>,</span>
                    </div>
                    <!-- <div>
                        <span>el monto de <span t-field="doc.currency_id.currency_unit_label"/>es <t t-esc="(doc.currency_id.with_context(lang=doc.partner_id.lang).amount_to_text(doc.total_amount)).replace(doc.currency_id.currency_unit_label,'')"/></span>
                    </div> -->
                    <div>
                        <span>En concepto de 
                            <t t-if="doc.concept">
                                <span t-field="doc.concept"/>
                            </t>
                            <t t-else="">
                                <span>________________________________________________________________________</span>
                            </t>
                        </span>
                    </div>
                </div>

                <br/>

                <div class="row">
                    <div class="col-2">
                        <strong style="padding-left:5px;">La cantidad de:</strong>
                    </div>
                    <div class="col-10 border" style="font-size:12px; padding:4px;">
                        <span t-field="doc.currency_id.currency_unit_label"/>es <t t-esc="(doc.currency_id.with_context(lang=doc.partner_id.lang).amount_to_text(doc.total_amount)).replace(doc.currency_id.currency_unit_label,'')"/>
                    </div>
                </div>

                <br/>
                
                <strong style="padding-left:5px;">DETALLES DE LAS FACTURAS</strong>
                <table class="table table-sm" style="font-size:10px"  id="invoice_details">
                    <thead>
                        <tr>
                            <th class="text-start">FECHA</th>
                            <th>FACTURA</th>
                            <th>VENCIMIENTO</th>
                            <th class="text-end">MONTO</th>
                            <th class="text-end">SALDO A PAGAR</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_amount" t-value="0"/>
                        <t t-set="balance_amount" t-value="0"/>
                        <t t-foreach="doc.invoice_ids" t-as="line">
                            <tr>
                                <td class="text-start">
                                    <span t-field="line.invoice_date"/>
                                </td>
                                <td class="text-center">
                                    <span t-esc="line.invoice_number or line.name"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.invoice_date_due"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.amount_total_signed" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.amount_residual_signed" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                </td>
                            </tr>
                            <t t-set="total_amount" t-value="total_amount + line.amount_total_signed"/>
                            <t t-set="balance_amount" t-value="balance_amount + line.amount_residual_signed"/>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end"><strong>TOTAL</strong></td>
                            <td class="text-end">
                                <!-- <h5><span t-field="doc.total_amount"/></h5> -->
                                <span t-esc="total_amount" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <!-- <h5><span t-field="doc.total_amount"/></h5> -->
                                <span t-esc="balance_amount" t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <t t-if="len(doc.payment_ids) > 0" id="payment_details">
                    <strong style="padding-left:5px;">DETALLES DE PAGOS</strong>
                    <table class="table table-sm" style="font-size:10px">
                        <thead>
                            <tr>
                                <th class="text-start">FECHA</th>
                                <th class="text-center">NUMERO</th>
                                <th class="text-center">FORMA DE COBRO</th>
                                <th class="text-center">DIARIO</th>
                                <th class="text-end">MONTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.payment_ids" t-as="line">
                            <tr>
                                <td class="text-start">
                                    <span t-field="line.date"></span>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.name"></span>
                                </td>
                                <td class="text-center">
                                    <span t-if="line.journal_id.type == 'bank'" t-esc="'TRANSFERENCIA'"/>
                                    <span t-if="line.journal_id.type == 'cash'" t-esc="'EFECTIVO'"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.journal_id.name"></span>
                                </td>
                                <td class="text-end">
                                    <span t-field="line.amount_company_currency_signed" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                </td>
                            </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-if="len(doc.credit_note_ids) > 0" id="payment_details">
                    <strong>DETALLES DE LAS NOTAS DE CRÉDITO</strong>
                    <table class="table table-sm" style="font-size:10px">
                        <thead>
                            <tr>
                                <th class="text-start">FECHA</th>
                                <th>NOTA CREDITO</th>
                                <!-- <th>TIPO</th> -->
                                <th class="text-end">MONTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.credit_note_ids" t-as="line">
                            <tr>
                                <td class="text-start">
                                    <span t-field="line.invoice_date"></span>
                                </td>
                                <td class="text-center">
                                    <span t-esc="line.invoice_number or line.name"/>
                                </td>
                                <!-- <td class="text-center">
                                    <span t-field="line.voucher_type"></span>
                                </td> -->
                                <td class="text-end">
                                    <span t-field="line.amount_total_signed" t-options="{'widget': 'monetary', 'display_currency': line.company_currency_id}"/>
                                </td>
                            </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <br/>
                <br/>

                <div class="row" id="signature">
                    <div class="col-6 text-center">
                        <span>_________________________</span>
                        <br/>
                        <span style="font-size:10px;">Firma</span>
                    </div>
                    <div class="col-6 text-center">
                        <span>_________________________</span>
                        <br/>
                        <span style="font-size:10px;">Aclaración de firma</span>
                    </div>
                </div>

                <!-- <br/>
                
                <div class="text-center">
                    <i><span class="text-center" style="font-size:10px;">- RECIBO DE DINERO AUTOIMPRESO - Nota: Si el pago se realizó con cheque, este recibo será válido para la compensación.</span></i>
                </div> -->
            </div>
        </t>
    </template>

    <template id="report_advanced_receipt_payments">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="advanced_receiptmoney_cross.report_advanced_receipt_payments_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- report action -->

    <record id="action_report_advanced_receipt_payments" model="ir.actions.report">
        <field name="name">Recibo de dinero</field>
        <field name="model">advanced.receipt.payments</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_receiptmoney_cross.report_advanced_receipt_payments</field>
        <field name="report_file">advanced_receiptmoney_cross.report_advanced_receipt_payments</field>
        <field name="binding_model_id" ref="advanced_receiptmoney_cross.model_advanced_receipt_payments"/>
        <field name="paperformat_id" ref="advanced_receiptmoney_cross.paperformat_a4_narrow_receiptmoney"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">('Recibo de dinero ' + object.name)</field>
    </record>

</odoo>
