<odoo>

    <!-- form view -->

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//app[@name='account']" position="inside">
                <block title="Firma en el recibo de dinero" name="add_employee_signature_container">
                    <setting string="Firma en el recibo de dinero" company_dependent="1" help="Esta opción instala el módulo de empleados si no lo tienes para gestionar firmas.">
                        <div class="content-group">
                            <div class="mt16">
                                <div>
                                    <label string="Agregar la firma del empleado al recibo de dinero" for="module_advanced_receiptmoney_signature_cross" class="col-2 o_light_label"/>
                                    <field name="module_advanced_receiptmoney_signature_cross"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        
        </field>
    </record>

</odoo>
