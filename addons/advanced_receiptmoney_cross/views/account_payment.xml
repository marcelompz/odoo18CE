<odoo>

    <!-- hide the standard odoo payment receipt print button -->

    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- form view -->

    <record id="account_payment_inherit_form" model="ir.ui.view">
        <field name="name">account.payment.inherit.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">

            <!-- boton recibo de dinero -->
            <xpath expr="//header" position="inside">
                <button 
                    name="action_create_receipt_payment" 
                    type="object" 
                    string="Recibo de dinero"
                    class="oe_highlight"
                    invisible="count_receipt_payments != 0 or payment_type == 'outbound' or state in ['draft','cancel']"
                />
            </xpath>

            <!-- boton inteligente, recibo de dinero -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="button_open_receipt_payments" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="count_receipt_payments == 0">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">
                            <field name="count_receipt_payments"/>
                            <span> Recibo de dinero</span>
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- campo concepto -->
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="concept"/>
            </xpath>
        
        </field>
    </record>

    <!-- tree view -->

    <record id="account_payment_inherit_tree" model="ir.ui.view">
        <field name="name">account.payment.inherit.tree</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="arch" type="xml">

            <!-- boton recibo de dinero -->
            <xpath expr="//list//header" position="inside">
                <button name="action_create_receipt_payment_group" type="object" string="Receipt payment"/>
            </xpath>

            <!-- boton ver recibo de dinero -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="receipt_payment_id" invisible="1"/>
                <button name="button_open_receipt_payments" type="object" string="" icon="fa-file-text-o" invisible="not receipt_payment_id"/>
            </xpath>
        
        </field>
    </record>

</odoo>
