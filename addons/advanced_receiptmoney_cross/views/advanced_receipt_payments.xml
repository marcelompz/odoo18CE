<odoo>

    <!-- tree view -->

    <record id="advanced_receipt_payments_tree" model="ir.ui.view">
        <field name="name">advanced.receipt.payments.tree</field>
        <field name="model">advanced.receipt.payments</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'canceled'" sample="1" default_order="id desc">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id"/>
                <field name="payment_date"/>
                <field name="currency_id" invisible="1"/>
                <field name="total_amount" options="{'currency_field': 'currency_id'}"/>
                <field 
                    name="state" 
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </list>
        </field>
    </record>

    <!-- form view -->

    <record id="advanced_receipt_payments_form" model="ir.ui.view">
        <field name="name">advanced.receipt.payments.form</field>
        <field name="model">advanced.receipt.payments</field>
        <field name="arch" type="xml">
            <form>
                
                <header>
                    <button name="button_done" type="object" string="Confirmar" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="%(advanced_receiptmoney_cross.action_report_advanced_receipt_payments)d" type="action" string="Imprimir" class="oe_highlight" invisible="state == 'draft'"/>
                    <button name="button_draft" type="object" string="Reestablecer a borrador" invisible="state == 'draft'" confirm="Estás seguro de que deseas reestablecer a borrador el recibo de pago?"/>
                    <button name="button_cancel" type="object" string="Cancelar" invisible="state in ['draft','canceled']" confirm="Estás seguro de que deseas cancelar el recibo de pago?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                
                <div 
                    role="alert" 
                    class="alert alert-warning oe_edit_only text-center" 
                    style="height:48px, width:30px; margin-botton:1px"
                    invisible="not has_credit_note or state in ['done','canceled']">
                    ¡Tienes notas de crédito relacionada a la factura que puedes agregar al recibo de dinero!
                </div>

                <sheet>
                    <div class="position-relative">
                        <h1>
                            <field name="total_amount" class="position-absolute top-0 end-0" decoration-info="1" decoration-bf="1"/>
                        </h1>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" groups="!base.group_system"/>
                            <field name="name" readonly="state != 'draft'" groups="base.group_system"/>
                        </h1>
                    </div>
                    <group>
                        <group name="group_left">
                            <field name="partner_id" default_focus="1" readonly="state in ['done','canceled']" required="1"/>
                            <field name="concept"/>
                            <field name="has_credit_note" invisible="1"/>
                        </group>
                        <group name="group_right">
                            <field name="payment_date" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Facturas -->
                    <h2 class="text-center">Detalles de las facturas</h2>
                    <field name="customer_invoices_domain" invisible="1"/>
                    <field name="invoice_ids" 
                        domain="customer_invoices_domain" 
                        context="{'list_view_ref': 'advanced_receiptmoney_cross.view_move_tree_invoice_selection'}"
                        readonly="state in ['done','canceled']"
                    >
                        <list>
                            <field name="invoice_number" string="Nro. Factura"/>
                            <field name="name" string="Nro. Interno"/>
                            <field name="invoice_date"/>
                            <!-- <field name="currency_id" column_invisible="1"/> -->
                            <!-- <field name="amount_total_in_currency_signed"/> -->
                            <field name="company_currency_id" column_invisible="1"/>
                            <field name="amount_total_signed" string="Total Factura" sum="total_amount"/>
                            <field name="amount_residual_signed" string="Saldo a Pagar" sum="total_residual"/>
                            <field name="payment_state"
                                widget="badge"
                                decoration-danger="payment_state == 'not_paid'"
                                decoration-warning="payment_state in ('partial', 'in_payment')"
                                decoration-success="payment_state in ('paid', 'reversed')"
                                optional="show"/>
                            <button 
                                name="add_withholdings" 
                                type="object" 
                                string=" Retención"
                                icon="fa-plus-square"
                                invisible="parent.state in ['done','canceled']"
                            />
                        </list>
                    </field>

                    <!-- Pagos -->
                    <h2 class="text-center">Detalles de pagos</h2>
                    <field name="customer_payments_domain" invisible="1"/>
                    <field name="payment_ids" domain="customer_payments_domain" readonly="state in ['done','canceled']">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount"/>
                            <field name="company_currency_id" column_invisible="1"/>
                            <field name="amount_company_currency_signed" sum="total_amount"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state or ['in_process','paid']"/>
                        </list>
                    </field>

                    <!-- Notas de creditos -->
                    <h2 class="text-center">Detalles de las notas de crédito</h2>
                    <field name="reversed_entries_ids" invisible="1"/>
                    <field name="credit_note_ids" domain="[('id','in',reversed_entries_ids)]" readonly="state in ['done','canceled']">
                        <list>
                            <field name="invoice_number"/>
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_total_in_currency_signed"/>
                            <field name="company_currency_id" column_invisible="1"/>
                            <field name="amount_total_signed" sum="total_amount"/>
                            <field name="payment_state"
                                widget="badge"
                                decoration-danger="payment_state == 'not_paid'"
                                decoration-warning="payment_state in ('partial', 'in_payment')"
                                decoration-success="payment_state in ('paid', 'reversed')"
                                optional="show"/>
                        </list>
                    </field>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- search view -->

    <record id="advanced_receipt_payments_search" model="ir.ui.view">
        <field name="name">advanced.receipt.payments.search</field>
        <field name="model">advanced.receipt.payments</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_done" string="Confirmados" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancel" string="Cancelados" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter name="payment_date" string="Fecha del recibo" date="payment_date"/>
                <filter name="groupby_partner" string="Cliente" context="{'group_by': 'partner_id'}" />
                <filter name="groupby_state" string="Estado" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>

    <!-- window action -->

    <record id="advanced_receipt_payments_action" model="ir.actions.act_window">
        <field name="name">Recibo de dinero</field>
        <field name="res_model">advanced.receipt.payments</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="advanced_receipt_payments_menu"
        name="Recibo de dinero"
        action="advanced_receiptmoney_cross.advanced_receipt_payments_action"
        parent="account.menu_finance_receivables"
        sequence="111"
    />

</odoo>
