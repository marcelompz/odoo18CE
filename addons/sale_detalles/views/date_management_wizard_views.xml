<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para el wizard de gestión de fechas -->
    <record id="view_date_management_wizard_form" model="ir.ui.view">
        <field name="name">date.management.wizard.form</field>
        <field name="model">date.management.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestión de Fechas">
                <sheet>
                    <group>
                        <group string="Órdenes Seleccionadas">
                            <field name="order_ids" readonly="1"/>
                        </group>
                        <group string="Configuración de Fechas">
                            <field name="confirmation_date"/>
                            <field name="set_validity_date"/>
                            <field name="days_to_validity" invisible="not set_validity_date"/>
                            <field name="validity_date" invisible="not set_validity_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="apply_to_all"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_validate_dates" string="Validar Fechas" type="object" class="btn-secondary"/>
                    <button name="action_apply_dates" string="Aplicar Fechas" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 