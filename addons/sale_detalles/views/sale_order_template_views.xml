<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para agregar campo código -->
    <!-- Intentando con diferentes nombres de vista -->
    <record id="view_sale_order_template_form_inherit_code" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit.code</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='sale_order_template_title']" position="after">
                <group>
                    <field name="code" placeholder="Código de la plantilla de cotización"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vista de lista para plantillas de cotización con código -->
    <record id="view_sale_order_template_list_code" model="ir.ui.view">
        <field name="name">sale.order.template.list.code</field>
        <field name="model">sale.order.template</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <list string="Plantillas de Cotización">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
</odoo>

