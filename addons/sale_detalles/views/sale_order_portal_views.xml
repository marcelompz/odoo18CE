<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista del Portal para Órdenes de Venta -->
    <template id="sale_order_portal_content_inherit" name="Sales Order Portal Content Inherit" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//section[@id='details']" position="replace">
            <section id="order_details" class="mt-4">
                <h4>Detalles por Tallas</h4>
                <hr class="mt-0 mb-1"/>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Modelo</th>
                                <th>Nombre</th>
                                <th>Número</th>
                                <th>Otros</th>
                                <th>Cantidad</th>
                                <th>Productos</th>
                                <th>Precio</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sale_order.order_detail_lines" t-as="detail">
                                <td><span t-esc="detail.customer_model.name"/></td>
                                <td><span t-esc="detail.name_customer"/></td>
                                <td><span t-esc="detail.number_customer"/></td>
                                <td><span t-esc="detail.other_customer"/></td>
                                <td><span t-esc="detail.quantity"/></td>
                                <td>
                                    <ul class="list-unstyled mb-0">
                                        <li t-if="detail.product1_variant_id">
                                            <small>
                                                <strong>Producto 1:</strong>
                                                <span t-esc="detail.product1_variant_id.display_name"/>
                                            </small>
                                        </li>
                                        <li t-if="detail.product2_variant_id">
                                            <small>
                                                <strong>Producto 2:</strong>
                                                <span t-esc="detail.product2_variant_id.display_name"/>
                                            </small>
                                        </li>
                                        <li t-if="detail.product3_variant_id">
                                            <small>
                                                <strong>Producto 3:</strong>
                                                <span t-esc="detail.product3_variant_id.display_name"/>
                                            </small>
                                        </li>
                                        <li t-if="detail.product4_variant_id">
                                            <small>
                                                <strong>Producto 4:</strong>
                                                <span t-esc="detail.product4_variant_id.display_name"/>
                                            </small>
                                        </li>
                                        <li t-if="detail.product5_variant_id">
                                            <small>
                                                <strong>Producto 5:</strong>
                                                <span t-esc="detail.product5_variant_id.display_name"/>
                                            </small>
                                        </li>
                                    </ul>
                                </td>
                                <td><span t-out="detail.price" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/></td>
                                <td><span t-out="detail.subtotal" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-end"><strong>Total General:</strong></td>
                                <td><strong t-out="sale_order.total_general" t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>

            <section id="model_details" class="mt-4">
                <h4>Líneas de Modelos</h4>
                <hr class="mt-0 mb-1"/>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Modelo</th>
                                <th>Imagen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sale_order.model_line_ids" t-as="model">
                                <td><span t-esc="model.model_type_id.name"/></td>
                                <td>
                                    <img t-if="model.image" t-att-src="image_data_uri(model.image)" style="max-width: 200px; max-height: 200px;" class="img-fluid"/>
                                    <a t-if="model.image"
                                       href="#"
                                       t-att-data-img="image_data_uri(model.image)"
                                       class="btn btn-sm btn-outline-primary ms-2 open-image-modal">
                                        Ver imagen
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Modal personalizado sin Bootstrap JS -->
            <div id="imageModal" style="display:none; position:fixed; z-index:1050; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
              <div style="background:#fff; padding:20px; border-radius:8px; max-width:90vw; max-height:90vh; position:relative; display:flex; flex-direction:column; align-items:center;">
                <button id="closeImageModal" style="position:absolute; top:10px; right:10px; background:transparent; border:none; font-size:2rem; line-height:1; cursor:pointer;">×</button>
                <h5 style="margin-bottom:15px;">Imagen del Modelo</h5>
                <img id="modalImage" src="" alt="Imagen del modelo" style="max-width:80vw; max-height:70vh;"/>
              </div>
            </div>

            <t t-jquery="body" t-operation="append">
              <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                  document.querySelectorAll('.open-image-modal').forEach(function(btn) {
                    btn.addEventListener('click', function(e) {
                      e.preventDefault();
                      var imgSrc = btn.getAttribute('data-img');
                      document.getElementById('modalImage').src = imgSrc;
                      document.getElementById('imageModal').style.display = 'flex';
                    });
                  });
                  document.getElementById('closeImageModal').addEventListener('click', function() {
                    document.getElementById('imageModal').style.display = 'none';
                    document.getElementById('modalImage').src = '';
                  });
                  // Cerrar modal al hacer click fuera del contenido
                  document.getElementById('imageModal').addEventListener('click', function(e) {
                    if (e.target === this) {
                      this.style.display = 'none';
                      document.getElementById('modalImage').src = '';
                    }
                  });
                });
              </script>
            </t>
        </xpath>
    </template>
</odoo> 