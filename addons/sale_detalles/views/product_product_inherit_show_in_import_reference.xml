<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_show_in_import_reference" model="ir.ui.view">
        <field name="name">product.template.form.inherit.show_in_import_reference</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="reference_code" placeholder="Código base para referencia" required="0"/>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="show_in_import_reference"/>
                    <label for="show_in_import_reference"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo> 