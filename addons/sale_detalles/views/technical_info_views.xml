<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para preguntas técnicas -->
    <record id="view_technical_info_question_form" model="ir.ui.view">
        <field name="name">technical.info.question.form</field>
        <field name="model">technical.info.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="recurrent"/>
                        <field name="permite_null"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para preguntas técnicas -->
    <record id="view_technical_info_question_list" model="ir.ui.view">
        <field name="name">technical.info.question.list</field>
        <field name="model">technical.info.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="recurrent"/>
                <field name="permite_null"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda para preguntas técnicas -->
    <record id="view_technical_info_question_search" model="ir.ui.view">
        <field name="name">technical.info.question.search</field>
        <field name="model">technical.info.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Preguntas Recurrentes" name="recurrent" domain="[('recurrent', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Recurrente" name="group_by_recurrent" context="{'group_by': 'recurrent'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para preguntas técnicas -->
    <record id="action_technical_info_question" model="ir.actions.act_window">
        <field name="name">Preguntas Técnicas</field>
        <field name="res_model">technical.info.question</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva pregunta técnica
            </p>
        </field>
    </record>

    <!-- Menú para preguntas técnicas -->
    <menuitem id="menu_technical_info_question"
              name="Preguntas Técnicas"
              action="action_technical_info_question"
              parent="sale.sale_menu_root"
              sequence="100"/>
</odoo> 