<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Acción para gestión de fechas -->
        <record id="action_date_management_wizard" model="ir.actions.act_window">
            <field name="name">Gestión de Fechas</field>
            <field name="res_model">date.management.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>

        <!-- Acción para ver modelos de la orden -->
        <record id="action_view_models" model="ir.actions.act_window">
            <field name="name">Modelos de la Orden</field>
            <field name="res_model">order.detail.model.lines</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sale_detalles.view_order_detail_list"/>
            <field name="domain">[('order_id', '=', active_id)]</field>
            <field name="context">{'default_order_id': active_id}</field>
        </record>

        <!-- Acción para agregar modelo -->
        <record id="action_add_model_form" model="ir.actions.act_window">
            <field name="name">Agregar Modelo</field>
            <field name="res_model">order.detail.model.lines</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale_detalles.view_order_detail_model_lines_form"/>
            <field name="target">current</field>
            <field name="context">{'default_order_id': active_id}</field>
        </record>
    </data>
</odoo> 