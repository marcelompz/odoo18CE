<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_detail_wizard_form" model="ir.ui.view">
        <field name="name">import.detail.wizard.form</field>
        <field name="model">import.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Detalles">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="order_name" readonly="1"/>
                    </group>
                    <group>
                        <field name="import_data" widget="text" placeholder="Pegue aquí los datos tabulados..."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p><strong>El formato debe ser:</strong></p>
                        <pre>Modelo	nombre	numero	otros	cantidad	categoría1	talle1	categoría2	talle2	categoría3	talle3	categoría4	talle4	categoría5	talle5</pre>
                        <p class="mt-2"><strong>Ejemplo:</strong></p>
                        <pre>Modelo1	Juan	123	Notas	2	Remera	M	Pantalón	L	Remera	XL</pre>
                        <p class="mt-2">El código del producto se construirá automáticamente como: <strong>código_plantilla-código_categoría-talle</strong></p>
                        <p>Ejemplo: Si la plantilla tiene código "PRM01" y la categoría "Remera" tiene código "REM", con talla "M", el código final será: <strong>PRM01-REM-M</strong></p>
                        <div class="mt-3 text-center">
                            <a href="/sale_detalles/static/plantilla_importacion.xlsx" class="btn btn-primary" target="_blank">
                                Descargar Plantilla Excel
                            </a>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Importar" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_detail_wizard" model="ir.actions.act_window">
        <field name="name">Importar Detalles</field>
        <field name="res_model">import.detail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_order_id': active_id}</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo> 