<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para tipos de modelos -->
    <record id="view_model_type_list" model="ir.ui.view">
        <field name="name">model.type.list</field>
        <field name="model">model.type</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Tipos de Modelos" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para tipos de modelos -->
    <record id="view_model_type_form" model="ir.ui.view">
        <field name="name">model.type.form</field>
        <field name="model">model.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Modelo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para tipos de modelos -->
    <record id="view_model_type_search" model="ir.ui.view">
        <field name="name">model.type.search</field>
        <field name="model">model.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipos de Modelos">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Activo" name="group_by_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para tipos de modelos -->
    <record id="action_model_type" model="ir.actions.act_window">
        <field name="name">Tipos de Modelos</field>
        <field name="res_model">model.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_model_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo tipo de modelo
            </p>
        </field>
    </record>
</odoo> 