<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista principal del wizard -->
    <record id="view_add_model_wizard_form" model="ir.ui.view">
        <field name="name">add.model.wizard.form</field>
        <field name="model">add.model.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar/Modificar Modelo">
                <sheet>
                    <!-- Información de la orden -->
                    <div class="oe_title" style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
                        <h3>Información de la Orden</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="order_name" string="Número de Orden"/>
                                <field name="order_name" readonly="1"/>
                            </div>
                            <div class="col-md-6">
                                <label for="partner_name" string="Cliente"/>
                                <field name="partner_name" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Alerta de modificación -->
                    <div class="alert alert-info" role="alert" style="margin-bottom: 20px;" invisible="not is_modification">
                        <strong>ℹ️ Modificación Detectada:</strong> Ya existe un modelo del tipo "<field name="model_type_id" readonly="1"/>" en esta orden. 
                        Al continuar, se actualizará la imagen y la información del modelo existente.
                        <br/>
                        <small>Los cambios se registrarán en el historial de diseño.</small>
                    </div>
                    
                    <!-- Información del modelo -->
                    <group string="Información del Modelo">
                        <group>
                            <field name="order_id" invisible="1"/>
                            <field name="is_modification" invisible="1"/>
                            <field name="existing_model_line_id" invisible="1"/>
                            <field name="model_type_id" placeholder="Seleccione un tipo de modelo" required="1"/>
                            <field name="quantity" required="1"/>
                        </group>
                        <group>
                            <field name="designer_id" placeholder="Seleccione un diseñador"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    
                    <!-- Productos relacionados -->
                    <group string="Productos Relacionados">
                        <field name="product_ids" widget="many2many_tags" 
                               placeholder="Seleccione productos relacionados"
                               help="Seleccione los productos que están relacionados con este modelo"/>
                    </group>
                    
                    <!-- Notas adicionales -->
                    <group string="Notas y Comentarios">
                        <field name="notes" placeholder="Agregue notas adicionales sobre el modelo, especificaciones técnicas, requerimientos especiales..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_add_model" 
                            type="object" 
                            string="Agregar Modelo"
                            class="btn-primary"
                            icon="fa-plus"/>
                    <button name="action_cancel" 
                            type="object" 
                            string="Cancelar" 
                            class="btn-secondary"
                            icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 
