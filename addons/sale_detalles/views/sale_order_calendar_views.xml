<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de calendario para órdenes de venta por fecha de vencimiento -->
    <record id="view_sale_order_calendar" model="ir.ui.view">
        <field name="name">sale.order.calendar</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <calendar string="Órdenes por Fecha de Vencimiento" 
                      date_start="validity_date" 
                      color="partner_id">
                <field name="name" string="Orden"/>
                <field name="partner_id" string="Cliente"/>
                <field name="total_products_count" string="Cantidad de Productos"/>
                <field name="amount_total" string="Monto Total"/>
            </calendar>
        </field>
    </record>

    <!-- Vista de lista para órdenes de venta -->
    <record id="view_sale_order_list_calendar" model="ir.ui.view">
        <field name="name">sale.order.list.calendar</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Venta" 
                  decoration-info="validity_date &gt;= context_today()"
                  decoration-warning="validity_date &lt; context_today() and validity_date &gt;= (context_today() - datetime.timedelta(days=7))"
                  decoration-danger="validity_date &lt; (context_today() - datetime.timedelta(days=7))">
                <field name="name" string="Orden"/>
                <field name="partner_id" string="Cliente"/>
                <field name="validity_date" string="Fecha de Vencimiento"/>
                <field name="total_products_count" string="Cantidad de Productos"/>
                <field name="amount_total" string="Monto Total"/>
                <field name="stage_id" string="Etapa"/>
                <field name="date_status" string="Estado de Fechas" widget="badge" options="{'classes': {'pending': 'badge-warning', 'valid': 'badge-success', 'invalid': 'badge-danger', 'overdue': 'badge-danger'}}"/>
            </list>
        </field>
    </record>

    <!-- Acción de ventana para la vista de calendario y lista -->
    <record id="action_sale_order_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Órdenes</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">calendar,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                     (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_sale_order_calendar')}),
                                     (0, 0, {'view_mode': 'list', 'view_id': ref('view_sale_order_list_calendar')})]"/>
        <field name="domain">[('validity_date', '!=', False)]</field>
        <field name="context"><![CDATA[{'search_default_validity_date_filter': 1}]]></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay órdenes con fecha de vencimiento programada
            </p>
            <p>
                Las órdenes se mostrarán en el calendario según su fecha de vencimiento.
                Cada evento mostrará el número de orden, cliente, cantidad de productos y monto total.
                También puedes ver la lista de órdenes con información detallada.
            </p>
        </field>
    </record>

    <!-- Vista de búsqueda completamente nueva -->
    <record id="view_sale_order_calendar_search" model="ir.ui.view">
        <field name="name">sale.order.calendar.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Búsqueda de Órdenes de Venta">
                <field name="name" string="Orden"/>
                <field name="partner_id" string="Cliente"/>
                <field name="validity_date" string="Fecha de Vencimiento"/>
                <filter string="Con Fecha de Vencimiento" 
                        name="validity_date_filter" 
                        domain="[('validity_date', '!=', False)]"/>
                <filter string="Vencidas" 
                        name="overdue_orders" 
                        domain="[('validity_date', '&lt;', context_today())]"/>
                <filter string="Pendientes" 
                        name="pending_orders" 
                        domain="[('validity_date', '&gt;=', context_today())]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha de Vencimiento" 
                            name="group_by_validity_date" 
                            context="{'group_by': 'validity_date:month'}"/>
                    <filter string="Cliente" 
                            name="group_by_partner" 
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" 
                            name="group_by_state" 
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo> 