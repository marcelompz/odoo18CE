<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Acción para Detalles de Tallas -->
        <record id="action_order_detail_lines" model="ir.actions.act_window">
            <field name="name">Detalles de Tallas</field>
            <field name="res_model">order.detail.lines</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nuevo detalle de talla
                </p>
            </field>
        </record>

        <!-- Acción para Líneas de Modelos -->
        <record id="action_order_detail_model_lines" model="ir.actions.act_window">
            <field name="name">Líneas de Modelos</field>
            <field name="res_model">order.detail.model.lines</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sale_detalles.view_order_detail_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva línea de modelo
                </p>
            </field>
        </record>

        <!-- Acción para importar detalles -->
        <record id="action_import_detail_wizard" model="ir.actions.act_window">
            <field name="name">Importar Detalles</field>
            <field name="res_model">import.detail.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_order_id': active_id}</field>
        </record>

        <!-- Acción principal de ventas con vista de calendario -->
        <record id="action_sale_order_main" model="ir.actions.act_window">
            <field name="name">Órdenes de Venta</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,calendar</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nueva orden de venta
                </p>
            </field>
        </record>
    </data>
</odoo> 