<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para configuración -->
    <record id="view_sale_detalles_config_form" model="ir.ui.view">
        <field name="name">sale.detalles.config.form</field>
        <field name="model">sale.detalles.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Sale Detalles">
                <sheet>
                    <group>
                        <group string="Configuración General">
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group string="Secuencia de Productos">
                            <field name="sequence_product_next_number"
                                   help="Edite este valor para definir el próximo número que se usará al generar códigos de producto"/>
                        </group>
                        <group string="Validación de Fechas">
                            <field name="min_validity_date_days" 
                                   help="Número mínimo de días que debe tener la validity_date desde hoy para poder aprobar la venta"/>
                        </group>
                    </group>
                    <group string="Información">
                        <field name="min_validity_date_days" readonly="1" 
                               string="Días Mínimos Configurados"/>
                        <field name="min_validity_date" readonly="1" 
                               string="Fecha Mínima Calculada"
                               widget="date"
                               options="{'format': 'dd/MM/yyyy'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista para configuración -->
    <record id="view_sale_detalles_config_list" model="ir.ui.view">
        <field name="name">sale.detalles.config.list</field>
        <field name="model">sale.detalles.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones">
                <field name="name"/>
                <field name="sequence_product_next_number"/>
                <field name="min_validity_date_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Acción de ventana para configuración -->
    <record id="action_sale_detalles_config" model="ir.actions.act_window">
        <field name="name">Configuración de Sale Detalles</field>
        <field name="res_model">sale.detalles.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva configuración
            </p>
            <p>
                Configure aquí los parámetros del módulo Sale Detalles.
                Especialmente importante es configurar los días mínimos para la validity_date.
            </p>
        </field>
    </record>
</odoo> 