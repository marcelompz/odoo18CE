<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario para etapas de venta -->
        <record id="view_sale_stage_form" model="ir.ui.view">
            <field name="name">sale.stage.form</field>
            <field name="model">sale.stage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence" widget="handle"/>
                            <field name="description"/>
                            <field name="color" widget="color_picker"/>
                            <field name="is_done"/>
                            <field name="is_cancel"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de lista para etapas de venta -->
        <record id="view_sale_stage_list" model="ir.ui.view">
            <field name="name">sale.stage.list</field>
            <field name="model">sale.stage</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="is_done"/>
                    <field name="is_cancel"/>
                </list>
            </field>
        </record>

        <!-- Vista kanban para etapas de venta -->
        <record id="view_sale_stage_kanban" model="ir.ui.view">
            <field name="name">sale.stage.kanban</field>
            <field name="model">sale.stage</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name" fold="False"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="description"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Acción de ventana para etapas de venta -->
        <record id="action_sale_stage" model="ir.actions.act_window">
            <field name="name">Etapas de Venta</field>
            <field name="res_model">sale.stage</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea una nueva etapa de venta
                </p>
            </field>
        </record>

        <!-- Elemento de menú para etapas de venta -->
        <menuitem id="menu_sale_stage"
                  name="Etapas de Venta"
                  action="action_sale_stage"
                  parent="sale.sale_menu_root"
                  sequence="100"/>
    </data>
</odoo> 