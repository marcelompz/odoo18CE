<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="order_detail_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <!-- Cabecera personalizada -->
                        <table class="table table-borderless" style="margin-bottom: 20px; font-size: 18px; font-weight: bold; border: 2px solid #333; border-radius: 8px; box-shadow: 2px 2px 8px #ccc;">
                            <tr>
                                <td><strong>Orden:</strong> <span t-esc="order.name"/></td>
                                <td><strong>Referencia Cliente:</strong> <span t-esc="order.client_order_ref or ''"/></td>
                                <td><strong>Fecha de Entrega:</strong> <span t-esc="order.validity_date or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Cliente:</strong> <span t-esc="order.partner_id.name or ''"/></td>
                                <td><strong>Vendedor:</strong> <span t-esc="order.user_id.name or ''"/></td>
                                <td><strong>Gestor:</strong> <span t-esc="order.manager_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Fecha Confirmación:</strong> <span t-esc="order.confirmation_date or 'No confirmada'"/></td>
                                <td><strong>Fecha Vencimiento:</strong> <span t-esc="order.validity_date or 'No establecida'"/></td>
                                <td><strong>Estado Fechas:</strong> <span t-esc="dict(order._fields['date_status'].selection).get(order.date_status, '')"/></td>
                            </tr>
                        </table>
                        <h3>Lista</h3>
                        <table class="table" style="font-size: 12px;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Orden</th>
                                    <th>Modelo</th>
                                    <th>Nombre</th>
                                    <th>Número</th>
                                    <th>Otros Datos</th>
                                    <th>Cantidad</th>
                                    <th>Productos</th>
                                   
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <tr t-foreach="order.order_detail_lines.sorted('sequence')" t-as="line">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <td><span t-esc="idx"/></td>
                                    <td><span t-esc="line.sequence"/></td>
                                    <td><span t-esc="line.customer_model.name or ''"/></td>
                                    <td><span t-esc="line.name_customer or ''"/></td>
                                    <td><span t-esc="line.number_customer or ''"/></td>
                                    <td><span t-esc="line.other_customer or ''"/></td>
                                    <td><span t-esc="line.quantity or 0"/></td>
                                    <td>
                                        <t t-esc="line.product1_variant_id.display_name if line.product1_variant_id else ''"/>
                                        <t t-esc="('+' + line.product2_variant_id.display_name) if line.product2_variant_id else ''"/>
                                        <t t-esc="('+' + line.product3_variant_id.display_name) if line.product3_variant_id else ''"/>
                                        <t t-esc="('+' + line.product4_variant_id.display_name) if line.product4_variant_id else ''"/>
                                        <t t-esc="('+' + line.product5_variant_id.display_name) if line.product5_variant_id else ''"/>
                                    </td>
                                    
                                    
                                </tr>
                            </tbody>
                        </table>
                        <!-- Ficha Técnica -->
                        <h3>Resumen de Productos</h3>
                        <t t-raw="order.sale_order_line_summary_html"/>
                        <t t-if="order.technical_info_ids">
                            <h3>Ficha Técnica</h3>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Pregunta</th>
                                        <th>Respuesta</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.technical_info_ids" t-as="info">
                                        <tr>
                                            <td><span t-esc="info.question_id.name or ''"/></td>
                                            <td><span t-esc="info.answer or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <!-- Modelos -->
                        <t t-if="order.model_line_ids">
                            <h3>Modelos</h3>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Modelo</th>
                                        <th>Imagen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order.model_line_ids" t-as="model">
                                        <tr>
                                            <td>Modelo <span t-esc="model.model_type_id.name or ''"/></td>
                                            <td>
                                                <t t-if="model.image">
                                                    <img t-att-src="image_data_uri(model.image)" style="max-width: 300px; max-height: 300px;"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <!-- DEPURACIÓN -->
                        <div>
                        
                            <strong>order.id:</strong> <span t-esc="order.id"/>
                        </div>
                        
                         <div class="text-center">
                            <img t-att-src="'/report/barcode/QR/' + order.access_url" style="width:150px;height:150px" alt="QR lista"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo> 