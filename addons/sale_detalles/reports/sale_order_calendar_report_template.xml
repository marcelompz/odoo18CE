<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sale_order_calendar_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Reporte de Calendario de Órdenes de Venta</h2>
                        <p><strong>Período:</strong> <span t-esc="start_date.strftime('%d/%m/%Y')"/> - <span t-esc="end_date.strftime('%d/%m/%Y')"/></p>
                        
                        <!-- Resumen estadístico -->
                        <div class="row mt-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Órdenes</h5>
                                        <h3 class="text-primary"><span t-esc="len(docs)"/></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Total Productos</h5>
                                        <h3 class="text-success"><span t-esc="total_products"/></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Monto Total</h5>
                                        <h3 class="text-info"><span t-esc="total_amount"/></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h5 class="card-title">Vencidas</h5>
                                        <h3 class="text-danger"><span t-esc="len(overdue_orders)"/></h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Órdenes por fecha -->
                        <h3 class="mt-4">Órdenes por Fecha de Vencimiento</h3>
                        <div t-foreach="orders_by_date.items()" t-as="date_orders" class="mt-3">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <span t-esc="datetime.strptime(date_orders[0], '%Y-%m-%d').strftime('%A, %d de %B de %Y')"/>
                                        <span t-if="datetime.strptime(date_orders[0], '%Y-%m-%d').date() &lt; today" class="badge badge-danger ml-2">Vencida</span>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div t-foreach="date_orders[1]" t-as="order" class="row border-bottom py-2">
                                        <div class="col-md-3">
                                            <strong>Orden:</strong> <span t-esc="order.name"/>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Cliente:</strong> <span t-esc="order.partner_id.name"/>
                                        </div>
                                        <div class="col-md-2">
                                            <strong>Productos:</strong> <span t-esc="order.total_products_count"/>
                                        </div>
                                        <div class="col-md-2">
                                            <strong>Monto:</strong> <span t-esc="order.amount_total"/>
                                        </div>
                                        <div class="col-md-2">
                                            <strong>Etapa:</strong> <span t-esc="order.stage_id.name if order.stage_id else 'Sin etapa'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Órdenes vencidas destacadas -->
                        <div t-if="overdue_orders" class="mt-4">
                            <h3 class="text-danger">Órdenes Vencidas</h3>
                            <div class="alert alert-danger">
                                <strong>¡Atención!</strong> Hay <span t-esc="len(overdue_orders)"/> órdenes vencidas que requieren atención inmediata.
                            </div>
                            <div t-foreach="overdue_orders" t-as="order" class="row border-bottom py-2">
                                <div class="col-md-3">
                                    <strong>Orden:</strong> <span t-esc="order.name"/>
                                </div>
                                <div class="col-md-3">
                                    <strong>Cliente:</strong> <span t-esc="order.partner_id.name"/>
                                </div>
                                <div class="col-md-2">
                                    <strong>Vencida:</strong> <span t-esc="(today - order.validity_date).days"/> días
                                </div>
                                <div class="col-md-2">
                                    <strong>Productos:</strong> <span t-esc="order.total_products_count"/>
                                </div>
                                <div class="col-md-2">
                                    <strong>Monto:</strong> <span t-esc="order.amount_total"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo> 