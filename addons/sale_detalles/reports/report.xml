<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   
    <record id="action_report_order_detail_simple" model="ir.actions.report">
        <field name="name">Hoja viajera</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_detalles.order_detail_report</field>
        <field name="report_file">sale_detalles.order_detail_report</field>
        <field name="print_report_name">'Hoja viajera - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Reporte de calendario de órdenes -->
    <record id="action_report_sale_order_calendar" model="ir.actions.report">
        <field name="name">Reporte de Calendario de Órdenes</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_detalles.sale_order_calendar_report</field>
        <field name="report_file">sale_detalles.sale_order_calendar_report</field>
        <field name="print_report_name">'Reporte de Calendario - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo> 