<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_contract_form_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.quincena</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wage']" position="after">
                <field name="cn_paga_quincena"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_contract_list_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.contract.list.inherit.quincena</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wage']" position="after">
                <field name="cn_paga_quincena" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
