<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_advance_form_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.advance.form.inherit.quincena</field>
        <field name="model">hr.advance</field>
        <field name="inherit_id" ref="hr_loan_advance_py_cross.view_hr_advance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="advance_type" readonly="1"/>
                <field name="quincena_date" readonly="1"
                       invisible="advance_type != 'quincena'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Calculo de la Quincena"
                       invisible="advance_type != 'quincena'">
                    <group>
                        <field name="quincena_wage" readonly="1"/>
                        <field name="quincena_dias_disponibles" readonly="1"/>
                        <field name="quincena_monto_bruto" readonly="1"/>
                    </group>
                    <group>
                        <field name="quincena_monto_ips" readonly="1"/>
                        <field name="quincena_monto_recupero_beneficio" readonly="1"
                               invisible="quincena_monto_recupero_beneficio == 0"/>
                        <field name="quincena_monto_cuotas_prestamo" readonly="1"
                               invisible="quincena_monto_cuotas_prestamo == 0"/>
                    </group>
                </group>
                <group string="Beneficios/Prestamos incluidos en el descuento"
                       invisible="quincena_loan_count == 0">
                    <field name="quincena_loan_count" readonly="1" string="# Incluidos"/>
                    <field name="quincena_loan_ids" readonly="1" nolabel="1" colspan="2">
                        <list>
                            <field name="name"/>
                            <field name="benefit_type_id" string="Tipo"/>
                            <field name="amount_total" widget="monetary" string="Monto total"/>
                            <field name="is_fractional" string="Fraccionado"/>
                            <field name="amount_per_installment" widget="monetary"
                                   string="Cuota mensual"/>
                            <field name="date_start" string="Fecha"/>
                            <field name="description"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_advance_list_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.advance.list.inherit.quincena</field>
        <field name="model">hr.advance</field>
        <field name="inherit_id" ref="hr_loan_advance_py_cross.view_hr_advance_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="advance_type" optional="show"/>
                <field name="quincena_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_advance_search_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.advance.search.inherit.quincena</field>
        <field name="model">hr.advance</field>
        <field name="inherit_id" ref="hr_loan_advance_py_cross.view_hr_advance_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="advance_type"/>
                <filter string="Solo quincenas" name="solo_quincena"
                        domain="[('advance_type', '=', 'quincena')]"/>
                <filter string="Solo normales" name="solo_normal"
                        domain="[('advance_type', '=', 'normal')]"/>
                <separator/>
                <filter string="Por tipo" name="group_advance_type"
                        context="{'group_by': 'advance_type'}"/>
            </xpath>
        </field>
    </record>

</odoo>
