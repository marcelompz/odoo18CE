<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_benefit_type_list" model="ir.ui.view">
        <field name="name">hr.benefit.type.list</field>
        <field name="model">hr.benefit.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Beneficio">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_fractional_default" widget="boolean_toggle"/>
                <field name="requires_seniority" widget="boolean_toggle"/>
                <field name="default_installments"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_benefit_type_form" model="ir.ui.view">
        <field name="name">hr.benefit.type.form</field>
        <field name="model">hr.benefit.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Beneficio">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Prestamo, Uniforme, Beneficio"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="Ej. PRESTAMO"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="is_fractional_default"/>
                            <field name="requires_seniority"/>
                            <field name="default_installments"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" nolabel="1"
                               placeholder="Descripcion / criterios de uso de este tipo de beneficio..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_benefit_type_search" model="ir.ui.view">
        <field name="name">hr.benefit.type.search</field>
        <field name="model">hr.benefit.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipo">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
                <filter string="Requiere antiguedad" name="seniority"
                        domain="[('requires_seniority','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_benefit_type" model="ir.actions.act_window">
        <field name="name">Tipos de Beneficio</field>
        <field name="res_model">hr.benefit.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_benefit_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo Tipo de Beneficio
            </p>
            <p>
                Los Tipos de Beneficio permiten configurar libremente los beneficios
                disponibles para empleados: Prestamos, Uniformes, Prestamos de
                Emergencia, Bonificaciones, etc. Cada tipo define si requiere
                antiguedad minima, si se fracciona en cuotas y la cantidad de
                cuotas por defecto.
            </p>
        </field>
    </record>

</odoo>
