<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FORM: agrega benefit_type_id, cambia etiquetas "Prestamo" -> "Beneficio"
         ================================================================ -->
    <record id="view_hr_loan_form_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.loan.form.inherit.quincena</field>
        <field name="model">hr.loan</field>
        <field name="inherit_id" ref="hr_loan_advance_py_cross.view_hr_loan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Beneficio a Funcionario</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="benefit_type_id"
                       options="{'no_create_edit': True}"
                       required="1"/>
                <field name="is_fractional"/>
            </xpath>
            <xpath expr="//field[@name='installments']" position="after">
                <field name="installment_first_date" readonly="1"/>
            </xpath>
            <!-- Banner: pendiente de absorber en quincena -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                     role="alert"
                     invisible="not pending_in_quincena or quincena_advance_id">
                    <i class="fa fa-hourglass-half fa-lg"/>
                    <span>
                        <strong>Pendiente de quincena:</strong>
                        Este desembolso sera incluido en el proximo anticipo quincenal del empleado.
                    </span>
                </div>
                <!-- Banner: ya absorbido por una quincena -->
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3"
                     role="alert"
                     invisible="not quincena_advance_id">
                    <i class="fa fa-check-circle fa-lg"/>
                    <span>
                        <strong>Incluido en quincena:</strong>
                        <field name="quincena_advance_id" readonly="1" nolabel="1"
                               class="d-inline ms-1"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         LIST: agrega tipo y badge pendiente en quincena
         ================================================================ -->
    <record id="view_hr_loan_list_inherit_quincena" model="ir.ui.view">
        <field name="name">hr.loan.list.inherit.quincena</field>
        <field name="model">hr.loan</field>
        <field name="inherit_id" ref="hr_loan_advance_py_cross.view_hr_loan_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="string">Beneficios a Funcionarios</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="benefit_type_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="pending_in_quincena" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ================================================================
         SEARCH: nueva vista de search (el modulo base no la tenia)
         ================================================================ -->
    <record id="view_hr_loan_search_quincena" model="ir.ui.view">
        <field name="name">hr.loan.search.quincena</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Buscar Beneficios">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="benefit_type_id"/>
                <separator/>
                <filter string="Borrador" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Aprobado RRHH" name="state_rrhh"
                        domain="[('state', '=', 'rrhh_approved')]"/>
                <filter string="Desembolsado" name="state_paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter string="En curso" name="state_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Cerrado" name="state_finished"
                        domain="[('state', '=', 'finished')]"/>
                <separator/>
                <filter string="Pendiente en quincena" name="pending_quincena"
                        domain="[('pending_in_quincena', '=', True)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Tipo de Beneficio" name="group_benefit_type"
                            context="{'group_by': 'benefit_type_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Renombrar la accion del menu de "Prestamos" -> "Beneficios"
         y asignarle la vista de search
         ================================================================ -->
    <record id="hr_loan_advance_py_cross.action_hr_loan" model="ir.actions.act_window">
        <field name="name">Beneficios a Funcionarios</field>
        <field name="search_view_id" ref="view_hr_loan_search_quincena"/>
    </record>

</odoo>
