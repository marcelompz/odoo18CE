<odoo>

    <!-- form view -->
    <record id="sale_order_prepayment_form_view" model="ir.ui.view">
        <field name="name">sale.order.prepayment.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Botón para registrar el anticipo -->
            <xpath expr="//header" position="inside">
                <button name="action_register_prepayment"
                        string="Registrar Anticipo"
                        type="object"
                        class="oe_highlight"
                        invisible="not id or state == 'cancel'"/>
            </xpath>
            <!-- Botón inteligente para ver los pagos -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="payment_count == 0">
                    <field name="payment_count" widget="statinfo" string="Anticipos"/>
                </button>
            </xpath>

            <!-- Estados y detalles de los pagos -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="id" invisible="1"/>
                <field name="payment_status" invisible="1"/>
                <!-- <field name="invoice_state" invisible="1"/> -->
                <field name="payment_details" widget="payment"
                       style="width: 60%"/>
                <field name="amount_due" options="{'currency_field': 'currency_id'}"/>
            </xpath>

            <!-- ribbon -->
            <xpath expr="//sheet//div[hasclass('oe_button_box')]"
                   position="after">
                <widget name="web_ribbon" title="No pagada"
                        bg_color="bg-danger" invisible = "payment_status != 'No pagada'"/>
                <widget name="web_ribbon" title="Pagada"
                        bg_color="bg-success" invisible = "payment_status !=  'Pagada'"/>
                <widget name="web_ribbon" title="Parcial"
                        bg_color="bg-warning" invisible = "payment_status !=  'Parcial'"/>
                <widget name="web_ribbon" title="En proceso de pago"
                        bg_color="bg-info" invisible = "payment_status !=  'En proceso de pago'"/>
                <widget name="web_ribbon" title="Revertido"
                        bg_color="bg-success" invisible = "payment_status != 'Revertido'"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_detalles.view_order_form_inherit" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="can_continue" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">not can_continue</attribute>
            </xpath>
        
        </field>
    </record>

    <!-- tree view -->
    <record id="sale_order_inherit_tree" model="ir.ui.view">
        <field name="name">sale.order.inherit.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="payment_status" optional="show"
                       decoration-success="payment_status in ['Pagada', 'Revertido']"
                       decoration-danger="payment_status == 'No pagada'"
                       decoration-info="payment_status == 'En proceso de pago'"
                       decoration-bf="payment_status == 'Sin factura'"
                       decoration-warning="payment_status == 'Parcial'"
                       widget="badge"/>
            </xpath>

        </field>
    </record>

</odoo>
