<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Hide product cost and price in product form view-->
     <record id="product_normal_form_view" model="ir.ui.view">
         <field name="name">product.product.view.form.inherit.hide.product.price.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_price</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </field>
        </field>
    </record>
<!--    Hide product cost and price in product kanban view-->
    <record id="product_kanban_view" model="ir.ui.view">
        <field name="name">product.product.view.kanban.inherit.hide.product.price.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[field[@name='list_price'] or field[@name='lst_price']]" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_price</attribute>
            </xpath>
        </field>
    </record>
<!--    Hide product cost and price in product tree view-->
    <record id="product_product_tree_view" model="ir.ui.view">
         <field name="name">product.product.view.form.inherit.hide.product.price.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_price</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </field>
        </field>
    </record>
<!--    Hide product cost and price in products / stock-->
    <record id="product_product_stock_tree_cost_security_inherit" model="ir.ui.view">
        <field name="name">product.product.stock.list.cost.security.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock_account.product_product_stock_tree_inherit_stock_account"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='avg_cost']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </xpath>

            <xpath expr="//field[@name='total_value']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_price</attribute>
            </xpath>

            <xpath expr="//button[@name='%(stock_account.stock_valuation_layer_action)d']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </xpath>

            <xpath expr="//button[@name='%(stock_account.stock_valuation_layer_report_action)d']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </xpath>

        </field>
    </record>
<!--    Hide product cost and price in wizard-->
    <record id="sale_order_line_form_cost_security_inherit_FIX" model="ir.ui.view">
        <field name="name">sale.order.line.form.cost.security.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </xpath>

        </field>
    </record>
<!--    Hide product cost and price in sale order line tree view-->
    <record id="sale_order_line_tree_cost_security_inherit_FIX" model="ir.ui.view">
        <field name="name">sale.order.line.tree.cost.security.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">hide_product_price_cost.hide_product_price_cost_group_user_show_product_cost</attribute>
            </xpath>
            
        </field>
    </record>
</odoo>
