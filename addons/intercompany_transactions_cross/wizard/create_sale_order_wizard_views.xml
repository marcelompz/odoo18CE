<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="create_sale_order_wizard_view_form" model="ir.ui.view">
        <field name="name">create.sale.order.wizard.form</field>
        <field name="model">create.sale.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Venta con Margen">
                <group>
                    <group>
                        <field name="purchase_id"/>
                        <field name="currency_id"/>
                        <field name="partner_id" context="{'res_partner_search_mode': 'customer'}"/>
                    </group>
                    <group>
                        <field name="calculation_method" widget="radio"/>
                        <field name="global_margin" invisible="calculation_method != 'global'"/>
                    </group>
                </group>
                <notebook>
                    <page string="Productos" name="products">
                        <field name="line_ids">
                            <list editable="bottom" create="false" delete="false">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="uom_id" readonly="1" force_save="1"/>
                                <field name="purchase_price" readonly="1" force_save="1"/>
                                <field name="sale_price"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_sale_order" string="Crear Venta" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
