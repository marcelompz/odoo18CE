<odoo>

    <!-- tree view -->

    <record id="res_questions_tree" model="ir.ui.view">
        <field name="name">res.questions.tree</field>
        <field name="model">res.questions</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="stage_ids" widget="many2many_tags"/>
                <field name="answers_count"/>
            </list>
        </field>
    </record>

    <!-- form view -->

    <record id="res_questions_form" model="ir.ui.view">
        <field name="name">res.questions.form</field>
        <field name="model">res.questions</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field class="text-break" name="name" placeholder="Has tu pregunta..." required="1"/></h1>
                    </div>
                    <group>
                        <field name="stage_ids" widget="many2many_tags" required="1"/>
                    </group>
                    <field name="answer_ids" nolabel="1">
                        <list editable="bottom">
                            <control>
                                <create string="Nueva respueta"/>
                            </control>
                            <field name="name"/>
                            <field name="score"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- window action -->

    <record id="res_questions_action" model="ir.actions.act_window">
        <field name="name">Preguntas</field>
        <field name="res_model">res.questions</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Click en nuevo para agregar nuevos registros</p>
        </field>
    </record>

    <!-- menu -->

    <menuitem
        id="res_questions_menu"
        name="Preguntas"
        parent="crm.crm_menu_config"
        sequence="21"
    />

    <menuitem
        id="res_ratings_questions_menu"
        name="Calificaciones"
        action="crm_questions_cross.res_questions_action"
        parent="crm_questions_cross.res_questions_menu"
        sequence="1"
    />

</odoo>
