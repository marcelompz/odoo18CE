<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ===================================================================
        Paperformats compactos
        ===================================================================
        A4 vertical, margenes 5mm, dpi 90 — para 2 copias por hoja
        croquelada (recibos IPS / Interno / Vacaciones)
    -->
    <record id="paperformat_recibo_compacto_2copias" model="report.paperformat">
        <field name="name">Recibo Compacto 2 copias (A4 vertical)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!--
        A4 vertical para 1 copia compacta (recibo de bonificacion)
    -->
    <record id="paperformat_recibo_compacto_1copia" model="report.paperformat">
        <field name="name">Recibo Compacto 1 copia (A4 vertical)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- ===================================================================
        Acciones de Reporte
        =================================================================== -->

    <!-- (1) RECIBO IPS — 2 copias por hoja -->
    <record id="action_report_recibo_ips_a5" model="ir.actions.report">
        <field name="name">Recibo IPS (2 copias)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payslip_bulk_print_cross.report_recibo_ips_a5</field>
        <field name="report_file">hr_payslip_bulk_print_cross.report_recibo_ips_a5</field>
        <field name="print_report_name">'Recibo_IPS_%s_%s' % (object.employee_id.name or '', object.date_to or '')</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_recibo_compacto_2copias"/>
    </record>

    <!-- (2) RECIBO INTERNO — 2 copias por hoja -->
    <record id="action_report_recibo_interno_a5" model="ir.actions.report">
        <field name="name">Recibo Interno (2 copias)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payslip_bulk_print_cross.report_recibo_interno_a5</field>
        <field name="report_file">hr_payslip_bulk_print_cross.report_recibo_interno_a5</field>
        <field name="print_report_name">'Recibo_Interno_%s_%s' % (object.employee_id.name or '', object.date_to or '')</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_recibo_compacto_2copias"/>
    </record>

    <!-- (3) RECIBO BONIFICACION — 1 hoja por empleado -->
    <record id="action_report_recibo_bonificacion" model="ir.actions.report">
        <field name="name">Recibo Bonificacion</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payslip_bulk_print_cross.report_recibo_bonificacion</field>
        <field name="report_file">hr_payslip_bulk_print_cross.report_recibo_bonificacion</field>
        <field name="print_report_name">'Recibo_Bonif_%s_%s' % (object.employee_id.name or '', object.date_to or '')</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_recibo_compacto_1copia"/>
    </record>

    <!-- (4) RECIBO VACACIONES — 2 copias por hoja -->
    <record id="action_report_recibo_vacaciones_a5" model="ir.actions.report">
        <field name="name">Recibo Vacaciones (2 copias)</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payslip_bulk_print_cross.report_recibo_vacaciones_a5</field>
        <field name="report_file">hr_payslip_bulk_print_cross.report_recibo_vacaciones_a5</field>
        <field name="print_report_name">'Recibo_Vac_%s_%s' % (object.employee_id.name or '', object.date_to or '')</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_recibo_compacto_2copias"/>
    </record>

</odoo>
