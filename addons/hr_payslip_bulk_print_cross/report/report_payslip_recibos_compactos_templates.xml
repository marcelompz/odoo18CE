<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================================
        TEMPLATE: Cabecera MTESS oficial COMPACTA (para IPS)
        =================================================================== -->
    <template id="cabecera_mtess_compacta">
        <!-- Cabecera con Ministerio + LIQUIDACION DE SALARIO -->
        <table style="width:100%; border-collapse:collapse; margin-bottom:3px; border-bottom:1.5px solid #000;">
            <tr>
                <td style="width:60%; vertical-align:top; padding:2px 4px;">
                    <div style="font-weight:bold; font-size:9pt; line-height:1.1;">
                        MINISTERIO DE TRABAJO, EMPLEO Y SEGURIDAD SOCIAL PARAGUAY
                    </div>
                    <div style="font-size:7pt; line-height:1.15;">
                        Direccion: Luis A. de Herrera e/ Paraguari<br/>
                        Telefono: (+595 21) 729-0100 | Horario: 07:00hs a 15:00hs
                    </div>
                </td>
                <td style="width:40%; vertical-align:top; padding:2px 4px; text-align:right;">
                    <div style="font-weight:bold; font-size:13pt; line-height:1;">
                        LIQUIDACION DE SALARIO
                    </div>
                    <div style="font-size:9pt;">
                        N&#176;: <span t-esc="o.number or o.id"/> &#160; <b>(<t t-out="etiqueta_copia or 'ORIGINAL'"/>)</b>
                    </div>
                </td>
            </tr>
        </table>

        <!-- EMPLEADOR + TRABAJADOR -->
        <table style="width:100%; border-collapse:collapse; font-size:8pt; margin-bottom:3px;">
            <tr>
                <td style="width:50%; border:1px solid #000; padding:3px 5px; vertical-align:top;">
                    <div style="font-weight:bold; font-size:8.5pt;">EMPLEADOR</div>
                    <div><span t-field="o.company_id.name"/></div>
                    <div style="font-weight:bold;">RUC N&#176;: <span t-field="o.company_id.vat"/></div>
                </td>
                <td style="width:50%; border:1px solid #000; padding:3px 5px; vertical-align:top;">
                    <div style="font-weight:bold; font-size:8.5pt;">NOMBRE Y APELLIDO DEL TRABAJADOR</div>
                    <div><span t-field="o.employee_id.name"/></div>
                    <div style="font-weight:bold;">C.I. N&#176;: <t t-out="o.employee_id.identification_id or '-'"/></div>
                </td>
            </tr>
        </table>

        <!-- PERIODO DE PAGO + DETALLES TRABAJO -->
        <table style="width:100%; border-collapse:collapse; font-size:7.5pt; margin-bottom:3px;">
            <tr>
                <td style="width:50%; border:1px solid #000; padding:3px 5px; vertical-align:top;">
                    <div style="font-weight:bold; font-size:8pt;">PERIODO DE PAGO</div>
                    <div><b>DESDE:</b> <span t-field="o.date_from"/> &#160; <b>HASTA:</b> <span t-field="o.date_to"/></div>
                    <div><b>FECHA:</b> <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/></div>
                    <div>
                        <b>FORMA DE PAGO:</b>
                        <t t-out="(o.struct_id.journal_id.name if o.struct_id and o.struct_id.journal_id else None) or 'Banco'"/>
                    </div>
                </td>
                <td style="width:50%; border:1px solid #000; padding:3px 5px; vertical-align:top;">
                    <div>
                        <b>HORAS TRABAJADAS:</b>
                        <t t-out="'{:.0f}'.format(sum(o.worked_days_line_ids.mapped('number_of_hours'))) if o.worked_days_line_ids else '-'"/>
                    </div>
                    <div>
                        <b>CANTIDAD DE DIAS TRABAJADOS:</b>
                        <t t-out="'{:.0f}'.format(sum(o.worked_days_line_ids.mapped('number_of_days'))) if o.worked_days_line_ids else '-'"/>
                    </div>
                    <div>
                        <b>CANTIDAD DE PIEZAS O TAREAS:</b> 0
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <!-- ===================================================================
        TEMPLATE BASE: Una "media hoja" compacta CROSSNEXION (logo+empresa)
        Usado por: Interno, Bonificacion, Vacaciones
        =================================================================== -->
    <template id="recibo_compacto_seccion">
        <div t-att-style="'border:1px solid #000; padding:6px; margin-bottom:18px; font-family:Arial, sans-serif; font-size:8.5pt; box-sizing:border-box; page-break-inside: avoid;'">

            <table style="width:100%; border-collapse:collapse; margin-bottom:4px;">
                <tr>
                    <td style="width:18%; vertical-align:top; padding:2px;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:42px; max-width:100%;"/>
                    </td>
                    <td style="vertical-align:top; padding:2px; line-height:1.15;">
                        <span style="font-size:10pt; font-weight:bold;"><span t-field="o.company_id.name"/></span><br/>
                        <span><b>RUC: </b><t t-out="o.company_id.vat or '-'"/> | <b>Tel: </b><t t-out="o.company_id.phone or '-'"/></span><br/>
                        <span style="font-size:8pt;">
                            <t t-out="o.company_id.street or ''"/>
                            <t t-if="o.company_id.city">, <t t-out="o.company_id.city"/></t>
                            <t t-if="o.company_id.country_id">, <t t-out="o.company_id.country_id.name"/></t>
                        </span>
                    </td>
                    <td style="width:32%; vertical-align:top; text-align:right; padding:2px;">
                        <div style="border:1.5px solid #000; padding:3px; font-weight:bold; font-size:10pt; text-align:center;">
                            RECIBO <t t-out="tipo_recibo"/>
                        </div>
                        <div style="text-align:center; font-size:8pt; margin-top:2px; font-weight:bold;">
                            N&#176;: <t t-out="o.number or o.id"/>
                        </div>
                        <div t-if="etiqueta_copia" style="text-align:center; font-size:7.5pt; margin-top:1px; color:#555;">
                            <t t-out="etiqueta_copia"/>
                        </div>
                    </td>
                </tr>
            </table>

            <table style="width:100%; border-collapse:collapse; font-size:8pt; margin-bottom:3px;">
                <tr>
                    <td style="border:1px solid #000; padding:3px; width:50%;">
                        <b>Empleado: </b><span t-field="o.employee_id.name"/><br/>
                        <b>C.I.: </b><t t-out="o.employee_id.identification_id or '-'"/>
                        <t t-if="'ips_number' in o.employee_id._fields and o.employee_id.ips_number">
                            | <b>IPS: </b><t t-out="o.employee_id.ips_number"/>
                        </t>
                    </td>
                    <td style="border:1px solid #000; padding:3px; width:50%;">
                        <b>Periodo: </b><span t-field="o.date_from"/> al <span t-field="o.date_to"/><br/>
                        <b>Cargo: </b><t t-out="o.employee_id.job_id.name if o.employee_id.job_id else '-'"/>
                    </td>
                </tr>
            </table>

            <t t-call="hr_payslip_bulk_print_cross.tabla_lineas"/>

            <table style="width:100%; margin-top:75px; font-size:8pt;">
                <tr>
                    <td style="text-align:center; border-top:1px solid #000; padding-top:4px; width:48%;">
                        Firma del Trabajador<br/><small>Aclaracion / C.I.</small>
                    </td>
                    <td style="width:4%;"></td>
                    <td style="text-align:center; border-top:1px solid #000; padding-top:4px; width:48%;">
                        Firma del Empleador / Sello
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- ===================================================================
        TEMPLATE: Tabla de lineas reutilizable
        =================================================================== -->
    <template id="tabla_lineas">
        <table style="width:100%; border-collapse:collapse; font-size:8pt;">
            <thead>
                <tr style="background:#dddddd;">
                    <th style="border:1px solid #000; padding:3px; text-align:left; width:55%;">Concepto</th>
                    <th style="border:1px solid #000; padding:3px; text-align:right; width:13%;">Cantidad</th>
                    <th style="border:1px solid #000; padding:3px; text-align:right; width:16%;">Haberes</th>
                    <th style="border:1px solid #000; padding:3px; text-align:right; width:16%;">Descuentos</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="lineas" t-as="line">
                    <tr>
                        <td style="border:1px solid #000; padding:2px;"><span t-field="line.name"/></td>
                        <td style="border:1px solid #000; padding:2px; text-align:right;"><span t-field="line.quantity"/></td>
                        <td style="border:1px solid #000; padding:2px; text-align:right;">
                            <t t-if="line.total &gt;= 0"><span t-out="'{:,.0f}'.format(line.total)"/></t>
                        </td>
                        <td style="border:1px solid #000; padding:2px; text-align:right;">
                            <t t-if="line.total &lt; 0"><span t-out="'{:,.0f}'.format(-line.total)"/></t>
                        </td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr style="background:#f0f0f0; font-weight:bold;">
                    <td style="border:1px solid #000; padding:3px; text-align:right;">TOTALES</td>
                    <td style="border:1px solid #000; padding:3px;"></td>
                    <td style="border:1px solid #000; padding:3px; text-align:right;">
                        <span t-out="'{:,.0f}'.format(sum(lineas.filtered(lambda l: l.total &gt; 0).mapped('total')))"/>
                    </td>
                    <td style="border:1px solid #000; padding:3px; text-align:right;">
                        <span t-out="'{:,.0f}'.format(-sum(lineas.filtered(lambda l: l.total &lt; 0).mapped('total')))"/>
                    </td>
                </tr>
                <tr t-if="mostrar_total" style="background:#cccccc; font-weight:bold;">
                    <td colspan="3" style="border:1px solid #000; padding:4px; text-align:right; font-size:9pt;">A PAGAR (Gs.)</td>
                    <td style="border:1px solid #000; padding:4px; text-align:right; font-size:9pt;">
                        <span t-out="'{:,.0f}'.format(sum(lineas.mapped('total')))"/>
                    </td>
                </tr>
            </tfoot>
        </table>
    </template>

    <!-- ===================================================================
        TEMPLATE: Seccion IPS con cabecera MTESS + bloques de firma con QR
        =================================================================== -->
    <template id="recibo_ips_seccion">
        <div style="border:1.5px solid #000; padding:4px; margin-bottom:18px; font-family:'DejaVu Sans','Liberation Sans',Arial,sans-serif; font-size:8pt; box-sizing:border-box; page-break-inside: avoid;">
            <t t-call="hr_payslip_bulk_print_cross.cabecera_mtess_compacta"/>
            <t t-call="hr_payslip_bulk_print_cross.tabla_lineas"/>

            <!-- Bloques de firma + QR (3 columnas) -->
            <table style="width:100%; margin-top:6px; border-collapse:collapse; font-size:7pt;">
                <tr>
                    <!-- FIRMA EMPLEADOR (con imagen company_signature si existe) -->
                    <td style="width:40%; border:1px solid #000; padding:4px; vertical-align:top;">
                        <div style="font-weight:bold; margin-bottom:2px;">
                            <span t-field="o.company_id.name"/>
                        </div>
                        <div style="margin-bottom:2px;">
                            RUC: <span t-field="o.company_id.vat"/>
                        </div>
                        <t t-if="'company_signature' in o.company_id._fields and o.company_id.company_signature">
                            <div style="margin:2px 0; text-align:center;">
                                <img t-att-src="image_data_uri(o.company_id.company_signature)" style="max-height:42px; max-width:90%;" alt="Firma empresa"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div style="height:48px;"></div>
                        </t>
                        <div style="margin-top:6px; border-top:1px solid #000; padding-top:2px; text-align:center; font-weight:bold;">
                            FIRMA DEL EMPLEADOR
                        </div>
                    </td>
                    <!-- FIRMA EMPLEADO -->
                    <td style="width:32%; border:1px solid #000; padding:4px; vertical-align:top; text-align:center;">
                        <div style="font-weight:bold; margin-bottom:8px;">FIRMA DEL EMPLEADO</div>
                        <div style="height:50px;"></div>
                        <div style="border-top:1px solid #000; padding-top:2px;">
                            <span t-field="o.employee_id.name"/><br/>
                            <span style="font-size:6.5pt;">C.I. N&#176;: <t t-out="o.employee_id.identification_id or '-'"/></span>
                        </div>
                    </td>
                    <!-- QR CODE -->
                    <td style="width:28%; border:1px solid #000; padding:4px; vertical-align:top; text-align:center;">
                        <t t-if="o.access_url">
                            <img t-att-src="'/report/barcode/QR/' + (o.access_url or '')" style="width:78px; height:78px;" alt="QR"/>
                        </t>
                        <t t-else="">
                            <div style="width:78px; height:78px; margin:0 auto; border:1px dashed #999;"></div>
                        </t>
                        <div style="margin-top:4px; font-size:6pt; color:#555;">
                            Codigo QR para validacion
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- ===================================================================
        WRAPPER: 2 copias para Interno / Vacaciones (header Crossnexion)
        =================================================================== -->
    <template id="recibo_dos_copias_wrapper">
        <div class="page" style="font-family:Arial, sans-serif;">
            <t t-call="hr_payslip_bulk_print_cross.recibo_compacto_seccion">
                <t t-set="etiqueta_copia">COPIA EMPRESA</t>
            </t>
            <div style="border-top:1.5px dashed #000; text-align:center; font-size:7pt; margin:4px 0; padding-top:2px; color:#666; letter-spacing:2px;">
                - - - - - - - - - - - - - - CORTE - - - - - - - - - - - - - -
            </div>
            <t t-call="hr_payslip_bulk_print_cross.recibo_compacto_seccion">
                <t t-set="etiqueta_copia">COPIA EMPLEADO</t>
            </t>
            <div style="border-top:1px dashed #999; margin:12px 0 18px 0; padding-top:2px; text-align:center; font-size:7pt; color:#999; letter-spacing:3px;">
                - - - - - - - - - - - - - SEPARAR AQUI - - - - - - - - - - - - -
            </div>
        </div>
    </template>

    <!-- ===================================================================
        (1) RECIBO IPS - 2 copias con cabecera MTESS
        =================================================================== -->
    <template id="report_recibo_ips_a5">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
            </head>
            <t t-foreach="docs" t-as="o">
                <t t-set="lineas" t-value="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_ips_receipt)"/>
                <t t-set="mostrar_total" t-value="True"/>
                <div class="page" style="font-family:'DejaVu Sans','Liberation Sans',Arial,sans-serif;">
                    <t t-call="hr_payslip_bulk_print_cross.recibo_ips_seccion">
                        <t t-set="etiqueta_copia">COPIA EMPRESA</t>
                    </t>
                    <div style="border-top:1.5px dashed #000; text-align:center; font-size:7pt; margin:3px 0; padding-top:2px; color:#666; letter-spacing:2px;">
                        - - - - - - - - - - - - - - CORTE - - - - - - - - - - - - - -
                    </div>
                    <t t-call="hr_payslip_bulk_print_cross.recibo_ips_seccion">
                        <t t-set="etiqueta_copia">COPIA EMPLEADO</t>
                    </t>
                    <div style="border-top:1px dashed #999; margin:12px 0 18px 0; padding-top:2px; text-align:center; font-size:7pt; color:#999; letter-spacing:3px;">
                        - - - - - - - - - - - - - SEPARAR AQUI - - - - - - - - - - - - -
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ===================================================================
        (2) RECIBO INTERNO - 2 copias (header Crossnexion)
        =================================================================== -->
    <template id="report_recibo_interno_a5">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
            </head>
            <t t-foreach="docs" t-as="o">
                <t t-set="lineas" t-value="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_internal_payslip)"/>
                <t t-set="tipo_recibo">INTERNO</t>
                <t t-set="mostrar_total" t-value="True"/>
                <t t-call="hr_payslip_bulk_print_cross.recibo_dos_copias_wrapper"/>
            </t>
        </t>
    </template>

    <!-- ===================================================================
        (3) RECIBO BONIFICACION - 1 hoja
        =================================================================== -->
    <template id="report_recibo_bonificacion">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
            </head>
            <t t-foreach="docs" t-as="o">
                <t t-set="lineas" t-value="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_bonification_receipt)"/>
                <t t-set="tipo_recibo">BONIFICACION</t>
                <t t-set="mostrar_total" t-value="True"/>
                <div class="page" style="font-family:Arial, sans-serif;">
                    <t t-call="hr_payslip_bulk_print_cross.recibo_compacto_seccion">
                        <t t-set="etiqueta_copia"></t>
                    </t>
                    <div style="border-top:1px dashed #999; margin:12px 0 18px 0; padding-top:2px; text-align:center; font-size:7pt; color:#999; letter-spacing:3px;">
                        - - - - - - - - - - - - - SEPARAR AQUI - - - - - - - - - - - - -
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ===================================================================
        (4) RECIBO VACACIONES - 2 copias
        =================================================================== -->
    <template id="report_recibo_vacaciones_a5">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
            </head>
            <t t-foreach="docs" t-as="o">
                <t t-set="lineas" t-value="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_vacation_receipt)"/>
                <t t-set="tipo_recibo">VACACIONES</t>
                <t t-set="mostrar_total" t-value="True"/>
                <t t-call="hr_payslip_bulk_print_cross.recibo_dos_copias_wrapper"/>
            </t>
        </t>
    </template>

</odoo>
