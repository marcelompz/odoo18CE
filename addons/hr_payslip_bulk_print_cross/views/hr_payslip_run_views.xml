<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_payslip_run_form_inherit_bulk_print" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.bulk.print</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_batch_review_wizard"
                        string="Revisar Lote"
                        type="object"
                        class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-search"
                        help="Abre el asistente para revisar y validar el lote de nómina."/>
                <button name="action_open_bulk_print_wizard"
                        string="Imprimir Recibos del Lote"
                        type="object"
                        class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-files-o"
                        help="Genera un ZIP/PDF con todos los recibos del lote (formato configurable)."/>
            </xpath>
            <!-- Field extension removed temporarily because the current base view on the server does not expose //field[@name='slip_ids'] in the inherited form. -->
        </field>
    </record>

    <record id="action_hr_payslip_run_bulk_print" model="ir.actions.server">
        <field name="name">Imprimir Recibos en Masa</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_open_bulk_print_wizard()
        </field>
    </record>

</odoo>
