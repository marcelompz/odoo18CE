<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_payslip_form_inherit_bulk_print" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.bulk.print</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_bonification" invisible="1"/>
                <field name="has_vacation" invisible="1"/>

                <button name="action_print_recibo_ips"
                        string="Imprimir Recibo IPS"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-print"
                        help="Imprime el Recibo IPS oficial (cabecera MTESS) con 2 copias por hoja A4."/>

                <button name="action_print_planilla_ips_individual"
                        string="Imprimir Planilla IPS"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-id-card-o"
                        help="Imprime la Planilla IPS oficial (formato MTESS) para este recibo."/>

                <button name="action_print_recibo_interno"
                        string="Imprimir Recibo Interno"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-print"
                        help="Imprime el Recibo Interno (Salario Bruto - IPS - Anticipos - Prestamo) con 2 copias por hoja A4."/>

                <button name="action_print_recibo_bonificacion"
                        string="Imprimir Bonificacion"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-print"
                        invisible="not has_bonification"
                        help="Imprime el Recibo de Bonificaciones. Solo aparece si el recibo tiene bonificaciones con valor."/>

                <button name="action_print_recibo_vacaciones"
                        string="Imprimir Vacaciones"
                        type="object"
                        class="btn-secondary"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-print"
                        invisible="not has_vacation"
                        help="Imprime el Recibo de Vacaciones. Solo aparece si el recibo tiene vacaciones calculadas."/>

                <button name="action_open_bulk_print_wizard"
                        string="Imprimir (Lote)"
                        type="object"
                        class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_user"
                        icon="fa-files-o"
                        help="Abre el asistente de impresion masiva."/>
            </xpath>
        </field>
    </record>

</odoo>
