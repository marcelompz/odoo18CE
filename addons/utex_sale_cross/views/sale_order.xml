<odoo>

    <!-- form view -->

    <record id="sale_order_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <!-- pestaña otra información -->
            <xpath expr="//notebook//page[@name='other_information']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>

            <!-- pestaña productos opcionales -->
            <xpath expr="//notebook//page[@name='optional_products']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>

            <!-- campo nombre del producto -->
            <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
                <attribute name="string">Nombre comercial</attribute>
            </xpath>
        
        </field>
    </record>

    <!-- list view -->
    <record id="sale_order_inherit_tree" model="ir.ui.view">
        <field name="name">sale.order.inherit.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">

            <!-- numero de factura -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="invoice_numbers_display" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='website_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        
        </field>
    </record>

    <!-- list view sale_detalles -->
    <record id="sale_order_inhert_sale_detalles_tree" model="ir.ui.view">
        <field name="name">sale.order.inhert.sale.detalles.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_detalles.view_order_list_inherit" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='total_products_count']" position="attributes">
                <attribute name="string">T.Vendido</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='total_products_count']" position="after">
                <field name="total_qty_delivered" string="T.Entregado" optional="show"/>
                <field name="total_qty_invoiced" string="T.Facturado" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='client_order_ref']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="replace"/>

        </field>
    </record>

</odoo>
