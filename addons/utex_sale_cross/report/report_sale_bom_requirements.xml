<odoo>

    <!-- report template -->
    <template id="report_sale_bom_req_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mt-4">Reporte de Materiales Requeridos</h2>
                    <p>
                        <strong>Basado en las cotizaciones: </strong>
                        <span t-esc="', '.join(docs.mapped('name'))"/>
                    </p>

                    <table class="table table-sm table-striped mt-4">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Proveedor</th>
                                <th>Unidad de Medida</th>
                                <th class="text-end">Cantidad Total Requerida</th>
                                <th class="text-end">Disponible en Stock</th>
                                <th class="text-end text-danger">Necesita Comprar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="materials" t-as="mat">
                                <td><span t-esc="mat['product_name']"/></td>
                                <td><span t-esc="mat['vendor_name']"/></td>
                                <td><span t-esc="mat['uom_name']"/></td>
                                <td class="text-end">
                                    <span t-esc="mat['qty_needed']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="mat['qty_available']" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="text-end font-weight-bold">
                                    <!-- Resaltar en rojo si hay que comprar -->
                                    <span t-att-class="'text-danger' if mat['to_buy'] > 0 else 'text-muted'" 
                                          t-esc="mat['to_buy']" 
                                          t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- report action -->
    <record id="action_report_sale_bom_requirements" model="ir.actions.report">
        <field name="name">Requerimientos de Materiales (BoM)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utex_sale_cross.report_sale_bom_req_template</field>
        <field name="report_file">utex_sale_cross.report_sale_bom_req_template</field>
        <field name="print_report_name">'Requerimientos - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
