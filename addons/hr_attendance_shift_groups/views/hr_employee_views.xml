<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_shift" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="shift_group_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_contract_form_inherit_shift" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.shift</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="shift_group_id"/>
            </xpath>
        </field>
    </record>

</odoo>
