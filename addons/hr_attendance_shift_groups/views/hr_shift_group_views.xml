<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_shift_group_form" model="ir.ui.view">
        <field name="name">hr.shift.group.form</field>
        <field name="model">hr.shift.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de Turno">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Operativo, Administrativo..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Tolerancia de marcacion">
                        <group>
                            <field name="tolerance_morning_minutes"/>
                            <field name="tolerance_evening_minutes"/>
                        </group>
                        <group>
                            <field name="hard_limit_entry_minutes"/>
                            <field name="hard_limit_exit_minutes"/>
                            <field name="hard_limit_minutes" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Franjas Horarias" name="slots">
                            <field name="slot_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="time_from" widget="float_time"/>
                                    <field name="time_to" widget="float_time"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="slot_type"/>
                                    <field name="crosses_midnight" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Horarios de Trabajo Vinculados" name="calendars">
                            <p class="text-muted">
                                Seleccione los <b>Horarios de Trabajo</b> (resource.calendar) cuyos
                                empleados pertenecen automaticamente a este grupo de turno.
                                <br/>Asi, al asignar un calendario al empleado/contrato (campo
                                <i>"Horario de trabajo"</i> en el contrato), el sistema deduce
                                automaticamente que pertenece a este grupo y clasifica sus
                                asistencias correctamente.
                            </p>
                            <field name="resource_calendar_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Descripcion" name="description">
                            <field name="description" nolabel="1"
                                   placeholder="Descripcion del grupo de turno..."/>
                        </page>
                        <page string="Empleados Asignados" name="employees">
                            <field name="employee_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_shift_group_list" model="ir.ui.view">
        <field name="name">hr.shift.group.list</field>
        <field name="model">hr.shift.group</field>
        <field name="arch" type="xml">
            <list string="Grupos de Turno">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="employee_count"/>
                <field name="resource_calendar_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_hr_shift_group_kanban" model="ir.ui.view">
        <field name="name">hr.shift.group.kanban</field>
        <field name="model">hr.shift.group</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="employee_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <small><field name="code"/></small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span><field name="employee_count"/> empleado(s)</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_shift_group_search" model="ir.ui.view">
        <field name="name">hr.shift.group.search</field>
        <field name="model">hr.shift.group</field>
        <field name="arch" type="xml">
            <search string="Grupos de Turno">
                <field name="name"/>
                <field name="code"/>
                <field name="resource_calendar_ids" string="Horario de Trabajo"/>
                <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empresa" name="group_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_shift_group" model="ir.actions.act_window">
        <field name="name">Grupos de Turno</field>
        <field name="res_model">hr.shift.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hr_shift_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo Grupo de Turno
            </p>
            <p>
                Los Grupos de Turno definen <b>como se clasifican las horas trabajadas</b>
                (ordinario, extra diurno, extra nocturno, descanso). NO confundir con
                "Horario de trabajo" del contrato (resource.calendar) que define
                <i>cuando</i> debe trabajar el empleado.
            </p>
            <p>
                Puede vincular Horarios de Trabajo al grupo para que la asignacion sea
                automatica.
            </p>
        </field>
    </record>

</odoo>
