<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_daily_report_oper_list" model="ir.ui.view">
        <field name="name">hr.attendance.daily.report.oper.list</field>
        <field name="model">hr.attendance.daily.report</field>
        <field name="arch" type="xml">
            <list string="Tablero Diario - Operativo"
                  create="0" delete="0" edit="0"
                  decoration-danger="absence_status == 'absence'"
                  decoration-warning="absence_status == 'leave'"
                  decoration-info="absence_status == 'rest'"
                  decoration-success="absence_status == 'present'"
                  default_order="date desc, employee_id">
                <header>
                    <button name="action_request_falta_approval" type="object"
                            string="Solicitar Aprobacion de Faltas"
                            class="btn-danger"
                            display="always"
                            help="Selecciona filas con estado FALTA y haz click aqui para enviar al supervisor."/>
                    <button name="action_recalculate_dashboard" type="object"
                            string="Recalcular Tablero" class="btn-warning"
                            display="always"
                            confirm="Esto recomputara los shift_lines a partir de las marcaciones y regenerara el tablero. Si hay registros seleccionados solo se recalcula esa seleccion; si no, todo el mes en curso. Continuar?"/>
                    <button name="action_export_xlsx_oper" type="object"
                            string="Exportar XLSX" class="btn-primary"
                            display="always"/>
                </header>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="absence_status" widget="badge"
                       decoration-danger="absence_status == 'absence'"
                       decoration-warning="absence_status == 'leave'"
                       decoration-info="absence_status == 'rest'"
                       decoration-success="absence_status == 'present'"/>
                <field name="leave_type_name" optional="show"/>
                <field name="h_oper_extra_dawn"  widget="float_time" sum="Total"/>
                <field name="h_oper_entry"       widget="float_time" sum="Total"/>
                <field name="h_oper_breakfast"   widget="float_time" sum="Total"/>
                <field name="h_oper_morning"     widget="float_time" sum="Total"/>
                <field name="h_oper_lunch"       widget="float_time" sum="Total"/>
                <field name="h_oper_afternoon"   widget="float_time" sum="Total"/>
                <field name="h_oper_extra_eve"   widget="float_time" sum="Total"/>
                <field name="h_oper_extra_night" widget="float_time" sum="Total"/>
                <field name="total_ordinary"     widget="float_time" sum="Total Jornada"/>
                <field name="total_extra_day"    widget="float_time" sum="Total Extra Diurno"/>
                <field name="total_extra_night"  widget="float_time" sum="Total Extra Nocturno"/>
                <field name="expected_ordinary"  widget="float_time" sum="Jornada Estandar" optional="show"/>
                <field name="to_deduct"          widget="float_time" sum="Total a Descontar"/>
                <field name="tolerance_applied"  widget="float_time" sum="Tolerancia" optional="show"/>
                <field name="observation" optional="show"/>
                <field name="has_incomplete_marking" optional="show"/>
                <field name="is_missing" invisible="1"/>
                <field name="shift_group_id" invisible="1"/>
                <button name="action_view_attendances" type="object"
                        string="Ver detalle" icon="fa-search-plus" class="btn-link"/>
            </list>
        </field>
    </record>

