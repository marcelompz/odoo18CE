    <record id="view_daily_report_form" model="ir.ui.view">
        <field name="name">hr.attendance.daily.report.form</field>
        <field name="model">hr.attendance.daily.report</field>
        <field name="arch" type="xml">
            <form string="Detalle Diario" create="0" delete="0" edit="0">
                <header>
                    <button name="action_recalculate_dashboard" type="object"
                            string="Recalcular este registro" class="btn-warning"
                            confirm="Recalculara los shift_lines y regenerara la fila para este empleado y dia. Continuar?"/>
                    <button name="action_view_attendances" type="object"
                            string="Ver Marcaciones del Dia" class="btn-primary"
                            icon="fa-clock-o"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="1"/> -
                            <field name="date" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shift_group_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="absence_status" readonly="1" widget="badge"
                                   decoration-danger="absence_status == 'absence'"
                                   decoration-warning="absence_status == 'leave'"
                                   decoration-info="absence_status == 'rest'"
                                   decoration-success="absence_status == 'present'"/>
                            <field name="leave_type_name" readonly="1"
                                   invisible="absence_status == 'present'"/>
                            <field name="leave_id" readonly="1"
                                   invisible="not leave_id"/>
                        </group>
                        <group>
                            <field name="total_ordinary"    widget="float_time" readonly="1"/>
                            <field name="total_extra_day"   widget="float_time" readonly="1"/>
                            <field name="total_extra_night" widget="float_time" readonly="1"/>
                            <field name="total_break"       widget="float_time" readonly="1"/>
                            <field name="expected_ordinary" widget="float_time" readonly="1"/>
                            <field name="to_deduct"         widget="float_time" readonly="1"/>
                            <field name="tolerance_applied" widget="float_time" readonly="1"/>
                            <field name="has_incomplete_marking" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Distribucion Operativo" name="oper"
                              invisible="shift_group_code != 'OPER'">
                            <field name="shift_group_code" invisible="1"/>
                            <group>
                                <field name="h_oper_extra_dawn"  widget="float_time" readonly="1"/>
                                <field name="h_oper_entry"       widget="float_time" readonly="1"/>
                                <field name="h_oper_breakfast"   widget="float_time" readonly="1"/>
                                <field name="h_oper_morning"     widget="float_time" readonly="1"/>
                                <field name="h_oper_lunch"       widget="float_time" readonly="1"/>
                                <field name="h_oper_afternoon"   widget="float_time" readonly="1"/>
                                <field name="h_oper_extra_eve"   widget="float_time" readonly="1"/>
                                <field name="h_oper_extra_night" widget="float_time" readonly="1"/>
                            </group>
                        </page>
                        <page string="Distribucion Administrativo" name="admin"
                              invisible="shift_group_code != 'ADMIN'">
                            <group>
                                <field name="h_admin_extra_dawn"  widget="float_time" readonly="1"/>
                                <field name="h_admin_morning"     widget="float_time" readonly="1"/>
                                <field name="h_admin_lunch"       widget="float_time" readonly="1"/>
                                <field name="h_admin_afternoon"   widget="float_time" readonly="1"/>
                                <field name="h_admin_extra_eve"   widget="float_time" readonly="1"/>
                                <field name="h_admin_extra_night" widget="float_time" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_daily_report_search" model="ir.ui.view">
        <field name="name">hr.attendance.daily.report.search</field>
        <field name="model">hr.attendance.daily.report</field>
        <field name="arch" type="xml">
            <search string="Buscar Tablero Diario">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="shift_group_id"/>
                <field name="leave_type_name"/>
                <separator/>
                <filter string="Presente" name="filter_present"
                        domain="[('absence_status', '=', 'present')]"/>
                <filter string="FALTA (sin justificar)" name="filter_absence"
                        domain="[('absence_status', '=', 'absence')]"/>
                <filter string="Vacaciones / Licencia" name="filter_leave"
                        domain="[('absence_status', '=', 'leave')]"/>
                <filter string="Descanso / Feriado" name="filter_rest"
                        domain="[('absence_status', '=', 'rest')]"/>
                <separator/>
                <filter string="Sin marcacion" name="filter_missing"
                        domain="[('is_missing', '=', True)]"/>
                <filter string="Marcacion incompleta" name="filter_incomplete"
                        domain="[('has_incomplete_marking', '=', True)]"/>
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter string="Empleado"     name="group_emp"  context="{'group_by': 'employee_id'}"/>
                    <filter string="Departamento" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Estado del dia" name="group_status" context="{'group_by': 'absence_status'}"/>
                    <filter string="Tipo Ausencia" name="group_leave" context="{'group_by': 'leave_type_name'}"/>
                    <filter string="Mes"          name="group_mon"  context="{'group_by': 'date:month'}"/>
                    <filter string="Semana"       name="group_week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_daily_report_oper" model="ir.actions.act_window">
        <field name="name">Tablero Diario - Operativo</field>
        <field name="res_model">hr.attendance.daily.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_daily_report_oper_list"/>
        <field name="search_view_id" ref="view_daily_report_search"/>
        <field name="domain">[('shift_group_id.code', '=', 'OPER')]</field>
    </record>

    <record id="action_daily_report_admin" model="ir.actions.act_window">
        <field name="name">Tablero Diario - Administrativo</field>
        <field name="res_model">hr.attendance.daily.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_daily_report_admin_list"/>
        <field name="search_view_id" ref="view_daily_report_search"/>
        <field name="domain">[('shift_group_id.code', '=', 'ADMIN')]</field>
    </record>

    <record id="view_daily_regen_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.daily.regen.wizard.form</field>
        <field name="model">hr.attendance.daily.regen.wizard</field>
        <field name="arch" type="xml">
            <form string="Regenerar Tablero Diario">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="shift_group_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <p class="text-muted">
                    Esto recalcula y regenera las filas del tablero diario para el rango indicado.
                </p>
                <footer>
                    <button name="action_regenerate" type="object" string="Regenerar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_regen_wizard" model="ir.actions.act_window">
        <field name="name">Regenerar Tablero Diario</field>
        <field name="res_model">hr.attendance.daily.regen.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Crossnexion: server action para limpiar Tableros (solo admin) -->
    <record id="server_action_clear_daily_report_admin" model="ir.actions.server">
        <field name="name">Borrar TODAS las filas del tablero (Admin)</field>
        <field name="model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_clear_all_admin()</field>
    </record>

    <!-- Server action para recalcular tablero desde menu Acciones -->
    <record id="server_action_recalculate_dashboard" model="ir.actions.server">
        <field name="name">Recalcular tablero (seleccionados)</field>
        <field name="model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_recalculate_dashboard()</field>
    </record>

</odoo>
