<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_hr_falta_justification" model="ir.sequence">
        <field name="name">Solicitudes de Justificacion de Falta</field>
        <field name="code">hr.falta.justification</field>
        <field name="prefix">FJ-</field>
        <field name="padding">5</field>
    </record>

    <record id="view_hr_falta_justification_list" model="ir.ui.view">
        <field name="name">hr.falta.justification.list</field>
        <field name="model">hr.falta.justification</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="manager_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="days_count"/>
                <field name="reason"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_falta_justification_form" model="ir.ui.view">
        <field name="name">hr.falta.justification.form</field>
        <field name="model">hr.falta.justification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="Enviar al Supervisor" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Aprobar" class="btn-primary"
                            invisible="state != 'pending'"
                            confirm="Confirma la aprobacion? Los dias seleccionados se reclasificaran como Ausencia justificada."/>
                    <button name="action_reject" type="object"
                            string="Rechazar" class="btn-danger"
                            invisible="state != 'pending'"
                            confirm="Indique el motivo de rechazo en el campo correspondiente antes de continuar."/>
                    <button name="action_reset_to_draft" type="object"
                            string="Volver a borrador" class="btn-secondary"
                            invisible="state in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_daily_reports" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="days_count" widget="statinfo" string="Dias"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="department_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason"
                                   readonly="state != 'draft'"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="approver_id" readonly="1"
                                   invisible="not approver_id"/>
                            <field name="approval_date" readonly="1"
                                   invisible="not approval_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dias a justificar">
                            <field name="daily_report_ids"
                                   readonly="state != 'draft'">
                                <list create="0" delete="0" edit="0">
                                    <field name="date"/>
                                    <field name="absence_status" widget="badge"/>
                                    <field name="leave_type_name"/>
                                    <field name="shift_group_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Descripcion">
                            <field name="description"
                                   readonly="state not in ('draft','pending')"
                                   placeholder="Detalle del motivo, certificado, etc."/>
                        </page>
                        <page string="Rechazo" invisible="state != 'pending' and not rejection_reason">
                            <field name="rejection_reason"
                                   readonly="state != 'pending'"
                                   placeholder="Si va a rechazar la solicitud, indique el motivo aqui antes de presionar Rechazar."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_falta_justification_search" model="ir.ui.view">
        <field name="name">hr.falta.justification.search</field>
        <field name="model">hr.falta.justification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="reason"/>
                <separator/>
                <filter string="Pendientes" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="A mi cargo" name="filter_my_team"
                        domain="[('manager_id.user_id', '=', uid)]"/>
                <filter string="Aprobadas" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rechazadas" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter string="Empleado" name="group_emp"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Supervisor" name="group_mgr"
                            context="{'group_by': 'manager_id'}"/>
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Motivo" name="group_reason"
                            context="{'group_by': 'reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_falta_justification" model="ir.actions.act_window">
        <field name="name">Aprobaciones de Faltas</field>
        <field name="res_model">hr.falta.justification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_falta_justification_search"/>
        <field name="context">{'search_default_filter_my_team': 1, 'search_default_filter_pending': 1}</field>
    </record>

    <!-- Menu bajo Asistencias -->
    <menuitem id="menu_hr_falta_justification"
              name="Aprobaciones de Faltas"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_hr_falta_justification"
              sequence="50"/>

</odoo>
