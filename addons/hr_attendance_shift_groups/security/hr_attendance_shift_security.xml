<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_attendance_shift" model="ir.module.category">
        <field name="name">Asistencia por Turnos</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_shift_user" model="res.groups">
        <field name="name">Operador de Asistencia por Turnos</field>
        <field name="category_id" ref="module_category_attendance_shift"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_shift_supervisor" model="res.groups">
        <field name="name">Supervisor de Asistencia por Turnos</field>
        <field name="category_id" ref="module_category_attendance_shift"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_shift_manager" model="res.groups">
        <field name="name">Administrador de Asistencia por Turnos</field>
        <field name="category_id" ref="module_category_attendance_shift"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_supervisor')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="hr_shift_group_company_rule" model="ir.rule">
        <field name="name">hr.shift.group multi-company</field>
        <field name="model_id" ref="model_hr_shift_group"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_shift_slot_company_rule" model="ir.rule">
        <field name="name">hr.shift.slot multi-company</field>
        <field name="model_id" ref="model_hr_shift_slot"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_attendance_shift_line_company_rule" model="ir.rule">
        <field name="name">hr.attendance.shift.line multi-company</field>
        <field name="model_id" ref="model_hr_attendance_shift_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_attendance_shift_line_user_rule" model="ir.rule">
        <field name="name">hr.attendance.shift.line user own</field>
        <field name="model_id" ref="model_hr_attendance_shift_line"/>
        <field name="groups" eval="[(4, ref('group_shift_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="hr_attendance_shift_line_supervisor_rule" model="ir.rule">
        <field name="name">hr.attendance.shift.line supervisor department</field>
        <field name="model_id" ref="model_hr_attendance_shift_line"/>
        <field name="groups" eval="[(4, ref('group_shift_supervisor'))]"/>
        <field name="domain_force">['|', ('employee_id.department_id.manager_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

    <record id="hr_attendance_shift_line_manager_rule" model="ir.rule">
        <field name="name">hr.attendance.shift.line manager all</field>
        <field name="model_id" ref="model_hr_attendance_shift_line"/>
        <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
