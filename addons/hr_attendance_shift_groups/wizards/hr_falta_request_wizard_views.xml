<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_falta_request_wizard_form" model="ir.ui.view">
        <field name="name">hr.falta.request.wizard.form</field>
        <field name="model">hr.falta.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitar Aprobacion de Faltas (via Tiempo Personal)">
                <div class="alert alert-info" role="alert">
                    <p>Esta accion crea solicitudes en el modulo
                    <b>Tiempo Personal (hr.leave)</b> que el supervisor
                    debe aprobar usando el flujo estandar de Odoo
                    (menu <b>Tiempo Personal &gt; Aprobar Faltas</b>).</p>
                    <p>Una vez aprobadas, los dias se reclasifican
                    automaticamente como "Ausencia justificada" en el
                    Tablero Diario y la nomina deja de descontar la falta.</p>
                </div>
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="reason"/>
                    <field name="holiday_status_id"
                           options="{'no_create': True}"
                           help="Tipo de tiempo personal que se creara. Por defecto se sugiere segun el motivo, pero puede cambiarlo."/>
                </group>
                <group>
                    <field name="description"
                           placeholder="Detalle: certificado medico, autorizacion verbal, etc."/>
                </group>
                <field name="summary_html" widget="html" readonly="1"/>
                <separator string="Dias seleccionados (puede deseleccionar antes de enviar)"/>
                <field name="daily_report_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="date"/>
                        <field name="absence_status" widget="badge"/>
                        <field name="employee_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_request" type="object"
                            string="Enviar al Supervisor" class="btn-primary"
                            confirm="Esto creara solicitudes en Tiempo Personal y las enviara al supervisor (estado Pendiente de Aprobacion). Continuar?"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_falta_request_wizard" model="ir.actions.act_window">
        <field name="name">Solicitar Aprobacion de Faltas</field>
        <field name="res_model">hr.falta.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server action visible en menu Acciones del Tablero Diario -->
    <record id="server_action_request_falta_approval" model="ir.actions.server">
        <field name="name">Solicitar Aprobacion de Faltas</field>
        <field name="model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_model_id" ref="hr_attendance_shift_groups.model_hr_attendance_daily_report"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Solicitar Aprobacion de Faltas',
    'res_model': 'hr.falta.request.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids, 'active_model': 'hr.attendance.daily.report'},
}</field>
    </record>

</odoo>
