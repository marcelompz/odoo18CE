<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_daily_report" model="ir.actions.report">
        <field name="name">Planilla Diaria (PDF)</field>
        <field name="model">hr.attendance.daily.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_attendance_shift_groups.report_daily_report_doc</field>
        <field name="report_file">hr_attendance_shift_groups.report_daily_report_doc</field>
        <field name="binding_model_id" ref="model_hr_attendance_daily_report"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <template id="report_daily_report_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Planilla Diaria</h2>
                    <p class="text-center">
                        <strong t-esc="docs.env.company.name"/>
                    </p>
                    <table class="table table-sm table-bordered" style="font-size:10px;">
                        <thead>
                            <tr style="background-color:#B4C6E7;">
                                <th>Colaborador</th>
                                <th>Día</th>
                                <th>Estado</th>
                                <th class="text-end">Normal</th>
                                <th class="text-end">Extra Diurna</th>
                                <th class="text-end">Extra Nocturna</th>
                                <th class="text-end">Descanso</th>
                                <th class="text-end">Jornada Est.</th>
                                <th class="text-end">a Descontar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc"
                                t-attf-style="#{'background-color:#F4CCCC;' if doc.absence_status == 'absence' else ('background-color:#FFF2CC;' if doc.has_incomplete_marking else '')}">
                                <td t-esc="doc.employee_id.name"/>
                                <td t-esc="doc.date"/>
                                <td t-esc="doc.leave_type_name or dict(doc._fields['absence_status'].selection).get(doc.absence_status)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.total_ordinary)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.total_extra_day)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.total_extra_night)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.total_break)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.expected_ordinary)"/>
                                <td class="text-end" t-esc="doc.fmt_hhmm(doc.to_deduct)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
