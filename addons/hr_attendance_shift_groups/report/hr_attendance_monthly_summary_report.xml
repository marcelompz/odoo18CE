<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_monthly_summary" model="ir.actions.report">
        <field name="name">Resumen Mensual de Horas</field>
        <field name="model">hr.attendance.monthly.summary</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_attendance_shift_groups.report_monthly_summary_doc</field>
        <field name="report_file">hr_attendance_shift_groups.report_monthly_summary_doc</field>
        <field name="print_report_name">'Resumen_Mensual_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

    <template id="report_monthly_summary_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="o._report_rows()"/>
                    <div class="page">
                        <h2 class="text-center">Resumen Mensual de Horas</h2>
                        <p class="text-center">
                            <strong t-esc="o.env.company.name"/><br/>
                            Período: <span t-esc="o.date_from"/> a <span t-esc="o.date_to"/>
                        </p>
                        <p class="text-muted" style="font-size:11px;">
                            Total = Normal − a Descontar + Extra Diurna + Extra Nocturna.
                            Normal = jornada estándar del turno.
                        </p>
                        <table class="table table-sm table-bordered" style="font-size:11px;">
                            <thead>
                                <tr style="background-color:#B4C6E7;">
                                    <th>Colaborador</th>
                                    <th>Departamento</th>
                                    <th>Grupo</th>
                                    <th class="text-end">Normal</th>
                                    <th class="text-end">Extra Diurna</th>
                                    <th class="text-end">Extra Nocturna</th>
                                    <th class="text-end">a Descontar</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Faltas</th>
                                    <th class="text-center">Incompl.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['rows']" t-as="row">
                                    <td t-esc="row['name']"/>
                                    <td t-esc="row['dept']"/>
                                    <td t-esc="row['group']"/>
                                    <td class="text-end" t-esc="row['normal']"/>
                                    <td class="text-end" style="background-color:#C6EFCE;" t-esc="row['xd']"/>
                                    <td class="text-end" style="background-color:#C6EFCE;" t-esc="row['xn']"/>
                                    <td class="text-end" style="background-color:#FFC7CE;" t-esc="row['ded']"/>
                                    <td class="text-end"><strong t-esc="row['total']"/></td>
                                    <td class="text-center" t-esc="row['faltas']"/>
                                    <td class="text-center" t-esc="row['incompl']"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background-color:#F2F2F2; font-weight:bold;">
                                    <td colspan="3" class="text-end">TOTAL GENERAL</td>
                                    <td class="text-end" t-esc="data['totals']['normal']"/>
                                    <td class="text-end" style="background-color:#A9D08E;" t-esc="data['totals']['xd']"/>
                                    <td class="text-end" style="background-color:#A9D08E;" t-esc="data['totals']['xn']"/>
                                    <td class="text-end" style="background-color:#F4B0B0;" t-esc="data['totals']['ded']"/>
                                    <td class="text-end" t-esc="data['totals']['total']"/>
                                    <td class="text-center" t-esc="data['totals']['faltas']"/>
                                    <td class="text-center" t-esc="data['totals']['incompl']"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
