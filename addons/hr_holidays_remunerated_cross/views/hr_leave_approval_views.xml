<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        List especifica para "Faltas a Aprobar":
        Muestra solo lo esencial y permite aprobar/rechazar masivamente.
    -->
    <record id="view_hr_leave_to_approve_list" model="ir.ui.view">
        <field name="name">hr.leave.to.approve.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <list string="Faltas a Aprobar"
                  decoration-warning="state == 'confirm'"
                  decoration-info="state == 'validate1'"
                  multi_edit="1">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="holiday_status_id" string="Tipo"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days" string="Dias"/>
                <field name="is_remunerated" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'confirm'"
                       decoration-info="state == 'validate1'"
                       decoration-success="state == 'validate'"
                       decoration-danger="state == 'refuse'"/>
                <field name="manager_id" optional="show"/>
                <button name="action_approve" string="Aprobar"
                        type="object" icon="fa-check text-success"
                        invisible="state not in ('confirm', 'validate1')"/>
                <button name="action_validate" string="Validar (RRHH)"
                        type="object" icon="fa-check-double text-info"
                        invisible="state != 'validate1'"
                        groups="hr_holidays.group_hr_holidays_user"/>
                <button name="action_refuse" string="Rechazar"
                        type="object" icon="fa-times text-danger"
                        invisible="state in ('refuse', 'cancel')"/>
            </list>
        </field>
    </record>

    <!--
        Search view con filtros para los aprobadores
    -->
    <record id="view_hr_leave_to_approve_search" model="ir.ui.view">
        <field name="name">hr.leave.to.approve.search</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <search string="Buscar Faltas">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="holiday_status_id"/>
                <filter string="Pendiente Gerente"
                        name="filter_pending_manager"
                        domain="[('state', '=', 'confirm')]"/>
                <filter string="Pendiente RRHH"
                        name="filter_pending_hr"
                        domain="[('state', '=', 'validate1')]"/>
                <filter string="Aprobadas"
                        name="filter_approved"
                        domain="[('state', '=', 'validate')]"/>
                <filter string="Rechazadas"
                        name="filter_refused"
                        domain="[('state', '=', 'refuse')]"/>
                <separator/>
                <filter string="Mi Equipo"
                        name="filter_my_team"
                        domain="[('manager_id.user_id', '=', uid)]"/>
                <filter string="Asignadas a Mi"
                        name="filter_assigned_to_me"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="No Remunerado"
                        name="filter_unremunerated"
                        domain="[('is_remunerated', '=', False)]"/>
                <filter string="Remunerado"
                        name="filter_remunerated"
                        domain="[('is_remunerated', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'holiday_status_id'}"/>
                    <filter string="Gerente" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--
        Accion: Faltas a Aprobar (con filtro por defecto para pendientes
        del usuario actual)
    -->
    <record id="action_hr_leave_to_approve" model="ir.actions.act_window">
        <field name="name">Aprobar Faltas</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="view_id" ref="view_hr_leave_to_approve_list"/>
        <field name="search_view_id" ref="view_hr_leave_to_approve_search"/>
        <field name="domain">[('state', 'in', ('confirm', 'validate1'))]</field>
        <field name="context">{
            'search_default_filter_pending_manager': 1,
            'search_default_filter_pending_hr': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay solicitudes pendientes de aprobacion.
            </p>
            <p>
                Aqui veras las solicitudes de tiempo personal que estan
                esperando aprobacion del gerente directo o de RRHH. Puedes
                aprobar, validar o rechazar masivamente desde esta vista.
            </p>
        </field>
    </record>

    <!--
        Menu directo bajo "Tiempo Personal".
        Visible para usuarios con permiso de aprobar (group_hr_holidays_responsible
        - jefes de equipo, group_hr_holidays_user - oficial RRHH, y group_hr_holidays_manager).
    -->
    <menuitem id="menu_hr_leave_to_approve"
              name="Aprobar Faltas"
              parent="hr_holidays.menu_hr_holidays_root"
              action="action_hr_leave_to_approve"
              sequence="1"
              groups="hr_holidays.group_hr_holidays_responsible,hr_holidays.group_hr_holidays_user,hr_holidays.group_hr_holidays_manager"/>

</odoo>
