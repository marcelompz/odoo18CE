<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_leave_type_form_remunerated" model="ir.ui.view">
        <field name="name">hr.leave.type.form.remunerated</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Configuracion de Remuneracion (Crossnexion)">
                    <field name="is_remunerated_default"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
