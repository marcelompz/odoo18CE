<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_leave_form_remunerated" model="ir.ui.view">
        <field name="name">hr.leave.form.remunerated</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Empleado siempre visible -->
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="readonly">state in ('validate', 'refuse')</attribute>
            </xpath>

            <!-- is_remunerated despues del tipo -->
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="is_remunerated"
                       readonly="state == 'validate'"
                       widget="boolean_toggle"/>
            </xpath>

            <!-- Boton manual en la cabecera (solo cuando state == validate) -->
            <xpath expr="//header" position="inside">
                <button name="action_manual_apply_attendances"
                        string="Aplicar a Asistencias"
                        type="object"
                        class="btn-primary"
                        icon="fa-refresh"
                        invisible="state != 'validate'"
                        groups="hr_holidays.group_hr_holidays_user"
                        help="Genera o actualiza las asistencias correspondientes a las fechas de esta solicitud."/>
                <button name="action_view_leave_attendances"
                        string="Ver Asistencias generadas"
                        type="object"
                        icon="fa-clock-o"
                        invisible="leave_attendance_count == 0"
                        help="Listar las asistencias creadas por esta solicitud."/>
            </xpath>

            <!-- Field invisible para que el invisible='leave_attendance_count == 0'
                 del botón funcione -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="leave_attendance_count" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
