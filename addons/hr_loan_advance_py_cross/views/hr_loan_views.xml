<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Prestamo a Funcionario">
                <header>
                    <button name="action_rrhh_approve" string="Aprobar (RRHH)"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hr_payroll.group_hr_payroll_user"/>
                    <button name="action_finance_pay" string="Desembolsar (Finanzas)"
                            type="object" class="btn-primary"
                            invisible="state != 'rrhh_approved'"
                            groups="account.group_account_manager"/>
                    <button name="action_cancel" string="Cancelar"
                            type="object" invisible="state in ('cancelled', 'paid', 'in_progress')"/>
                    <button name="action_back_to_draft" string="Volver a Borrador"
                            type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,rrhh_approved,paid,in_progress,finished"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_payment" icon="fa-money"
                                invisible="not payment_id">
                            <span>Ver Pago</span>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_attachment" icon="fa-link"
                                invisible="not salary_attachment_id">
                            <span>Ver Attachment</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="amount_total" readonly="state != 'draft'"/>
                            <field name="installments" readonly="state != 'draft'"/>
                            <field name="amount_per_installment" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="description" readonly="state != 'draft'"/>
                        </group>
                        <group string="Configuracion contable">
                            <field name="journal_id" readonly="state in ('paid', 'in_progress', 'finished', 'cancelled')"/>
                            <field name="loan_account_id" readonly="state in ('paid', 'in_progress', 'finished', 'cancelled')"/>
                            <field name="rrhh_approver_id" readonly="1" invisible="not rrhh_approver_id"/>
                            <field name="finance_approver_id" readonly="1" invisible="not finance_approver_id"/>
                            <field name="payment_id" readonly="1" invisible="not payment_id"/>
                            <field name="salary_attachment_id" readonly="1" invisible="not salary_attachment_id"/>
                        </group>
                    </group>
                    <group string="Saldos" invisible="state in ('draft', 'rrhh_approved', 'cancelled')">
                        <group>
                            <field name="paid_amount" readonly="1"/>
                            <field name="pending_amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_loan_list" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Prestamos a Funcionarios"
                  decoration-info="state == 'rrhh_approved'"
                  decoration-success="state == 'finished'"
                  decoration-warning="state == 'in_progress'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="amount_total" sum="Total"/>
                <field name="installments"/>
                <field name="amount_per_installment" optional="show"/>
                <field name="paid_amount" optional="show"/>
                <field name="pending_amount" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">Prestamos a Funcionarios</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
