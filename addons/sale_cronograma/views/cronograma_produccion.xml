<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cronograma_produccion" model="ir.ui.view">
        <field name="name">cronograma.produccion</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Cronograma Producción">
                <field name="validity_date" type="row" interval="day"/>
                <field name="order_customer" type="row"/>
                <field name="product_category_id" type="col"/>
                <field name="order_state" type="col"/>

                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_cronograma_produccion" model="ir.actions.act_window">
        <field name="name">Cronograma Producción</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_cronograma_produccion"/>
        <field name="domain">[("order_state", "not in", ["draft", "sent", "cancel"]), ("mostrar_en_reportes", "=", True)]</field>
    </record>

    <menuitem id="menu_cronograma_produccion"
              name="Cronograma Producción"
              parent="sale.menu_sale_report"
              action="action_cronograma_produccion"
              sequence="21"/>
</odoo>

