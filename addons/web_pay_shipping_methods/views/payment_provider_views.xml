<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.view.form.inherit.web.pay.shipping.methods</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="delivery_address_id"/>
            </xpath>
            
            <!-- Sección para adjuntos de comprobantes de transferencia -->
            <xpath expr="//notebook" position="inside">
                <page string="Comprobantes de Transferencia" name="transfer_receipts">
                    <group>
                        <group string="Comprobante de Transferencia">
                            <field name="transfer_receipt_attachment" widget="binary" filename="transfer_receipt_name"/>
                            <field name="transfer_receipt_name" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
