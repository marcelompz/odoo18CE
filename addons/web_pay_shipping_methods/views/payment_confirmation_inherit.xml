<odoo>
    <template id="payment_confirmation_inherit" inherit_id="website_sale.confirmation">
        <xpath expr="." position="inside">
            <t t-if="bank_transfer_checkout">
                <div class="alert alert-info mt-3">
                    <h4>¡Comprobante recibido!</h4>
                    <p>Tu pedido está pendiente de validación. Un asesor revisará tu comprobante y confirmará tu compra en breve.</p>
                </div>
            </t>
        </xpath>
    </template>
</odoo> 