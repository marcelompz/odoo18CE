<odoo>

    <!-- report template -->

    <template id="report_advanced_receipt_payments_document_inherit" inherit_id="advanced_receiptmoney_cross.report_advanced_receipt_payments_document">

        <xpath expr="//div[@id='signature']" position="replace">
            <div t-if="doc.employee_signature" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.employee_signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <p t-field="doc.employee_id"/>
                </div>
            </div>
                
            <div t-if="not doc.employee_signature" class="row">
                <div class="col-6 text-center">
                    <span>_________________________</span>
                    <br/>
                    <span style="font-size:10px;">Firma</span>
                </div>
                <div class="col-6 text-center">
                    <span t-if="doc.employee_id" t-field="doc.employee_id"/>
                    <span t-if="not doc.employee_id">_________________________</span>
                    <br/>
                    <span style="font-size:10px;">Aclaración de firma</span>
                </div>
            </div>
        </xpath>
        
    </template>

</odoo>
