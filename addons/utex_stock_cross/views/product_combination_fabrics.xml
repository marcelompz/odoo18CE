<odoo>

    <!-- tree view -->
    
    <record id="product_combination_fabrics_tree" model="ir.ui.view">
        <field name="name">product.combination.fabrics.tree</field>
        <field name="model">product.combination.fabrics</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="product_template_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- form view -->

    <record id="product_combination_fabrics_form" model="ir.ui.view">
        <field name="name">product.combination.fabrics.form</field>
        <field name="model">product.combination.fabrics</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" class="text-break" default_focus="1" placeholder="Ej.: Infraboost Tech" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="product_related" string="Productos relacionados">
                            <field name="product_template_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- window action -->

    <record id="product_combination_fabrics_action" model="ir.actions.act_window">
        <field name="name">Telas para combinaciones</field>
        <field name="res_model">product.combination.fabrics</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menu -->

    <menuitem
        id="product_combination_fabrics_menu"
        name="Telas para combinaciones"
        action="utex_stock_cross.product_combination_fabrics_action"
        parent="stock.menu_product_in_config_stock"
        sequence="64"
    />

</odoo>
