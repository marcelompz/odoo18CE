<odoo>

    <!-- form view -->

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//app[@name='stock']//block[@name='product_setting_container']" position="inside">
                <setting id="product_name_sequences" help="Configura la secuencia de campos a tener en cuenta para crear el nombre a ser mostrado en el producto">
                    <field name="configure_product_display_name"/>
                    <div class="content-group">
                        <div class="mt8" invisible="not configure_product_display_name">
                            <button name="%(utex_stock_cross.product_name_sequence_action)d" icon="oi-arrow-right" type="action" string="Configurar" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        
        </field>
    </record>

</odoo>
