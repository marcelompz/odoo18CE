<odoo>

    <!-- tree view -->

    <record id="product_type_thread_tree" model="ir.ui.view">
        <field name="name">product.type.thread.tree</field>
        <field name="model">product.type.thread</field>
        <field name="arch" type="xml">
            <list editable="bottom" sample="1">
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="product_type_thread_action" model="ir.actions.act_window">
        <field name="name">Tipo de hilo</field>
        <field name="res_model">product.type.thread</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
