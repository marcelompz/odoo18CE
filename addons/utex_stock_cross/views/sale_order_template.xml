<odoo>

    <!-- form view -->
    <record id="sale_order_template_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.template.inherit.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_detalles.view_sale_order_template_form_inherit_code" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='code']" position="before">
                <field name="product_model_id" options="{'no_create': 1}"/>
            </xpath>
        
        </field>
    </record>

</odoo>
