<odoo>

    <!-- tree view -->

    <record id="product_molding_label_tree" model="ir.ui.view">
        <field name="name">product.molding.label.tree</field>
        <field name="model">product.molding.label</field>
        <field name="arch" type="xml">
            <list editable="bottom" sample="1">
                <field name="name" required="1"/>
            </list>
        </field>
    </record>

    <!-- window action -->

    <record id="product_molding_label_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">product.molding.label</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
