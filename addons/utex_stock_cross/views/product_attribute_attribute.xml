<odoo>

    <!-- tree view -->
    
    <record id="product_attribute_attribute_tree" model="ir.ui.view">
        <field name="name">product.attribute.attribute.tree</field>
        <field name="model">product.attribute.attribute</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_template_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- form view -->

    <record id="product_attribute_attribute_form" model="ir.ui.view">
        <field name="name">product.attribute.attribute.form</field>
        <field name="model">product.attribute.attribute</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" class="text-break" default_focus="1" required="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="product_related" string="Productos relacionados">
                            <field name="product_template_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- window action -->

    <record id="product_attribute_attribute_action" model="ir.actions.act_window">
        <field name="name">Atributo de la materia prima</field>
        <field name="res_model">product.attribute.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menu -->

    <menuitem
        id="product_attribute_attribute_menu"
        name="Atributo de la materia prima"
        action="utex_stock_cross.product_attribute_attribute_action"
        parent="stock.menu_product_in_config_stock"
        sequence="68"
    />

</odoo>
