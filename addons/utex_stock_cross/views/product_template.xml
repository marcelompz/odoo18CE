<odoo>

    <!-- form view -->
    <record id="product_template_inherit_form" model="ir.ui.view">
        <field name="name">product.template.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">

            <!-- campo nombre comercial -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <label for="display_name" string="Comercial"/>
                <h1>
                    <div class="d-flex">
                        <field class="text-break" name="display_name" options="{'line_breaks': False}"/>
                    </div>
                </h1>
            </xpath>

            <!-- reordenamiento de campos -->
            <xpath expr="//notebook//page[@name='general_information']" position="before">
                <page name="product_details_cross" string="Detalles">
                    <group>
                        <group name="left_group">
                            <field name="type" widget="radio" options="{'horizontal': True}" string="Tipo de producto"/>
                            <field name="service_tracking" invisible="type != 'service'"/>
                            <field name="invoice_policy" required="1" invisible="not sale_ok or type == 'combo'" string="Política de facturación"/>
                            <label for="is_storable" string="Rastrear inventario" class="oe_inline" invisible="type != 'consu'"/>
                            <div class="o_row w-100" invisible="type != 'consu'">
                                <field name="is_storable"/>
                                <field name="tracking" invisible="not is_storable" groups="stock.group_production_lot"/>
                            </div>
                            <field name="product_tooltip" class="fst-italic text-muted" invisible="not sale_ok or type == 'combo'" string=""/>
                            <field name="product_class" widget="radio" options="{'horizontal': True}" invisible="type != 'consu'"/>
                            <field name="categ_id" string="Categoría de Fabricación/Rubro/Deporte" invisible="type == 'service'"/>
                            <field name="product_initial_id" options="{'no_create': 1}" string="Producto" invisible="type == 'service'" required="product_class == 'merchandise'"/>
                            
                            <field name="default_code" string="Referencia (SKU)" invisible="product_variant_count &gt; 1"/>
                            <field name="barcode" invisible="product_variant_count &gt; 1 or (product_variant_count == 0 and valid_product_template_attribute_line_ids) or type in ['service', 'combo']"/>
                            <field name="product_attribute_attribute_ids" options="{'no_create': 1}" widget="many2many_tags" invisible="product_class == 'merchandise' or type == 'service'"/>
                            <field name="product_online_technology_ids" options="{'no_create': 1}" widget="many2many_tags" invisible="product_class == 'merchandise' or type == 'service'"/>
                            <field name="product_composition" invisible="product_class == 'merchandise' or type == 'service'"/>
                            <field name="product_width" invisible="product_class != 'merchandise' or type == 'service'"/>
                            <field name="product_grammar" invisible="product_class != 'merchandise' or type == 'service'"/>
                            <field name="product_performance" invisible="product_class == 'merchandise' or type == 'service'"/>
                            <field name="product_color_id" invisible="type == 'service'" options="{'no_create': 1, 'no_open': 1}" domain="[('field_related', '=', 'color')]"/>
                        </group>
                        <group name="right_group">
                            <field name="product_gender_id" options="{'no_create': 1}" string="Género"/>
                            <field name="product_model_id" options="{'no_create': 1}" string="Modelo" required="product_class == 'merchandise'"/>
                            <field name="product_type_use_id" options="{'no_create': 1}" string="Línea"/>
                            <field name="product_combination_fabrics_id" options="{'no_create': 1}" string="Combinación de Telas" widget="many2many_tags" required="product_class == 'merchandise'"/>
                            <field name="product_brand_id" options="{'no_create': 1}" string="Marca del producto"/>
                            <field name="product_collection_id" options="{'no_create': 1}" string="Colección"/>
                            <field name="product_design_id" options="{'no_create': 1}" string="Diseño"/>
                            <field name="product_molding_id" options="{'no_create': 1}" string="Moldería"/>
                            <label for="list_price" string="Precio de venta"/>
                            <div name="list_price_uom">
                                <field name="list_price"
                                    class="oe_inline"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                                <span
                                    name="uom_span"
                                    groups="uom.group_uom"
                                    invisible="type == 'combo'"
                                >
                                    por
                                    <field
                                        name="uom_id"
                                        class="oe_inline" style="max-width:136px"
                                        options="{'no_create': True}"
                                    />
                                </span>
                            </div>
                            <label for="taxes_id" string="Impuesto de ventas"/>
                            <div name="tax_info" class="o_row">
                                <field name="taxes_id" widget="many2many_tags"
                                    context="{'default_type_tax_use': 'sale', 'search_default_sale': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu',}"
                                    options="{'create': false, 'create_edit': false}"/>
                                <field name="tax_string"/>
                            </div>
                            <label
                                for="standard_price"
                                invisible="(id and product_variant_count != 1
                                            and not is_product_variant) or type == 'combo'"
                                id="standard_price_label"
                            />
                            <div
                                name="standard_price_uom"
                                invisible="(id and product_variant_count != 1
                                            and not is_product_variant) or type == 'combo'"
                            >
                                <field
                                    name="standard_price"
                                    class="oe_inline"
                                    widget="monetary"
                                    options="{
                                        'currency_field': 'cost_currency_id',
                                        'field_digits': True,
                                    }"
                                />
                                <span groups="uom.group_uom">
                                    por
                                    <field name="uom_name" class="oe_inline"/>
                                </span>
                            </div>
                            <field name="supplier_taxes_id"
                                invisible="not purchase_ok or type == 'combo'"
                                widget="many2many_tags"
                                context="{
                                    'default_type_tax_use':'purchase',
                                    'search_default_purchase': 1,
                                    'search_default_service': type == 'service',
                                    'search_default_goods': type == 'consu',
                                }"
                                string="Impuesto de compras"
                            />
                            <label for="coefficient_value"/>
                            <div name="div_coefficient_value">
                                <field name="coefficient_value"
                                    class="oe_inline"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            </div>
                            <div colspan="2" class="o_row">
                                <label for="margin_gain"/>
                                <field name="margin_gain" class="oe_inline" nolabel="1" widget="percentage"/>
                                <button name="recalculate_coefficient_from_margin"
                                    string="Calcular valor sugerido" type="object"
                                    help="Calcula el valor sugerido son el margen sobre el costo."
                                    class="oe_inline oe_link pt-0"
                                />
                            </div>
                            <div colspan="2" class="o_row">
                                <label for="suggested_value"/>
                                <field name="suggested_value"
                                    class="oe_inline"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                                    invisible="suggested_alert"
                                    nolabel="1"
                                    readonly="1"
                                />
                                <field name="suggested_value"
                                    class="oe_inline text-danger"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                                    invisible="not suggested_alert"
                                    nolabel="1"
                                    readonly="1"
                                />
                            </div>
                            <field name="revenue"/>
                            <field name="margin_on_sale"/>
                            <field name="margin_over_cost"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- campo referencia interna -->
            <xpath expr="//page[@name='general_information']//field[@name='default_code']" position="attributes">
                <attribute name="string">Referencia (SKU)</attribute>
            </xpath>

            <!-- oculta la pestaña de "Información general" -->
            <xpath expr="//page[@name='general_information']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>

            <!-- campo name -->
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="string">Nombre técnico</attribute>
            </xpath>
        
        </field>
    </record>

    <record id="product_template_utex_inherit_form" model="ir.ui.view">
        <field name="name">product.template.utex.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="utex_stock_landed_costs_cross.product_template_inherit_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='margin_gain']" position="replace"/>
                <!-- <div colspan="2" class="o_row">
                    <label for="margin_gain"/>
                    <field name="margin_gain" class="oe_inline" nolabel="1" widget="percentage"/>
                    <button name="recalculate_coefficient_from_margin"
                        string="Calcular valor sugerido" type="object"
                        help="Calcula el valor sugerido son el margen sobre el costo."
                        class="oe_inline oe_link pt-0"
                    />
                </div>
            </xpath> -->

            <!-- <xpath expr="//div[@name='div_suggested_value']" position="replace"/> -->
                <!-- <field name="suggested_value"
                    class="oe_inline"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                    invisible="suggested_alert"
                    nolabel="1"
                    readonly="1"
                />
                <field name="suggested_value"
                    class="oe_inline text-danger"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                    invisible="not suggested_alert"
                    nolabel="1"
                    readonly="1"
                />
            </xpath> -->
            <xpath expr="//label[@for='coefficient_value']" position="replace"/>
            <xpath expr="//div[@name='div_coefficient_value']" position="replace"/>
            <xpath expr="//label[@for='suggested_value']" position="replace"/>
            <xpath expr="//div[@name='div_suggested_value']" position="replace"/>
        </field>
    </record>

    <!-- kanban view -->

    <record id="product_template_inherit_kanban" model="ir.ui.view">
        <field name="name">product.template.inherit.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">

            <xpath expr="//templates//field[@name='name']" position="replace">
                <field name="display_name" options="{'line_breaks': False}" class="text-truncate"/>
            </xpath>
        
        </field>
    </record>

    <!-- tree view -->

    <record id="product_template_inherit_tree" model="ir.ui.view">
        <field name="name">product.template.inherit.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">

            <xpath expr="//list//field[@name='name']" position="before">
                <field name="display_name"/>
            </xpath>

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        
        </field>
    </record>

    <!-- search view -->

    <record id="product_template_inherit_search_form" model="ir.ui.view">
        <field name="name">product.template.inherit.search.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_tag_ids']" position="after">
                <field name="display_name"/>
            </xpath>
        
        </field>
    </record>

    <!-- window action to new product -->
    <record id="action_create_product_direct" model="ir.actions.act_window">
        <field name="name">Nuevo Producto</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_sale_ok': True}</field>
    </record>

    <!-- menu to new product -->
    <menuitem id="menu_root_create_product"
        name="Crear Producto"
        action="action_create_product_direct"
        web_icon="utex_stock_cross,static/description/new_product_icon.png"
        sequence="1"
    />

</odoo>
