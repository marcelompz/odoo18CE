<odoo>

    <!-- report stock ticket -->
    <template id="report_delivery_ticket_template">
        <!-- Para tickets, es mejor no usar 'web.external_layout'. 
             'web.html_container' nos da una página en blanco para un control total. -->
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Aplicamos estilos directamente para que se vean bien en el PDF -->
                <div class="page" style="font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif; font-size: 10px; line-height: 1.2; color: #000; padding: 2px;">
                    <meta charset="utf-8"/>
                    <!-- Encabezado -->
                    <div style="text-align: center;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 40px; max-width: 60px;" alt="Logo"/>
                        <h5 style="margin-top: 5px; margin-bottom: 2px; font-weight: bold;"><t t-esc="o.company_id.name"/></h5>
                        <div t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                    </div>

                    <hr style="border-top: 1px dashed black; margin-top: 5px; margin-bottom: 5px;"/>

                    <!-- Información del Documento -->
                    <h4 style="font-weight: bold; margin: 5px 0; text-align: center;">ALBARÁN DE ENTREGA</h4>
                    <div class="row">
                        <div class="col-12"><strong>Número:</strong> <span t-field="o.name"/></div>
                        <div class="col-12"><strong>Fecha:</strong> <span t-field="o.date_done" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/></div>
                        <div class="col-12" t-if="o.partner_id"><strong>Cliente:</strong> <span t-field="o.partner_id.name"/></div>
                        <div class="col-12" t-if="o.origin"><strong>Origen:</strong> <span t-field="o.origin"/></div>
                    </div>

                    <hr style="border-top: 1px dashed black; margin-top: 5px; margin-bottom: 5px;"/>
                    
                    <!-- Líneas de Productos -->
                    <table class="table table-sm" style="width: 100%;">
                        <thead>
                            <tr>
                                <th class="text-start">Producto</th>
                                <th class="text-end">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Usamos move_line_ids si el albarán está hecho, para ver las cantidades reales movidas -->
                            <t t-set="lines_to_print" t-value="o.move_line_ids and o.move_line_ids or o.move_ids"/>
                            <tr t-foreach="lines_to_print" t-as="line">
                                <td style="padding: 2px 0;">
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                                <td class="text-end" style="padding: 2px 0;">
                                    <!-- Reutilizamos la lógica para mostrar enteros -->
                                    <span t-esc="int(line.quantity if 'quantity' in line else line.product_uom_qty)"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <hr style="border-top: 1px dashed black; margin-top: 5px; margin-bottom: 5px;"/>

                    <!-- Pie de página: Código de barras y firma -->
                    <div style="text-align: center;">
                        <p style="margin-top: 20px;">Recibido por:</p>
                        <br/><br/>
                        <p>_________________________</p>
                        <p>(Firma y Aclaración)</p>

                        <div t-if="o.name" class="mt-4">
                            <div t-field="o.name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 400, 'height': 80, 'humanreadable': 1, 'img_style': 'max-width: 100%; height: auto;'}"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Acción de Reporte para el Ticket -->
    <record id="action_report_delivery_ticket" model="ir.actions.report">
        <field name="name">Imprimir Ticket de Entrega</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utex_stock_cross.report_delivery_ticket_template</field>
        <field name="report_file">utex_stock_cross.report_delivery_ticket_template</field>
        <field name="paperformat_id" ref="utex_stock_cross.ticket_80mm_papelformat"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">(object.name or 'TICKET').replace('/','_')</field>
    </record>

</odoo>
