<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista propia (no inherit, evita XML ID inestable) -->
    <record id="view_hr_contract_type_list_cn" model="ir.ui.view">
        <field name="name">hr.contract.type.list.cn</field>
        <field name="model">hr.contract.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Contrato">
                <field name="name"/>
                <field name="cn_is_jornalero"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_type_form_cn" model="ir.ui.view">
        <field name="name">hr.contract.type.form.cn</field>
        <field name="model">hr.contract.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Contrato">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cn_is_jornalero"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_contract_type_cn" model="ir.actions.act_window">
        <field name="name">Tipos de Contrato (Jornalero/Mensualizado)</field>
        <field name="res_model">hr.contract.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_contract_type_list_cn"/>
    </record>

    <!-- Menu bajo Configuracion de RRHH (ID estandar Odoo 18) -->
    <menuitem id="menu_hr_contract_type_cn"
              name="Tipos de Contrato (Jornalero/Mensualizado)"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_contract_type_cn"
              sequence="99"/>

</odoo>
