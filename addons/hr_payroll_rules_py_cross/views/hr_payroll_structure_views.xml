<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Server Action visible en el menu "Acciones" tanto en la lista
        como en el form de Estructuras Salariales.
        Se muestra para cualquier usuario con permiso de lectura sobre
        hr.payroll.structure.
    -->
    <record id="server_action_apply_cn_py_rules" model="ir.actions.server">
        <field name="name">Aplicar reglas PY (Crossnexion)</field>
        <field name="model_id" ref="hr_payroll.model_hr_payroll_structure"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payroll_structure"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_apply_cn_py_rules()
        </field>
    </record>

</odoo>
