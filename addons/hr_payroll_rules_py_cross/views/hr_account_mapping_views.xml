<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Server action para configurar Plan de Cuentas PY desde menu "Acciones"
         tanto en lista como form de hr.payroll.structure (sin inherit de vista
         para evitar dependencia de XML IDs especificos por version). -->
    <record id="server_action_setup_py_accounts_struct" model="ir.actions.server">
        <field name="name">Configurar Plan de Cuentas PY (Res. 49/14)</field>
        <field name="model_id" ref="hr_payroll.model_hr_payroll_structure"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payroll_structure"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_setup_py_accounts()
        </field>
    </record>

</odoo>
