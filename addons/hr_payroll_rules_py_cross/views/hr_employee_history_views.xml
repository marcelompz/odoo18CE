<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_inherit_history" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.history.cn</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Historial de Pagos" name="cn_payslip_history">
                    <div class="alert alert-info" role="alert">
                        <p>Historial completo de recibos del empleado con resumen
                        por mes: dias y horas trabajadas, ingresos, descuentos,
                        neto desembolsado y acceso directo a impresion (recibo
                        IPS oficial e Interno MTESS).</p>
                    </div>
                    <group col="2">
                        <group>
                            <field name="cn_payslip_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="cn_currency_id" invisible="1"/>
                            <field name="cn_total_paid_lifetime" readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'cn_currency_id'}"/>
                        </group>
                    </group>
                    <field name="cn_payslip_history_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0"
                              decoration-success="state == 'paid'"
                              decoration-info="state == 'done'"
                              decoration-muted="state == 'verify'"
                              default_order="date_from desc">
                            <field name="number" string="Recibo"/>
                            <field name="date_from" string="Desde"/>
                            <field name="date_to" string="Hasta"/>
                            <field name="struct_id" string="Estructura" optional="hide"/>
                            <field name="cn_dias_trabajados" string="Dias" optional="show"/>
                            <field name="cn_horas_trabajadas" widget="float_time"
                                   string="Horas" optional="show"/>
                            <field name="cn_total_ingresos" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="Ingresos" sum="Total Ingresos"/>
                            <field name="cn_total_descuentos" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="Descuentos" sum="Total Descuentos"/>
                            <field name="cn_total_neto" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   string="Neto" sum="Total Neto"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'paid'"
                                   decoration-info="state == 'done'"/>
                            <button name="action_print_payslip_internal" type="object"
                                    string="Interno" icon="fa-file-pdf-o"
                                    class="btn-link"
                                    title="Imprimir recibo INTERNO (MTESS Crossnexion)"/>
                            <button name="action_print_payslip_ips" type="object"
                                    string="IPS" icon="fa-id-card-o"
                                    class="btn-link"
                                    title="Imprimir recibo OFICIAL IPS / Funcionario"/>
                            <field name="currency_id" invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
