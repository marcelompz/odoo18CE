<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el template del carrito para agregar enlace al checkout simplificado -->
    <template id="cart_simplified_link" inherit_id="website_sale.cart">
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="after">
            <a href="/shop/checkout/simplified" class="btn btn-success ms-2">
                <i class="fa fa-bolt me-1"></i>
                Checkout Simplificado
            </a>
        </xpath>
    </template>
    <!-- Template para el checkout simplificado -->
    <template t-name="web_checkout_simplifier.checkout">
        <t t-call="web_checkout_simplifier.checkout_simplifier_layout">
            <t t-if="not request.env.context.get('website_editor_mode')">
                <t t-javascript="true">
                    <script type="text/javascript">
                        // Solución de emergencia: sobrescribir la función global
                        window.shop_update_address = function() {};
                    </script>
                </t>
            </t>
            <div id="wrap" class="oe_structure oe_empty">
                <div id="shop_checkout">
                    <!-- Todo el contenido del checkout unificado va aquí -->
                    <div class="container mt-4">
                        <div class="row">
                            <div class="col-lg-8 mx-auto">
                                <div class="card shadow-sm">
                                    <div class="card-header bg-primary text-white">
                                        <h3 class="mb-0">
                                            <i class="fa fa-shopping-cart me-2"/>
                                            Finalizar Compra
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <!-- Resumen de la orden -->
                                        <div class="row mb-4">
                                            <div class="col-12">
                                                <h5 class="border-bottom pb-2">Resumen de tu pedido</h5>
                                                <div class="order-summary">
                                                    <t t-foreach="order.order_line" t-as="line">
                                                        <div class="d-flex justify-content-between align-items-center py-2">
                                                            <div>
                                                                <strong t-field="line.product_id.name"/>
                                                                <small class="text-muted d-block">
                                                                    Cantidad: <span t-field="line.product_uom_qty"/>
                                                                </small>
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="fw-bold" t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    <hr/>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <h5>Total:</h5>
                                                        <h5 class="text-primary" t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Formulario unificado -->
                                        <form method="post" enctype="multipart/form-data" id="simplified_checkout_form">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            
                                            <!-- Información de contacto y dirección -->
                                            <div class="row mb-4">
                                                <div class="col-12">
                                                    <h5 class="border-bottom pb-2">
                                                        <i class="fa fa-user me-2"/>
                                                        Información de contacto y envío
                                                    </h5>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="name" class="form-label">Nombre completo *</label>
                                                    <input type="text" class="form-control" id="name" name="name" t-att-value="form_data.get('name', partner.name if partner else '')" required="required"/>
                                                    <div class="invalid-feedback" t-if="errors.get('name')" t-esc="errors['name']"/>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="email" class="form-label">Email *</label>
                                                    <input type="email" class="form-control" id="email" name="email" t-att-value="form_data.get('email', partner.email if partner else '')" required="required"/>
                                                    <div class="invalid-feedback" t-if="errors.get('email')" t-esc="errors['email']"/>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="phone" class="form-label">Teléfono</label>
                                                    <input type="tel" class="form-control" id="phone" name="phone" t-att-value="form_data.get('phone', partner.phone if partner else '')"/>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="country_id" class="form-label">País *</label>
                                                    <select class="form-select" id="country_id" name="country_id" required="required" t-onchange="this.form.submit()">
                                                        <option value="">Seleccionar país...</option>
                                                        <t t-foreach="countries" t-as="country">
                                                            <option t-att-value="country.id" t-att-selected="'selected' if (form_data.get('country_id') == str(country.id)) or (partner and partner.country_id.id == country.id) or (not form_data and not partner and country.id == default_country_id) else None" t-esc="country.name"/>
                                                        </t>
                                                    </select>
                                                    <div class="invalid-feedback" t-if="errors.get('country_id')" t-esc="errors['country_id']"/>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="state_id" class="form-label">Departamento</label>
                                                    <select class="form-select" id="state_id" name="state_id">
                                                        <option value="">Seleccionar estado...</option>
                                                        <t t-foreach="states" t-as="state">
                                                            <t t-if="state.country_id.id == (form_data.get('country_id') or (partner.country_id.id if partner else default_country_id))">
                                                                <option t-att-value="state.id" t-att-selected="'selected' if (form_data.get('state_id') == str(state.id)) or (partner and partner.state_id.id == state.id) else None" t-esc="state.name"/>
                                                            </t>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="city" class="form-label">Ciudad *</label>
                                                    <input type="text" class="form-control" id="city" name="city" t-att-value="form_data.get('city', partner.city if partner else '')" required="required"/>
                                                    <div class="invalid-feedback" t-if="errors.get('city')" t-esc="errors['city']"/>
                                                </div>
                                                <div class="col-md-8 mb-3">
                                                    <label for="street" class="form-label">Dirección *</label>
                                                    <input type="text" class="form-control" id="street" name="street" t-att-value="form_data.get('street', partner.street if partner else '')" required="required"/>
                                                    <div class="invalid-feedback" t-if="errors.get('street')" t-esc="errors['street']"/>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <label for="zip" class="form-label">Código postal</label>
                                                    <input type="text" class="form-control" id="zip" name="zip" t-att-value="form_data.get('zip', partner.zip if partner else '')"/>
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label for="street2" class="form-label">Dirección adicional</label>
                                                    <input type="text" class="form-control" id="street2" name="street2" t-att-value="form_data.get('street2', partner.street2 if partner else '')" placeholder="Apartamento, suite, etc."/>
                                                </div>
                                            </div>

                                            <!-- Método de pago -->
                                            <div class="row mb-4">
                                                <div class="col-12">
                                                    <h5 class="border-bottom pb-2">
                                                        <i class="fa fa-credit-card me-2"/>
                                                        Método de pago
                                                    </h5>
                                                </div>
                                                <div class="col-12">
                                                    <t t-foreach="payment_methods" t-as="payment_method">
                                                        <div class="form-check mb-3 p-3 border rounded">
                                                            <input class="form-check-input payment-method-radio" type="radio" name="payment_method" t-att-id="'payment_method_' + str(payment_method.id)" t-att-value="payment_method.id" t-att-data-code="payment_method.code" required="required"/>
                                                            <label class="form-check-label w-100" t-att-for="'payment_method_' + str(payment_method.id)">
                                                                <div class="d-flex align-items-center">
                                                                    <i class="fa fa-credit-card me-2"/>
                                                                    <strong t-esc="payment_method.name"/>
                                                                </div>
                                                                <small class="text-muted d-block mt-1" t-esc="payment_method.pre_msg"/>
                                                            </label>
                                                        </div>
                                                    </t>
                                                    <div class="invalid-feedback" t-if="errors.get('payment_method')" t-esc="errors['payment_method']"/>
                                                </div>
                                            </div>

                                            <!-- Mensaje de transferencia bancaria (oculto por defecto) -->
                                            <div id="bank_transfer_section" class="row mb-4" style="display: none;">
                                                <div class="col-12">
                                                    <div class="alert alert-info">
                                                        <h6><i class="fa fa-info-circle me-2"/>Instrucciones para transferencia bancaria</h6>
                                                        <p>Por favor, realiza la transferencia a la siguiente cuenta bancaria:</p>
                                                        <ul>
                                                            <li><strong>Banco:</strong> Banco Ejemplo</li>
                                                            <li><strong>Número de cuenta:</strong> 1234567890</li>
                                                            <li><strong>Titular:</strong> Tu Empresa S.A.</li>
                                                            <li><strong>Concepto:</strong> Pedido #<span t-esc="order.name"/></li>
                                                        </ul>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="bank_transfer_note" class="form-label">Nota adicional para transferencia</label>
                                                        <textarea class="form-control" id="bank_transfer_note" name="bank_transfer_note" rows="3" placeholder="Información adicional sobre la transferencia..."/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Carga de comprobante de pago -->
                                            <div class="row mb-4">
                                                <div class="col-12">
                                                    <h5 class="border-bottom pb-2">
                                                        <i class="fa fa-receipt me-2"/>
                                                        Comprobante de pago (opcional)
                                                    </h5>
                                                    <div class="alert alert-info">
                                                        <i class="fa fa-info-circle me-2"/>
                                                        <strong>Importante:</strong> Si selecciona transferencia bancaria, puede subir el comprobante de pago aquí. 
                                                        El archivo se guardará como comentario en su pedido antes de la confirmación.
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="checkout_file" class="form-label">
                                                            Subir comprobante de transferencia o documento
                                                        </label>
                                                        <input type="file" class="form-control" id="checkout_file" name="checkout_file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt"/>
                                                        <div class="form-text">
                                                            Formatos permitidos: PDF, JPG, PNG, DOC, DOCX, TXT. Tamaño máximo: 10MB
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Botón de confirmación -->
                                            <div class="row">
                                                <div class="col-12 text-center">
                                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                                        <i class="fa fa-check me-2"/>
                                                        Confirmar Pedido
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <!-- Parche para evitar error de Odoo JS en checkout simplificado -->
        <script type="text/javascript">
            if (window.odoo &amp;&amp; window.odoo.__DEBUG__) {
                // Solo en modo debug, para desarrolladores
                console.warn('Odoo JS sigue buscando elementos del checkout estándar.');
            }
        </script>
    </template>
    <!-- El resto de tus templates personalizados (cart_simplified_link, checkout_confirmation, etc.) pueden quedarse igual -->
</odoo>

