<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupos de Usuarios -->
    <record id="group_portal_detail_user" model="res.groups">
        <field name="name">Usuario Portal Detalles</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="comment">Puede crear y gestionar configuraciones de listas portal</field>
    </record>

    <record id="group_portal_detail_commercial" model="res.groups">
        <field name="name">Comercial Portal Detalles</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_portal_detail_user'))]"/>
        <field name="comment">Puede revisar y gestionar listas de sus clientes</field>
    </record>

    <record id="group_portal_detail_manager" model="res.groups">
        <field name="name">Gestor Portal Detalles</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_portal_detail_commercial'))]"/>
        <field name="comment">Puede gestionar todas las configuraciones y listas portal</field>
    </record>

    <!-- Reglas de Seguridad para portal.detail.config -->
    <record id="portal_detail_config_rule_user" model="ir.rule">
        <field name="name">Portal Detail Config: Solo mis documentos</field>
        <field name="model_id" ref="model_portal_detail_config"/>
        <field name="domain_force">[('commercial_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_detail_config_rule_manager" model="ir.rule">
        <field name="name">Portal Detail Config: Administradores</field>
        <field name="model_id" ref="model_portal_detail_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Reglas de Seguridad para portal.detail.list -->
    <record id="portal_detail_list_rule_user" model="ir.rule">
        <field name="name">Portal Detail List: Solo mis listas</field>
        <field name="model_id" ref="model_portal_detail_list"/>
        <field name="domain_force">[('commercial_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_detail_list_rule_manager" model="ir.rule">
        <field name="name">Portal Detail List: Administradores</field>
        <field name="model_id" ref="model_portal_detail_list"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Reglas de Seguridad para portal.detail.item -->
    <record id="portal_detail_item_rule_user" model="ir.rule">
        <field name="name">Portal Detail Item: Solo mis items</field>
        <field name="model_id" ref="model_portal_detail_item"/>
        <field name="domain_force">[('list_id.commercial_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_detail_item_rule_manager" model="ir.rule">
        <field name="name">Portal Detail Item: Administradores</field>
        <field name="model_id" ref="model_portal_detail_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Reglas de Seguridad para Portal (Clientes) -->
    <record id="portal_detail_config_rule_portal" model="ir.rule">
        <field name="name">Portal Detail Config: Portal</field>
        <field name="model_id" ref="model_portal_detail_config"/>
        <field name="domain_force">[('customer_id', 'in', user.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_detail_list_rule_portal" model="ir.rule">
        <field name="name">Portal Detail List: Portal</field>
        <field name="model_id" ref="model_portal_detail_list"/>
        <field name="domain_force">[('customer_id', 'in', user.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="portal_detail_item_rule_portal" model="ir.rule">
        <field name="name">Portal Detail Item: Portal</field>
        <field name="model_id" ref="model_portal_detail_item"/>
        <field name="domain_force">[('customer_id', 'in', user.partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
