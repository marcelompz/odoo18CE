<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para portal.detail.config -->
    <record id="portal_detail_config_list_view" model="ir.ui.view">
        <field name="name">portal.detail.config.list</field>
        <field name="model">portal.detail.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones Portal" decoration-success="state == 'active'" decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="commercial_id"/>
                <field name="state" widget="badge"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="list_count"/>
                <field name="expires_date"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para portal.detail.config -->
    <record id="portal_detail_config_form_view" model="ir.ui.view">
        <field name="name">portal.detail.config.form</field>
        <field name="model">portal.detail.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Portal">
                <header>
                    <button name="action_activate" string="Activar" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_expire" string="Expirar" type="object" 
                            class="btn-warning" invisible="state not in ['active']"/>
                    <button name="action_cancel" string="Cancelar" type="object" 
                            class="btn-secondary" invisible="state in ['expired', 'cancelled']"/>
                    <button name="action_regenerate_token" string="Regenerar Token Portal" type="object" 
                            class="btn-info" invisible="state in ['expired', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la configuración"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" options="{'no_create': True}"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="commercial_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="expires_date"/>
                            <field name="portal_url" readonly="1" widget="url"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Configuración de Productos">
                            <group>
                                <group>
                                    <field name="available_categories" widget="many2many_tags" 
                                           options="{'no_create': True}"/>
                                    <p class="text-muted">
                                        Seleccione las categorías de productos que estarán disponibles 
                                        en el formulario del portal. Estas categorías aparecerán como 
                                        opciones en el campo "Producto" del formulario.
                                    </p>
                                </group>
                                <group>
                                    <field name="available_sizes" widget="many2many_tags" 
                                           options="{'no_create': True}"/>
                                    <p class="text-muted">
                                        Seleccione los talles que estarán disponibles en el formulario. 
                                        Estos son los valores del atributo "Talle" de los productos.
                                    </p>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Listas Enviadas" name="lists">
                            <field name="list_count" invisible="1"/>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_view_lists" type="object" 
                                        class="oe_stat_button" icon="fa-list">
                                    <div class="o_stat_info">
                                        <span class="o_stat_value">
                                            <field name="list_count"/>
                                        </span>
                                        <span class="o_stat_text">Listas</span>
                                    </div>
                                </button>
                            </div>
                            <field name="detail_lists" readonly="1">
                                <list string="Listas Enviadas">
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="submitted_date"/>
                                    <field name="commercial_notified" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para portal.detail.config -->
    <record id="portal_detail_config_search_view" model="ir.ui.view">
        <field name="name">portal.detail.config.search</field>
        <field name="model">portal.detail.config</field>
        <field name="arch" type="xml">
            <search string="Buscar Configuraciones">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="commercial_id"/>
                
                <filter string="Activas" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Expiradas" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Canceladas" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                
                
                <separator/>
                <filter string="Mis Configuraciones" name="my_configs" 
                        domain="[('commercial_id', '=', uid)]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Comercial" name="group_commercial" context="{'group_by': 'commercial_id'}"/>
                    <filter string="Cliente" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Fecha Creación" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para portal.detail.config -->
    <record id="portal_detail_config_action" model="ir.actions.act_window">
        <field name="name">Configuraciones Portal</field>
        <field name="res_model">portal.detail.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva configuración de lista portal
            </p>
            <p>
                Configure listas portal para que los clientes puedan cargar 
                detalles de productos desde el portal web.
            </p>
        </field>
    </record>

    <!-- Vista de formulario simplificada para portal.detail.config -->
    <record id="portal_detail_config_simple_form_view" model="ir.ui.view">
        <field name="name">portal.detail.config.simple.form</field>
        <field name="model">portal.detail.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Portal">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la configuración"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" options="{'no_create': True}"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="commercial_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="expires_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="available_categories" widget="many2many_tags" 
                               options="{'no_create': True}"/>
                        <field name="available_sizes" widget="many2many_tags" 
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
