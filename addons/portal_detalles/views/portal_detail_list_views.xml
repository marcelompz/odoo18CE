<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para portal.detail.list -->
    <record id="portal_detail_list_list_view" model="ir.ui.view">
        <field name="name">portal.detail.list.list</field>
        <field name="model">portal.detail.list</field>
        <field name="arch" type="xml">
            <list string="Listas Portal" decoration-success="state == 'processed'" decoration-info="state == 'reviewed'" decoration-warning="state == 'submitted'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="commercial_id"/>
                <field name="state" widget="badge"/>
                <field name="item_count"/>
                <field name="submitted_date"/>
                <field name="reviewed_date"/>
                <field name="commercial_notified" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para portal.detail.list -->
    <record id="portal_detail_list_form_view" model="ir.ui.view">
        <field name="name">portal.detail.list.form</field>
        <field name="model">portal.detail.list</field>
        <field name="arch" type="xml">
            <form string="Lista Portal">
                <header>
                    <button name="action_submit" string="Enviar" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" string="Revisar" type="object" 
                            class="btn-info" invisible="state != 'submitted'"/>
                    <button name="action_process" string="Procesar" type="object" 
                            class="btn-success" invisible="state not in ['reviewed']"/>
                    <button name="action_reject" string="Rechazar" type="object" 
                            class="btn-danger" invisible="state not in ['submitted', 'reviewed']"/>
                    <button name="action_reset_to_draft" string="Resetear" type="object" 
                            class="btn-secondary" invisible="state not in ['rejected']"/>
                    <button name="action_export_excel" string="Exportar Excel" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed,processed,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_items" type="object" 
                                class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="item_count"/>
                                </span>
                                <span class="o_stat_text">Items</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="config_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="commercial_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="submitted_date" readonly="1"/>
                            <field name="reviewed_date" readonly="1"/>
                            <field name="commercial_notified" readonly="1"/>
                            <field name="customer_notified" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="customer_notes" readonly="1"/>
                        <field name="commercial_notes"/>
                    </group>
                    
                    <notebook>
                        <page string="Items de la Lista" name="items">
                            <div class="oe_button_box" name="items_button_box">
                                <button name="action_approve_all_items" string="Aprobar Todos" type="object" 
                                        class="btn-success" invisible="state not in ['submitted', 'reviewed']"/>
                                <button name="action_reject_all_items" string="Rechazar Todos" type="object" 
                                        class="btn-danger" invisible="state not in ['submitted', 'reviewed']"/>
                                <button name="action_reset_all_items" string="Resetear Todos" type="object" 
                                        class="btn-secondary" invisible="state not in ['rejected']"/>
                            </div>
                            
                            <field name="detail_items">
                                <list editable="bottom">
                                    <field name="modelo"/>
                                    <field name="nombre"/>
                                    <field name="numero"/>
                                    <field name="otros"/>
                                    <field name="cantidad"/>
                                    <field name="products_summary"/>
                                    <field name="state" widget="badge"/>
                                    <field name="commercial_notes"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Estadísticas" name="statistics">
                            <group>
                                <group>
                                    <field name="total_items" readonly="1"/>
                                    <field name="approved_items" readonly="1"/>
                                </group>
                                <group>
                                    <field name="rejected_items" readonly="1"/>
                                    <field name="pending_items" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda para portal.detail.list -->
    <record id="portal_detail_list_search_view" model="ir.ui.view">
        <field name="name">portal.detail.list.search</field>
        <field name="model">portal.detail.list</field>
        <field name="arch" type="xml">
            <search string="Buscar Listas">
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="commercial_id"/>
                
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Enviadas" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Revisadas" name="reviewed" domain="[('state', '=', 'reviewed')]"/>
                <filter string="Procesadas" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Rechazadas" name="rejected" domain="[('state', '=', 'rejected')]"/>
                
                <separator/>
                <filter string="Sin Notificar" name="not_notified" domain="[('commercial_notified', '=', False)]"/>
                <filter string="Cliente Sin Notificar" name="customer_not_notified" domain="[('customer_notified', '=', False)]"/>
                
                <separator/>
                <filter string="Mis Listas" name="my_lists" 
                        domain="[('commercial_id', '=', uid)]"/>
                <filter string="Listas de Mis Clientes" name="my_customers" 
                        domain="[('customer_id.user_ids', 'in', uid)]"/>
                
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Comercial" name="group_commercial" context="{'group_by': 'commercial_id'}"/>
                    <filter string="Cliente" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Fecha Envío" name="group_submitted_date" context="{'group_by': 'submitted_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para portal.detail.list -->
    <record id="portal_detail_list_action" model="ir.actions.act_window">
        <field name="name">Listas Portal</field>
        <field name="res_model">portal.detail.list</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay listas portal creadas
            </p>
            <p>
                Las listas portal se crean automáticamente cuando los clientes 
                envían detalles desde el portal web.
            </p>
        </field>
    </record>

    <!-- Vista de formulario para portal.detail.item -->
    <record id="portal_detail_item_form_view" model="ir.ui.view">
        <field name="name">portal.detail.item.form</field>
        <field name="model">portal.detail.item</field>
        <field name="arch" type="xml">
            <form string="Item de Lista">
                <header>
                    <button name="action_approve" string="Aprobar" type="object" 
                            class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Rechazar" type="object" 
                            class="btn-danger" invisible="state != 'pending'"/>
                    <button name="action_reset" string="Resetear" type="object" 
                            class="btn-secondary" invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="modelo"/>
                            <field name="nombre"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="list_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="numero"/>
                            <field name="otros"/>
                            <field name="cantidad"/>
                        </group>
                        <group>
                            <field name="products_summary" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="commercial_notes"/>
                    </group>
                    
                    <notebook>
                        <page string="Productos" name="products">
                            <group>
                                <group>
                                    <field name="producto1"/>
                                    <field name="talle1"/>
                                    <field name="producto2"/>
                                    <field name="talle2"/>
                                    <field name="producto3"/>
                                    <field name="talle3"/>
                                </group>
                                <group>
                                    <field name="producto4"/>
                                    <field name="talle4"/>
                                    <field name="producto5"/>
                                    <field name="talle5"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana para portal.detail.item -->
    <record id="portal_detail_item_action" model="ir.actions.act_window">
        <field name="name">Items de Lista</field>
        <field name="res_model">portal.detail.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay items de lista creados
            </p>
            <p>
                Los items se crean automáticamente cuando los clientes 
                envían listas desde el portal web.
            </p>
        </field>
    </record>
</odoo>
