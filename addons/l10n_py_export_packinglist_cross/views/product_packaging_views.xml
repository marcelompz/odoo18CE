<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Agregar campo "Peso del Bulto Vacio" en su propia linea, con la
         unidad "kg" al lado, en el form del Embalaje (product.packaging). -->
    <record id="view_product_packaging_form_inherit_weight" model="ir.ui.view">
        <field name="name">product.packaging.form.empty.weight</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <!-- Insertamos antes del campo barcode para que quede en una linea
                 separada y no pegado al lado de "Cantidad incluida". -->
            <xpath expr="//field[@name='barcode']" position="before">
                <label for="package_empty_weight" string="Peso del Bulto Vacio"/>
                <div class="o_row">
                    <field name="package_empty_weight" class="oe_inline" nolabel="1"/>
                    <span>kg</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
