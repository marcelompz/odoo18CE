<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- FORM del Bulto (stock.packing.list.package)            -->
    <!-- Form inline embebido dentro del Packing List           -->
    <!-- ===================================================== -->
    <record id="view_stock_packing_list_package_form" model="ir.ui.view">
        <field name="name">stock.packing.list.package.form</field>
        <field name="model">stock.packing.list.package</field>
        <field name="arch" type="xml">
            <form string="Bulto / BOX">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h2><field name="name" placeholder="BOX 1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="packaging_id" options="{'no_create_edit': True}"/>
                            <field name="empty_weight"/>
                        </group>
                        <group>
                            <field name="dimensions" placeholder="Ej: 80x60x40 cm"/>
                            <field name="line_count"/>
                            <field name="total_quantity"/>
                            <field name="net_weight"/>
                            <field name="gross_weight"/>
                            <field name="volume"/>
                        </group>
                    </group>
                    <separator string="Lineas / Productos en este BOX"/>
                    <field name="line_ids">
                        <list editable="bottom" string="Lineas">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="description"/>
                            <field name="product_model_id" optional="show"/>
                            <field name="product_type_use_id" optional="show"/>
                            <field name="product_gender_id" optional="show"/>
                            <field name="ncm"/>
                            <field name="quantity"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="net_weight" sum="Peso Neto"/>
                            <field name="volume" sum="Volumen"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Observaciones del bulto..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_packing_list_package_list" model="ir.ui.view">
        <field name="name">stock.packing.list.package.list</field>
        <field name="model">stock.packing.list.package</field>
        <field name="arch" type="xml">
            <list string="Bultos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="packaging_id" optional="show"/>
                <field name="line_count" string="Lineas"/>
                <field name="total_quantity" sum="Total Cant."/>
                <field name="empty_weight"/>
                <field name="net_weight" sum="Total Neto"/>
                <field name="gross_weight" sum="Total Bruto"/>
                <field name="volume" sum="Total Vol."/>
                <field name="dimensions" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- FORM PRINCIPAL : stock.packing.list                    -->
    <!-- ===================================================== -->
    <record id="view_stock_packing_list_form" model="ir.ui.view">
        <field name="name">stock.packing.list.form</field>
        <field name="model">stock.packing.list</field>
        <field name="arch" type="xml">
            <form string="Packing List de Exportacion">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_print_pdf" string="Imprimir PDF" type="object"
                            class="oe_highlight" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_draft" string="Volver a Borrador" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_print_pdf" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o"
                                invisible="state == 'cancelled'">
                            <span>Imprimir</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Packing List"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="picking_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="invoice_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="dua_number" readonly="state != 'draft'"/>
                            <field name="eremision_number"/>
                            <field name="seal_number" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Envio" name="shipping">
                            <group>
                                <group string="Logistica">
                                    <field name="incoterm_id" readonly="state != 'draft'"/>
                                    <field name="transport_mode" readonly="state != 'draft'"/>
                                    <field name="port_origin" readonly="state != 'draft'"/>
                                    <field name="port_destination" readonly="state != 'draft'"/>
                                </group>
                                <group string="Origen / Destino">
                                    <field name="country_origin_id" readonly="state != 'draft'"/>
                                    <field name="country_dest_id" readonly="state != 'draft'"/>
                                    <field name="shipper_partner_id" readonly="state != 'draft'"/>
                                    <field name="consignee_partner_id" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Bultos / BOXES" name="packages">
                            <field name="package_ids" readonly="state != 'draft'"
                                   context="{'default_packing_list_id': id}">
                                <list string="Bultos">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="packaging_id" optional="show"/>
                                    <field name="line_count" string="# Lineas"/>
                                    <field name="total_quantity" sum="Total" string="Cant."/>
                                    <field name="empty_weight" string="P. Vacio (kg)"/>
                                    <field name="net_weight" sum="Total Neto"/>
                                    <field name="gross_weight" sum="Total Bruto"/>
                                    <field name="volume" sum="Total Vol." optional="hide"/>
                                    <field name="dimensions" optional="hide"/>
                                </list>
                                <form>
                                    <sheet>
                                        <div class="oe_title">
                                            <label for="name"/>
                                            <h2><field name="name" placeholder="BOX 1"/></h2>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="packaging_id" options="{'no_create_edit': True}"/>
                                                <field name="empty_weight"/>
                                                <field name="dimensions" placeholder="80x60x40 cm"/>
                                            </group>
                                            <group>
                                                <field name="line_count"/>
                                                <field name="total_quantity"/>
                                                <field name="net_weight"/>
                                                <field name="gross_weight"/>
                                                <field name="volume"/>
                                            </group>
                                        </group>
                                        <separator string="Lineas / Productos en este BOX"/>
                                        <field name="line_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="product_id" options="{'no_create': True}"/>
                                                <field name="description"/>
                                                <field name="product_model_id" optional="show"/>
                                                <field name="product_type_use_id" optional="show"/>
                                                <field name="product_gender_id" optional="show"/>
                                                <field name="ncm"/>
                                                <field name="quantity"/>
                                                <field name="uom_id" groups="uom.group_uom"/>
                                                <field name="net_weight" sum="Peso Neto"/>
                                                <field name="volume" sum="Volumen" optional="hide"/>
                                            </list>
                                        </field>
                                        <field name="notes" placeholder="Observaciones..."/>
                                    </sheet>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_packages"/>
                                <field name="total_lines"/>
                                <field name="total_quantity"/>
                                <field name="total_net_weight"/>
                                <field name="total_gross_weight"/>
                                <field name="total_volume"/>
                            </group>
                        </page>

                        <page string="Referencias" name="references">
                            <group>
                                <field name="picking_id" readonly="1"/>
                                <field name="sale_id" readonly="1"/>
                                <field name="invoice_id" readonly="1"/>
                            </group>
                        </page>

                        <page string="Notas / Observaciones" name="notes">
                            <field name="notes"
                                   placeholder="Observaciones generales del Packing List..."
                                   readonly="state != 'draft'"/>
                        </page>

                        <page string="Configuracion de Impresion" name="print_config">
                            <group string="Secciones a ocultar en el PDF">
                                <field name="hide_commercial_section"/>
                                <field name="hide_logistics_section"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_packing_list_list" model="ir.ui.view">
        <field name="name">stock.packing.list.list</field>
        <field name="model">stock.packing.list</field>
        <field name="arch" type="xml">
            <list string="Packing Lists" decoration-info="state == 'draft'"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="picking_id"/>
                <field name="consignee_partner_id"/>
                <field name="country_dest_id" optional="show"/>
                <field name="incoterm_id" optional="show"/>
                <field name="total_packages" sum="Total Bultos"/>
                <field name="total_gross_weight" sum="Total P. Bruto" string="P. Bruto"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_packing_list_search" model="ir.ui.view">
        <field name="name">stock.packing.list.search</field>
        <field name="model">stock.packing.list</field>
        <field name="arch" type="xml">
            <search string="Buscar Packing Lists">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="consignee_partner_id"/>
                <field name="invoice_id"/>
                <field name="dua_number"/>
                <separator/>
                <filter string="Borrador" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmado" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelado" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Consignatario" name="group_consignee"
                            context="{'group_by': 'consignee_partner_id'}"/>
                    <filter string="Pais Destino" name="group_country"
                            context="{'group_by': 'country_dest_id'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_packing_list" model="ir.actions.act_window">
        <field name="name">Packing Lists de Exportacion</field>
        <field name="res_model">stock.packing.list</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_packing_list_search"/>
    </record>

</odoo>
