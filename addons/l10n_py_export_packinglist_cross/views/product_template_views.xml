<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- NCM en la pestaña de Compras del producto -->
    <record id="view_product_template_form_inherit_ncm" model="ir.ui.view">
        <field name="name">product.template.form.ncm</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group string="Datos Aduaneros (Mercosur)" name="customs_info">
                    <field name="ncm"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Pestaña Packing List: solo el tipo de bulto por defecto.
         El peso y volumen ya estan disponibles nativamente en la pestaña Inventario. -->
    <record id="view_product_template_form_inherit_packinglist" model="ir.ui.view">
        <field name="name">product.template.form.packinglist</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Packing List" name="packing_list_info"
                      groups="stock.group_stock_user">
                    <group>
                        <group string="Datos para Packing List">
                            <field name="default_packaging_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Datos Logisticos (nativos de Odoo)">
                            <label for="weight"/>
                            <div class="o_row">
                                <field name="weight" class="oe_inline"/>
                                <span>kg</span>
                            </div>
                            <label for="volume"/>
                            <div class="o_row">
                                <field name="volume" class="oe_inline"/>
                                <span>m3</span>
                            </div>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" style="margin-top:10px;">
                        <strong>Tip:</strong> El peso y volumen se toman del producto (campos nativos).
                        El "Tipo de Bulto por Defecto" se selecciona del modulo de Embalajes
                        nativo de Odoo (pestaña Inventario &gt; Embalajes del producto).
                        Cargue ahi los embalajes (BAG, CTN, DRM, PLT, BOX, etc.) y luego seleccionelos aqui.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
