<odoo>

    <!-- FORM VIEW -->
    <record id="view_production_wave_form" model="ir.ui.view">
        <field name="name">production.wave.form</field>
        <field name="model">production.wave</field>
        <field name="arch" type="xml">
            <form string="Ola de Producción">
                <header>
                    <button name="action_calculate_requirements" string="Calcular Materiales" type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <button name="action_generate_transfers" string="Generar Traslados" type="object" class="btn-primary" 
                            invisible="state != 'calculated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_pickings"
                            class="oe_stat_button"
                            icon="fa-truck" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Traslados"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <notebook>
                        <!-- PESTAÑA 1: ORDENES (INPUT) -->
                        <page string="Órdenes">
                            <field name="sale_order_ids" readonly="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="commitment_date"/>
                                    <field name="user_id"/>
                                    <field name="amount_total" sum="Total"/>
                                </list>
                            </field>
                        </page>

                        <!-- PESTAÑA 2: PRODUCTOS (INFO) -->
                        <page string="Resumen Productos">
                            <field name="product_line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="qty_total"/>
                                </list>
                            </field>
                        </page>

                        <!-- PESTAÑA 3: MATERIALES (ACTION) - LO QUE PEDISTE -->
                        <page string="Lista de Materiales y Destinos">
                            <field name="component_line_ids" readonly="state == 'done'">
                                <list editable="bottom" decoration-info="qty_delivered &lt; qty_needed">
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="qty_needed" readonly="0"/>
                                    <!-- <field name="qty_delivered"/> -->
                                    <!-- Campos Editables -->
                                    <field name="location_id" options="{'no_create': True}"/>
                                    <field name="location_dest_id" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_production_wave" model="ir.actions.act_window">
        <field name="name">Olas de Producción</field>
        <field name="res_model">production.wave</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Oops, nada a ser mostrado!</p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_production_wave_root" name="Olas de Producción" parent="sale.sale_order_menu" sequence="50">
        <menuitem id="menu_production_wave_action" action="action_production_wave"/>
    </menuitem>

</odoo>
