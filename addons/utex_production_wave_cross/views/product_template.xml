<odoo>

    <!-- form view -->
    <record id="product_template_inherit_form" model="ir.ui.view">
        <field name="name">product.template.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            
            <xpath expr="//notebook//page[@name='inventory']//group[@name='group_lots_and_weight']" position="after">
                <group name="production_wave_location" string="Ubicaciones para los traslados">
                    <field name="wave_source_location_id" options="{'no_create': 1}"/>
                    <field name="wave_dest_location_id" options="{'no_create': 1}"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
