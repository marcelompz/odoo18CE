<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_cross.commercial_dashboard" owl="1">
        <div class="o_dashboard_cross_container bg-gray-100 text-slate-800 font-sans antialiased h-full overflow-y-auto pb-24 o_pf_theme" style="height: 100%; overflow-y: auto;">

            <t t-if="state.loading">
                <div class="flex h-full w-full items-center justify-center">
                    <div class="text-xl text-odoo-purple font-bold animate-pulse">Cargando Dashboard...</div>
                </div>
            </t>

            <t t-else="">
                <!-- Filtros: franja colapsable al pasar el mouse (desktop) -->
                <div class="o_filter_hoverbar o_dashboard_filters_desktop">
                    <div class="o_filter_hoverbar__handle"></div>
                    <div class="o_filter_hoverbar__panel">
                        <div class="px-4 py-3 grid grid-cols-1 md:grid-cols-5 gap-4 items-end max-w-7xl mx-auto">
                            <div class="flex space-x-2 col-span-1 md:col-span-2">
                                <div class="w-1/2">
                                    <label class="block text-xs font-medium text-gray-700 mb-1">Fecha Desde</label>
                                    <input type="date" t-model="state.filters.date_from" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"/>
                                </div>
                                <div class="w-1/2">
                                    <label class="block text-xs font-medium text-gray-700 mb-1">Fecha Hasta</label>
                                    <input type="date" t-model="state.filters.date_to" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"/>
                                </div>
                            </div>
                            <div t-if="(state.companies || []).length > 1">
                                <label class="block text-xs font-medium text-gray-700 mb-1">Compañía (consolida)</label>
                                <div class="flex flex-wrap gap-x-3 gap-y-1 pt-1">
                                    <label t-foreach="state.companies" t-as="co" t-key="co.id" class="inline-flex items-center gap-1 text-xs text-gray-700 cursor-pointer">
                                        <input type="checkbox" t-att-checked="isCompanySelected(co.id)" t-on-change="() => this.toggleCompany(co.id)" style="accent-color:#714B67;"/>
                                        <span><t t-esc="co.name"/></span>
                                    </label>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Producto</label>
                                <select id="filter_product_id" t-model="state.filters.product_id" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                    <option value="">Todos</option>
                                    <t t-foreach="state.filterData.products" t-as="prod" t-key="prod.id">
                                        <option t-att-value="prod.id"><t t-esc="prod.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Categoría</label>
                                <select id="filter_category_id" t-model="state.filters.category_id" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                    <option value="">Todas</option>
                                    <t t-foreach="state.filterData.categories" t-as="cat" t-key="cat.id">
                                        <option t-att-value="cat.id"><t t-esc="cat.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="flex items-end space-x-2">
                                <div class="flex-grow w-full">
                                    <label class="block text-xs font-medium text-gray-700 mb-1">Cliente</label>
                                    <select id="filter_partner_id" t-model="state.filters.partner_id" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                        <option value="">Todos</option>
                                        <t t-foreach="state.filterData.partners" t-as="partner" t-key="partner.id">
                                            <option t-att-value="partner.id"><t t-esc="partner.name"/></option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div style="padding:0 16px 10px;max-width:1280px;margin:0 auto;">
                            <label style="display:inline-flex;align-items:center;font-size:12px;color:#475569;cursor:pointer;">
                                <input type="checkbox" t-model="state.showRangeCaption" style="margin-right:6px;"/>
                                Mostrar el rango de fecha debajo de cada gráfico
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Encabezado Perfipar -->
                <div class="o_pf_header">
                    <div class="o_pf_logo">
                        <t t-if="state.data.company &amp;&amp; state.data.company.logo">
                            <img t-att-src="'data:image/png;base64,' + state.data.company.logo" alt="logo"/>
                        </t>
                        <t t-else="">
                            <span class="o_pf_logo_text"><t t-esc="(state.data.company &amp;&amp; state.data.company.name) || 'Perfipar'"/></span>
                        </t>
                    </div>
                    <div class="o_pf_title">Reporte Gerencial</div>
                    <div style="justify-self:end;display:flex;align-items:center;gap:8px;">
                        <span class="o_pf_live">Live</span>
                        <button class="md:hidden" style="background:#eef2f7;color:#1c3d6e;border:none;border-radius:6px;padding:5px 10px;font-size:12px;font-weight:700;cursor:pointer;"
                                t-on-click="toggleMobileFilters">
                            <i class="fa fa-filter" style="margin-right:4px;"></i> Filtros
                        </button>
                    </div>
                </div>
                
                <!-- Sidebar Drawer for Mobile -->
                <div t-attf-class="o_filter_sidebar {{state.showMobileFilters ? 'open' : ''}}">
                    <div class="p-4 border-b flex justify-between items-center bg-gray-50">
                        <h3 class="font-bold text-slate-700">Filtros</h3>
                        <button class="text-gray-500" t-on-click="toggleMobileFilters"><i class="fa fa-times text-lg"></i></button>
                    </div>
                    <div class="p-4 space-y-4 overflow-y-auto" style="max-height: calc(100% - 60px);">
                        <!-- Mobile Date Inputs -->
                        <div class="space-y-2">
                             <label class="block text-xs font-medium text-gray-700">Fecha Desde</label>
                             <input type="date" t-model="state.filters.date_from" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"/>
                             <label class="block text-xs font-medium text-gray-700 pt-2">Fecha Hasta</label>
                             <input type="date" t-model="state.filters.date_to" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm"/>
                        </div>
                        <!-- Mobile Selects -->
                        <div class="space-y-2 pt-2 border-t">
                             <label class="block text-xs font-medium text-gray-700">Producto</label>
                             <select id="mobile_filter_product_id" t-model="state.filters.product_id" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                <option value="">Todos</option>
                                <t t-foreach="state.filterData.products" t-as="prod" t-key="prod.id">
                                    <option t-att-value="prod.id"><t t-esc="prod.name"/></option>
                                </t>
                             </select>
                             <label class="block text-xs font-medium text-gray-700 pt-2">Categoría</label>
                             <select id="mobile_filter_category_id" t-model="state.filters.category_id" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                <option value="">Todas</option>
                                <t t-foreach="state.filterData.categories" t-as="cat" t-key="cat.id">
                                    <option t-att-value="cat.id"><t t-esc="cat.name"/></option>
                                </t>
                             </select>
                             <label class="block text-xs font-medium text-gray-700 pt-2">Cliente</label>
                             <select id="mobile_filter_partner_id" t-model="state.filters.partner_id" t-on-change="applyFilters" class="block w-full rounded-md border-gray-300 shadow-sm sm:text-sm">
                                <option value="">Todos</option>
                                <t t-foreach="state.filterData.partners" t-as="partner" t-key="partner.id">
                                    <option t-att-value="partner.id"><t t-esc="partner.name"/></option>
                                </t>
                             </select>
                        </div>
                        <button class="w-full bg-odoo-purple text-white py-3 rounded-lg font-bold mt-4" t-on-click="toggleMobileFilters">Ver Resultados</button>
                    </div>
                </div>
                <div t-attf-class="o_sidebar_overlay {{state.showMobileFilters ? 'show' : ''}}" t-on-click="toggleMobileFilters"></div>

                <main class="p-4 space-y-6 max-w-7xl mx-auto pb-20">
                    <!-- BEGIN: Key Performance Indicators -->
                    <section class="grid grid-cols-2 md:grid-cols-5 gap-4">
                        <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col justify-between hover:shadow-md hover:border-odoo-teal cursor-pointer transition-all"
                             t-on-click="() => this.drillInvoices([], 'Ventas Totales del Período')"
                             title="Click para ver el detalle de facturas">
                            <span class="text-xs font-bold text-slate-500 uppercase">Ventas Totales</span>
                            <div class="mt-2 text-odoo-teal">
                                <span class="text-2xl font-bold" t-att-title="formatFullNumber(state.data.kpis.total_sales)">
                                    <t t-esc="formatCurrency(state.data.kpis.total_sales)"/>
                                </span>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col justify-between hover:shadow-md hover:border-indigo-500 cursor-pointer transition-all"
                             t-on-click="() => this.drillInvoices([], 'Ganancia Bruta - Detalle de Facturas')"
                             title="Click para ver las facturas que componen la ganancia">
                            <span class="text-xs font-bold text-slate-500 uppercase">Ganancia Bruta</span>
                            <div class="mt-2 text-indigo-600">
                                <span class="text-2xl font-bold" t-att-title="formatFullNumber(state.data.kpis.total_profit)">
                                    <t t-esc="formatCurrency(state.data.kpis.total_profit)"/>
                                </span>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col justify-between hover:shadow-md hover:border-slate-400 cursor-pointer transition-all"
                             t-on-click="() => this.drillInvoices([], 'Ticket Medio - Detalle de Facturas')"
                             title="Click para ver las facturas que promedian el ticket">
                            <span class="text-xs font-bold text-slate-500 uppercase">Ticket Medio</span>
                            <div class="mt-2 text-slate-800">
                                <span class="text-2xl font-bold" t-att-title="formatFullNumber(state.data.kpis.avg_ticket)">
                                    <t t-esc="formatCurrency(state.data.kpis.avg_ticket)"/>
                                </span>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col justify-between hover:shadow-md hover:border-orange-500 cursor-pointer transition-all"
                             t-on-click="() => this.drillQuotations()"
                             title="Click para ver los presupuestos en negociación">
                            <span class="text-xs font-bold text-slate-500 uppercase">En Negociación</span>
                            <div class="mt-2">
                                <div class="text-orange-600">
                                    <span class="text-2xl font-bold" t-att-title="formatFullNumber(state.data.kpis.open_pipe)">
                                        <t t-esc="formatCurrency(state.data.kpis.open_pipe)"/>
                                    </span>
                                </div>
                                <span class="block text-xs text-slate-400 font-medium"><t t-esc="state.data.kpis.opp_count"/> Presupuestos</span>
                            </div>
                        </div>
                        <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col justify-between">
                            <span class="text-xs font-bold text-slate-500 uppercase">Conversión</span>
                            <div class="mt-2 text-slate-800">
                                <span class="text-2xl font-bold"><t t-esc="state.data.kpis.conversion_rate.toFixed(1)"/>%</span>
                            </div>
                        </div>
                    </section>
                    <!-- END: Key Performance Indicators -->
                    
                    <!-- BEGIN: Revenue Trend Visualization (2) -->
                    <section class="bg-white rounded-lg border shadow-sm">
                        <div class="px-4 py-3 border-b bg-gray-50/50 flex items-center justify-between">
                            <h2 class="font-bold text-slate-700">Tendencia de Ventas</h2>
                            <div class="flex items-center space-x-4 text-xs font-medium">
                                <div class="flex items-center"><span class="w-2 h-2 rounded-full bg-odoo-teal mr-1"></span> Actual</div>
                            </div>
                        </div>
                        <div class="p-6 h-48 relative">
                            <!-- Mock Canvas for visualization -->
                            <canvas class="w-full h-full" id="salesTrendCanvas"></canvas>
                            <!-- Labels row -->
                            <div class="flex justify-between w-full mt-2 absolute bottom-0 px-6 text-xs text-slate-400">
                                <t t-foreach="state.data.trends.labels" t-as="label" t-key="label_index">
                                    <span><t t-esc="label"/></span>
                                </t>
                            </div>
                        </div>
                        <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:0 0 8px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                    </section>
                    <!-- END: Revenue Trend Visualization -->

                    <!-- BEGIN: Payment Methods Chart -->
                    <section class="bg-white rounded-lg border shadow-sm">
                        <div class="px-4 py-3 border-b bg-gray-50/50 flex items-center justify-between">
                            <h2 class="font-bold text-slate-700">Monto por Tipo de Pago</h2>
                            <div class="flex items-center space-x-4 text-xs font-medium">
                                <div class="flex items-center"><span class="w-2 h-2 rounded-sm bg-blue-500 mr-1"></span> Contado</div>
                                <div class="flex items-center"><span class="w-2 h-2 rounded-sm bg-odoo-orange mr-1"></span> Crédito</div>
                            </div>
                        </div>
                        <div class="p-6 h-64 relative">
                            <canvas class="w-full h-full" id="paymentMethodCanvas"></canvas>
                        </div>
                        <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:0 0 8px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                    </section>
                    <!-- BEGIN: Revenue Composition Chart -->
                    <section class="bg-white rounded-lg border shadow-sm">
                        <div class="px-4 py-3 border-b bg-gray-50/50 flex items-center justify-between">
                            <h2 class="font-bold text-slate-700">Análisis de Margen Mensual</h2>
                            <div class="flex items-center space-x-4 text-xs font-medium">
                                <div class="flex items-center"><span class="w-2 h-2 rounded-sm bg-indigo-500 mr-1"></span> Ganancia Bruta</div>
                                <div class="flex items-center"><span class="w-2 h-2 rounded-sm bg-gray-400 mr-1"></span> Costo</div>
                            </div>
                        </div>
                        <div class="p-6 h-64 relative">
                            <canvas class="w-full h-full" id="revenueCompositionCanvas"></canvas>
                        </div>
                        <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:0 0 8px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                    </section>
                    <!-- END: Revenue Composition Chart -->

                    <!-- BEGIN: Product Performance & Trends (3) -->
                    <section class="bg-white rounded-lg border shadow-sm">
                        <div class="px-4 py-3 border-b bg-gray-50/50">
                            <h2 class="font-bold text-slate-700">Análisis de Portafolio de Productos</h2>
                        </div>
                        <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-4 bg-gray-100/50">
                            <!-- Top Sellers -->
                            <div class="space-y-3 bg-white border border-gray-200 shadow-sm rounded-lg p-4">
                                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-tighter border-b pb-2">🔥 Más Vendidos (Ingresos)</h3>
                                <div class="divide-y divide-gray-100 pt-1">
                                    <t t-foreach="state.data.product_portfolio.top_sellers" t-as="product" t-key="product.id or product.name">
                                        <div class="flex items-center justify-between gap-3 py-2 px-1 rounded hover:bg-gray-50 cursor-pointer transition-colors"
                                             t-on-click="() => this.drillByProduct(product.id, product.name)"
                                             t-att-title="product.name">
                                            <div class="flex-1 min-w-0">
                                                <div class="truncate text-sm font-medium text-slate-800"><t t-esc="product.name"/></div>
                                                <div t-if="product.code" class="text-[10px] text-slate-400 font-mono tracking-tight truncate"><t t-esc="product.code"/></div>
                                            </div>
                                            <span class="font-bold text-odoo-teal text-sm whitespace-nowrap flex-shrink-0"
                                                  t-att-title="formatFullNumber(product.revenue)">
                                                <t t-esc="formatCurrency(product.revenue)"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <!-- High Margin -->
                            <div class="space-y-3 bg-white border border-gray-200 shadow-sm rounded-lg p-4">
                                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-tighter border-b pb-2">💎 Artículos de Alto Margen</h3>
                                <div class="divide-y divide-gray-100 pt-1">
                                    <t t-foreach="state.data.product_portfolio.high_margin" t-as="product" t-key="product.id or product.name">
                                        <div class="flex items-center justify-between gap-3 py-2 px-1 rounded hover:bg-gray-50 cursor-pointer transition-colors"
                                             t-on-click="() => this.drillByProduct(product.id, product.name)"
                                             t-att-title="product.name">
                                            <div class="flex-1 min-w-0">
                                                <div class="truncate text-sm font-medium text-slate-800"><t t-esc="product.name"/></div>
                                                <div t-if="product.code" class="text-[10px] text-slate-400 font-mono tracking-tight truncate"><t t-esc="product.code"/></div>
                                            </div>
                                            <span class="inline-flex items-center gap-1 text-xs font-bold text-green-700 bg-green-50 border border-green-100 rounded-full px-2 py-0.5 whitespace-nowrap flex-shrink-0">
                                                <t t-esc="product.margin.toFixed(0)"/>%
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <!-- Low Rotation -->
                            <div class="space-y-3 bg-white border border-gray-200 shadow-sm rounded-lg p-4">
                                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-tighter border-b pb-2">⚠️ Baja Rotación (Stock)</h3>
                                <div class="divide-y divide-gray-100 pt-1">
                                    <t t-foreach="state.data.product_portfolio.low_rotation" t-as="product" t-key="product.id or product.name">
                                        <div class="flex items-center justify-between gap-3 py-2 px-1 rounded hover:bg-gray-50 cursor-pointer transition-colors"
                                             t-on-click="() => this.drillByProduct(product.id, product.name)"
                                             t-att-title="product.name">
                                            <div class="flex-1 min-w-0">
                                                <div class="truncate text-sm font-medium text-slate-800"><t t-esc="product.name"/></div>
                                                <div t-if="product.code" class="text-[10px] text-slate-400 font-mono tracking-tight truncate"><t t-esc="product.code"/></div>
                                            </div>
                                            <span class="inline-flex items-center gap-1 text-xs font-bold text-orange-700 bg-orange-50 border border-orange-100 rounded-full px-2 py-0.5 whitespace-nowrap flex-shrink-0">
                                                <t t-esc="product.days_in_stock"/> d
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </section>
                    <!-- END: Product Performance & Trends -->

                    <!-- BEGIN: Dual Analysis Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- BEGIN: Salesperson Ranking (4) -->
                        <section class="bg-white rounded-lg border shadow-sm col-span-1">
                            <div class="px-4 py-3 border-b bg-gray-50/50">
                                <h2 class="font-bold text-slate-700">Top Vendedores</h2>
                            </div>
                            <div class="p-4 overflow-x-auto">
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="text-left text-slate-400 uppercase text-[10px] tracking-wider border-b">
                                            <th class="pb-2 font-medium">Nombre</th>
                                            <th class="pb-2 font-medium text-right">Facturado</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y">
                                        <t t-foreach="state.data.top_salespeople" t-as="person" t-key="person.id or person.name">
                                            <tr class="group hover:bg-gray-50 cursor-pointer transition-colors"
                                                t-on-click="() => this.drillByUser(person.id, person.name)"
                                                t-att-title="person.name">
                                                <td class="py-3">
                                                    <div class="flex items-center space-x-2 min-w-0">
                                                        <div class="w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center text-[10px] font-bold text-indigo-700 flex-shrink-0"><t t-esc="(person.name||'?').charAt(0).toUpperCase()"/></div>
                                                        <span class="font-medium truncate"><t t-esc="person.name"/></span>
                                                    </div>
                                                </td>
                                                <td class="py-3 text-right font-bold text-slate-700 whitespace-nowrap" t-att-title="formatFullNumber(person.amount)"><t t-esc="formatCurrency(person.amount)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        <!-- END: Salesperson Ranking -->

                        <!-- BEGIN: Top Customers Ranking (4) -->
                        <section class="bg-white rounded-lg border shadow-sm col-span-1">
                            <div class="px-4 py-3 border-b bg-gray-50/50">
                                <h2 class="font-bold text-slate-700">Top 10 Clientes</h2>
                            </div>
                            <div class="p-4 overflow-x-auto h-64 overflow-y-auto">
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="text-left text-slate-400 uppercase text-[10px] tracking-wider border-b">
                                            <th class="pb-2 font-medium">Cliente</th>
                                            <th class="pb-2 font-medium text-right">Monto</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y">
                                        <t t-foreach="state.data.top_customers || []" t-as="customer" t-key="customer.id or customer.name">
                                            <tr class="group hover:bg-gray-50 cursor-pointer transition-colors"
                                                t-on-click="() => this.drillByPartner(customer.id, customer.name)"
                                                t-att-title="customer.name">
                                                <td class="py-2">
                                                    <div class="flex items-center space-x-2 min-w-0">
                                                        <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center text-[10px] font-bold text-orange-700 flex-shrink-0"><t t-esc="(customer.name||'?').charAt(0).toUpperCase()"/></div>
                                                        <span class="font-medium truncate"><t t-esc="customer.name"/></span>
                                                    </div>
                                                </td>
                                                <td class="py-2 text-right font-bold text-odoo-teal whitespace-nowrap" t-att-title="formatFullNumber(customer.amount)"><t t-esc="formatCurrency(customer.amount)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        <!-- END: Top Customers Ranking -->
                        
                        <!-- BEGIN: Customer Segmentation (5) -->
                        <section class="bg-white rounded-lg border shadow-sm col-span-1 md:col-span-2">
                            <div class="px-4 py-3 border-b bg-gray-50/50 flex justify-between items-center">
                                <h2 class="font-bold text-slate-700">Salud del Cliente</h2>
                                <span class="text-[10px] font-bold text-white bg-slate-400 px-2 py-0.5 rounded">30 Días</span>
                            </div>
                            <div class="p-6 grid grid-cols-3 gap-4 h-full">
                                <div class="text-center">
                                    <div class="text-3xl font-bold text-odoo-teal"><t t-esc="state.data.customer_health.new"/></div>
                                    <div class="text-[10px] text-slate-500 font-bold uppercase mt-1">Nuevos</div>
                                    <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-odoo-teal w-2/3"></div>
                                    </div>
                                </div>
                                <div class="text-center">
                                    <div class="text-3xl font-bold text-slate-700"><t t-esc="state.data.customer_health.recurring"/></div>
                                    <div class="text-[10px] text-slate-500 font-bold uppercase mt-1">Recurrentes</div>
                                    <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-blue-500 w-4/5"></div>
                                    </div>
                                </div>
                                <div class="text-center">
                                    <div class="text-3xl font-bold text-red-400"><t t-esc="state.data.customer_health.lost"/></div>
                                    <div class="text-[10px] text-slate-500 font-bold uppercase mt-1">Perdidos</div>
                                    <div class="mt-2 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                        <div class="h-full bg-red-400 w-1/4"></div>
                                    </div>
                                </div>
                                <div class="col-span-3 pt-4">
                                    <div class="bg-slate-50 p-3 rounded-md flex justify-between items-center">
                                        <div>
                                            <p class="text-xs text-slate-500">Valor Promedio de Vida del Cliente</p>
                                            <p class="text-lg font-bold text-slate-800"><t t-esc="formatCurrency(state.data.customer_health.avg_lifetime_value)"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- END: Customer Segmentation -->
                    </div>
                    <!-- END: Dual Analysis Grid -->

                    <!-- BEGIN: Salesperson Analysis (7) -->
                    <section class="mt-6 flex flex-col space-y-4">
                        <div class="px-4 py-3 border-b bg-white rounded-t-lg shadow-sm border flex items-center justify-between">
                            <h2 class="font-bold text-slate-700">Análisis Exclusivo por Vendedor</h2>
                            <div class="flex items-center bg-gray-100 rounded-lg p-1">
                                <button t-on-click="() => this.setViewMode('amount')" 
                                        t-attf-class="px-3 py-1 text-xs font-bold rounded-md transition-colors #{state.viewMode == 'amount' ? 'bg-white shadow text-odoo-teal' : 'text-slate-500 hover:text-slate-700'}">
                                    Monto
                                </button>
                                <button t-on-click="() => this.setViewMode('quantity')" 
                                        t-attf-class="px-3 py-1 text-xs font-bold rounded-md transition-colors #{state.viewMode == 'quantity' ? 'bg-white shadow text-odoo-teal' : 'text-slate-500 hover:text-slate-700'}">
                                    Cantidad
                                </button>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-4">
                            <!-- 1. Contado vs Crédito -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Ventas Contado vs Crédito</h3>
                                <div class="h-48 relative">
                                    <canvas class="w-full h-full" id="salespersonCashCreditCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                            
                            <!-- 2. Nuevos vs Recurrentes -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Clientes Nuevos vs Recurrentes</h3>
                                <div class="h-48 relative">
                                    <canvas class="w-full h-full" id="salespersonNewRecurringCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                            
                            <!-- 3. Distribución (%) -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col items-center">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Distribución de Ventas (%)</h3>
                                <div class="h-48 w-full relative flex justify-center">
                                    <canvas id="salespersonPieCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>

                            <!-- 4. Comparativo Margen -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Comparativo Margen de Productos</h3>
                                <div class="h-48 relative">
                                    <canvas class="w-full h-full" id="salespersonMarginCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                        </div>
                    </section>
                    <!-- END: Salesperson Analysis -->

                    <!-- BEGIN: Category Analysis (8) -->
                    <section class="mt-6 flex flex-col space-y-4">
                        <div class="px-4 py-3 border-b bg-white rounded-t-lg shadow-sm border flex items-center justify-between">
                            <h2 class="font-bold text-slate-700">Análisis Exclusivo de Productos por Categoría</h2>
                            <div class="flex items-center bg-gray-100 rounded-lg p-1">
                                <button t-on-click="() => this.setViewMode('amount')" 
                                        t-attf-class="px-3 py-1 text-xs font-bold rounded-md transition-colors #{state.viewMode == 'amount' ? 'bg-white shadow text-odoo-teal' : 'text-slate-500 hover:text-slate-700'}">
                                    Monto
                                </button>
                                <button t-on-click="() => this.setViewMode('quantity')" 
                                        t-attf-class="px-3 py-1 text-xs font-bold rounded-md transition-colors #{state.viewMode == 'quantity' ? 'bg-white shadow text-odoo-teal' : 'text-slate-500 hover:text-slate-700'}">
                                    Cantidad
                                </button>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <!-- 1. Revenue Pie -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm flex flex-col items-center">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Distribución Venta Total (%)</h3>
                                <div class="h-56 w-full relative flex justify-center">
                                    <canvas id="categoryRevenuePieCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                            
                            <!-- 2. Margin Bar -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Distribución por Margen (%)</h3>
                                <div class="h-56 relative">
                                    <canvas class="w-full h-full" id="categoryMarginBarCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                            
                            <!-- 3. Rotation Horizontal Bar -->
                            <div class="bg-white p-4 rounded-lg border shadow-sm">
                                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-tighter mb-2 text-center">Mayor Rotación (Cant. Vendida)</h3>
                                <div class="h-56 relative">
                                    <canvas class="w-full h-full" id="categoryRotationBarCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin-top:4px;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </div>
                        </div>
                    </section>
                    <!-- END: Category Analysis -->

                    <!-- BEGIN: Sales Funnel -->
                    <section class="bg-white rounded-lg border shadow-sm overflow-hidden">
                        <div class="px-4 py-3 border-b flex justify-between items-center bg-gray-50/50">
                            <h2 class="font-bold text-slate-700">Funnel de Ventas</h2>
                        </div>
                        <div class="p-6">
                            <div class="flex flex-col space-y-2">
                                <t t-foreach="state.data.funnel" t-as="stage" t-key="stage_index">
                                    <div class="flex items-center group">
                                        <div class="w-1/4 pr-4 text-right text-sm font-medium text-slate-500"><t t-esc="stage.name"/></div>
                                        <div class="w-3/4 relative">
                                            <div t-attf-class="h-10 bg-blue-100 funnel-step w-full flex items-center px-8 text-blue-800 font-bold border-r-4 border-blue-400">
                                                <t t-esc="stage.count"/> <span class="ml-2 font-normal text-xs opacity-75">(<t t-esc="formatCurrency(stage.revenue)"/>)</span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                    <!-- END: Sales Funnel -->
                </main>
            </t>
        </div>
    </t>
</templates>
