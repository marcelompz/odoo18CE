<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dashboard_cross.purchase_dashboard" owl="1">
        <div class="o_dashboard_cross_container o_pd_container bg-gray-100 text-slate-800 font-sans antialiased o_pf_theme"
             style="height: 100%; overflow: hidden;">

            <t t-if="state.loading">
                <div class="flex h-full w-full items-center justify-center">
                    <div class="text-xl text-odoo-purple font-bold animate-pulse">Cargando Dashboard de Compras...</div>
                </div>
            </t>

            <t t-else="">
                <!-- Encabezado Perfipar -->
                <div class="o_pf_header">
                    <div class="o_pf_logo">
                        <t t-if="state.data.company &amp;&amp; state.data.company.logo">
                            <img t-att-src="'data:image/png;base64,' + state.data.company.logo" alt="logo"/>
                        </t>
                        <t t-else="">
                            <span class="o_pf_logo_text"><t t-esc="(state.data.company &amp;&amp; state.data.company.name) || 'Perfipar'"/></span>
                        </t>
                    </div>
                    <div class="o_pf_title">Dashboard de Compras</div>
                    <div style="justify-self:end;display:flex;align-items:center;gap:8px;">
                        <span class="o_pf_live">Live</span>
                        <button class="md:hidden" style="background:#eef2f7;color:#1c3d6e;border:none;border-radius:6px;padding:5px 10px;font-size:12px;font-weight:700;cursor:pointer;"
                                t-on-click="toggleMobileFilters">
                            <i class="fa fa-filter" style="margin-right:4px;"></i> Filtros
                        </button>
                    </div>
                </div>

                <!-- Mobile drawer overlay -->
                <div t-attf-class="o_sidebar_overlay {{state.showMobileFilters ? 'show' : ''}}"
                     t-on-click="toggleMobileFilters"></div>

                <div class="o_pd_layout">
                    <!-- SIDEBAR DE FILTROS -->
                    <aside t-attf-class="o_pd_sidebar {{state.showMobileFilters ? 'open' : ''}}">
                        <div class="o_pd_sidebar_inner">
                            <div class="flex justify-between items-center md:hidden p-3 border-b">
                                <h3 class="font-bold text-slate-700">Filtros</h3>
                                <button class="text-gray-500" t-on-click="toggleMobileFilters">
                                    <i class="fa fa-times text-lg"></i>
                                </button>
                            </div>
                            <div class="p-4 space-y-5">
                                <!-- Período -->
                                <div>
                                    <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Período</h3>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button t-on-click="() => this.setPreset('3m')"
                                                t-attf-class="text-xs font-medium px-2 py-1.5 rounded border #{state.filters.preset == '3m' ? 'bg-odoo-purple text-white border-odoo-purple' : 'bg-white text-slate-600 border-gray-200 hover:bg-gray-50'}">
                                            3 meses
                                        </button>
                                        <button t-on-click="() => this.setPreset('6m')"
                                                t-attf-class="text-xs font-medium px-2 py-1.5 rounded border #{state.filters.preset == '6m' ? 'bg-odoo-purple text-white border-odoo-purple' : 'bg-white text-slate-600 border-gray-200 hover:bg-gray-50'}">
                                            6 meses
                                        </button>
                                        <button t-on-click="() => this.setPreset('9m')"
                                                t-attf-class="text-xs font-medium px-2 py-1.5 rounded border #{state.filters.preset == '9m' ? 'bg-odoo-purple text-white border-odoo-purple' : 'bg-white text-slate-600 border-gray-200 hover:bg-gray-50'}">
                                            9 meses
                                        </button>
                                        <button t-on-click="() => this.setPreset('12m')"
                                                t-attf-class="text-xs font-medium px-2 py-1.5 rounded border #{state.filters.preset == '12m' ? 'bg-odoo-purple text-white border-odoo-purple' : 'bg-white text-slate-600 border-gray-200 hover:bg-gray-50'}">
                                            12 meses
                                        </button>
                                    </div>
                                    <p class="text-[10px] text-slate-400 mt-2">
                                        Periodo activo:
                                        <t t-if="state.data.period.date_from">
                                            <span class="font-semibold text-slate-600"><t t-esc="state.data.period.date_from"/></span>
                                            →
                                            <span class="font-semibold text-slate-600"><t t-esc="state.data.period.date_to"/></span>
                                        </t>
                                    </p>
                                </div>

                                <!-- Compañía (solo si hay más de una) -->
                                <div t-if="(state.companies || []).length > 1">
                                    <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Compañía</h3>
                                    <div class="space-y-1">
                                        <label t-foreach="state.companies" t-as="co" t-key="co.id"
                                               class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer px-2 py-1.5 rounded border border-gray-200 hover:bg-gray-50">
                                            <input type="checkbox" t-att-checked="isCompanySelected(co.id)"
                                                   t-on-change="() => this.toggleCompany(co.id)"/>
                                            <span><t t-esc="co.name"/></span>
                                        </label>
                                    </div>
                                    <p class="text-[10px] text-slate-400 mt-1">Marcá ambas para sumar todo.</p>
                                </div>

                                <!-- Comparativo con ventas -->
                                <div>
                                    <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Comparativo</h3>
                                    <label class="inline-flex items-center gap-2 cursor-pointer select-none w-full">
                                        <input type="checkbox"
                                               t-att-checked="state.ui.compareWithSales"
                                               t-on-change="toggleCompareWithSales"
                                               class="rounded"
                                               style="accent-color: #017E84;"/>
                                        <span class="text-xs font-bold text-slate-600">Mostrar línea de ventas</span>
                                    </label>
                                    <p class="text-[10px] text-slate-400 mt-1">Superpone la facturación de ventas sobre el chart de compras.</p>
                                </div>

                                <!-- Check: Impuesto incluido (IVA) -->
                                <div class="pt-3 border-t">
                                    <label class="inline-flex items-center gap-2 cursor-pointer select-none w-full">
                                        <input type="checkbox"
                                               t-att-checked="state.filters.tax_included"
                                               t-on-change="toggleTaxIncluded"
                                               class="rounded"
                                               style="accent-color: #714B67;"/>
                                        <span class="text-xs font-bold text-slate-600">Impuesto incluido (IVA)</span>
                                    </label>
                                    <p class="text-[10px] text-slate-400 mt-1">Aplica a la línea de ventas. Las compras son costo (sin IVA).</p>
                                </div>

                                <!-- Mostrar % -->
                                <div class="pt-3 border-t">
                                    <label class="inline-flex items-center gap-2 cursor-pointer select-none w-full">
                                        <input type="checkbox"
                                               t-att-checked="state.filters.show_pct"
                                               t-on-change="toggleShowPct"
                                               class="rounded"
                                               style="accent-color: #714B67;"/>
                                        <span class="text-xs font-bold text-slate-600">Mostrar % en gráficos</span>
                                    </label>
                                </div>

                                <div class="pt-3 border-t">
                                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                                        <input type="checkbox" t-model="state.showRangeCaption" style="accent-color:#1c3d6e;"/>
                                        <span style="font-size:12px;font-weight:700;color:#475569;">Rango de fecha bajo gráficos</span>
                                    </label>
                                </div>

                                <div class="pt-2 border-t">
                                    <button class="w-full bg-odoo-purple text-white py-2 rounded-lg font-bold text-sm"
                                            t-on-click="applyFilters">
                                        Aplicar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </aside>

                    <!-- MAIN -->
                    <main class="o_pd_main">
                        <div class="p-4 space-y-6 max-w-7xl mx-auto pb-24">

                            <!-- KPIs (4 cards) -->
                            <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div class="bg-white p-4 rounded-lg border shadow-sm">
                                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Compras de Mercadería (recibida)</span>
                                    <div class="mt-2 text-odoo-orange">
                                        <span class="text-2xl font-bold" t-att-title="formatFullNumber(state.data.kpis.compras_mercaderia || 0)">
                                            <t t-esc="formatCurrency(state.data.kpis.compras_mercaderia || 0)"/>
                                        </span>
                                    </div>
                                    <div class="mt-1 text-[11px] text-slate-500 leading-tight">
                                        <div class="text-slate-400">Mercadería recibida valorizada (costo + landed costs)</div>
                                        <div t-if="state.data.kpis.gastos">Gastos (servicios, desde facturas): <span class="font-bold text-amber-700"><t t-esc="formatCurrency(state.data.kpis.gastos)"/></span></div>
                                    </div>
                                    <div t-if="state.data.merchandise_filter and state.data.merchandise_filter.compras_note"
                                         class="mt-1 text-[10px] text-amber-700 leading-tight"
                                         t-att-title="state.data.merchandise_filter.compras_note">
                                        <i class="fa fa-exclamation-triangle mr-1"></i>
                                        Pueden faltar facturas/precios de OC. Ver detalle.
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-lg border shadow-sm">
                                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Facturas de Compra</span>
                                    <div class="mt-2 text-slate-800">
                                        <span class="text-2xl font-bold"><t t-esc="state.data.kpis.invoice_count"/></span>
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-lg border shadow-sm">
                                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Proveedores</span>
                                    <div class="mt-2 text-indigo-600">
                                        <span class="text-2xl font-bold"><t t-esc="state.data.kpis.supplier_count"/></span>
                                    </div>
                                </div>
                                <div class="bg-white p-4 rounded-lg border shadow-sm">
                                    <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Productos Distintos</span>
                                    <div class="mt-2 text-odoo-teal">
                                        <span class="text-2xl font-bold"><t t-esc="state.data.kpis.product_count"/></span>
                                    </div>
                                </div>
                            </section>

                            <!-- Tendencia mensual: Compras + Ventas -->
                            <section class="bg-white rounded-lg border shadow-sm">
                                <div class="px-4 py-3 border-b bg-gray-50/50">
                                    <h2 class="font-bold text-slate-700">Tendencia Mensual</h2>
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        Compras = <span class="font-semibold">mercadería recibida valorizada</span> (costo + landed costs), ligada a órdenes de compra. Incluye importaciones; excluye el stock inicial de migración.
                                        <t t-if="state.ui.compareWithSales"> Línea = ventas de mercadería para comparar.</t>
                                    </p>
                                    <p t-if="state.data.merchandise_filter and state.data.merchandise_filter.compras_note"
                                       class="text-[11px] text-amber-700 mt-0.5"
                                       t-att-title="state.data.merchandise_filter.compras_note">
                                        <i class="fa fa-exclamation-triangle mr-1"></i>
                                        Valorizado por recepción. Las facturas de proveedor / precios de OC pueden estar incompletos
                                        (gastos/servicios facturados aparte: <span class="font-bold"><t t-esc="formatCurrency(state.data.merchandise_filter.amount || 0)"/></span>).
                                    </p>
                                </div>
                                <div class="p-4 h-80 relative">
                                    <canvas class="w-full h-full" id="pcMonthlyCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:4px 0 0;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                            </section>

                            <!-- Top 10 Proveedores + Por Categoría (grid 2 cols) -->
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                <section class="bg-white rounded-lg border shadow-sm">
                                    <div class="px-4 py-3 border-b bg-gray-50/50">
                                        <h2 class="font-bold text-slate-700">Top 10 Proveedores</h2>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Por monto neto comprado en el período. Click abre las facturas del proveedor.
                                        </p>
                                    </div>
                                    <div class="p-4 h-80 relative">
                                        <canvas class="w-full h-full" id="pcSuppliersCanvas"></canvas>
                                    </div>
                                    <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:4px 0 0;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                                </section>

                                <section class="bg-white rounded-lg border shadow-sm">
                                    <div class="px-4 py-3 border-b bg-gray-50/50">
                                        <h2 class="font-bold text-slate-700">Compras por Categoría</h2>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Distribución del monto comprado por rubro. Click abre las líneas del rubro.
                                        </p>
                                    </div>
                                    <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="h-64 w-64 mx-auto relative">
                                            <canvas class="w-full h-full" id="pcCategoryCanvas"></canvas>
                                        </div>
                                        <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:4px 0 0;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                                        <div class="space-y-1 overflow-y-auto" style="max-height: 256px;">
                                            <t t-foreach="state.data.category_summary || []" t-as="cat" t-key="cat.category_id or cat_index">
                                                <div class="flex items-center justify-between gap-2 text-xs py-1 px-2 rounded hover:bg-gray-50 cursor-pointer transition-colors"
                                                     t-on-click="() => this.drillCategory(cat.category_id, cat.name)"
                                                     t-att-title="cat.name">
                                                    <div class="flex items-center gap-2 min-w-0">
                                                        <span class="inline-block w-3 h-3 rounded-sm flex-shrink-0 border border-white/50 shadow-sm"
                                                              t-attf-style="background-color: #{categoryColor(cat_index)};"></span>
                                                        <span class="font-medium text-slate-700 truncate"><t t-esc="cat.name"/></span>
                                                    </div>
                                                    <span class="font-bold text-odoo-orange whitespace-nowrap"
                                                          t-att-title="formatFullNumber(cat.amount)">
                                                        <t t-esc="formatCurrency(cat.amount)"/>
                                                    </span>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <!-- Top 10 Productos comprados -->
                            <section class="bg-white rounded-lg border shadow-sm">
                                <div class="px-4 py-3 border-b bg-gray-50/50 flex items-center justify-between flex-wrap gap-2">
                                    <div>
                                        <h2 class="font-bold text-slate-700">Top 10 Productos Comprados</h2>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            Por monto neto en el período. Click abre las líneas de compra del producto.
                                        </p>
                                    </div>
                                    <button t-on-click="toggleTopProductsDetail"
                                            class="text-xs font-bold text-odoo-purple hover:underline px-2 py-1 rounded">
                                        <t t-if="state.ui.topProductsDetail">
                                            <i class="fa fa-eye-slash mr-1"></i> Ocultar detalle
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-list-ul mr-1"></i> Ver detalle
                                        </t>
                                    </button>
                                </div>
                                <div class="p-4 h-80 relative">
                                    <canvas class="w-full h-full" id="pcTopProductsCanvas"></canvas>
                                </div>
                                <p style="text-align:center;font-size:11px;color:#9aa3b2;margin:4px 0 0;" t-if="state.showRangeCaption"><t t-esc="rangeLabel()"/></p>
                                <t t-if="state.ui.topProductsDetail">
                                    <div class="border-t bg-slate-50/30 px-4 pt-3 pb-4 overflow-x-auto">
                                        <table class="w-full text-sm">
                                            <thead>
                                                <tr class="text-left text-slate-400 uppercase text-[11px] tracking-wider border-b">
                                                    <th class="pb-2 font-medium">#</th>
                                                    <th class="pb-2 font-medium">Producto</th>
                                                    <th class="pb-2 font-medium">Categoría</th>
                                                    <th class="pb-2 font-medium text-right">Monto comprado</th>
                                                    <th class="pb-2 font-medium text-right">Cantidad</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y">
                                                <t t-foreach="state.data.top_products || []" t-as="prod" t-key="prod.id or prod_index">
                                                    <tr class="group hover:bg-gray-50 cursor-pointer transition-colors"
                                                        t-on-click="() => this.drillProduct(prod.id, prod.name)"
                                                        t-att-title="prod.name">
                                                        <td class="py-2 text-slate-400 font-mono text-xs"><t t-esc="prod_index + 1"/></td>
                                                        <td class="py-2">
                                                            <div class="min-w-0">
                                                                <div class="truncate text-sm font-medium text-slate-800"><t t-esc="prod.name"/></div>
                                                                <div t-if="prod.code" class="text-[11px] text-slate-400 font-mono tracking-tight truncate"><t t-esc="prod.code"/></div>
                                                            </div>
                                                        </td>
                                                        <td class="py-2 text-xs text-slate-500 truncate" t-att-title="prod.category">
                                                            <t t-esc="prod.category"/>
                                                        </td>
                                                        <td class="py-2 text-right font-bold text-odoo-orange whitespace-nowrap"
                                                            t-att-title="formatFullNumber(prod.amount)">
                                                            <t t-esc="formatCurrency(prod.amount)"/>
                                                        </td>
                                                        <td class="py-2 text-right text-slate-700 whitespace-nowrap">
                                                            <t t-esc="prod.qty.toLocaleString()"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                            </section>

                        </div>
                    </main>
                </div>
            </t>
        </div>
    </t>
</templates>
