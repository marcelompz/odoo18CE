<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Categoría que agrupa los permisos en la pestaña "Permisos de Acceso"
             del formulario de usuario. Aparece como un selector con los grupos
             que pertenecen a esta categoría. -->
        <record id="module_category_dashboard_cross" model="ir.module.category">
            <field name="name">Dashboards Cross</field>
            <field name="description">Permisos para acceder a los dashboards de Crossnexion.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo "Usuario Dashboard": habilita el acceso a los dashboards Comercial
             y de Productos. Cualquier usuario que NO tenga este grupo NO ve los
             menus y tampoco puede llamar al endpoint dashboard_cross.api por RPC. -->
        <record id="group_dashboard_cross_user" model="res.groups">
            <field name="name">Usuario Dashboard</field>
            <field name="category_id" ref="module_category_dashboard_cross"/>
            <field name="comment">Acceso a los dashboards Comercial y de Productos de Crossnexion.</field>
            <!-- Por default, asignamos al super-admin para que pueda administrar
                 quien mas tiene el permiso. Otros usuarios se agregan desde el
                 formulario del usuario, marcando el check "Usuario Dashboard". -->
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
