<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action Definitions -->
    <record id="action_commercial_dashboard" model="ir.actions.client">
        <field name="name">Reporte Gerencial</field>
        <field name="tag">dashboard_cross.commercial_dashboard</field>
        <field name="target">main</field>
    </record>

    <record id="action_product_dashboard" model="ir.actions.client">
        <field name="name">Dashboard de Productos</field>
        <field name="tag">dashboard_cross.product_dashboard</field>
        <field name="target">main</field>
    </record>

    <record id="action_purchase_dashboard" model="ir.actions.client">
        <field name="name">Dashboard de Compras</field>
        <field name="tag">dashboard_cross.purchase_dashboard</field>
        <field name="target">main</field>
    </record>

    <record id="action_sales_by_manager_dashboard" model="ir.actions.client">
        <field name="name">Ventas por días</field>
        <field name="tag">dashboard_cross.sales_by_manager_dashboard</field>
        <field name="target">main</field>
    </record>

    <record id="action_monthly_summary_dashboard" model="ir.actions.client">
        <field name="name">Ventas por mes</field>
        <field name="tag">dashboard_cross.monthly_summary_dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- ============================================================
         Menu Structure - Reorganizada en 3 niveles
         Dashboards Cross
         └── Comercial (parent)
             ├── Compras (purchase_dashboard)
             └── Ventas (subparent)
                  ├── Reporte Gerencial (commercial_dashboard)
                  ├── Productos (product_dashboard)
                  ├── Ventas por días (sales_by_manager_dashboard)
                  └── Ventas por mes (monthly_summary_dashboard)
         ============================================================ -->

    <menuitem id="menu_dashboard_cross_root"
              name="Dashboards Cross"
              web_icon="dashboard_cross,static/description/icon.png"
              sequence="10"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <!-- Nivel 1: Comercial (parent, sin acción) -->
    <menuitem id="menu_dashboard_commercial_parent"
              name="Comercial"
              parent="menu_dashboard_cross_root"
              sequence="1"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <!-- Nivel 2 dentro de Comercial: Compras -->
    <menuitem id="menu_dashboard_purchases"
              name="Compras"
              parent="menu_dashboard_commercial_parent"
              action="action_purchase_dashboard"
              sequence="1"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <!-- Nivel 2 dentro de Comercial: Ventas (subparent, sin acción) -->
    <menuitem id="menu_dashboard_ventas_parent"
              name="Ventas"
              parent="menu_dashboard_commercial_parent"
              sequence="2"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <!-- Nivel 3 dentro de Ventas: los dashboards de ventas -->
    <menuitem id="menu_dashboard_commercial"
              name="Reporte Gerencial"
              parent="menu_dashboard_ventas_parent"
              action="action_commercial_dashboard"
              sequence="1"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <menuitem id="menu_dashboard_products"
              name="Productos"
              parent="menu_dashboard_ventas_parent"
              action="action_product_dashboard"
              sequence="2"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <menuitem id="menu_dashboard_sales_by_manager"
              name="Ventas por días"
              parent="menu_dashboard_ventas_parent"
              action="action_sales_by_manager_dashboard"
              sequence="3"
              groups="dashboard_cross.group_dashboard_cross_user"/>

    <menuitem id="menu_dashboard_monthly_summary"
              name="Ventas por mes"
              parent="menu_dashboard_ventas_parent"
              action="action_monthly_summary_dashboard"
              sequence="4"
              groups="dashboard_cross.group_dashboard_cross_user"/>
</odoo>
