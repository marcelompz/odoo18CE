<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista personalizada usada como "drill-down" desde el dashboard -->
    <record id="view_dashboard_cross_invoice_drill_list" model="ir.ui.view">
        <field name="name">dashboard.cross.invoice.drill.list</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Detalle de Facturas"
                  create="false" delete="false" duplicate="false"
                  sample="1"
                  decoration-danger="move_type == 'out_refund'">
                <field name="name" string="Nro. Documento"/>
                <field name="partner_id" string="Cliente"/>
                <field name="invoice_date" string="Fecha Factura"/>
                <field name="invoice_date_due" string="Vencimiento"/>
                <field name="invoice_payment_term_id" string="Termino de Pago"/>
                <field name="move_type" string="Tipo" widget="badge"
                       decoration-success="move_type == 'out_invoice'"
                       decoration-danger="move_type == 'out_refund'"/>
                <field name="invoice_user_id" string="Vendedor" optional="show"/>
                <field name="amount_untaxed_signed" string="Neto" sum="Total Neto" optional="hide"/>
                <field name="amount_total_signed" string="Total (IVA Incl.)" sum="Total"/>
                <field name="currency_id" optional="hide"/>
                <field name="payment_state" string="Estado Pago" widget="badge"/>
                <field name="state" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista tree de líneas de factura: usada como drill-down desde el chart de Top Productos -->
    <record id="view_dashboard_cross_move_line_drill_list" model="ir.ui.view">
        <field name="name">dashboard.cross.move.line.drill.list</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Detalle Líneas de Factura"
                  create="false" delete="false" duplicate="false"
                  sample="1"
                  default_order="date desc, id desc"
                  decoration-danger="parent_state == 'cancel'"
                  decoration-muted="parent_state != 'posted'">
                <field name="move_id" string="Factura"/>
                <field name="date" string="Fecha"/>
                <field name="partner_id" string="Cliente"/>
                <field name="product_id" string="Producto"/>
                <field name="name" string="Descripción" optional="hide"/>
                <field name="quantity" string="Cantidad" sum="Total Cant."/>
                <field name="product_uom_id" string="UdM" optional="show"/>
                <field name="price_unit" string="Precio Unit." optional="show"/>
                <field name="price_subtotal" string="Subtotal" sum="Subtotal" optional="hide"/>
                <field name="price_total" string="Total (IVA Incl.)" sum="Total"/>
                <field name="currency_id" optional="hide"/>
                <field name="dashboard_antiquity_days" string="Antig. (días)" optional="show"/>
                <field name="parent_state" string="Estado" widget="badge" optional="show"
                       decoration-success="parent_state == 'posted'"
                       decoration-warning="parent_state == 'draft'"
                       decoration-danger="parent_state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Action base (usada como fallback, el dashboard lo llama via doAction con domain custom) -->
    <record id="action_dashboard_cross_invoice_drill" model="ir.actions.act_window">
        <field name="name">Detalle de Facturas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_dashboard_cross_invoice_drill_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="domain">[('move_type','in',['out_invoice','out_refund']),('state','=','posted')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
