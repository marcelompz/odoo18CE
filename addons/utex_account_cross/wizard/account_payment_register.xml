<odoo>

    <!-- form view -->

    <record id="account_payment_register_inherit_form" model="ir.ui.view">
        <field name="name">account.payment.register.inherit.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='communication']" position="after">
                <field name="note"/>
            </xpath>

            <xpath expr="//group[@name='group2']" position="after">
                <group>
                    <field name="journal_type" invisible="1"/>
                    <field name="origin_bank_id" invisible="journal_type == 'cash'" required="journal_type == 'bank'"/>
                    <field name="account_holder" invisible="journal_type == 'cash'" required="journal_type == 'bank'"/>
                    <field name="operation_number" invisible="journal_type == 'cash'" required="journal_type == 'bank'"/>
                </group>
            </xpath>
        
        </field>
    </record>

</odoo>
