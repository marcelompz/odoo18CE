<odoo>

    <!-- form view -->

    <record id="delinquent_customer_report_cross_form" model="ir.ui.view">
        <field name="name">delinquent.customer.report.cross.form</field>
        <field name="model">delinquent.customer.report.cross</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" options="{'no_create': 1, 'no_open': 1}"/>
                        <div class="text-muted">
                            <span><i>* Campo vacio muestra de todos</i></span>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="show_only_expired"/>
                    </group>
                    <footer>
                        <button name="action_done" type="object" string="Aceptar" class="btn btn-primary"/>
                        <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- window action -->

    <record id="delinquent_customer_report_cross_action" model="ir.actions.act_window">
        <field name="name">Reporte de estado de cuentas de clientes</field>
        <field name="res_model">delinquent.customer.report.cross</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- menu -->

    <menuitem
        id="delinquent_customer_report_cross_menu"
        name="Estado de cuentas de clientes"
        action="utex_account_cross.delinquent_customer_report_cross_action"
        parent="account.account_reports_legal_statements_menu"
        sequence="60"
    />

</odoo>
