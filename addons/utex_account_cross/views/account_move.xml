<odoo>

    <!-- form view -->
    <record id="account_move_in_invoice_inherit_form" model="ir.ui.view">
        <field name="name">account.move.in.invoice.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_total']" position="replace"/>

            <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="replace">
                <field name="price_subtotal" column_invisible="parent.move_type not in ['out_invoice', 'in_invoice', 'in_refund', 'in_receipt']" string="Importe S/Imp." optional="hide"/>
                <field name="price_total" column_invisible="parent.move_type not in ['out_invoice', 'in_invoice', 'in_refund', 'in_receipt']" string="Importe C/Imp." optional="show"/>
            </xpath>
        
        </field>
    </record>

</odoo>
