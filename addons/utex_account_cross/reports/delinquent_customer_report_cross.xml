<odoo>

    <!-- reporte de cuenta de clientes -->

    <template id="delinquent_customer_report">
        <t t-call="web.external_layout">
            <!-- Envolvemos todo el contenido en una etiqueta <main> -->
            <main>
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <!-- Ahora sí, el contenido del reporte -->
                        <h2 class="mt-4">Estado de cuentas de clientes</h2>
                        <div t-if="doc.partner_id">
                            Cliente: <t t-esc="doc.partner_id.name"/>
                        </div>
                        <div>
                            Periodo: <t t-esc="doc.date_from" t-options='{"widget": "date"}'/> - <t t-esc="doc.date_to" t-options='{"widget": "date"}'/>
                        </div>
                        
                        <table class="table table-sm mt-4" style="font-size: 12px;">
                            <thead>
                                <tr class="table-secondary">
                                    <th t-if="not doc.partner_id">Cliente</th>
                                    <th>Factura</th>
                                    <th>Fecha</th>
                                    <th>Vencimiento</th>
                                    <th class="text-end">Monto Total</th>
                                    <th class="text-end">Monto Pagado</th>
                                    <th class="text-end">Saldo Pendiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_residual" t-value="0.0"/>
                                <t t-set="total_paid" t-value="0.0"/>
                                <t t-set="total_balance" t-value="0.0"/>

                                <t t-foreach="sorted(doc.line_ids, key=lambda l: (l.partner_id.name, l.invoice_id.invoice_date))" t-as="line">
                                    <tr>
                                        <td t-if="not doc.partner_id"><span t-field="line.partner_id.name"/></td>
                                        <td><span t-esc="line.invoice_number or line.invoice_id.name"/></td>
                                        <td class="text-center"><span t-field="line.invoice_id.invoice_date" t-options='{"widget": "date"}'/></td>
                                        <td class="text-center"><span t-field="line.invoice_id.invoice_date_due" t-options='{"widget": "date"}'/></td>
                                        <td class="text-end"><span t-field="line.invoice_id.amount_total_signed" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/></td>
                                        <td class="text-end"><span t-esc="line.invoice_id.amount_total_signed - line.invoice_id.amount_residual_signed" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/></td>
                                        <td class="text-end"><span t-field="line.invoice_id.amount_residual_signed" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/></td>
                                    </tr>
                                    <t t-set="total_residual" t-value="total_residual + line.invoice_id.amount_total_signed"/>
                                    <t t-set="total_paid" t-value="total_paid + (line.invoice_id.amount_total_signed - line.invoice_id.amount_residual_signed)"/>
                                    <t t-set="total_balance" t-value="total_balance + line.invoice_id.amount_residual_signed"/>
                                </t>
                            </tbody>                            
                            <tfoot>
                                <tr class="table-secondary" style="font-weight: bold;">
                                    <td t-att-colspan="3 if doc.partner_id else 4" class="text-end">Total General Pendiente:</td>
                                    <td class="text-end">
                                        <span t-esc="total_residual" t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="total_paid" t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="total_balance" t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </main>
        </t>
    </template>

    <!-- action report -->

    <record id="action_delinquent_customer_report" model="ir.actions.report">
        <field name="name">Reporte de cuenta de clientes</field>
        <field name="model">delinquent.customer.report.cross</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utex_account_cross.delinquent_customer_report</field>
        <field name="report_file">utex_account_cross.delinquent_customer_report</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">
            f"Reporte cuenta cliente {object.date_from.strftime('%d-%m-%Y')} al {object.date_to.strftime('%d-%m-%Y')}" + (f" - {object.partner_id.name}" if object.partner_id else "")
        </field>
    </record>

</odoo>
