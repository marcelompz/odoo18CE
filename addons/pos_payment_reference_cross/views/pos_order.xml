<odoo>

    <!-- form view -->
    <record id="view_pos_pos_form_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ids']/list/field[@name='amount']" position="after">
                <field name="transaction_reference"/>
            </xpath>
        </field>
    </record>

    <!-- list view -->
    <record id="pos_order_inherit_tree" model="ir.ui.view">
        <field name="name">pos.order.inherit.tree</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']" position="after">
                <field name="payment_references" optional="show"/>
            </xpath>

        </field>
    </record>
    
</odoo>
