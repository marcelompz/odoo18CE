<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreenPaymentLinesInherit" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        
        <xpath expr="(//div[hasclass('payment-infos')])[1]" position="inside">
            <div class="payment-line-reference" t-if="line.payment_method_id.require_reference" t-on-click.stop="">
                <input class="form-control"
                       type="text"
                       placeholder="Referencia"
                       t-att-value="line.transaction_reference || ''"
                       t-on-change="(event) => this.onReferenceChange(line, event.target.value)"
                       style="font-size: 0.8rem; width: 150px;"
                       />
            </div>
        </xpath>

        <xpath expr="(//div[hasclass('payment-infos')])[2]" position="inside">
            <div class="payment-line-reference" t-if="line.payment_method_id.require_reference" t-on-click.stop="">
                <input class="form-control"
                       type="text"
                       placeholder="Referencia"
                       t-att-value="line.transaction_reference || ''"
                       t-on-change="(event) => this.onReferenceChange(line, event.target.value)"
                       style="font-size: 0.8rem; width: 150px;"
                       />
            </div>
        </xpath>

    </t>

</templates>
