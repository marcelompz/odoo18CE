<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_hr_job_manual">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
                <style>
                    body, div, span, td, th { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif !important; }
                </style>
            </head>
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family:'DejaVu Sans','Liberation Sans',Arial,sans-serif; font-size:10pt;">

                    <!-- ENCABEZADO -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; margin-bottom:0;">
                        <tr>
                            <td style="border:1px solid #000; padding:6px; width:18%; text-align:center; vertical-align:middle;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:60px; max-width:95%;"/>
                            </td>
                            <td style="border:1px solid #000; padding:8px; text-align:center; vertical-align:middle;">
                                <div style="font-size:14pt; font-weight:bold; line-height:1.1;">DESCRIPCION DE FUNCIONES</div>
                                <div style="font-size:9pt; margin-top:3px;">
                                    <t t-out="o.company_id.name"/>
                                </div>
                            </td>
                            <td style="border:1px solid #000; padding:6px; width:18%; text-align:center; vertical-align:middle; font-size:9pt;">
                                <b>Revision:</b><br/>
                                <span style="font-size:11pt;"><t t-out="o.manual_revision or '00'"/></span>
                            </td>
                        </tr>
                    </table>

                    <!-- METADATA: codigo, fechas, responsables -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:0;">
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; width:22%; font-weight:bold; font-size:9pt; background:#f5f5f5;">Codigo del Manual</td>
                            <td style="border:1px solid #000; padding:4px 6px; width:28%; font-size:9pt;"><t t-out="o.manual_code or '-'"/></td>
                            <td style="border:1px solid #000; padding:4px 6px; width:22%; font-weight:bold; font-size:9pt; background:#f5f5f5;">Estado</td>
                            <td style="border:1px solid #000; padding:4px 6px; width:28%; font-size:9pt;">
                                <t t-set="state_map" t-value="{'draft':'Borrador','review':'En Revision','approved':'Aprobado','rejected':'Rechazado'}"/>
                                <t t-out="state_map.get(o.manual_state, o.manual_state or '-')"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Fecha de Creacion</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_create_date" t-out="o.manual_create_date.strftime('%d/%m/%Y %H:%M')"/>
                                <t t-else="">-</t>
                            </td>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Creador del Documento</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_creator_id" t-out="o.manual_creator_id.name"/>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Fecha Envio a Revision</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_review_date" t-out="o.manual_review_date.strftime('%d/%m/%Y %H:%M')"/>
                                <t t-else="">-</t>
                            </td>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Aprobador</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_approved_by_id" t-out="o.manual_approved_by_id.name"/>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Proxima Revision</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_next_revision_date">
                                    <span t-attf-style="font-weight:bold;#{' color:#c00000;' if o.manual_is_overdue else ''}">
                                        <t t-out="o.manual_next_revision_date.strftime('%d/%m/%Y')"/>
                                        <t t-if="o.manual_is_overdue"> [VENCIDO]</t>
                                    </span>
                                </t>
                                <t t-else="">-</t>
                            </td>
                            <td style="border:1px solid #000; padding:4px 6px; font-weight:bold; font-size:9pt; background:#f5f5f5;">Fecha de Aprobacion</td>
                            <td style="border:1px solid #000; padding:4px 6px; font-size:9pt;">
                                <t t-if="o.manual_approval_date" t-out="o.manual_approval_date.strftime('%d/%m/%Y %H:%M')"/>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                    </table>

                    <!-- I. INFORMACION BASICA -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:0;">
                        <tr style="background:#dddddd;">
                            <td colspan="2" style="border:1px solid #000; padding:5px; font-weight:bold; font-size:11pt;">
                                I. INFORMACION BASICA
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; width:25%; font-weight:bold; background:#f5f5f5;">CARGO</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <span t-field="o.name"/>
                                <t t-if="o.department_id"> &#8211; <span t-field="o.department_id.name"/></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; font-weight:bold; background:#f5f5f5;">JEFE</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_boss_job_id"><span t-field="o.manual_boss_job_id.name"/></t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; font-weight:bold; background:#f5f5f5;">SUPERVISA A</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_supervises_job_ids">
                                    <t t-foreach="o.manual_supervises_job_ids" t-as="sup">
                                        <span t-field="sup.name"/><t t-if="not sup_last">, </t>
                                    </t>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>
                    </table>

                    <!-- II. NATURALEZA DEL PUESTO -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:0;">
                        <tr style="background:#dddddd;">
                            <td style="border:1px solid #000; padding:5px; font-weight:bold; font-size:11pt;">
                                II. NATURALEZA DEL PUESTO
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:8px; text-align:justify;">
                                <t t-if="o.manual_nature" t-out="o.manual_nature"/>
                                <t t-else=""><i style="color:#999;">(Sin descripcion cargada)</i></t>
                            </td>
                        </tr>
                    </table>

                    <!-- III. FUNCIONES Y RESPONSABILIDADES -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:0;">
                        <tr style="background:#dddddd;">
                            <td style="border:1px solid #000; padding:5px; font-weight:bold; font-size:11pt;">
                                III. FUNCIONES Y RESPONSABILIDADES
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:8px; text-align:justify;">
                                <t t-if="o.manual_function_line_ids">
                                    <ol style="margin:0; padding-left:20px;">
                                        <t t-foreach="o.manual_function_line_ids.sorted('sequence')" t-as="fn">
                                            <li style="margin-bottom:4px;">
                                                <b><t t-out="fn.name or (fn.function_id.name if fn.function_id else '')"/>:</b>
                                                <span t-if="fn.description" t-out="fn.description"/>
                                            </li>
                                        </t>
                                    </ol>
                                </t>
                                <t t-else=""><i style="color:#999;">(Sin funciones cargadas)</i></t>
                            </td>
                        </tr>
                    </table>

                    <!-- IV. REQUISITOS MINIMOS -->
                    <table style="width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:0;">
                        <tr style="background:#dddddd;">
                            <td colspan="2" style="border:1px solid #000; padding:5px; font-weight:bold; font-size:11pt;">
                                IV. REQUISITOS MINIMOS PARA EL PUESTO
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; width:22%; font-weight:bold; background:#f5f5f5; vertical-align:top;">EXPERIENCIA</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_experience" t-out="o.manual_experience"/>
                                <t t-else=""><i style="color:#999;">-</i></t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; font-weight:bold; background:#f5f5f5; vertical-align:top;">FORMACION</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_education_ids">
                                    <div style="margin-bottom:4px;">
                                        <t t-foreach="o.manual_education_ids" t-as="ed">
                                            <span style="display:inline-block; margin:2px 4px 2px 0; padding:2px 8px; border:1px solid #888; border-radius:10px; background:#eef; font-size:9pt;">
                                                <t t-out="ed.name"/>
                                            </span>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.manual_education_notes" t-out="o.manual_education_notes"/>
                                <t t-if="not o.manual_education_ids and not o.manual_education_notes">
                                    <i style="color:#999;">-</i>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; font-weight:bold; background:#f5f5f5; vertical-align:top;">HABILIDAD</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_skill_ids">
                                    <div style="margin-bottom:4px;">
                                        <t t-foreach="o.manual_skill_ids" t-as="sk">
                                            <span style="display:inline-block; margin:2px 4px 2px 0; padding:2px 8px; border:1px solid #888; border-radius:10px; background:#eef; font-size:9pt;">
                                                <t t-out="sk.name"/>
                                            </span>
                                        </t>
                                    </div>
                                </t>
                                <t t-if="o.manual_skills_notes" t-out="o.manual_skills_notes"/>
                                <t t-if="not o.manual_skill_ids and not o.manual_skills_notes">
                                    <i style="color:#999;">-</i>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000; padding:6px; font-weight:bold; background:#f5f5f5; vertical-align:top;">EPI</td>
                            <td style="border:1px solid #000; padding:6px;">
                                <t t-if="o.manual_epi" t-out="o.manual_epi"/>
                                <t t-else=""><i style="color:#999;">-</i></t>
                            </td>
                        </tr>
                    </table>

                    <!-- Pie de firma -->
                    <table style="width:100%; margin-top:50px; font-size:9pt;">
                        <tr>
                            <td style="text-align:center; border-top:1px solid #000; padding-top:4px; width:45%;">
                                Elaborado por<br/><small>Recursos Humanos</small>
                            </td>
                            <td style="width:10%;"></td>
                            <td style="text-align:center; border-top:1px solid #000; padding-top:4px; width:45%;">
                                Aprobado por<br/><small>Direccion</small>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
