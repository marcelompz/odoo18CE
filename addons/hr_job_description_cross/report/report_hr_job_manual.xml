<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hr_job_manual" model="report.paperformat">
        <field name="name">Manual de Funciones - A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_hr_job_manual" model="ir.actions.report">
        <field name="name">Manual de Funciones</field>
        <field name="model">hr.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_job_description_cross.report_hr_job_manual</field>
        <field name="report_file">hr_job_description_cross.report_hr_job_manual</field>
        <field name="print_report_name">'Manual_Funciones_%s' % (object.name or '')</field>
        <field name="binding_model_id" ref="hr.model_hr_job"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_hr_job_manual"/>
    </record>
</odoo>
