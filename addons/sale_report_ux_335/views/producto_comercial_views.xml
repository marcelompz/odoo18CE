<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="producto_comercial_view_tree" model="ir.ui.view">
        <field name="name">producto.comercial.tree</field>
        <field name="model">producto.comercial</field>
        <field name="arch" type="xml">
            <list string="Productos comerciales" create="1" delete="1" edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="list_price" string="Precio"/>
                <field name="descripcion"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="producto_comercial_view_form" model="ir.ui.view">
        <field name="name">producto.comercial.form</field>
        <field name="model">producto.comercial</field>
        <field name="arch" type="xml">
            <form string="Producto comercial">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="list_price"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion" placeholder="Descripción del producto comercial..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
