<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_presupuesto_rapido" model="ir.ui.view">
        <field name="name">sale.order.form.presupuesto.rapido</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Presupuesto rápido" name="presupuesto_rapido">
                    <field name="currency_id" invisible="1"/>
                    <field name="presupuesto_rapido_line_ids" nolabel="1">
                        <list editable="bottom" create="1" delete="1">
                            <field name="producto_comercial_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                        </list>
                    </field>
                    <group class="mt-3">
                        <group/>
                        <group>
                            <label for="amount_presupuesto_rapido"/>
                            <div class="o_row">
                                <field name="amount_presupuesto_rapido" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                    <p class="text-muted mb-0"><i class="fa fa-info-circle"/> Sin impacto en inventario. El total se carga en una línea con el producto "Presupuesto".</p>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="other_notes" string="Otras Notas">
                    <group name="group_other_notes" string="Otras notas para el presupuesto UX 335">
                        <field name="other_note" nolabel="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
