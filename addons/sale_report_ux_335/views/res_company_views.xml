<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_presupuesto" model="ir.ui.view">
        <field name="name">res.company.form.presupuesto</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Presupuesto rápido (UX 335)">
                    <field name="product_presupuesto_id" placeholder="Seleccionar producto para la línea de presupuesto..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
