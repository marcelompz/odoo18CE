<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presupuesto_config_form" model="ir.ui.view">
        <field name="name">presupuesto.rapido.config.form</field>
        <field name="model">presupuesto.rapido.config</field>
        <field name="arch" type="xml">
            <form string="Configuracion Presupuesto Rapido">
                <sheet>
                    <group>
                        <group string="Producto para linea de presupuesto">
                            <field name="product_presupuesto_id" placeholder="Seleccionar producto para la linea de presupuesto..." options="{'no_create': True}"/>
                        </group>
                        <group/>
                    </group>
                    <separator string="Imagen de fondo del reporte"/>
                    <group>
                        <group>
                            <field name="report_background_image" widget="image" options="{'size': [300, 400]}"/>
                            <field name="report_background_filename" invisible="1"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                <p><i class="fa fa-info-circle"/> Suba una imagen A4 (210x297 mm) que se usara como fondo en todas las paginas del presupuesto PDF.</p>
                                <p>Formatos recomendados: PNG o JPG.</p>
                            </div>
                        </group>
                    </group>
                    <separator string="Texto introductorio"/>
                    <group>
                        <field name="report_intro_html" widget="html" nolabel="1" placeholder="Ingrese el texto introductorio del presupuesto..."/>
                    </group>
                    <separator string="Margenes del contenido (en pixeles)"/>
                    <group>
                        <group>
                            <field name="report_margin_top"/>
                            <field name="report_margin_bottom"/>
                        </group>
                        <group>
                            <field name="report_margin_left"/>
                            <field name="report_margin_right"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Guardar" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_presupuesto_config" model="ir.actions.act_window">
        <field name="name">Configuracion</field>
        <field name="res_model">presupuesto.rapido.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>
</odoo>
