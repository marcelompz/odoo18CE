<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_ux_335">
        <t t-set="report_company" t-value="docs[0].company_id if docs else env.company"/>
        <t t-set="bg_image" t-value="report_company.report_background_image"/>
        <t t-set="report_fondo_data_uri" t-value="'data:image/png;base64,' + bg_image.decode() if bg_image else False"/>
        
        <!-- Reducimos los márgenes por defecto de 15 a 10 para ganar ancho -->
        <t t-set="m_top" t-value="report_company.report_margin_top or 45"/>
        <t t-set="m_bottom" t-value="report_company.report_margin_bottom or 30"/>
        <t t-set="m_left" t-value="report_company.report_margin_left or 10"/>
        <t t-set="m_right" t-value="report_company.report_margin_right or 10"/>

        <html>
            <head>
                <meta charset="utf-8"/>
            </head>
            <body style="font-family: sans-serif;">
                <t t-foreach="docs" t-as="doc">
                    <main>
                    <div class="article" t-att-data-oe-model="'sale.order'" t-att-data-oe-id="doc.id" style="margin: 0; padding: 0;">
                        <style>
                            @page {
                                margin-top: <t t-esc="m_top"/>mm !important;
                                margin-bottom: <t t-esc="m_bottom"/>mm !important;
                                margin-left: <t t-esc="m_left"/>mm !important;
                                margin-right: <t t-esc="m_right"/>mm !important;
                                size: A4;
                            }
                            /* Forzamos que la tabla use todo el ancho disponible */
                            .table-custom {
                                width: 100% !important;
                                table-layout: fixed;
                                border-collapse: collapse;
                                font-size: 13px; /* Tamaño de letra reducido para la tabla */
                            }
                            .table-custom th, .table-custom td {
                                border: 1px solid black !important;
                                padding: 4px 6px !important;
                                vertical-align: middle;
                            }
                        </style>

                        <!-- Eliminamos el padding redundante del wrapper para que la tabla se pegue al margen -->
                        <div class="page-wrapper">

                            <div class="text-end mb-4" style="text-align: right !important; font-size: 16px;">
                                <span t-esc="'Ciudad del Este, %s de %s del %s' % (doc.date_order.day, ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'][doc.date_order.month-1], doc.date_order.year)"/>
                            </div>

                            <div class="mb-4" style="font-size: 12pt; line-height: 1.2; color: black;">
                                <div style="font-weight: bold; margin-bottom: 5px; text-transform: uppercase;">
                                    PRESUPUESTO Nº <t t-esc="doc.name.replace('S', '').lstrip('0')"/>
                                </div>

                                <div style="margin-top: 15px;">
                                    <div style="margin-bottom: 4px;"><span style="text-decoration: underline;">Sr./Sres.</span></div>
                                    <div style="margin-bottom: 4px;"><span>Cliente: </span><span t-field="doc.partner_id.name"/></div>
                                    <t t-if="doc.partner_id.vat">
                                        <div><span>RUC: </span><span t-field="doc.partner_id.vat"/></div>
                                    </t>
                                </div>
                            </div>

                            <div class="mb-4 text-justify" style="font-size: 14px; line-height: 1.3;">
                                <t t-if="doc.company_id.report_intro_html">
                                    <div t-field="doc.company_id.report_intro_html"/>
                                </t>
                                <t t-else="">
                                    <p>Nos dirigimos a Uds. con el fin de presentar el presupuesto correspondiente a las prendas solicitadas...</p>
                                </t>
                            </div>

                            <div style="page-break-inside: avoid;">
                                <table class="table-custom">
                                    <thead>
                                        <tr style="background-color: #f2f2f2; font-weight: bold;">
                                            <th class="text-center" style="width: 8%;">Cant.</th>
                                            <th class="text-start" style="width: 57%;">Producto / Descripción</th>
                                            <th class="text-end" style="width: 15%;">Precio</th>
                                            <th class="text-end" style="width: 20%;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc._get_report_lines()" t-as="line">
                                            <tr>
                                                <td class="text-center"><span t-esc="line['quantity']"/></td>
                                                <td class="text-start" style="word-wrap: break-word;">
                                                    <span t-esc="line['name']"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-esc="'{:,.0f}'.format(int(round(line['price_unit']))).replace(',', '.')"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-esc="'{:,.0f}'.format(int(round(line['price_subtotal']))).replace(',', '.')"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <tr style="background-color: #f9f9f9; font-size: 15px;">
                                            <td colspan="3" class="text-end"><strong>TOTAL GUARANÍES</strong></td>
                                            <td class="text-end" style="white-space: nowrap;">
                                                <strong><span t-esc="'{:,.0f}'.format(int(round(doc.amount_total))).replace(',', '.')"/></strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div t-if="doc.other_note" style="font-size: 12px; margin-top: 10px; border: 1px solid #ddd; padding: 8px; border-radius: 4px;">
                                    <strong>Notas adicionales:</strong>
                                    <div style="line-height: 1.1; margin-top: 3px;">
                                        <span t-out="doc.other_note"/>
                                    </div>
                                </div>

                                <div t-if="doc.note" style="font-size: 12px; margin-top: 10px; border: 1px solid #ddd; padding: 8px; border-radius: 4px;">
                                    <strong>Términos y condiciones:</strong>
                                    <div style="line-height: 1.1; margin-top: 3px;">
                                        <span t-out="doc.note"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    </main>
                </t>
            </body>
        </html>
    </template>
</odoo>
